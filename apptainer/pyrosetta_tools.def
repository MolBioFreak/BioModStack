Bootstrap: docker
From: mambaorg/micromamba:1.5.8

%post -c /bin/bash
    apt-get update && apt-get upgrade -y
    apt-get install -y \
        wget \
        unzip \
        git \
        curl \
        procps \
        coreutils \
        grep \
        pigz \
        sed

    micromamba create -n pyrosetta -c conda-forge python=3.9 pip pyyaml -y
    eval "$(micromamba shell hook --shell bash)"
    micromamba activate pyrosetta

    # Install UV package manager (10-100x faster than pip)
    pip install --compile uv
    
    uv pip install --compile pyrosetta-installer
    python -c 'import pyrosetta_installer; pyrosetta_installer.install_pyrosetta()'

    # Install PyTorch 2.4.1 with CUDA 12.1
    # WARNING: RTX 5090 (sm_120) not officially supported but DOES work (tested)
    uv pip install --compile torch==2.4.1 torchvision torchaudio --index-url https://download.pytorch.org/whl/cu121

    uv pip install --compile biopython pandas matplotlib

    apt-get autoremove -y
    apt-get clean

%environment
    # so we can just run it out of the box without having to set the prefix
    export PATH=/opt/conda/envs/pyrosetta/bin:$PATH

# Entry point for the container when run.
%runscript
    exec "$@"
