Bootstrap: docker
From: ubuntu:24.04@sha256:008173c23f95b170204355c12626cb5a965d779a7e1283b09e9cffbb1bf33ca3

# Build from the BMS repository root; this tracked hook adds producer identity
# without altering the pinned native sampling/filtering algorithms.
%files
    apptainer/bindcraft2-producer.patch /opt/bindcraft2-producer.patch

%labels
    Author BioModStack
    Version d5bae16e9fee95f4c97fc16bc05dcbde4ccb885f
    Description BindCraft2 cuda13 native campaign image (not retired BindCraft v1)

%post
    set -eu
    export DEBIAN_FRONTEND=noninteractive PIP_BREAK_SYSTEM_PACKAGES=1 PIP_NO_CACHE_DIR=1
    apt-get update
    apt-get install -y --no-install-recommends python3 python3-pip python3-dev build-essential ca-certificates git
    rm -rf /var/lib/apt/lists/*
    git clone https://github.com/PacesaLab/BindCraft2.git /opt/bindcraft
    cd /opt/bindcraft
    git checkout --detach d5bae16e9fee95f4c97fc16bc05dcbde4ccb885f
    test "$(git rev-parse HEAD)" = d5bae16e9fee95f4c97fc16bc05dcbde4ccb885f
    git apply --check /opt/bindcraft2-producer.patch
    git apply /opt/bindcraft2-producer.patch
    python3 -m py_compile bindcraft/campaign.py
    # Dependency versions observed in the installed pinned image. Keep the source
    # editable for native settings/scaffolds; do not resolve new accelerator wheels.
    python3 -m pip install \
        absl-py==2.5.0 \
        biotite==1.7.1 \
        biotraj==1.2.2 \
        certifi==2026.7.22 \
        charset-normalizer==3.5.1 \
        contourpy==1.4.0 \
        cuequivariance==0.11.1 \
        cuequivariance-jax==0.11.1 \
        cuequivariance-ops-cu13==0.11.1 \
        cycler==0.12.1 \
        dm-haiku==0.0.17 \
        einops==0.8.2 \
        fonttools==4.66.0 \
        idna==3.20 \
        jax==0.11.2 \
        jax-cuda13-pjrt==0.11.2 \
        jax-cuda13-plugin==0.11.2 \
        jaxlib==0.11.2 \
        jmp==0.0.4 \
        kiwisolver==1.5.1 \
        matplotlib==3.11.2 \
        ml_collections==1.1.0 \
        ml_dtypes==0.6.0 \
        mpmath==1.3.0 \
        msgpack==1.2.2 \
        networkx==3.7 \
        numpy==2.5.3 \
        nvidia-cublas==13.8.0.4 \
        nvidia-cuda-cccl==13.3.4.3.1 \
        nvidia-cuda-crt==13.4.92 \
        nvidia-cuda-cupti==13.4.92 \
        nvidia-cuda-nvcc==13.4.92 \
        nvidia-cuda-nvrtc==13.4.92 \
        nvidia-cuda-runtime==13.4.92 \
        nvidia-cudnn-cu13==9.26.0.51 \
        nvidia-cufft==12.4.0.43 \
        nvidia-cusolver==12.3.4.7 \
        nvidia-cusparse==12.8.6.72 \
        nvidia-ml-py==13.610.43 \
        nvidia-nccl-cu13==2.32.3 \
        nvidia-nvjitlink==13.4.92 \
        nvidia-nvshmem-cu13==3.8.0 \
        nvidia-nvvm==13.4.92 \
        opt_einsum==3.4.0 \
        optax==0.2.8 \
        packaging==26.3 \
        pillow==12.3.0 \
        platformdirs==4.11.12 \
        pyparsing==3.3.3 \
        python-dateutil==2.9.0.post0 \
        PyYAML==6.0.3 \
        requests==2.34.2 \
        scipy==1.18.1 \
        setuptools==68.1.2 \
        six==1.17.0 \
        sympy==1.14.0 \
        tabulate==0.10.0 \
        tqdm==4.70.1 \
        urllib3==2.8.0 \
        wheel==0.42.0
    python3 -m pip install --no-deps --no-build-isolation -e '/opt/bindcraft[cuda13]'
    # Existing BMS image manifest mechanism, not a runtime admission gate.
    python3 -m pip freeze > /opt/bindcraft/requirements.lock
    dpkg-query -W > /opt/bindcraft/system-packages.lock
    python3 -c "import nvidia,pathlib; print('\\n'.join(sorted(str(path) for root in nvidia.__path__ for path in pathlib.Path(root).glob('*/lib'))))" > /etc/ld.so.conf.d/bindcraft-cuda.conf
    ldconfig
    ldconfig -p | grep -q libcupti
    cd /
    python3 -c 'import jax, bindcraft.proteinmpnn; print(jax.__version__)'
    python3 -m bindcraft.selfcheck cuda13 --shipped-only

%environment
    export PIP_BREAK_SYSTEM_PACKAGES=1
    export NVIDIA_VISIBLE_DEVICES=all
    export NVIDIA_DRIVER_CAPABILITIES=compute,utility
    export PYTHONUNBUFFERED=1

%test
    test "$(git -C /opt/bindcraft rev-parse HEAD)" = d5bae16e9fee95f4c97fc16bc05dcbde4ccb885f
    git -C /opt/bindcraft apply --reverse --check /opt/bindcraft2-producer.patch
    python3 -m bindcraft.selfcheck cuda13 --shipped-only

%help
    Pinned BC2 v1.0.1. Bind the shared AlphaFold params and durable JAX cache
    at runtime; the image includes shipped MPNN weights, not AF2 downloads.
    Build/qualify on an authorized CUDA 13 compatible host before enabling.
