Bootstrap: docker
From: ubuntu:24.04@sha256:008173c23f95b170204355c12626cb5a965d779a7e1283b09e9cffbb1bf33ca3

# Build from the BMS repository root. Native source, presets, shipped checkpoints
# and both scientific/producer patches are unchanged; only accelerator wheels move.
%files
    apptainer/bindcraft2-producer.patch /opt/bindcraft2-producer.patch
    apptainer/bindcraft2-aa-bias.patch /opt/bindcraft2-aa-bias.patch
    apptainer/bindcraft2-cuda12-requirements.lock /opt/bindcraft2-cuda12-requirements.lock
    apptainer/bindcraft2-cuda12-identity.json /opt/bindcraft2-cuda12-identity.json

%labels
    Author BioModStack
    Version d5bae16e9fee95f4c97fc16bc05dcbde4ccb885f
    Description BindCraft2 pinned CUDA12.8 Blackwell native campaign image (not retired BindCraft v1)
    AminoAcidBiasFix 90f5496550d5981aa0d6fe1831f76c87322350d9-code-only

%post
    set -eu
    export DEBIAN_FRONTEND=noninteractive PIP_BREAK_SYSTEM_PACKAGES=1 PIP_NO_CACHE_DIR=1
    apt-get update
    apt-get install -y --no-install-recommends python3 python3-pip python3-dev build-essential ca-certificates git
    rm -rf /var/lib/apt/lists/*
    git clone https://github.com/PacesaLab/BindCraft2.git /opt/bindcraft
    cd /opt/bindcraft
    git checkout --detach d5bae16e9fee95f4c97fc16bc05dcbde4ccb885f
    test "$(git rev-parse HEAD)" = d5bae16e9fee95f4c97fc16bc05dcbde4ccb885f
    git apply --check /opt/bindcraft2-producer.patch
    git apply /opt/bindcraft2-producer.patch
    git apply --check /opt/bindcraft2-aa-bias.patch
    git apply /opt/bindcraft2-aa-bias.patch
    python3 -m py_compile bindcraft/af2.py bindcraft/campaign.py bindcraft/protein_preparation.py bindcraft/proteinmpnn.py bindcraft/sequence_optimization.py
    # The native cuda12 extra exists at this exact scientific pin. All wheels,
    # including non-accelerator packages, are pinned by version and PyPI SHA256.
    python3 -m pip install --only-binary=:all: --require-hashes -r /opt/bindcraft2-cuda12-requirements.lock
    python3 -m pip install --no-deps --no-build-isolation -e '/opt/bindcraft[cuda12]'
    python3 -m pip check
    python3 -m pip freeze > /opt/bindcraft/requirements.lock
    dpkg-query -W > /opt/bindcraft/system-packages.lock
    python3 -c "import nvidia,pathlib; print('\\n'.join(sorted(str(path) for root in nvidia.__path__ for path in pathlib.Path(root).glob('*/lib'))))" > /etc/ld.so.conf.d/bindcraft-cuda.conf
    ldconfig
    ldconfig -p | grep -q libcupti
    cd /
    JAX_PLATFORMS=cpu python3 -c 'import jax, bindcraft.proteinmpnn; print(jax.__version__, jax.devices())'
    python3 -m bindcraft.selfcheck cuda12 --shipped-only

%environment
    export PIP_BREAK_SYSTEM_PACKAGES=1
    export NVIDIA_VISIBLE_DEVICES=all
    export NVIDIA_DRIVER_CAPABILITIES=compute,utility
    export PYTHONUNBUFFERED=1

%test
    test "$(git -C /opt/bindcraft rev-parse HEAD)" = d5bae16e9fee95f4c97fc16bc05dcbde4ccb885f
    git -C /opt/bindcraft apply --reverse --check /opt/bindcraft2-aa-bias.patch
    git -C /opt/bindcraft apply --reverse --check /opt/bindcraft2-producer.patch
    python3 -m pip check
    python3 -m bindcraft.selfcheck cuda12 --shipped-only

%help
    Pinned BC2 v1.0.1 plus the upstream PR17 bias calculation correction.
    Presets and operator settings are unchanged. Bind AlphaFold params and JAX cache
    at runtime; the image includes shipped MPNN weights, not AF2 downloads.
    CUDA12.8 compiler/runtime/library closure supports Blackwell sm120.
    JAX 0.11.2, cuEquivariance 0.11.1 and cuDNN 9.10.2.21 are unchanged.
    GPU-specific driver requirements apply; CPU checks are not GPU qualification.
