Bootstrap: docker
From: nvidia/cuda:12.4.1-runtime-ubuntu22.04

%labels
    Author BioModStack
    Description RFantibody - De novo antibody backbone design with fine-tuned RFdiffusion
    Version 1.0.0

%post
    apt-get update && apt-get install -y \
        wget \
        git \
        curl \
        python3 \
        python3-pip \
        python3-venv \
        && apt-get clean \
        && rm -rf /var/lib/apt/lists/*

    # Install UV package manager (10-100x faster than pip)
    curl -LsSf https://astral.sh/uv/install.sh | sh
    export PATH="/root/.local/bin:$PATH"

    # Create virtual environment
    uv venv /opt/venv
    export VIRTUAL_ENV=/opt/venv
    export PATH="/opt/venv/bin:$PATH"

    # Install PyTorch with CUDA 12.4 support
    uv pip install torch torchvision torchaudio --index-url https://download.pytorch.org/whl/cu124

    # Clone RFantibody
    git clone https://github.com/RosettaCommons/RFantibody.git /opt/RFantibody
    cd /opt/RFantibody

    # Install RFantibody and all dependencies with UV
    # Poetry install often fails in containers, so we use uv pip directly
    uv pip install icecream e3nn hydra-core omegaconf pyyaml biopython
    
    # Install RFantibody as editable package
    uv pip install -e /opt/RFantibody 2>/dev/null || true
    
    # SE3-Transformer (required for RF tools)
    uv pip install dgl -f https://data.dgl.ai/wheels/cu124/repo.html

    # Cleanup
    rm -rf /root/.cache/uv

    # Create weights directory - weights should be mounted at runtime
    mkdir -p /opt/RFantibody/weights

%environment
    # CRITICAL: Include src/ and include/ in PYTHONPATH for rfantibody module
    export PYTHONPATH="/opt/RFantibody/src:/opt/RFantibody/include:/opt/RFantibody:$PYTHONPATH"
    export PATH="/opt/venv/bin:/opt/RFantibody:$PATH"
    export VIRTUAL_ENV=/opt/venv
    # Weights path - should be mounted from host at /opt/RFantibody/weights
    export RFANTIBODY_WEIGHTS="/opt/RFantibody/weights"

%runscript
    cd /opt/RFantibody
    python3 "$@"
