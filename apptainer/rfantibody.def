Bootstrap: docker
From: nvcr.io/nvidia/cuda:12.8.0-devel-ubuntu22.04

# RFantibody container for NVIDIA Blackwell/Ada/Ampere
# Deterministic build with pinned RFantibody commit + pinned torch nightly date.
# DGL is built from source against the pinned torch/cuda stack.

%labels
    Author BioModStack
    Version 2.1
    Description RFantibody - antibody design with RFdiffusion (pinned runtime)
    RFantibodyCommit 8d9d402a99fd63052ad538b3d670e467b800123c
    TorchSpec torch==2.11.0.dev20260204+cu128
    TorchvisionSpec torchvision==0.25.0.dev20260204+cu128
    TorchaudioSpec torchaudio==2.11.0.dev20260204+cu128
    DGLVersion 2.5.0-source
    CUDA 12.8.0

%post
    set -euxo pipefail
    export DEBIAN_FRONTEND=noninteractive
    export RFANTIBODY_REPO_URL="https://github.com/RosettaCommons/RFantibody.git"
    export RFANTIBODY_COMMIT="8d9d402a99fd63052ad538b3d670e467b800123c"
    export TORCH_SPEC="torch==2.11.0.dev20260204+cu128"
    export TORCHVISION_SPEC="torchvision==0.25.0.dev20260204+cu128"
    export TORCHAUDIO_SPEC="torchaudio==2.11.0.dev20260204+cu128"
    export DGL_VERSION="2.5.0"

    # Install system dependencies
    apt-get -q update
    apt-get install --no-install-recommends -y \
        git \
        wget \
        curl \
        build-essential \
        ninja-build \
        g++-11 \
        python3.11 \
        python3.11-venv \
        python3.11-dev \
        python3-pip \
        pkg-config \
        libomp-dev \
        ca-certificates

    # Install modern CMake (3.29.3) - Ubuntu 22.04 default is too old
    cd /tmp
    wget -q https://github.com/Kitware/CMake/releases/download/v3.29.3/cmake-3.29.3-linux-x86_64.sh
    sh cmake-3.29.3-linux-x86_64.sh --skip-license --prefix=/usr/local
    rm cmake-3.29.3-linux-x86_64.sh

    # Install UV (10-100x faster than pip)
    curl -LsSf https://astral.sh/uv/install.sh | sh
    export PATH="/root/.local/bin:$PATH"

    # Create virtualenv with UV
    uv venv --python python3.11 /opt/venv
    export VIRTUAL_ENV=/opt/venv
    export PATH="/opt/venv/bin:$PATH"
    export CC=gcc-11
    export CXX=g++-11

    # Install pinned torch nightly build (date-pinned, not floating).
    uv pip install --compile --no-cache-dir \
        --index-url https://download.pytorch.org/whl/nightly/cu128 \
        "${TORCH_SPEC}" "${TORCHVISION_SPEC}" "${TORCHAUDIO_SPEC}"

    # Install pinned Python dependencies used by RFantibody.
    uv pip install --compile \
        numpy==1.26.4 \
        scipy==1.17.0 \
        sympy==1.14.0 \
        networkx==3.6 \
        jinja2==3.1.6 \
        fsspec==2026.1.0 \
        filelock==3.20.0 \
        typing-extensions==4.15.0 \
        pillow==12.0.0

    # Clone and pin RFantibody repository.
    git clone "${RFANTIBODY_REPO_URL}" /opt/RFantibody
    cd /opt/RFantibody
    git checkout "${RFANTIBODY_COMMIT}"

    # Install RFantibody runtime dependencies.
    uv pip install --compile \
        hydra-core==1.3.2 \
        pandas==3.0.0 \
        pydantic==2.12.5 \
        pyrsistent==0.19.3 \
        icecream==2.1.3 \
        biopython==1.81 \
        pyyaml==6.0.3 \
        pyarrow==23.0.0 \
        opt_einsum==3.4.0

    # Install e3nn with --no-deps to prevent torch downgrade
    uv pip install --compile --no-deps e3nn==0.5.9
    uv pip install --compile --no-deps opt_einsum==3.4.0
    uv pip install --compile --no-deps opt-einsum-fx

    # Build DGL from source for the pinned torch/cuda stack.
    cd /tmp
    git clone --recursive --branch "v${DGL_VERSION}" https://github.com/dmlc/dgl.git
    cd /tmp/dgl
    mkdir -p build
    cmake -S . -B build \
        -DUSE_CUDA=ON \
        -DBUILD_TORCH=ON \
        -DUSE_GRAPHBOLT=OFF \
        -DUSE_LIBXSMM=OFF
    cmake --build build -j"$(nproc)"
    cd /tmp/dgl/python
    DGLBACKEND=pytorch python setup.py install

    # Build and install SE3Transformer from RFantibody/include
    # Must rebuild CUDA extensions from source for pinned torch ABI compatibility.
    cd /opt/RFantibody/include/SE3Transformer
    find . -name "*.so" -delete
    find . -name "*.pyc" -delete
    rm -rf build/ *.egg-info/
    uv pip install --compile --no-build-isolation .

    # Install RFantibody as editable package
    cd /opt/RFantibody
    uv pip install --compile --no-deps -e .

    # Create python symlinks for backward compatibility with Nextflow modules
    ln -sf /opt/venv/bin/python /opt/venv/bin/python3.10
    ln -sf /opt/venv/bin/python /opt/venv/bin/python3

    # Record pinned build manifest and lockfile for reproducibility.
    {
        echo "rfantibody_repo_url=${RFANTIBODY_REPO_URL}"
        echo "rfantibody_commit=${RFANTIBODY_COMMIT}"
        echo "torch_spec=${TORCH_SPEC}"
        echo "torchvision_spec=${TORCHVISION_SPEC}"
        echo "torchaudio_spec=${TORCHAUDIO_SPEC}"
        echo "dgl_source_tag=v${DGL_VERSION}"
        echo "cuda_base=12.8.0"
    } > /opt/RFantibody/.build_manifest
    uv pip freeze > /opt/venv/requirements.lock

    # Clean up
    apt-get autoremove -y
    apt-get clean
    rm -rf /var/lib/apt/lists/*
    rm -rf /tmp/dgl /tmp/cmake-*.sh
    rm -rf /root/.cache/uv

    # Create weights directory - weights should be mounted at runtime
    mkdir -p /opt/RFantibody/weights

%environment
    export PATH="/opt/venv/bin:$PATH"
    export VIRTUAL_ENV=/opt/venv
    export DGLBACKEND="pytorch"
    export PYTHONUNBUFFERED=1
    # Compatibility setting: keep TorchScript JIT disabled for this stack.
    # This avoids known JIT compatibility crashes, but it is not a fix for
    # numerical corruption from ABI/runtime mismatches.
    export PYTORCH_JIT=0
    export RFANTIBODY_COMMIT="8d9d402a99fd63052ad538b3d670e467b800123c"
    # PyTorch CUDA libraries (cusparselt, cudnn, cublas, etc.)
    export LD_LIBRARY_PATH="/opt/venv/lib/python3.11/site-packages/nvidia/cusparselt/lib:/opt/venv/lib/python3.11/site-packages/nvidia/cusparse/lib:/opt/venv/lib/python3.11/site-packages/nvidia/cudnn/lib:/opt/venv/lib/python3.11/site-packages/nvidia/cublas/lib:/opt/venv/lib/python3.11/site-packages/nvidia/cuda_runtime/lib:/opt/venv/lib/python3.11/site-packages/nvidia/nvjitlink/lib:/opt/venv/lib/python3.11/site-packages/torch/lib:$LD_LIBRARY_PATH"
    # Include RFantibody and bundled modules in PYTHONPATH.
    export PYTHONPATH="/opt/RFantibody/src:/opt/RFantibody/src/rfantibody/rfdiffusion:/opt/RFantibody/src/rfantibody/rf2:/opt/RFantibody/include:/opt/RFantibody/include/SE3Transformer:/opt/RFantibody:$PYTHONPATH"
    export RFANTIBODY_WEIGHTS="/opt/RFantibody/weights"

%runscript
    cd /opt/RFantibody
    exec python scripts/rfdiffusion_inference.py "$@"

%help
    RFantibody container for antibody design with RFdiffusion.
    Deterministic runtime:
      - RFantibody commit: 8d9d402a99fd63052ad538b3d670e467b800123c
      - torch: 2.11.0.dev20260204+cu128
      - dgl: source build from v2.5.0
    
    Usage:
        apptainer run --nv --bind /path/to/weights:/opt/RFantibody/weights rfantibody.sif [args]
    
    Lockfile: /opt/venv/requirements.lock
