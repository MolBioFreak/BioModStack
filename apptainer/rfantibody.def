Bootstrap: docker
From: nvidia/cuda:12.4.1-runtime-ubuntu22.04

%post
    apt-get update && apt-get install -y \
        wget \
        git \
        python3 \
        python3-pip \
        && apt-get clean \
        && rm -rf /var/lib/apt/lists/*

    # Install PyTorch
    pip3 install torch torchvision torchaudio --index-url https://download.pytorch.org/whl/cu124

    # Clone RFantibody
    git clone https://github.com/RosettaCommons/RFantibody.git /opt/RFantibody
    cd /opt/RFantibody

    # Install dependencies
    pip3 install -r requirements.txt || true  # Continue even if some fail, we fix below
    
    # Specific adjustments for Blackwell/Ampere if needed
    pip3 install "hydra-core>=1.3.2" "omegaconf>=2.3.0"

    # Install RFdiffusion and ProteinMPNN if they are submodules or required
    # Assuming RFantibody acts as a wrapper, we ensure the env is set
    
    # Install SE3-Transformer (often required for RF tools)
    pip3 install dgl -f https://data.dgl.ai/wheels/cu124/repo.html
    
%environment
    export PYTHONPATH="/opt/RFantibody:$PYTHONPATH"
    export PATH="/opt/RFantibody:$PATH"
