Bootstrap: docker
From: nvidia/cuda:12.4.1-runtime-ubuntu22.04

%labels
    Author BioModStack
    Description RFantibody - De novo antibody backbone design with fine-tuned RFdiffusion
    Version 1.0.0

%post
    apt-get update && apt-get install -y \
        wget \
        git \
        curl \
        python3 \
        python3-pip \
        python3-venv \
        && apt-get clean \
        && rm -rf /var/lib/apt/lists/*

    # Install UV package manager (10-100x faster than pip)
    curl -LsSf https://astral.sh/uv/install.sh | sh
    export PATH="/root/.local/bin:$PATH"

    # Create virtual environment
    uv venv /opt/venv
    export VIRTUAL_ENV=/opt/venv
    export PATH="/opt/venv/bin:$PATH"

    # Install PyTorch 2.4 with CUDA 12.4 support (DGL 2.1.0 requires PyTorch <= 2.4)
    uv pip install "torch==2.4.*" "torchvision==0.19.*" "torchaudio==2.4.*" --index-url https://download.pytorch.org/whl/cu124

    # Clone RFantibody
    git clone https://github.com/RosettaCommons/RFantibody.git /opt/RFantibody
    cd /opt/RFantibody

    # Install ALL RFantibody dependencies from pyproject.toml with UV
    # Core deps: torch, numpy, hydra-core, icecream, opt-einsum, e3nn, pyrsistent
    # Runtime deps (not listed but needed): pandas, scipy
    # DGL hidden deps: pydantic, pyarrow, fsspec
    uv pip install numpy pandas scipy hydra-core icecream opt-einsum e3nn pyrsistent pyyaml biopython pydantic pyarrow fsspec
    
    # Install RFantibody as editable package from src/
    uv pip install -e /opt/RFantibody 2>/dev/null || true
    
    # Pin torchdata to version with datapipes API (required by DGL)
    uv pip install "torchdata==0.8.0"
    
    # SE3-Transformer / DGL - try older version for compatibility
    # Also install dgl without graphbolt dependency issues
    uv pip install "dgl==2.0.0" -f https://data.dgl.ai/wheels/cu121/repo.html

    # Cleanup
    rm -rf /root/.cache/uv

    # Create weights directory - weights should be mounted at runtime
    mkdir -p /opt/RFantibody/weights

%environment
    # CRITICAL: Include all necessary paths for rfantibody module imports
    # parsers.py uses relative imports, so we need to add those directories
    # SE3Transformer contains se3_transformer module
    export PYTHONPATH="/opt/RFantibody/src:/opt/RFantibody/src/rfantibody/rfdiffusion:/opt/RFantibody/src/rfantibody/rf2:/opt/RFantibody/include:/opt/RFantibody/include/SE3Transformer:/opt/RFantibody:$PYTHONPATH"
    export PATH="/opt/venv/bin:/opt/RFantibody:$PATH"
    export VIRTUAL_ENV=/opt/venv
    # Weights path - should be mounted from host at /opt/RFantibody/weights
    export RFANTIBODY_WEIGHTS="/opt/RFantibody/weights"

%runscript
    cd /opt/RFantibody
    python3 "$@"
