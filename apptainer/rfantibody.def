Bootstrap: docker
From: nvcr.io/nvidia/cuda:12.8.0-devel-ubuntu22.04

# RFantibody container optimized for NVIDIA RTX 5090 (sm_120) and RTX 3090 (sm_86)
# Using UV for fast package installation
# Builds DGL from source to support Blackwell architecture

%labels
    Author BioModStack
    Version 2.0
    Description RFantibody - Antibody design with RFdiffusion (UV-based)

%post
    export DEBIAN_FRONTEND=noninteractive

    # Install system dependencies
    apt-get -q update
    apt-get install --no-install-recommends -y \
        git \
        wget \
        curl \
        build-essential \
        ninja-build \
        g++-11 \
        python3.11 \
        python3.11-venv \
        python3.11-dev \
        ca-certificates

    # Install modern CMake (3.29.3) - Ubuntu 22.04 default is too old
    cd /tmp
    wget -q https://github.com/Kitware/CMake/releases/download/v3.29.3/cmake-3.29.3-linux-x86_64.sh
    sh cmake-3.29.3-linux-x86_64.sh --skip-license --prefix=/usr/local
    rm cmake-3.29.3-linux-x86_64.sh

    # Install UV (10-100x faster than pip)
    curl -LsSf https://astral.sh/uv/install.sh | sh
    export PATH="/root/.local/bin:$PATH"

    # Create virtualenv with UV
    uv venv --python python3.11 /opt/venv
    export VIRTUAL_ENV=/opt/venv
    export PATH="/opt/venv/bin:$PATH"

    # Install PyTorch nightly with CUDA 12.8 support (required for RTX 5090 sm_120)
    # Use --no-deps to bypass dependency resolver issues with nightly builds
    uv pip install --compile --no-deps --prerelease=allow torch --index-url https://download.pytorch.org/whl/nightly/cu128
    uv pip install --compile --no-deps --prerelease=allow torchvision --index-url https://download.pytorch.org/whl/nightly/cu128
    uv pip install --compile --no-deps --prerelease=allow torchaudio --index-url https://download.pytorch.org/whl/nightly/cu128

    # Install PyTorch's CUDA dependencies from the nightly index
    uv pip install --compile --prerelease=allow --index-url https://download.pytorch.org/whl/nightly/cu128 \
        nvidia-cudnn-cu12 \
        nvidia-cublas-cu12 \
        nvidia-cuda-cupti-cu12 \
        nvidia-cuda-nvrtc-cu12 \
        nvidia-cuda-runtime-cu12 \
        nvidia-cufft-cu12 \
        nvidia-curand-cu12 \
        nvidia-cusolver-cu12 \
        nvidia-cusparse-cu12 \
        nvidia-cusparselt-cu12 \
        nvidia-nccl-cu12 \
        nvidia-nvjitlink-cu12 \
        nvidia-nvtx-cu12 \
        pytorch-triton || true

    # Install other dependencies
    uv pip install --compile "numpy<2.0" sympy networkx jinja2 fsspec filelock typing-extensions scipy pillow

    # Clone RFantibody repository
    git clone https://github.com/RosettaCommons/RFantibody.git /opt/RFantibody
    cd /opt/RFantibody

    # Install RFantibody dependencies
    uv pip install --compile \
        hydra-core==1.3.2 \
        pandas \
        "pydantic>=2.0" \
        pyrsistent==0.19.3 \
        icecream==2.1.3 \
        biopython==1.81 \
        pyyaml \
        pyarrow \
        fsspec

    # Install e3nn with --no-deps to prevent torch downgrade
    uv pip install --compile --no-deps e3nn==0.5.9
    uv pip install --compile --no-deps opt_einsum
    uv pip install --compile --no-deps opt-einsum-fx

    # Install torchdata with --no-deps to prevent torch downgrade
    uv pip install --compile --no-deps torchdata || true

    # Install DGL from pre-built wheel (CUDA 12.1 - closest available)
    # Source build fails due to NVSHMEM dependency in PyTorch nightly cu128
    uv pip install --compile dgl -f https://data.dgl.ai/wheels/torch-2.3/cu121/repo.html || \
        uv pip install --compile dgl -f https://data.dgl.ai/wheels/torch-2.4/cu121/repo.html || \
        uv pip install --compile dgl || true

    # Build and install SE3Transformer from RFantibody/include
    cd /opt/RFantibody/include/SE3Transformer
    uv pip install --compile --no-deps . || true

    # Install RFantibody as editable package
    cd /opt/RFantibody
    uv pip install --compile --no-deps -e . || true

    # Create python symlinks for backward compatibility with Nextflow modules
    ln -sf /opt/venv/bin/python /opt/venv/bin/python3.10
    ln -sf /opt/venv/bin/python /opt/venv/bin/python3

    # Generate lockfile for reproducibility
    uv pip freeze > /opt/venv/requirements.lock

    # Clean up
    apt-get autoremove -y
    apt-get clean
    rm -rf /var/lib/apt/lists/*
    rm -rf /tmp/dgl /tmp/cmake-*.sh
    rm -rf /root/.cache/uv

    # Create weights directory - weights should be mounted at runtime
    mkdir -p /opt/RFantibody/weights

%environment
    export PATH="/opt/venv/bin:$PATH"
    export VIRTUAL_ENV=/opt/venv
    export DGLBACKEND="pytorch"
    export PYTHONUNBUFFERED=1
    # PyTorch CUDA libraries (needed for nvshmem, cusparselt, etc.)
    export LD_LIBRARY_PATH="/opt/venv/lib/python3.11/site-packages/nvidia/nvshmem/lib:/opt/venv/lib/python3.11/site-packages/nvidia/cusparselt/lib:/opt/venv/lib/python3.11/site-packages/nvidia/cusparse/lib:/opt/venv/lib/python3.11/site-packages/nvidia/cudnn/lib:/opt/venv/lib/python3.11/site-packages/nvidia/cublas/lib:/opt/venv/lib/python3.11/site-packages/nvidia/cuda_runtime/lib:/opt/venv/lib/python3.11/site-packages/nvidia/nvjitlink/lib:/opt/venv/lib/python3.11/site-packages/torch/lib:$LD_LIBRARY_PATH"
    # CRITICAL: Include all necessary paths for rfantibody module imports
    export PYTHONPATH="/opt/RFantibody/src:/opt/RFantibody/src/rfantibody/rfdiffusion:/opt/RFantibody/src/rfantibody/rf2:/opt/RFantibody/include:/opt/RFantibody/include/SE3Transformer:/opt/RFantibody:$PYTHONPATH"
    # Weights path - should be mounted from host at /opt/RFantibody/weights
    export RFANTIBODY_WEIGHTS="/opt/RFantibody/weights"

%runscript
    cd /opt/RFantibody
    exec python scripts/rfdiffusion_inference.py "$@"

%help
    RFantibody container for antibody design with RFdiffusion.
    Optimized for NVIDIA RTX 5090 (sm_120) and RTX 3090 (sm_86).
    
    Usage:
        apptainer run --nv --bind /path/to/weights:/opt/RFantibody/weights rfantibody.sif [args]
    
    Lockfile: /opt/venv/requirements.lock
