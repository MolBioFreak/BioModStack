Bootstrap: docker
From: nvcr.io/nvidia/cuda:12.8.0-cudnn-devel-ubuntu24.04

%labels
    Author BioModStack
    Version 0.1.0
    Description Biohub ESMFold2 experimental runtime pinned for local BMS all-atom protein/complex folding
    BiohubESMCommit c94ed8d763bbd7088b296949e5b401e8ea12073a
    BiohubTransformersCommit 3a8956fb4d4ea16b0ec8e71deef2c2909b6a5cbf

%post
    set -eu
    export DEBIAN_FRONTEND=noninteractive

    apt-get update && apt-get install -y \
        git \
        curl \
        ca-certificates \
        build-essential \
        pkg-config \
        cmake \
        python3.12 \
        python3.12-dev \
        python3.12-venv \
        && rm -rf /var/lib/apt/lists/*

    ln -sf /usr/bin/python3.12 /usr/bin/python3
    ln -sf /usr/bin/python3.12 /usr/bin/python

    curl -LsSf https://astral.sh/uv/install.sh | sh
    export PATH="/root/.local/bin:${PATH}"

    mkdir -p /opt/esmfold2 /weights/esmfold2/hf_home /cache/general /cache/triton /cache/matplotlib
    cd /opt/esmfold2

    uv venv .venv -p python3.12
    . .venv/bin/activate
    uv pip install --upgrade pip setuptools wheel

    # Blackwell-capable CUDA runtime. Keep this image independent from Boltz/Protenix/RF3.
    uv pip install --index-url https://download.pytorch.org/whl/cu128 \
        torch==2.7.1+cu128 \
        torchvision==0.22.1+cu128 \
        torchaudio==2.7.1+cu128

    # Biohub ESM pulls the pinned Biohub transformers fork from pyproject.toml.
    uv pip install \
        "git+https://github.com/Biohub/esm.git@c94ed8d763bbd7088b296949e5b401e8ea12073a"

    uv pip install huggingface_hub safetensors accelerate
    uv pip freeze > /opt/esmfold2/requirements.lock 2>/dev/null || true

%environment
    export PATH=/opt/esmfold2/.venv/bin:$PATH
    export PYTHONNOUSERSITE=1
    export PYTHONPATH=/opt/esmfold2:$PYTHONPATH
    export HF_HOME=/weights/esmfold2/hf_home
    export HF_HUB_CACHE=/weights/esmfold2/hf_home/hub
    export TRANSFORMERS_CACHE=/weights/esmfold2/hf_home/hub
    export XDG_CACHE_HOME=/cache/general
    export TRITON_CACHE_DIR=/cache/triton
    export MPLCONFIGDIR=/cache/matplotlib

%test
    . /opt/esmfold2/.venv/bin/activate
    python3 -c "import torch; print(torch.__version__)"
    # Do not import transformers.models.esmfold2.modeling_esmfold2 during image
    # build: Triton initializes an active CUDA driver at import time, and the
    # Dockerized Apptainer builder does not expose the host NVIDIA driver.
    python3 -c "from esm.models.esmfold2 import ESMFold2InputBuilder, ProteinInput, StructurePredictionInput; import transformers; print('ESMFold2 runtime package imports ok')"

%help
    BioModStack ESMFold2 experimental runtime.

    Scope:
    - pinned Biohub ESM runtime for local ESMFold2-Fast protein and complex folds
    - supports protein, DNA/RNA, ligand, local PDB sequence-source, and user MSA inputs
    - PDB coordinates are sequence sources only; no structural-template conditioning is claimed here
    - no Biohub remote API path
    - model assets are expected at /weights/esmfold2/hf_home, bound from
      /mnt/BioModStack/weights/esmfold2/hf_home on the workstation

    Upstream pins:
    - Biohub/esm@c94ed8d763bbd7088b296949e5b401e8ea12073a
    - Biohub/transformers@3a8956fb4d4ea16b0ec8e71deef2c2909b6a5cbf
