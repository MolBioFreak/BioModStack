Bootstrap: docker
From: nvidia/cuda:13.5.0-cudnn-devel-ubuntu24.04

%labels
    Author BioModStack
    Version 0.1.0
    Description Biohub ESMFold2 experimental runtime pinned for local BMS all-atom protein/complex folding
    BiohubESMCommit d49ee4606ea4a95a8bc7388171a6e21fefdf1c26
    BiohubTransformersCommit 3a8956fb4d4ea16b0ec8e71deef2c2909b6a5cbf

%post
    set -eu
    export DEBIAN_FRONTEND=noninteractive

    apt-get update && apt-get install -y \
        git \
        curl \
        ca-certificates \
        build-essential \
        pkg-config \
        cmake \
        python3.12 \
        python3.12-dev \
        python3.12-venv \
        && rm -rf /var/lib/apt/lists/*

    ln -sf /usr/bin/python3.12 /usr/bin/python3
    ln -sf /usr/bin/python3.12 /usr/bin/python

    # Install pinned uv 0.13.10 with SHA256 verification
    UV_VERSION="0.13.10"
    case "$(uname -m)" in
        x86_64|amd64)
            UV_TARGET="x86_64-unknown-linux-gnu"
            UV_SHA256="bf65ac1a0af10f92c522d91ac096c7c0a39657647b155577e7836c2cbbb4526c"
            ;;
        aarch64|arm64)
            UV_TARGET="aarch64-unknown-linux-gnu"
            UV_SHA256="14590f644805a6234ffe071154340669e38137f38e60aa9629690119704107d2"
            ;;
        *)
            echo "Unsupported architecture for uv: $(uname -m)" >&2
            exit 1
            ;;
    esac
    UV_TMP="$(mktemp -d)"
    curl -fsSL --retry 3 --retry-delay 2         "https://github.com/astral-sh/uv/releases/download/${UV_VERSION}/uv-${UV_TARGET}.tar.gz"         -o "${UV_TMP}/uv.tar.gz"
    printf '%s  %s\n' "${UV_SHA256}" "${UV_TMP}/uv.tar.gz" | sha256sum -c -
    tar -xzf "${UV_TMP}/uv.tar.gz" -C "${UV_TMP}"
    install -D -m 0755 "${UV_TMP}/uv-${UV_TARGET}/uv" /usr/local/bin/uv
    install -D -m 0755 "${UV_TMP}/uv-${UV_TARGET}/uvx" /usr/local/bin/uvx
    rm -rf "${UV_TMP}"
    uv --version

    mkdir -p /opt/esmfold2 /weights/esmfold2/hf_home /cache/general /cache/triton /cache/matplotlib
    cd /opt/esmfold2

    uv venv .venv -p python3.12
    . .venv/bin/activate
    uv pip install --upgrade pip setuptools wheel

    # Hold the chosen CUDA wheels during later tool dependency resolution.
    export UV_CONSTRAINT=/opt/bms-gpu-constraints.txt
    export UV_INDEX="https://download.pytorch.org/whl/cu134"
    export UV_DEFAULT_INDEX="https://pypi.org/simple"
    printf '%s\n' 'torch==2.15.0+cu134' 'torchvision==0.29.2+cu134' 'torchaudio==2.11.1+cu134' > "$UV_CONSTRAINT"
    # PyTorch release built for CUDA 13.4 (includes RTX 50-series sm_120 kernels).
    uv pip install --python /opt/esmfold2/.venv/bin/python --compile --no-cache         torch==2.15.0+cu134 torchvision==0.29.2+cu134 torchaudio==2.11.1+cu134         --index https://download.pytorch.org/whl/cu134 --default-index https://pypi.org/simple

    # Biohub ESM pulls the pinned Biohub transformers fork from pyproject.toml.
    uv pip install \
        "git+https://github.com/Biohub/esm.git@d49ee4606ea4a95a8bc7388171a6e21fefdf1c26"

    uv pip install --index-strategy unsafe-best-match huggingface_hub safetensors accelerate
    uv pip freeze > /opt/esmfold2/requirements.lock 2>/dev/null || true

%environment
    export PATH=/opt/esmfold2/.venv/bin:$PATH
    export PYTHONNOUSERSITE=1
    export PYTHONPATH=/opt/esmfold2:$PYTHONPATH
    export HF_HOME=/weights/esmfold2/hf_home
    export HF_HUB_CACHE=/weights/esmfold2/hf_home/hub
    export TRANSFORMERS_CACHE=/weights/esmfold2/hf_home/hub
    export XDG_CACHE_HOME=/cache/general
    export TRITON_CACHE_DIR=/cache/triton
    export MPLCONFIGDIR=/cache/matplotlib

%test
    . /opt/esmfold2/.venv/bin/activate
    python3 -c "import torch; print(torch.__version__)"
    # Do not import transformers.models.esmfold2.modeling_esmfold2 during image
    # build: Triton initializes an active CUDA driver at import time, and the
    # Dockerized Apptainer builder does not expose the host NVIDIA driver.
    python3 -c "from esm.models.esmfold2 import ESMFold2InputBuilder, ProteinInput, StructurePredictionInput; import transformers; print('ESMFold2 runtime package imports ok')"

%help
    BioModStack ESMFold2 experimental runtime.

    Scope:
    - pinned Biohub ESM runtime for local ESMFold2-Fast protein and complex folds
    - supports protein, DNA/RNA, ligand, local PDB sequence-source, and user MSA inputs
    - PDB coordinates are sequence sources only; no structural-template conditioning is claimed here
    - no Biohub remote API path
    - model assets are expected at /weights/esmfold2/hf_home, bound from
      $BMS_WEIGHTS/esmfold2/hf_home on the host

    Upstream pins:
    - Biohub/esm@d49ee4606ea4a95a8bc7388171a6e21fefdf1c26
    - Biohub/transformers@3a8956fb4d4ea16b0ec8e71deef2c2909b6a5cbf
