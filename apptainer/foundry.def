Bootstrap: docker
From: nvidia/cuda:13.5.0-cudnn-devel-ubuntu24.04

%labels
    Author ProteinDJ Extended Pipeline
    Version 1.0
    Description Foundry container with RFdiffusion3, RosettaFold3, LigandMPNN

%files
    scripts/rfd3_generation/install_schedule_return.py /opt/bms/install_schedule_return.py

%post
    # Prevent interactive prompts during build
    export DEBIAN_FRONTEND=noninteractive
    export TZ=America/Chicago
    ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone
    
    # System packages
    apt-get update && apt-get install -y \
        git \
        wget \
        curl \
        build-essential \
        software-properties-common \
        && rm -rf /var/lib/apt/lists/*
    
    # Install Python 3.12 (native on Ubuntu 24.04)
    apt-get update && apt-get install -y         python3.12         python3.12-dev         python3.12-venv         python3-pip         && rm -rf /var/lib/apt/lists/*
    
    # Set Python 3.12 as default
    update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.12 1
    update-alternatives --install /usr/bin/python python /usr/bin/python3.12 1
    
    # Install pinned uv 0.13.10 with SHA256 verification
    UV_VERSION="0.13.10"
    case "$(uname -m)" in
        x86_64|amd64)
            UV_TARGET="x86_64-unknown-linux-gnu"
            UV_SHA256="bf65ac1a0af10f92c522d91ac096c7c0a39657647b155577e7836c2cbbb4526c"
            ;;
        aarch64|arm64)
            UV_TARGET="aarch64-unknown-linux-gnu"
            UV_SHA256="14590f644805a6234ffe071154340669e38137f38e60aa9629690119704107d2"
            ;;
        *)
            echo "Unsupported architecture for uv: $(uname -m)" >&2
            exit 1
            ;;
    esac
    UV_TMP="$(mktemp -d)"
    curl -fsSL --retry 3 --retry-delay 2         "https://github.com/astral-sh/uv/releases/download/${UV_VERSION}/uv-${UV_TARGET}.tar.gz"         -o "${UV_TMP}/uv.tar.gz"
    printf '%s  %s\n' "${UV_SHA256}" "${UV_TMP}/uv.tar.gz" | sha256sum -c -
    tar -xzf "${UV_TMP}/uv.tar.gz" -C "${UV_TMP}"
    install -D -m 0755 "${UV_TMP}/uv-${UV_TARGET}/uv" /usr/local/bin/uv
    install -D -m 0755 "${UV_TMP}/uv-${UV_TARGET}/uvx" /usr/local/bin/uvx
    rm -rf "${UV_TMP}"
    uv --version

    # Hold the chosen CUDA wheels during later tool dependency resolution.
    export UV_CONSTRAINT=/opt/bms-gpu-constraints.txt
    export UV_INDEX="https://download.pytorch.org/whl/cu134"
    export UV_DEFAULT_INDEX="https://pypi.org/simple"
    printf '%s\n' 'torch==2.15.0+cu134' 'torchvision==0.29.2+cu134' 'torchaudio==2.11.1+cu134' > "$UV_CONSTRAINT"
    uv pip install --system --break-system-packages --compile --no-cache         torch==2.15.0+cu134 torchvision==0.29.2+cu134 torchaudio==2.11.1+cu134         --index https://download.pytorch.org/whl/cu134 --default-index https://pypi.org/simple

    # Install Foundry with all dependencies (RFD3, RF3, MPNN) keeping cu134 torch pinned
    uv pip install --system --break-system-packages --compile --no-cache "rc-foundry[all]==0.1.9"
    python3.12 /opt/bms/install_schedule_return.py
    
    # Download Foundry model weights
    mkdir -p /root/.foundry/checkpoints
    foundry install base-models --checkpoint-dir /root/.foundry/checkpoints || echo "Model download deferred"
    # The optional interface-context leaf must never silently download its
    # checkpoint at first run or accept a different scientific weight set.
    foundry install proteinmpnn ligandmpnn --checkpoint-dir /root/.foundry/checkpoints
    printf '%s  %s\n' \
        161cd264061fda9680cbb940255522ae42f2966c552d045d87913d9452a80970 \
        /root/.foundry/checkpoints/ligandmpnn_v_32_010_25.pt | sha256sum -c -
    
    # Create symlinks for consistent paths
    ln -sf /root/.foundry /foundry
    
    # Set up RF3 source layout for CLI compatibility
    # RF3 expects PROJECT_ROOT/models/rf3/configs structure
    # We create this in site-packages where RF3 is installed
    SITE_PACKAGES="/usr/local/lib/python3.12/dist-packages"
    mkdir -p "${SITE_PACKAGES}/models/rf3"
    ln -sf "${SITE_PACKAGES}/rf3/configs" "${SITE_PACKAGES}/models/rf3/configs" || true
    
    # Generate lockfile for reproducibility
    uv pip freeze > /opt/venv/requirements.lock 2>/dev/null || true

%environment
    export PATH=/usr/local/bin:$PATH
    export FOUNDRY_CHECKPOINT_DIRS=/foundry/checkpoints
    export CUDA_DEVICE_ORDER=PCI_BUS_ID
    export PYTHONUNBUFFERED=1
    # Set PROJECT_ROOT for RF3 CLI compatibility
    export PROJECT_ROOT=/usr/local/lib/python3.12/dist-packages

%runscript
    exec python3.12 "$@"

%test
    python3.12 -c "import torch; print(f'PyTorch: {torch.__version__}')"
    python3.12 -c "import torch; print(f'CUDA available: {torch.cuda.is_available()}')"
    python3.12 -c "from rfd3 import RFDiffusion3; print('RFD3: OK')" || echo "RFD3 test skipped (no weights)"
    python3.12 -c "from rf3 import RosettaFold3; print('RF3: OK')" || echo "RF3 test skipped (no weights)"
    python3.12 -c "from mpnn import ProteinMPNN; print('MPNN: OK')" || echo "MPNN test skipped"

%help
    Foundry Container - RFdiffusion3, RosettaFold3, LigandMPNN
    
    Components:
    - RFdiffusion3 (RFD3): All-atom protein structure generation
    - RosettaFold3 (RF3): Structure prediction (open-source AF3 alternative)
    - LigandMPNN: Ligand-aware sequence design
    
    Usage:
        apptainer run foundry.sif rfd3 --help
        apptainer run foundry.sif rf3 --help
        apptainer run foundry.sif mpnn --help
        
    Weights should be downloaded on first run or pre-mounted.
