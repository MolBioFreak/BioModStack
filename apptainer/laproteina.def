%labels
    Author BioModStack
    Version laproteina-bms-2
    SourceRevision cde5de3ead6e4d76f367da6dc5174be9913ef6ca
    Description Pinned La-Proteina sampling runtime; no oracle or training payloads

%files
    scripts/lib/laproteina_contract.py /opt/bms/laproteina_contract.py

%post
    set -eu
    python -m venv /opt/venv
    export PATH=/opt/venv/bin:$PATH
    python - <<'PY'
import hashlib, io, tarfile, urllib.request
from pathlib import Path
url = "https://codeload.github.com/NVIDIA-Digital-Bio/la-proteina/tar.gz/cde5de3ead6e4d76f367da6dc5174be9913ef6ca"
body = urllib.request.urlopen(url).read()
assert hashlib.sha256(body).hexdigest() == "844fea44b6727731a146cf68f8b6066edb8db31ed64b4099ab6ef5d05e735de7"
root = Path("/opt/laproteina")
root.mkdir()
with tarfile.open(fileobj=io.BytesIO(body), mode="r:gz") as archive:
    for member in archive.getmembers():
        parts = Path(member.name).parts
        if len(parts) < 2:
            continue
        member.name = str(Path(*parts[1:]))
        archive.extract(member, root, filter="data")
PY
