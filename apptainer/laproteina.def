Bootstrap: docker
From: nvcr.io/nvidia/cuda:12.8.0-cudnn-devel-ubuntu22.04

%labels
    Author BioModStack
    Version 0.1.0
    Description La-Proteina runtime for experimental protein CAD generation

%post
    set -eu
    export DEBIAN_FRONTEND=noninteractive

    apt-get update && apt-get install -y \
        git \
        curl \
        wget \
        build-essential \
        python3.11 \
        python3.11-dev \
        python3.11-venv \
        python3-pip \
        && rm -rf /var/lib/apt/lists/*

    ln -sf /usr/bin/python3.11 /usr/bin/python3
    ln -sf /usr/bin/python3.11 /usr/bin/python

    curl -LsSf https://astral.sh/uv/install.sh | sh
    export PATH="/root/.local/bin:${PATH}"

    uv venv /opt/venv
    . /opt/venv/bin/activate

    uv pip install --compile torch==2.7.0 --index-url https://download.pytorch.org/whl/cu118
    uv pip install --compile graphein==1.7.7 --no-deps
    uv pip install --compile torch_geometric torch_scatter torch_sparse torch_cluster -f https://data.pyg.org/whl/torch-2.7.0+cu118.html

    git clone https://github.com/NVIDIA-Digital-Bio/la-proteina.git /opt/laproteina
    cd /opt/laproteina

    uv pip install --compile python-dotenv==1.0.1 einops==0.6 dm-tree==0.1.8 lightning==2.5.0 \
        loguru==0.7.2 hydra-core==1.3.1 numpy==1.23.5 pandas==2.3.0 biopandas==0.5.1 \
        wandb==0.17.0 wget==3.2 tqdm==4.66.4 ml-collections==0.1.1 jaxtyping loralib \
        biopython biotite cpdb-protein==0.2.0 pre-commit joblib==1.4.2 rich==14.0.0 \
        deepdiff multipledispatch plotly pydantic rich-click scikit-learn seaborn xarray

    uv pip install --compile -e .

    mkdir -p /weights/laproteina /cache/huggingface
    uv pip freeze > /opt/venv/requirements.lock 2>/dev/null || true

%environment
    export PATH=/opt/venv/bin:$PATH
    export PYTHONPATH=/opt/laproteina:$PYTHONPATH
    export LAPROTEINA_REPO=/opt/laproteina
    export XDG_CACHE_HOME=/cache/general
    export HF_HOME=/cache/huggingface
    export MPLCONFIGDIR=/cache/matplotlib

%test
    . /opt/venv/bin/activate
    python3 -c "import torch; print(torch.__version__)"
    python3 -c "import hydra, lightning, proteinfoundation; print('La-Proteina runtime ok')"

%help
    La-Proteina runtime image for BioModStack experimental Protein CAD work.

    Expected external mounts:
    - /weights/laproteina for AE/LD checkpoints
    - /cache for HuggingFace and matplotlib cache state

    Upstream:
    https://github.com/NVIDIA-Digital-Bio/la-proteina
