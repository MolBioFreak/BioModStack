Bootstrap: localimage
From: /mnt/BioModStack/apptainer/foundry.sif

%labels
    org.biomodstack.component "shape-rfd3"
    org.biomodstack.base-sampler-sha256 "fcc9d94bf92f0fcbb2f91a305e89985696016b2a2786db12ba5790240b53191a"
    org.biomodstack.patched-sampler-sha256 "b27da5ee1341255cf351e2cd55f2de046a3e9a8b5a4df65fd831b3639240f86d"
    org.biomodstack.rfd3-version "0.1.9"

%files
    scripts/shape_blueprint/shape_guidance.py /usr/local/lib/python3.12/dist-packages/shape_guidance.py
    scripts/shape_blueprint/rfd3_shape_sampler.py /usr/local/lib/python3.12/dist-packages/bms_shape_sampler.py
    scripts/shape_blueprint/install_rfd3_shape_extension.py /opt/bms_shape/install_rfd3_shape_extension.py

%post
    python3 /opt/bms_shape/install_rfd3_shape_extension.py
    python3 - <<'PY'
import hashlib
from pathlib import Path
from rfd3.model.inference_sampler import ConditionalDiffusionSampler
sampler_path = Path("/usr/local/lib/python3.12/dist-packages/rfd3/model/inference_sampler.py")
assert hashlib.sha256(sampler_path.read_bytes()).hexdigest() == "b27da5ee1341255cf351e2cd55f2de046a3e9a8b5a4df65fd831b3639240f86d"
assert "shape" in ConditionalDiffusionSampler._registry
sampler = ConditionalDiffusionSampler._registry["shape"]
assert sampler.__name__ == "ShapeGuidedDiffusionSampler"
PY

%test
    python3 - <<'PY'
import hashlib
from pathlib import Path
from rfd3.model.inference_sampler import ConditionalDiffusionSampler
sampler_path = Path("/usr/local/lib/python3.12/dist-packages/rfd3/model/inference_sampler.py")
assert hashlib.sha256(sampler_path.read_bytes()).hexdigest() == "b27da5ee1341255cf351e2cd55f2de046a3e9a8b5a4df65fd831b3639240f86d"
assert "shape" in ConditionalDiffusionSampler._registry
PY

%runscript
    exec rfd3 "$@"
