+def _writer_dp_local(value):
+    """Gather context axes only; keep the data-parallel record/sample axis local.
+
+    Mesh dimension 0 is DP in both native topologies. full_tensor() also
+    gathers DP and therefore misassociates writer-local records on DP rank >0.
+    Redistributing only CP placements preserves native values and sample order.
+    """
+    if not isinstance(value, DTensor):
+        return value
+    placements = (value.placements[0],) + (Replicate(),) * (len(value.placements) - 1)
+    return value.redistribute(placements=placements).to_local()
 
 
