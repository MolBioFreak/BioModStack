# Protenix, built from upstream sources only.
#   apptainer build protenix.sif apptainer/protenix.def
# Inputs, all public:
# - nvcr.io/nvidia/cuda 12.8 devel base (nvcc is needed for the LayerNorm kernel)
# - PyTorch 2.7.1 cu128 wheels from download.pytorch.org
# - https://github.com/bytedance/Protenix at a fixed commit, with its own requirements.txt
# - NVIDIA CUTLASS v3.5.1 (headers for the DeepSpeed attention kernel), as in the upstream Dockerfile
# Weights and data files are not part of the image; they are bound at run time.
Bootstrap: docker
From: nvcr.io/nvidia/cuda:12.8.0-cudnn-devel-ubuntu22.04

%post
    set -eu
    export DEBIAN_FRONTEND=noninteractive
    apt-get -q update
    apt-get install --no-install-recommends -y \
        git curl ca-certificates g++ gcc libc6-dev make hmmer kalign
    apt-get clean
    rm -rf /var/lib/apt/lists/*

    curl -LsSf https://astral.sh/uv/0.8.4/install.sh | env UV_INSTALL_DIR=/usr/local/bin sh
    uv python install 3.11
    uv venv --python 3.11 /opt/venv
    export PATH="/opt/venv/bin:${PATH}"
    export VIRTUAL_ENV=/opt/venv
    export PYTHONNOUSERSITE=1
    PYTHON_BIN="/opt/venv/bin/python3"

    # Blackwell-capable torch runtime (sm_120 support).
    uv pip install --index-url https://download.pytorch.org/whl/cu128 \
        torch==2.7.1+cu128 \
        torchvision==0.22.1+cu128 \
        torchaudio==2.7.1+cu128

    # Upstream Protenix at a fixed commit that includes Protenix-v2 model support.
    git clone https://github.com/bytedance/Protenix.git /opt/protenix
    git -C /opt/protenix checkout bd54a05d047b8925a241056f36d619700604068a
    uv pip install /opt/protenix
    git clone --depth 1 -b v3.5.1 https://github.com/NVIDIA/cutlass.git /opt/cutlass
    rm -rf /opt/protenix/.git /opt/cutlass/.git

    # Patch Protenix CUDA extension build flags for Blackwell.
    "$PYTHON_BIN" - << 'PY'
import site
from pathlib import Path

targets = [Path(p) for p in site.getsitepackages()]
patched = False
for base in targets:
    path = base / "protenix" / "model" / "layer_norm" / "torch_ext_compile.py"
    if not path.exists():
        continue
    text = path.read_text()
    updated = text.replace(
        'os.environ["TORCH_CUDA_ARCH_LIST"] = "7.0;8.0"',
        'os.environ["TORCH_CUDA_ARCH_LIST"] = "7.0;8.0;8.6;9.0;12.0"',
    )
    marker = '            "-gencode",\n            "arch=compute_90,code=sm_90",\n'
    if 'arch=compute_120,code=sm_120' not in updated and marker in updated:
        updated = updated.replace(
            marker,
            marker + '            "-gencode",\n            "arch=compute_120,code=sm_120",\n',
        )
    if updated != text:
        path.write_text(updated)
        print(f"Patched Blackwell CUDA flags in {path}")
    else:
        print(f"Blackwell CUDA flags already present in {path}")
    patched = True
    break

if not patched:
    raise SystemExit("Could not locate protenix/model/layer_norm/torch_ext_compile.py")
PY

    # If nvcc in this base image cannot compile sm_120, bake in a safe fallback
    # so Blackwell runs do not fail at runtime.
    "$PYTHON_BIN" - << 'PY'
import subprocess
import site
from pathlib import Path

nvcc_has_120 = False
try:
    out = subprocess.check_output(
        ["/usr/local/cuda/bin/nvcc", "--list-gpu-arch"],
        stderr=subprocess.STDOUT,
        text=True,
    )
    nvcc_has_120 = "compute_120" in out
except Exception:
    pass

if nvcc_has_120:
    print("nvcc supports compute_120; not forcing LayerNorm fallback.")
    raise SystemExit(0)

fallback_code = '''# [BMS-BLACKWELL-FALLBACK]
import numbers
from typing import Union

import torch
from torch.nn.parameter import Parameter


class FusedLayerNorm(torch.nn.Module):
    def __init__(
        self,
        normalized_shape: Union[int, list[int], torch.Size],
        create_scale: bool = True,
        create_offset: bool = True,
        eps: float = 1e-5,
    ) -> None:
        super().__init__()
        if isinstance(normalized_shape, numbers.Integral):
            normalized_shape = (normalized_shape,)
        self.normalized_shape = torch.Size(normalized_shape)
        self.eps = eps
        self.weight = Parameter(torch.ones(*normalized_shape)) if create_scale else None
        self.bias = Parameter(torch.zeros(*normalized_shape)) if create_offset else None
        self.reset_parameters()

    def reset_parameters(self) -> None:
        if self.weight is not None:
            torch.nn.init.ones_(self.weight)
        if self.bias is not None:
            torch.nn.init.zeros_(self.bias)

    def forward(self, input: torch.Tensor) -> torch.Tensor:
        weight = self.weight.to(dtype=input.dtype, device=input.device) if self.weight is not None else None
        bias = self.bias.to(dtype=input.dtype, device=input.device) if self.bias is not None else None
        return torch.nn.functional.layer_norm(
            input,
            self.normalized_shape,
            weight,
            bias,
            self.eps,
        )
'''

updated_any = False
for base in [Path(p) for p in site.getsitepackages()]:
    layer_dir = base / "protenix" / "model" / "layer_norm"
    layer_norm_py = layer_dir / "layer_norm.py"
    if not layer_norm_py.exists():
        continue
    for so in layer_dir.glob("fast_layer_norm_cuda_v2*.so"):
        so.unlink(missing_ok=True)
    layer_norm_py.write_text(fallback_code)
    print(f"Installed Blackwell-safe LayerNorm fallback at {layer_norm_py}")
    updated_any = True
    break

if not updated_any:
    raise SystemExit("Could not locate protenix/model/layer_norm/layer_norm.py")
PY

%environment
    export PATH="/opt/venv/bin:$PATH"
    export PYTHONNOUSERSITE=1
    export CUTLASS_PATH=/opt/cutlass
    export XDG_CACHE_HOME=/tmp
    export TRITON_CACHE_DIR=/tmp/triton

%test
    set -eu
    export PATH="/opt/venv/bin:$PATH"
    export PYTHONNOUSERSITE=1
    export MPLCONFIGDIR=/tmp/matplotlib
    mkdir -p "$MPLCONFIGDIR"

    protenix --help | head -3
    hmmsearch -h | head -3
    python3 - << 'PY'
import inspect
import site
import torch
import protenix
from pathlib import Path
from protenix.model.layer_norm import layer_norm

print("protenix", getattr(protenix, "__version__", "unknown"))
print("torch", torch.__version__, "cuda", torch.version.cuda)
print("arch_list", torch.cuda.get_arch_list())
arch_list = torch.cuda.get_arch_list()
if arch_list:
    assert "sm_120" in arch_list, "sm_120 not present in torch CUDA arch list"
else:
    print("CUDA arch list unavailable in build-time test environment; skipping sm_120 assert")
assert "/home/" not in str(Path(protenix.__file__)), f"protenix imported from user/home path: {protenix.__file__}"

from runner.inference import URL
assert "protenix-v2" in URL, "Protenix-v2 checkpoint mapping missing from runtime"
print("Protenix-v2 checkpoint mapping available")

layer_norm_module_path = Path(inspect.getfile(layer_norm)).resolve()
assert layer_norm_module_path.exists(), f"LayerNorm module path missing: {layer_norm_module_path}"
print("Protenix import path:", protenix.__file__)
print("LayerNorm module path:", layer_norm_module_path)
PY
    echo "Protenix container tests passed"

%labels
    Author BioModStack
    Version 2.0-upstream
    Description "Protenix built from upstream sources with a CUDA 12.8 runtime"

%help
    Protenix structure prediction container with Blackwell-safe runtime.

    Key properties:
    - Protenix upstream revision with Protenix-v2 support installed in-image
    - PyTorch 2.7.1 + CUDA 12.8 wheels (sm_120 support)
    - No dependency on host/user-site Python packages
    - LayerNorm fallback baked when base nvcc cannot target compute_120

    Usage:
      apptainer exec --nv protenix.sif protenix pred --input input.json --out_dir results
