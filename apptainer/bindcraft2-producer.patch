+def _bms_receipt_json(value):
+    # Preserve native nonfinite "unrejecting" thresholds without invalid JSON.
+    if isinstance(value, float) and not math.isfinite(value):
+        return {'$bc2_nonfinite_float': 'NaN' if math.isnan(value) else ('Infinity' if value > 0 else '-Infinity')}
+    if isinstance(value, dict):
+        return {key: _bms_receipt_json(item) for key, item in value.items()}
+    if isinstance(value, (tuple, list)):
+        return [_bms_receipt_json(item) for item in value]
+    return value
