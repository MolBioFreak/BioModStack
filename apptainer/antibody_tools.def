Bootstrap: docker
From: nvidia/cuda:12.4.1-runtime-ubuntu22.04

%post
    # Update and install system dependencies
    apt-get update && apt-get install -y \
        wget \
        git \
        python3 \
        python3-pip \
        hmmer \
        && apt-get clean \
        && rm -rf /var/lib/apt/lists/*

    # Install PyTorch with CUDA 12.4 support
    # Using stable release compatible with CUDA 12
    pip3 install torch torchvision torchaudio --index-url https://download.pytorch.org/whl/cu124

    # Note: ANARCI can be installed separately if needed for IMGT numbering
    # pip3 install git+https://github.com/oxpig/ANARCI.git (requires Python 2 setup.py fix)

    # Install AntiFold
    # Cloning from repo to get latest
    git clone https://github.com/oxpig/AntiFold.git /opt/AntiFold
    cd /opt/AntiFold
    pip3 install .

    # Install ImmuneBuilder
    # Note: pdbfixer requires conda. OpenMM optional for relaxation.
    # Using lightweight install without relaxation support
    pip3 install ImmuneBuilder

    # Install AntiBERTy for immunogenicity scoring
    # Uses pseudo-log-likelihood to score sequence "naturalness"
    pip3 install antiberty

    # Cleanup
    rm -rf /root/.cache/pip

%environment
    export PATH="/opt/AntiFold:$PATH"
    export PYTHONPATH="/opt/AntiFold:$PYTHONPATH"
