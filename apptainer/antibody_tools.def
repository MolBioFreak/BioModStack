Bootstrap: docker
From: nvidia/cuda:12.4.1-runtime-ubuntu22.04

%post
    # Update and install system dependencies
    apt-get update && apt-get install -y \
        wget \
        git \
        curl \
        python3 \
        python3-pip \
        python3-venv \
        hmmer \
        && apt-get clean \
        && rm -rf /var/lib/apt/lists/*

    # Install UV package manager (10-100x faster than pip)
    curl -LsSf https://astral.sh/uv/install.sh | sh
    export PATH="/root/.local/bin:$PATH"

    # Create virtual environment
    uv venv /opt/venv
    export VIRTUAL_ENV=/opt/venv
    export PATH="/opt/venv/bin:$PATH"

    # Install PyTorch with CUDA 12.4 support (pinned to compatible versions)
    # torch.library.register_fake requires torch 2.4+, torchvision 0.20+ requires torch 2.5
    uv pip install --compile torch==2.5.1 torchvision==0.20.1 torchaudio==2.5.1 --index-url https://download.pytorch.org/whl/cu124

    # Install biopython (required by antibody tools)
    uv pip install --compile biopython

    # Note: We use ANARCII (deep learning), not legacy ANARCI (HMM-based)
    # ANARCI's setup.py runs hmmpress which can hang for hours

    # Install ANARCII (deep learning antibody numbering - IMGT scheme)
    # Superior to ANARCI: Seq2Seq model, faster, Python 3.9-3.13 compatible
    git clone https://github.com/oxpig/ANARCII.git /opt/ANARCII
    cd /opt/ANARCII
    uv pip install --compile -e .
    cd /

    # Install AntiFold
    git clone https://github.com/oxpig/AntiFold.git /opt/AntiFold
    cd /opt/AntiFold
    uv pip install --compile .
    cd /

    # Install OpenMM and pdbfixer for structure refinement
    # OpenMM: molecular dynamics for energy minimization
    # black-pdbfixer: pip-installable fork of pdbfixer (original requires conda)
    uv pip install --compile openmm black-pdbfixer

    # Install ImmuneBuilder (structure prediction from sequence)
    # Requires OpenMM/pdbfixer for structure relaxation step
    uv pip install --compile ImmuneBuilder

    # Install AntiBERTy for immunogenicity scoring
    # Uses pseudo-log-likelihood to score sequence "naturalness"
    uv pip install --compile antiberty

    # CRITICAL: Force reinstall torch 2.6+ to satisfy transformers CVE-2025-32434 security check
    # Also reinstall numpy<2 to avoid NumPy 2.x compatibility issues with torch
    uv pip install --compile --force-reinstall torch==2.6.0 torchvision==0.21.0 numpy==1.26.4 --index-url https://download.pytorch.org/whl/cu124

    # Cleanup
    rm -rf /root/.cache/uv

    # Generate lockfile for reproducibility
    uv pip freeze > /opt/venv/requirements.lock 2>/dev/null || true

%environment
    export PATH="/opt/venv/bin:/opt/AntiFold:/opt/ANARCII:$PATH"
    export PYTHONPATH="/opt/AntiFold:/opt/ANARCII:$PYTHONPATH"
    export VIRTUAL_ENV=/opt/venv
