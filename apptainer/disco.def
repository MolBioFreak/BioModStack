Bootstrap: docker
From: nvcr.io/nvidia/cuda:12.8.0-cudnn-devel-ubuntu22.04

%labels
    Author BioModStack
    Version 0.1.0
    NativeSource 82b594f838eb61dd8c78ae3a403ccb8f00cf7abf
    Description DISCO runtime for experimental protein CAD generation

%post
    set -eu
    export DEBIAN_FRONTEND=noninteractive
    apt-get update && apt-get install -y git curl ca-certificates build-essential libgomp1 libxrender1 libxext6 libsm6 python3 python3-pip && rm -rf /var/lib/apt/lists/*
    python3 -m pip install --no-cache-dir uv==0.8.22
    export UV_PYTHON_INSTALL_DIR=/opt/python
    uv python install 3.11.13
    git clone https://github.com/DISCO-design/DISCO.git /opt/disco
    cd /opt/disco
    git checkout --detach 82b594f838eb61dd8c78ae3a403ccb8f00cf7abf
    git rev-parse HEAD > /opt/disco/NATIVE_REVISION
    # Packaging constraints only; native configs and model source stay unchanged.
    printf '\n[tool.uv]\nconstraint-dependencies = ["torch==2.7.1+cu128", "triton==3.3.1", "deepspeed==0.18.3", "transformers==4.50.3", "numpy==1.26.4"]\n' >> pyproject.toml
    export DS_BUILD_OPS=0
    uv sync --no-dev --python 3.11.13 --index https://download.pytorch.org/whl/cu128 --index-strategy unsafe-best-match
    # Optional attention remains selectable, with its native JIT source available.
    git clone https://github.com/NVIDIA/cutlass.git /opt/cutlass
    git -C /opt/cutlass checkout --detach ad7b2f5e84fcfa124cb02b91d5bd26d238c0459e
    uv pip freeze --python /opt/disco/.venv/bin/python > /opt/disco/requirements.lock
    mkdir -p /weights/disco

%environment
    export PATH=/opt/disco/.venv/bin:$PATH
    export PYTHONPATH=/opt/disco:$PYTHONPATH
    export DISCO_REPO=/opt/disco
    export CUTLASS_PATH=/opt/cutlass
    export HF_HUB_DISABLE_TELEMETRY=1

%test
    /opt/disco/.venv/bin/python -c "import torch; assert torch.__version__ == '2.7.1+cu128'; assert torch.version.cuda == '12.8'; import disco; print('DISCO package / CUDA stack import OK')"
    /opt/disco/.venv/bin/python -c "from pdbeccdutils.core import ccd_reader; print('CCD native extension imports OK')"
    test "$(cat /opt/disco/NATIVE_REVISION)" = 82b594f838eb61dd8c78ae3a403ccb8f00cf7abf

%help
    DISCO runtime image for BioModStack experimental Protein CAD work.
    Native source and its Apache-2.0 notices remain under /opt/disco.
    Default checkpoint: /weights/disco/DISCO.pt.
    Native HF cache: selected checkpoint parent's huggingface/hub directory.
    The BMS wrapper uses a writable per-invocation cwd and preserves shared JIT caches.
    CUTLASS is packaged; attention choices and native science defaults are unchanged.
    CPU package tests do not qualify GPU sampling or the full external model closure.
