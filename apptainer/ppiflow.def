Bootstrap: docker
From: nvidia/cuda:12.8.1-cudnn-devel-ubuntu22.04

%labels
    Author BioModStack
    Version 1.1
    Description PPIFlow - Flow matching for protein binder design

%post
    export DEBIAN_FRONTEND=noninteractive
    apt-get update && apt-get install -y \
        git wget curl \
        python3.10 python3.10-venv \
        build-essential cmake \
        libhdf5-dev libnetcdf-dev \
        && rm -rf /var/lib/apt/lists/*
    
    # Install pinned uv 0.13.10 with SHA256 verification
    UV_VERSION="0.13.10"
    case "$(uname -m)" in
        x86_64|amd64)
            UV_TARGET="x86_64-unknown-linux-gnu"
            UV_SHA256="bf65ac1a0af10f92c522d91ac096c7c0a39657647b155577e7836c2cbbb4526c"
            ;;
        aarch64|arm64)
            UV_TARGET="aarch64-unknown-linux-gnu"
            UV_SHA256="14590f644805a6234ffe071154340669e38137f38e60aa9629690119704107d2"
            ;;
        *)
            echo "Unsupported architecture for uv: $(uname -m)" >&2
            exit 1
            ;;
    esac
    UV_TMP="$(mktemp -d)"
    curl -fsSL --retry 3 --retry-delay 2 \
        "https://github.com/astral-sh/uv/releases/download/${UV_VERSION}/uv-${UV_TARGET}.tar.gz" \
        -o "${UV_TMP}/uv.tar.gz"
    printf '%s  %s\n' "${UV_SHA256}" "${UV_TMP}/uv.tar.gz" | sha256sum -c -
    tar -xzf "${UV_TMP}/uv.tar.gz" -C "${UV_TMP}"
    install -D -m 0755 "${UV_TMP}/uv-${UV_TARGET}/uv" /usr/local/bin/uv
    install -D -m 0755 "${UV_TMP}/uv-${UV_TARGET}/uvx" /usr/local/bin/uvx
    rm -rf "${UV_TMP}"
    uv --version
    
    # Create virtualenv with UV
    uv venv /opt/venv
    export VIRTUAL_ENV=/opt/venv
    export PATH="/opt/venv/bin:$PATH"
    
    # Install a Blackwell-capable PyTorch stack.
    uv pip install --python /opt/venv/bin/python --no-cache --compile torch==2.7.1 torchvision==0.22.1 torchaudio==2.7.1 \
        --index-url https://download.pytorch.org/whl/cu128
    
    # Install PyG dependencies
    uv pip install --python /opt/venv/bin/python --no-cache --compile pyg-lib torch-cluster torch-scatter torch-sparse torch-spline-conv \
        -f https://data.pyg.org/whl/torch-2.7.1+cu128.html
    uv pip install --python /opt/venv/bin/python --no-cache --compile torch-geometric==2.7.0
    
    # Install core scientific dependencies
    uv pip install --python /opt/venv/bin/python --no-cache --compile numpy==1.26.3 scipy==1.15.2 pandas==2.2.3
    uv pip install --python /opt/venv/bin/python --no-cache --compile biopython==1.83 biotite==1.0.1
    uv pip install --python /opt/venv/bin/python --no-cache --compile einops==0.8.1 e3nn==0.5.6
    uv pip install --python /opt/venv/bin/python --no-cache --compile hydra-core==1.3.2 omegaconf==2.3.0
    uv pip install --python /opt/venv/bin/python --no-cache --compile pytorch-lightning==2.5.0.post0 lightning==2.5.0.post0
    uv pip install --python /opt/venv/bin/python --no-cache --compile wandb==0.19.8
    uv pip install --python /opt/venv/bin/python --no-cache --compile mdtraj==1.10.3
    # Native binder metrics imports, pinned by the upstream environment.yml.
    uv pip install --python /opt/venv/bin/python --no-cache --compile tmtools==0.2.0 freesasa==2.2.1
    uv pip install --python /opt/venv/bin/python --no-cache --compile fair-esm==2.0.0
    uv pip install --python /opt/venv/bin/python --no-cache --compile rdkit==2023.3.1
    uv pip install --python /opt/venv/bin/python --no-cache --compile scikit-learn==1.2.2
    # Match the upstream antibody partial-flow runtime imports.
    uv pip install --python /opt/venv/bin/python --no-cache --compile deepspeed==0.16.4 dm-tree==0.1.6 optree==0.14.1 GPUtil==1.4.0 gpustat==1.1.1
    
    # Clone PPIFlow
    mkdir -p /app
    cd /app
    git clone https://github.com/Mingchenchen/PPIFlow.git ppiflow
    cd ppiflow
    # Match the installed source inventoried for initial and partial generation.
    git checkout --detach 000ce45a4411e7b97c1523a22c0f1bece7ede5fc
    
    # Install PPIFlow (if setup.py exists)
    if [ -f "setup.py" ]; then
        uv pip install --python /opt/venv/bin/python --no-cache --compile -e .
    fi

    # The upstream fused layer-norm extension hardcodes pre-Blackwell CUDA arch
    # flags. Patch it before any import compiles the extension.
    python - <<'PY'
from pathlib import Path

path = Path("/app/ppiflow/models/layer_norm/torch_ext_compile.py")
text = path.read_text()
text = text.replace(
    'os.environ["TORCH_CUDA_ARCH_LIST"] = "7.0;8.0"',
    'os.environ["TORCH_CUDA_ARCH_LIST"] = "7.0;8.0;8.6;9.0;10.0;12.0+PTX"',
)
text = text.replace(
    '''            "-gencode",
            "arch=compute_90,code=sm_90",''',
    '''            "-gencode",
            "arch=compute_90,code=sm_90",
            "-gencode",
            "arch=compute_100,code=sm_100",
            "-gencode",
            "arch=compute_120,code=sm_120",
            "-gencode",
            "arch=compute_120,code=compute_120",''',
)
path.write_text(text)
PY

    rm -f /app/ppiflow/models/layer_norm/fastfold_layer_norm_cuda.so \
          /app/ppiflow/models/layer_norm/layer_norm_cuda.o \
          /app/ppiflow/models/layer_norm/layer_norm_cuda_kernel.cuda.o \
          /app/ppiflow/models/layer_norm/build.ninja \
          /app/ppiflow/models/layer_norm/.ninja_log

    # Upstream scripts refer to configs/test_antibody.yaml, but some snapshots only
    # carry the hydrated test config under test/4dn4_ccl2/.
    if [ ! -f "/app/ppiflow/configs/test_antibody.yaml" ] && [ -f "/app/ppiflow/test/4dn4_ccl2/config.yaml" ]; then
        cp /app/ppiflow/test/4dn4_ccl2/config.yaml /app/ppiflow/configs/test_antibody.yaml
    fi

    # Exercise initial binder generation as well as the partial-flow runtime.
    export PYTHONPATH="/app/ppiflow:$PYTHONPATH"
    python - <<'PY'
from pathlib import Path
import tree
import optree
import deepspeed
import tmtools
import freesasa
import sample_binder
from experiments.inference_antibody_partial import Experiment
from models.layer_norm.layer_norm import FusedLayerNorm

assert Path("/app/ppiflow/configs/test_antibody.yaml").exists()
assert Path("/app/ppiflow/models/layer_norm/fastfold_layer_norm_cuda.so").exists()
print("PPIFlow initial binder and partial-flow runtime imports OK")
PY
    
    # Generate lockfile for reproducibility
    uv pip freeze --python /opt/venv/bin/python > /opt/venv/requirements.lock
    
    # Create checkpoint directory
    mkdir -p /opt/ppiflow/ckpt
    
    # Activate venv in environment
    echo 'export PATH="/opt/venv/bin:$PATH"' >> $APPTAINER_ENVIRONMENT
    echo 'export PYTHONPATH=/app/ppiflow:$PYTHONPATH' >> $APPTAINER_ENVIRONMENT

%environment
    export PATH="/opt/venv/bin:$PATH"
    export PYTHONPATH="/app/ppiflow:$PYTHONPATH"
    export VIRTUAL_ENV=/opt/venv

%runscript
    exec python "$@"

%help
    PPIFlow container for protein-protein interaction-aware binder design.
    
    Usage:
        apptainer run --nv --bind /path/to/ckpt:/opt/ppiflow/ckpt ppiflow.sif script.py [args]
    
    Lockfile: /opt/venv/requirements.lock
