Bootstrap: docker
From: nvidia/cuda:12.4.1-runtime-ubuntu22.04

%post
    apt-get update && apt-get install -y \
        wget \
        git \
        python3 \
        python3-pip \
        ffmpeg \
        && apt-get clean \
        && rm -rf /var/lib/apt/lists/*

    # Install PyTorch
    pip3 install torch torchvision torchaudio --index-url https://download.pytorch.org/whl/cu124

    # Install FreeBindCraft
    git clone https://github.com/cytokineking/FreeBindCraft.git /opt/FreeBindCraft
    cd /opt/FreeBindCraft

    # Dependencies for "No PyRosetta" mode
    pip3 install openmm pdbfixer
    pip3 install freesasa
    pip3 install biopython
    pip3 install numpy pandas scipy

    # Install sc-rs (Shape Complementarity) if Python bindings available, or build from source
    # For now ensuring basic requirements are met

%environment
    export PYTHONPATH="/opt/FreeBindCraft:$PYTHONPATH"
    export PATH="/opt/FreeBindCraft:$PATH"
    export FREESASA_QUIET="1"
