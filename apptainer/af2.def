Bootstrap: docker
From: nvcr.io/nvidia/cuda:12.1.1-cudnn8-devel-ubuntu22.04

%post
    # Install Python 3.11 and dependencies for RTX 5090 support
    apt-get -q update
    DEBIAN_FRONTEND=noninteractive apt-get install --no-install-recommends -y \
        git \
        software-properties-common \
        wget

    # Add deadsnakes PPA for Python 3.11
    add-apt-repository ppa:deadsnakes/ppa -y
    apt-get -q update

    DEBIAN_FRONTEND=noninteractive apt-get install --no-install-recommends -y \
        python3.11 \
        python3.11-dev \
        python3.11-distutils \
        python3-pip

    # Set Python 3.11 as default
    update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.11 1

    # Upgrade pip
    python3.11 -m pip install -q -U --no-cache-dir pip

    # Cleanup
    rm -rf /var/lib/apt/lists/*
    apt-get autoremove -y
    apt-get clean

    ldconfig
    ldconfig -p

    # CRITICAL: Install NumPy 1.x first (JAX 0.4.20 requires NumPy <2.0)
    pip install -q --no-cache-dir "numpy<2.0"

    # Install JAX with CUDA 12 support (RTX 5090 requires compute capability 12.0)
    # Using JAX 0.4.26 for robust CUDA 12 support
    pip install -q --no-cache-dir "jax[cuda12_local]==0.4.26" -f https://storage.googleapis.com/jax-releases/jax_cuda_releases.html

    # Install JAX ecosystem dependencies (REQUIRED for AlphaFold2 Initial-Guess)
    pip install -q --no-cache-dir \
        dm-haiku \
        dm-tree \
        biopython==1.81 \
        ml-collections \
        ml_dtypes \
        mock

    # CRITICAL PATCH: Fix Haiku compatibility with JAX 0.4.26+
    # The 'jax.extend.core' module is missing attributes like 'JaxprEqn' and 'Var' in JAX 0.4.26.
    # We redirect the entire module alias 'jax_core' to 'jax.core' which has these attributes.
    sed -i 's/from jax.extend import core as jax_core/from jax import core as jax_core/g' /usr/local/lib/python3.11/dist-packages/haiku/_src/jaxpr_info.py
    
    # CRITICAL: Remove stale bytecode to ensure patch takes effect
    find /usr/local/lib/python3.11/dist-packages/haiku -name "*.pyc" -delete
    find /usr/local/lib/python3.11/dist-packages/haiku -name "__pycache__" -type d -exec rm -rf {} +

    # Note: TensorFlow removed - testing if AF2 actually needs it
    # If AF2 fails with import errors, uncomment the line below:
    # pip install -q --no-cache-dir tensorflow==2.13.0

    # Install PyRosetta (required for AF2 Initial-Guess)
    pip install -q --no-cache-dir pyrosetta-installer
    python3.11 -c 'import pyrosetta_installer; pyrosetta_installer.install_pyrosetta()'

    # Clone PapenfussLab fork of dl_binder_design (contains AF2 Initial-Guess modifications)
    git clone https://github.com/PapenfussLab/dl_binder_design.git /dl_binder_design

%environment
  export PATH="/opt/conda/bin${PATH:+:${PATH}}"
  export LD_LIBRARY_PATH="/usr/local/cuda/lib64${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"

%runscript
  exec   "$@"

%labels
