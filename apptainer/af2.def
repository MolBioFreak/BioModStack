Bootstrap: docker
From: nvcr.io/nvidia/cuda:12.1.1-cudnn8-devel-ubuntu22.04

%post
    # Install Python 3.11 and dependencies for RTX 5090 support
    apt-get -q update
    DEBIAN_FRONTEND=noninteractive apt-get install --no-install-recommends -y \
        git \
        software-properties-common \
        wget

    # Add deadsnakes PPA for Python 3.11
    add-apt-repository ppa:deadsnakes/ppa -y
    apt-get -q update

    DEBIAN_FRONTEND=noninteractive apt-get install --no-install-recommends -y \
        python3.11 \
        python3.11-dev \
        python3.11-distutils \
        python3-pip

    # Set Python 3.11 as default
    update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.11 1

    # Upgrade pip
    python3.11 -m pip install -q -U --no-cache-dir pip

    # Cleanup
    rm -rf /var/lib/apt/lists/*
    apt-get autoremove -y
    apt-get clean

    ldconfig
    ldconfig -p

    # Install JAX with CUDA 12 support (RTX 5090 requires compute capability 12.0)
    # Using JAX 0.4.20 as specified by nrbennet/dl_binder_design for CUDA 12
    pip install -q --no-cache-dir "jax[cuda12_pip]==0.4.20" -f https://storage.googleapis.com/jax-releases/jax_cuda_releases.html

    # Install JAX ecosystem dependencies (REQUIRED for AlphaFold2 Initial-Guess)
    pip install -q --no-cache-dir \
        dm-haiku \
        dm-tree \
        biopython==1.81 \
        ml-collections \
        ml_dtypes \
        mock

    # Note: TensorFlow removed - testing if AF2 actually needs it
    # If AF2 fails with import errors, uncomment the line below:
    # pip install -q --no-cache-dir tensorflow==2.13.0

    # Install PyRosetta (required for AF2 Initial-Guess)
    pip install -q --no-cache-dir pyrosetta-installer
    python3.11 -c 'import pyrosetta_installer; pyrosetta_installer.install_pyrosetta()'

    # Clone PapenfussLab fork of dl_binder_design (contains AF2 Initial-Guess modifications)
    git clone https://github.com/PapenfussLab/dl_binder_design.git /dl_binder_design

%environment
  export PATH="/opt/conda/bin${PATH:+:${PATH}}"
  export LD_LIBRARY_PATH="/usr/local/cuda/lib64${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"

%runscript
  exec   "$@"

%labels
AUTHOR esteva.m@wehi.edu.au
