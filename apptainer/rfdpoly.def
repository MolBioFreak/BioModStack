Bootstrap: docker
From: nvcr.io/nvidia/cuda:12.8.0-cudnn-devel-ubuntu22.04

%post
    # Install build dependencies
    apt-get -q update
    DEBIAN_FRONTEND=noninteractive apt-get install --no-install-recommends -y \
        git \
        wget \
        curl \
        python3.10 \
        python3.10-dev \
        python3-venv \
        python3-pip \
        build-essential \
        cmake \
        libopenbabel-dev \
        openbabel \
        python3-openbabel \
        swig

    # Install UV package manager (10-100x faster than pip)
    curl -LsSf https://astral.sh/uv/install.sh | sh
    export PATH="/root/.local/bin:$PATH"

    # Create venv with system-site-packages so apt-installed openbabel is visible
    python3.10 -m venv --system-site-packages /opt/venv
    . /opt/venv/bin/activate

    # ──────────────────────────────────────────────────────────────────────────
    # PyTorch 2.7.0 with CUDA 12.8 — first release with sm_120 (Blackwell)
    # Pinned to 2.7.0 because DGL CUDA wheels only go up to torch-2.5/cu124
    # but cu124 wheels are forward-compatible with CUDA 12.8 runtime
    # ──────────────────────────────────────────────────────────────────────────
    uv pip install --compile --no-cache-dir \
        "torch==2.7.0" "torchvision==0.22.0" "torchaudio==2.7.0" \
        --index-url https://download.pytorch.org/whl/cu128

    # ──────────────────────────────────────────────────────────────────────────
    # Force numpy <2.0 BEFORE other deps — PyTorch pulls numpy 2.x which
    # breaks RFDpoly's internal array handling
    # ──────────────────────────────────────────────────────────────────────────
    uv pip install --compile --no-cache-dir "numpy>=1.23,<2.0"

    # ──────────────────────────────────────────────────────────────────────────
    # DGL from source with CUDA — pre-built wheels lack CUDA array ops
    # (libdgl.so reports "Operator Range does not support cuda device")
    # Build DGL 2.4.0 with -DUSE_CUDA=ON against the installed PyTorch
    # ──────────────────────────────────────────────────────────────────────────
    cd /tmp
    git clone --recurse-submodules -b v2.4.0 https://github.com/dmlc/dgl.git dgl_src
    cd dgl_src
    mkdir build && cd build
    cmake .. -DUSE_CUDA=ON -DBUILD_TYPE=Release -DCUDA_TOOLKIT_ROOT_DIR=/usr/local/cuda
    make -j$(nproc)
    cd ../python
    pip install --no-deps .
    cd /
    rm -rf /tmp/dgl_src

    # Reinstall PyTorch 2.7.0+cu128 — DGL cmake contaminates venv with torch 2.4
    uv pip install --reinstall --compile --no-cache-dir \
        "torch==2.7.0" "torchvision==0.22.0" "torchaudio==2.7.0" \
        --index-url https://download.pytorch.org/whl/cu128
    # Re-pin numpy <2.0 (torch reinstall may pull numpy 2.x)
    uv pip install --compile --no-cache-dir "numpy>=1.23,<2.0"

    # ──────────────────────────────────────────────────────────────────────────
    # DGL graphbolt + torchdata fix: inject stubs via sitecustomize.py
    # This runs at Python startup before any imports, avoiding .pyc cache issues
    # ──────────────────────────────────────────────────────────────────────────
    SITE_DIR=$(python3 -c "import site; print(site.getsitepackages()[0])")
    cat > "$SITE_DIR/sitecustomize.py" << 'SITECUSTOM'
"""Auto-stub graphbolt and torchdata.datapipes for DGL + PyTorch 2.7 compatibility.
RFDpoly only uses core DGL graph ops (DGLGraph, edge_softmax, AvgPooling)."""
import sys, types

# Stub torchdata.datapipes.iter.IterDataPipe
td = types.ModuleType('torchdata')
td_dp = types.ModuleType('torchdata.datapipes')
td_dp_iter = types.ModuleType('torchdata.datapipes.iter')
# Provide IterDataPipe as a simple base class
td_dp_iter.IterDataPipe = type('IterDataPipe', (), {})
sys.modules['torchdata'] = td
sys.modules['torchdata.datapipes'] = td_dp
sys.modules['torchdata.datapipes.iter'] = td_dp_iter

# Stub dgl.graphbolt to prevent C++ lib load
gb = types.ModuleType('dgl.graphbolt')
sys.modules['dgl.graphbolt'] = gb
SITECUSTOM

    # Also nuke any compiled .pyc for graphbolt so Python doesn't use cached bytecode
    DGL_DIR=$(python3 -c "import importlib.util; print(importlib.util.find_spec('dgl').submodule_search_locations[0])")
    find "$DGL_DIR/graphbolt" -name "*.pyc" -delete 2>/dev/null || true
    cat > "$DGL_DIR/graphbolt/__init__.py" << 'EOF'
"""Patched: skips graphbolt C++ lib load."""
EOF

    # ──────────────────────────────────────────────────────────────────────────
    # RFDpoly dependencies (from original SE3nv container package list)
    # ──────────────────────────────────────────────────────────────────────────
    uv pip install --compile --no-cache-dir \
        "scipy>=1.10,<1.14" \
        hydra-core==1.3.2 \
        omegaconf \
        e3nn==0.5.1 \
        biopython \
        pandas \
        matplotlib \
        icecream \
        assertpy \
        deepdiff \
        wandb \
        prody \
        pyrsistent \
        networkx \
        python-dateutil \
        pyyaml \
        opt-einsum-fx \
        psutil \
        tqdm \
        packaging \
        pydantic \
        requests

    # Cleanup
    rm -rf /var/lib/apt/lists/*
    apt-get autoremove -y
    apt-get clean

    # Link venv activation
    echo '. /opt/venv/bin/activate' >> $APPTAINER_ENVIRONMENT

    # Generate lockfile for reproducibility
    uv pip freeze > /opt/venv/requirements.lock 2>/dev/null || true

%environment
    # RFDpoly expects its code mounted at /RFDpoly and weights at /models
    export PYTHONPATH="/RFDpoly/rf_diffusion:/RFDpoly/rf_diffusion/RF2-allatom:$PYTHONPATH"
    # Prevent user-site package contamination
    export PYTHONNOUSERSITE=1
    # Cache directories for torch.compile / DGL / matplotlib
    export NUMBA_CACHE_DIR=/tmp
    export XDG_CONFIG_HOME=/tmp
    export TRITON_CACHE_DIR=/tmp
    export DGL_HOME=/tmp
    export MPLCONFIGDIR=/tmp

%runscript
    cd /RFDpoly/rf_diffusion
    if [ $# -eq 0 ]; then
        exec /bin/bash --norc
    else
        exec "$@"
    fi

%test
    . /opt/venv/bin/activate
    export NUMBA_CACHE_DIR=/tmp
    export XDG_CONFIG_HOME=/tmp
    export TRITON_CACHE_DIR=/tmp
    export DGL_HOME=/tmp
    export MPLCONFIGDIR=/tmp
    python3 -u -c "
import torch
print(f'PyTorch {torch.__version__}')
print(f'CUDA: {torch.version.cuda}')
arch_list = torch.cuda.get_arch_list()
print(f'Architectures: {arch_list}')
if 'sm_120' not in arch_list:
    print('WARNING: sm_120 not in arch list (expected — no GPU during build)')
else:
    print('✓ Blackwell (sm_120) support confirmed')
"
    python3 -u -c "import dgl; print(f'DGL {dgl.__version__}')"
    python3 -u -c "import e3nn; print(f'e3nn {e3nn.__version__}')"
    python3 -u -c "import hydra; print(f'hydra-core {hydra.__version__}')"
    python3 -u -c "import numpy; assert int(numpy.__version__.split('.')[0]) < 2, 'numpy >= 2.0 breaks RFDpoly!'; print(f'numpy {numpy.__version__} (< 2.0 ✓)')"
    # Verify ALL critical imports that have caused past failures
    python3 -u -c "
import psutil, tqdm, requests, packaging, pydantic, pyrsistent, networkx, yaml, dateutil
import openbabel
from opt_einsum_fx import optimize_einsums_full
print('All critical imports OK')
"
    echo "All build tests passed"

%labels
    Author BioModStack
    Version 2.0
    Description "RFDpoly multi-polymer diffusion container with PyTorch CUDA 12.8 for Blackwell (sm_120) support"
    OriginalBase "SE3nv.sif from Baker lab (June 2023, PyTorch 1.13.1+cu117)"
    RebuildReason "Original container lacks sm_120 support — cannot run on RTX 5090"

%help
    Container for running RFDpoly multi-polymer diffusion design.
    Rebuilt from scratch with PyTorch CUDA 12.8 for RTX 5090 (Blackwell/sm_120).

    Original container was SE3nv.sif from Baker lab (PyTorch 1.13.1).

    Expected bind mounts (configured in nextflow.config):
      --bind <rfdpoly_repo>:/RFDpoly    # RFDpoly source code
      --bind <weights_dir>:/models      # Model checkpoints
      --bind <scripts>:/scripts         # BMS helper scripts
      --bind <code_root>                # BMS code root

    Usage:
      apptainer run --nv rfdpoly.sif python3 /RFDpoly/rf_diffusion/run_inference.py \
        --config-name=multi_polymer \
        inference.ckpt_path=/models/<checkpoint.pt> \
        inference.num_designs=4 \
        ...
