Bootstrap: docker
From: nvcr.io/nvidia/cuda:12.8.0-cudnn-devel-ubuntu22.04

%post
    # Install build dependencies
    apt-get -q update
    DEBIAN_FRONTEND=noninteractive apt-get install --no-install-recommends -y \
        git \
        wget \
        curl \
        python3.10 \
        python3.10-dev \
        python3-venv \
        python3-pip \
        build-essential \
        cmake \
        libopenbabel-dev \
        openbabel \
        python3-openbabel \
        swig

    # Install UV package manager (10-100x faster than pip)
    curl -LsSf https://astral.sh/uv/install.sh | sh
    export PATH="/root/.local/bin:$PATH"

    # Create venv with system-site-packages so apt-installed openbabel is visible
    python3.10 -m venv --system-site-packages /opt/venv
    . /opt/venv/bin/activate

    # ──────────────────────────────────────────────────────────────────────────
    # PyTorch 2.7.0 with CUDA 12.8 — first release with sm_120 (Blackwell)
    # Pinned to 2.7.0 because DGL CUDA wheels only go up to torch-2.5/cu124
    # but cu124 wheels are forward-compatible with CUDA 12.8 runtime
    # ──────────────────────────────────────────────────────────────────────────
    uv pip install --compile --no-cache-dir \
        "torch==2.7.0" "torchvision==0.22.0" "torchaudio==2.7.0" \
        --index-url https://download.pytorch.org/whl/cu128

    # ──────────────────────────────────────────────────────────────────────────
    # Force numpy <2.0 BEFORE other deps — PyTorch pulls numpy 2.x which
    # breaks RFDpoly's internal array handling
    # ──────────────────────────────────────────────────────────────────────────
    uv pip install --compile --no-cache-dir "numpy>=1.23,<2.0"

    # ──────────────────────────────────────────────────────────────────────────
    # DGL with CUDA support — install from DGL's cu124 wheel index
    # cu124 wheels are binary-compatible with CUDA 12.8 runtime
    # Must use --find-links and allow the wheel to match torch 2.7
    # ──────────────────────────────────────────────────────────────────────────
    pip install dgl -f https://data.dgl.ai/wheels/torch-2.5/cu124/repo.html

    # ──────────────────────────────────────────────────────────────────────────
    # RFDpoly dependencies (from original SE3nv container package list)
    # ──────────────────────────────────────────────────────────────────────────
    uv pip install --compile --no-cache-dir \
        "scipy>=1.10,<1.14" \
        hydra-core==1.3.2 \
        omegaconf \
        e3nn==0.5.1 \
        biopython \
        pandas \
        matplotlib \
        icecream \
        assertpy \
        deepdiff \
        wandb \
        prody \
        pyrsistent \
        networkx \
        python-dateutil \
        pyyaml \
        opt-einsum-fx

    # Cleanup
    rm -rf /var/lib/apt/lists/*
    apt-get autoremove -y
    apt-get clean

    # Link venv activation
    echo '. /opt/venv/bin/activate' >> $APPTAINER_ENVIRONMENT

    # Generate lockfile for reproducibility
    uv pip freeze > /opt/venv/requirements.lock 2>/dev/null || true

%environment
    # RFDpoly expects its code mounted at /RFDpoly and weights at /models
    export PYTHONPATH="/RFDpoly/rf_diffusion:/RFDpoly/rf_diffusion/RF2-allatom:$PYTHONPATH"
    # Prevent user-site package contamination
    export PYTHONNOUSERSITE=1
    # Cache directories for torch.compile / DGL / matplotlib
    export NUMBA_CACHE_DIR=/tmp
    export XDG_CONFIG_HOME=/tmp
    export TRITON_CACHE_DIR=/tmp
    export DGL_HOME=/tmp
    export MPLCONFIGDIR=/tmp

%runscript
    cd /RFDpoly/rf_diffusion
    if [ $# -eq 0 ]; then
        exec /bin/bash --norc
    else
        exec "$@"
    fi

%test
    . /opt/venv/bin/activate
    export NUMBA_CACHE_DIR=/tmp
    export XDG_CONFIG_HOME=/tmp
    export TRITON_CACHE_DIR=/tmp
    python3 -c "
import torch
print(f'PyTorch {torch.__version__}')
print(f'CUDA: {torch.version.cuda}')
arch_list = torch.cuda.get_arch_list()
print(f'Architectures: {arch_list}')
assert 'sm_120' in arch_list, 'ERROR: sm_120 (Blackwell) not in arch list!'
print('✓ Blackwell (sm_120) support confirmed')
"
    python3 -c "import dgl; print(f'DGL {dgl.__version__}')"
    python3 -c "import e3nn; print(f'e3nn {e3nn.__version__}')"
    python3 -c "import hydra; print(f'hydra-core {hydra.__version__}')"
    python3 -c "import numpy; assert int(numpy.__version__.split('.')[0]) < 2, 'numpy >= 2.0 breaks RFDpoly!'; print(f'numpy {numpy.__version__} (< 2.0 ✓)')"
    echo "All build tests passed"

%labels
    Author BioModStack
    Version 2.0
    Description "RFDpoly multi-polymer diffusion container with PyTorch CUDA 12.8 for Blackwell (sm_120) support"
    OriginalBase "SE3nv.sif from Baker lab (June 2023, PyTorch 1.13.1+cu117)"
    RebuildReason "Original container lacks sm_120 support — cannot run on RTX 5090"

%help
    Container for running RFDpoly multi-polymer diffusion design.
    Rebuilt from scratch with PyTorch CUDA 12.8 for RTX 5090 (Blackwell/sm_120).

    Original container was SE3nv.sif from Baker lab (PyTorch 1.13.1).

    Expected bind mounts (configured in nextflow.config):
      --bind <rfdpoly_repo>:/RFDpoly    # RFDpoly source code
      --bind <weights_dir>:/models      # Model checkpoints
      --bind <scripts>:/scripts         # BMS helper scripts
      --bind <code_root>                # BMS code root

    Usage:
      apptainer run --nv rfdpoly.sif python3 /RFDpoly/rf_diffusion/run_inference.py \
        --config-name=multi_polymer \
        inference.ckpt_path=/models/<checkpoint.pt> \
        inference.num_designs=4 \
        ...
