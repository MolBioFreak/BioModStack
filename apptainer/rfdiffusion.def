Bootstrap: docker
From: nvcr.io/nvidia/cuda:12.8.0-devel-ubuntu22.04

# RFdiffusion container optimized for NVIDIA RTX 5090 (sm_120) and RTX 3090 (sm_86)
# Based on successful JMB-Scripts implementation using CUDA 12.8
# https://github.com/JMB-Scripts/RFdiffusion-dockerfile-nvidia-RTX5090

%post
    export DEBIAN_FRONTEND=noninteractive

    # Install system dependencies
    apt-get -q update
    apt-get install --no-install-recommends -y \
        git \
        wget \
        build-essential \
        ninja-build \
        g++-11 \
        ca-certificates

    # Install modern CMake (3.29.3) - Ubuntu 22.04 default is too old
    cd /tmp
    wget -q https://github.com/Kitware/CMake/releases/download/v3.29.3/cmake-3.29.3-linux-x86_64.sh
    sh cmake-3.29.3-linux-x86_64.sh --skip-license --prefix=/usr/local
    rm cmake-3.29.3-linux-x86_64.sh

    # Install Mambaforge for conda environment management
    wget -q https://github.com/conda-forge/miniforge/releases/download/24.3.0-0/Mambaforge-24.3.0-0-Linux-x86_64.sh -O /tmp/mambaforge.sh
    bash /tmp/mambaforge.sh -b -p /opt/conda
    rm /tmp/mambaforge.sh
    export PATH="/opt/conda/bin:$PATH"

    # Create Python 3.11 environment
    mamba create -y -n rfdiffusion python=3.11
    export PATH="/opt/conda/envs/rfdiffusion/bin:$PATH"

    # Install PyTorch nightly with CUDA 12.8 support (required for RTX 5090 sm_120)
    pip install --pre torch torchvision torchaudio --index-url https://download.pytorch.org/whl/nightly/cu128

    # Enforce NumPy < 2.0 to prevent ABI conflicts
    pip install "numpy<2.0"

    # Clone RFdiffusion repository
    git clone https://github.com/PapenfussLab/RFdiffusion /app/RFdiffusion
    cd /app/RFdiffusion
    git checkout 0938f878388466d30d16f1f468c362afe9c8d345

    # Install core dependencies
    pip install --no-cache-dir \
        hydra-core==1.3.2 \
        pandas \
        "pydantic>=2.0" \
        wandb==0.12.0 \
        pynvml==11.0.0 \
        decorator==5.1.0 \
        pyrsistent==0.19.3 \
        icecream==2.1.3 \
        biopython==1.81 \
        ml-collections==0.1.1 \
        git+https://github.com/NVIDIA/dllogger#egg=dllogger

    # Install e3nn with version 0.3.3
    pip install --no-cache-dir e3nn==0.3.3

    # Install torchdata (compatible with PyTorch nightly)
    pip install --no-cache-dir torchdata

    # Build and install SE3Transformer
    cd /app/RFdiffusion/env/SE3Transformer
    pip install --no-cache-dir . --no-deps

    # Build and install DGL from source with CUDA 12.8 support
    # Clean up any existing DGL directory from previous build attempts
    rm -rf /tmp/dgl
    cd /tmp
    git clone --recursive https://github.com/dmlc/dgl.git
    cd dgl
    mkdir build
    cd build
    cmake -DUSE_CUDA=ON \
          -DCUDA_TOOLKIT_ROOT_DIR=/usr/local/cuda \
          -DCMAKE_BUILD_TYPE=Release \
          ..
    make -j$(nproc)
    cd ../python
    python setup.py install

    # Install RFdiffusion
    cd /app/RFdiffusion
    pip install --no-cache-dir . --no-deps

    # Apply e3nn hotfix using Python to handle nested function calls properly
    python3.11 << 'PYTHON_EOF'
import re
import os
from pathlib import Path

e3nn_dir = Path("/opt/conda/envs/rfdiffusion/lib/python3.11/site-packages/e3nn")

def fix_torch_load(content):
    # Match torch.load( and find the matching closing paren
    # Add weights_only=False before the closing paren of torch.load
    pattern = r'torch\.load\s*\('

    result = []
    pos = 0

    for match in re.finditer(pattern, content):
        result.append(content[pos:match.end()])

        # Find matching closing paren
        paren_count = 1
        i = match.end()
        while i < len(content) and paren_count > 0:
            if content[i] == '(':
                paren_count += 1
            elif content[i] == ')':
                paren_count -= 1
            i += 1

        # Extract the arguments
        args_end = i - 1
        args = content[match.end():args_end]

        # Check if weights_only is already present
        if 'weights_only' not in args:
            # Add weights_only=False before closing paren
            result.append(args)
            result.append(', weights_only=False')
        else:
            result.append(args)

        result.append(')')
        pos = i

    result.append(content[pos:])
    return ''.join(result)

# Process all Python files in e3nn
for py_file in e3nn_dir.rglob("*.py"):
    try:
        with open(py_file, 'r') as f:
            content = f.read()

        if 'torch.load(' in content and 'weights_only' not in content:
            fixed_content = fix_torch_load(content)
            with open(py_file, 'w') as f:
                f.write(fixed_content)
            print(f"Fixed: {py_file}")
    except Exception as e:
        print(f"Error processing {py_file}: {e}")

print("e3nn hotfix complete")
PYTHON_EOF

    # Create python3.10 symlink for backward compatibility with Nextflow modules
    ln -s /opt/conda/envs/rfdiffusion/bin/python /opt/conda/envs/rfdiffusion/bin/python3.10

    # Clean up
    apt-get autoremove -y
    apt-get clean
    rm -rf /var/lib/apt/lists/*
    # Clean up specific temp files (avoid /tmp/* which conflicts with Apptainer build mounts)
    rm -rf /tmp/dgl /tmp/mambaforge.sh /tmp/cmake-*.sh

%environment
    export PATH="/opt/conda/envs/rfdiffusion/bin:$PATH"
    export DGLBACKEND="pytorch"
    export PYTHONUNBUFFERED=1

%runscript
    exec python /app/RFdiffusion/scripts/run_inference.py "$@"
