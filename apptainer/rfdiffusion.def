Bootstrap: docker
From: nvcr.io/nvidia/cuda:12.8.0-cudnn-devel-ubuntu22.04

# The post section is equivalent to the Docker RUN instruction.
%post
    apt-get -q update
    DEBIAN_FRONTEND=noninteractive apt-get install --no-install-recommends -y \
        git \
        python3.10 \
        python3-pip \
        sed \
        cmake \
        build-essential
    python3.10 -m pip install -q -U --no-cache-dir pip
    rm -rf /var/lib/apt/lists/*
    apt-get autoremove -y
    apt-get clean

    # Clone the RFdiffusion repository
    git clone https://github.com/PapenfussLab/RFdiffusion /app/RFdiffusion
    cd /app/RFdiffusion && git checkout 0938f878388466d30d16f1f468c362afe9c8d345

    # Install PyTorch nightly with CUDA 12.8 for RTX 5090 (sm_120) support
    # CUDA 12.8 nightly builds include sm_120 support for Blackwell architecture
    pip install -q --no-cache-dir \
        torch torchvision torchaudio --index-url https://download.pytorch.org/whl/nightly/cu128

    # Build DGL from source for PyTorch nightly compatibility
    # Pre-built DGL 1.1.3 from PyPI lacks CUDA operations needed by PyTorch nightly
    git clone --branch v1.1.3 --recurse-submodules https://github.com/dmlc/dgl.git /tmp/dgl
    cd /tmp/dgl
    mkdir build && cd build
    cmake -DUSE_CUDA=ON -DCUDA_TOOLKIT_ROOT_DIR=/usr/local/cuda ..
    make -j$(nproc)
    cd ../python
    python3.10 setup.py install
    cd / && rm -rf /tmp/dgl

    # Install RFdiffusion dependencies (removed TensorFlow, JAX, dm-haiku, dm-tree, ml-collections - not used by RFdiffusion)
    pip install -q --no-cache-dir \
        e3nn==0.3.3 \
        wandb==0.12.0 \
        pynvml==11.0.0 \
        git+https://github.com/NVIDIA/dllogger#egg=dllogger \
        decorator==4.4.2 \
        hydra-core==1.3.2 \
        pyrsistent==0.19.3 \
        icecream==2.1.3 \
        biopython==1.81 \
        /app/RFdiffusion/env/SE3Transformer

    # CRITICAL FIX: Patch e3nn to add weights_only=False to torch.load() call
    # This fixes PyTorch nightly's stricter pickle security for RTX 5090 compatibility
    # Solution adapted from: https://github.com/JMB-Scripts/RFdiffusion-dockerfile-nvidia-RTX5090
    sed -i "s/torch\.load(os\.path\.join(os\.path\.dirname(__file__), 'constants\.pt'))/torch.load(os.path.join(os.path.dirname(__file__), 'constants.pt'), weights_only=False)/" \
        /usr/local/lib/python3.10/dist-packages/e3nn/o3/_wigner.py

    # Install RFdiffusion itself
    pip install --no-cache-dir /app/RFdiffusion --no-deps

    # Create schedules directory for RFdiffusion (read-only filesystem workaround)
    # RFdiffusion tries to create this at runtime, but Apptainer containers are read-only
    mkdir -p /usr/local/lib/python3.10/dist-packages/schedules
    chmod 777 /usr/local/lib/python3.10/dist-packages/schedules

# Setting environment variables
%environment
    DGLBACKEND="pytorch"

# Entry point for the container when run.
%runscript
    exec python3.10 /app/RFdiffusion/scripts/run_inference.py "$@"
