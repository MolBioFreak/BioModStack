CALIBY_RUNTIME_LOCK
    uv pip install --no-deps "torch==2.8.0+cu128" --index-url https://download.pytorch.org/whl/cu128
    uv pip install --no-deps -r /opt/caliby/runtime.lock

    mkdir -p /weights/caliby/model_params /cache/huggingface /cache/triton /cache/general
    uv pip freeze > /opt/caliby/.venv/requirements.lock

%environment
    export PATH=/opt/caliby/.venv/bin:$PATH
    export PYTHONPATH=/opt/caliby:$PYTHONPATH
    export MODEL_PARAMS_DIR=/weights/caliby/model_params
    export XDG_CACHE_HOME=/cache/general
    export HF_HOME=/cache/huggingface
    export TRITON_CACHE_DIR=/cache/triton
    export PDB_MIRROR_PATH=
    export CCD_MIRROR_PATH=

%test
    . /opt/caliby/.venv/bin/activate
    python3 -c "import torch; print(torch.__version__)"
    python3 -c "from caliby import load_model; print('Caliby runtime ok')"

%help
    Caliby runtime image for BioModStack experimental sequence design.

    Notes:
    - This image intentionally uses Python 3.12 and UV, matching upstream.
    - Torch is installed from the cu128 wheel index to support both Ampere and
      Blackwell hosts through a single CUDA 12.8 runtime surface.
    - Default model cache location in BMS is /weights/caliby/model_params.

    Upstream:
    https://github.com/ProteinDesignLab/caliby
