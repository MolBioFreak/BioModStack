Bootstrap: docker
From: nvcr.io/nvidia/cuda:12.8.0-cudnn-devel-ubuntu24.04

%labels
    Author BioModStack
    Version 0.1.0
    Description Caliby runtime for experimental sequence design and nanobody CDR redesign

%post
    set -eu
    export DEBIAN_FRONTEND=noninteractive

    apt-get update && apt-get install -y \
        git \
        curl \
        wget \
        build-essential \
        python3.12 \
        python3.12-dev \
        python3.12-venv \
        && rm -rf /var/lib/apt/lists/*

    ln -sf /usr/bin/python3.12 /usr/bin/python3
    ln -sf /usr/bin/python3.12 /usr/bin/python

    curl -LsSf https://astral.sh/uv/0.11.7/install.sh | sh
    export PATH="/root/.local/bin:${PATH}"

    git clone https://github.com/ProteinDesignLab/caliby.git /opt/caliby
    cd /opt/caliby
    git checkout --detach ddb368cbe239ddc2bd731a963f10ffe81452bb1f

    uv venv .venv -p python3.12
    . .venv/bin/activate
    # Runtime dependency closure captured from the installed Caliby image.
    # Install exact resolved inputs, including immutable native Git dependencies;
    # do not re-resolve upstream's ranges or upgrade the scientific runtime.
    cat > /opt/caliby/runtime.lock <<'CALIBY_RUNTIME_LOCK'
