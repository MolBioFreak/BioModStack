Bootstrap: docker
From: nvidia/cuda:12.4.1-runtime-ubuntu22.04

%labels
    Author BioModStack
    Description IgGM - Generative Foundation Model for Antibody Design (Tencent AI4S)
    Version 1.0.0

%post
    apt-get update && apt-get install -y \
        wget \
        git \
        curl \
        python3 \
        python3-pip \
        python3-venv \
        && apt-get clean \
        && rm -rf /var/lib/apt/lists/*

    # Install UV package manager (10-100x faster than pip)
    curl -LsSf https://astral.sh/uv/install.sh | sh
    export PATH="/root/.local/bin:$PATH"

    # Create virtual environment
    uv venv /opt/venv
    export VIRTUAL_ENV=/opt/venv
    export PATH="/opt/venv/bin:$PATH"

    # Install PyTorch with CUDA 12.4 support (matching other containers)
    uv pip install --compile torch==2.4.1 torchvision torchaudio --index-url https://download.pytorch.org/whl/cu124

    # Clone IgGM repository
    git clone https://github.com/TencentAI4S/IgGM.git /opt/IgGM
    cd /opt/IgGM

    # Install PyTorch Geometric dependencies
    uv pip install --compile pyg_lib torch_scatter torch_sparse torch_cluster torch_spline_conv \
        -f https://data.pyg.org/whl/torch-2.4.0+cu124.html

    # Install IgGM dependencies
    uv pip install --compile hydra-core omegaconf biopython scipy pandas numpy einops
    uv pip install --compile fair-esm  # For ESM embeddings
    
    # Install additional requirements if present
    if [ -f requirements.txt ]; then
        uv pip install --compile -r requirements.txt || true
    fi

    # Cleanup
    rm -rf /root/.cache/uv

    # Generate lockfile for reproducibility
    uv pip freeze > /opt/venv/requirements.lock 2>/dev/null || true

%environment
    export PYTHONPATH="/opt/IgGM:$PYTHONPATH"
    export PATH="/opt/venv/bin:/opt/IgGM:$PATH"
    export VIRTUAL_ENV=/opt/venv

%runscript
    cd /opt/IgGM
    python3 "$@"
