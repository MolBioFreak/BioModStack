Bootstrap: docker
From: ubuntu@sha256:5ec03bb3441e8b0bf3b4f9cd4629a1ae763010dc3035bb8da3ae6cf026486401

# Build from the repository root:
# apptainer build iggm.sif apptainer/iggm.def
# CUDA 12.8 user-space libraries are supplied by the complete hash-locked
# torch wheel closure, not an inherited CUDA 12.4 system installation.
# Scientific source is the exact clean revision found in the installed image.
# Native external checkpoint lookup/defaults are unchanged; the installed image
# contained no embedded model checkpoints. No runtime admission checks are added.

%labels
    Author BioModStack
    Description IgGM - preserved native science with pinned CUDA 12.8 accelerator packaging
    NativeRevision 6b1bd91abdf6785d9bbf59c51d6e0c8880aceb8a
    TorchVersion 2.7.1+cu128
    AcceleratorCUDA 12.8

%files
    apptainer/iggm-requirements.in /opt/iggm-requirements.in
    apptainer/iggm-requirements.lock /opt/iggm-requirements.lock
    apptainer/iggm-source-identity.json /opt/iggm-source-identity.json

%post
    set -eu
    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    apt-get install -y --no-install-recommends ca-certificates curl git python3 python3-pip python3-venv
    /usr/bin/python3 -m pip install --no-cache-dir uv==0.11.26
    uv venv --clear --python /usr/bin/python3 /opt/venv
    uv pip sync --python /opt/venv/bin/python --require-hashes \
        --index-url https://pypi.org/simple \
        --extra-index-url https://download.pytorch.org/whl/cu128 \
        --find-links https://data.pyg.org/whl/torch-2.7.0+cu128.html \
        --index-strategy unsafe-best-match /opt/iggm-requirements.lock
    uv pip check --python /opt/venv/bin/python
    mkdir -p /opt/IgGM
    curl -fL https://github.com/TencentAI4S/IgGM/archive/6b1bd91abdf6785d9bbf59c51d6e0c8880aceb8a.tar.gz -o /opt/iggm-source.tar.gz
    printf '%s  %s\n' dc0011b2a35749a4bd8ffb3a1af96e5e66e2489be1ce48183b70b9f1af8d72af /opt/iggm-source.tar.gz | sha256sum -c -
    tar -xzf /opt/iggm-source.tar.gz --strip-components=1 -C /opt/IgGM
    rm /opt/iggm-source.tar.gz
    uv pip freeze --python /opt/venv/bin/python > /opt/venv/requirements.lock
    apt-get clean
    rm -rf /var/lib/apt/lists/* /root/.cache/uv /root/.cache/pip

%environment
    export PYTHONPATH="/opt/IgGM:$PYTHONPATH"
    export PATH="/opt/venv/bin:/opt/IgGM:$PATH"
    export VIRTUAL_ENV=/opt/venv

%runscript
    cd /opt/IgGM
    exec /opt/venv/bin/python "$@"
