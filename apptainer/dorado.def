# Dorado + modkit container for ONT Nanopore basecalling and methylation analysis
# Self-contained: BMS-lite extractable
Bootstrap: docker
From: nvcr.io/nvidia/cuda:12.8.0-cudnn-runtime-ubuntu22.04

%post
    set -eux

    apt-get -q update
    DEBIAN_FRONTEND=noninteractive apt-get install --no-install-recommends -y \
        wget \
        curl \
        jq \
        unzip \
        ca-certificates \
        samtools \
        minimap2

    # ── Dorado v1.3.1 (Jan 2026) ──────────────────────────────────────────
    # Pre-built Linux x86_64 binary with CUDA support
    DORADO_VERSION="1.3.1"
    wget -qO- "https://cdn.oxfordnanoportal.com/software/analysis/dorado-${DORADO_VERSION}-linux-x64.tar.gz" \
        | tar xzf - -C /opt
    ln -s /opt/dorado-${DORADO_VERSION}-linux-x64/bin/dorado /usr/local/bin/dorado

    # ── modkit (resolve current release asset dynamically) ───────────────────
    MODKIT_REPO="nanoporetech/modkit"
    MODKIT_VERSION="latest"   # set to e.g. v0.7.0 to pin
    MODKIT_TMP="/tmp/modkit_download"
    MODKIT_EXTRACT="/tmp/modkit_extract"
    rm -f "${MODKIT_TMP}" /usr/local/bin/modkit
    rm -rf "${MODKIT_EXTRACT}"
    mkdir -p "${MODKIT_EXTRACT}"

    if [ "${MODKIT_VERSION}" = "latest" ]; then
        MODKIT_API_URL="https://api.github.com/repos/${MODKIT_REPO}/releases/latest"
    else
        MODKIT_API_URL="https://api.github.com/repos/${MODKIT_REPO}/releases/tags/${MODKIT_VERSION}"
    fi

    echo "Querying modkit release metadata: ${MODKIT_API_URL}"
    MODKIT_JSON="$(curl -fsSL --retry 3 --retry-delay 2 "${MODKIT_API_URL}")"
    MODKIT_TAG="$(printf '%s' "${MODKIT_JSON}" | jq -r '.tag_name // empty')"
    echo "Resolved modkit tag: ${MODKIT_TAG}"

    MODKIT_URL="$(printf '%s' "${MODKIT_JSON}" \
        | jq -r '.assets[].browser_download_url' \
        | grep -Ei 'modkit.*(linux|centos).*(x86_64|amd64)|modkit.*(x86_64|amd64).*(linux|centos)' \
        | head -n1 || true)"

    if [ -z "${MODKIT_URL}" ]; then
        echo "No architecture-specific asset matched filter; trying any asset containing modkit." >&2
        MODKIT_URL="$(printf '%s' "${MODKIT_JSON}" \
            | jq -r '.assets[].browser_download_url' \
            | grep -Ei 'modkit' \
            | head -n1 || true)"
    fi

    if [ -z "${MODKIT_URL}" ]; then
        echo "ERROR: unable to find a downloadable modkit asset in release ${MODKIT_TAG}." >&2
        exit 1
    fi

    echo "Downloading modkit asset: ${MODKIT_URL}"
    curl -fsSL --retry 3 --retry-delay 2 -o "${MODKIT_TMP}" "${MODKIT_URL}"

    case "${MODKIT_URL}" in
        *.tar.gz|*.tgz)
            tar -xzf "${MODKIT_TMP}" -C "${MODKIT_EXTRACT}"
            ;;
        *.zip)
            unzip -q "${MODKIT_TMP}" -d "${MODKIT_EXTRACT}"
            ;;
        *)
            install -m 0755 "${MODKIT_TMP}" /usr/local/bin/modkit
            ;;
    esac

    if [ ! -x /usr/local/bin/modkit ]; then
        MODKIT_BIN="$(find "${MODKIT_EXTRACT}" -type f \( -name modkit -o -name 'modkit*' \) | head -n1 || true)"
        if [ -z "${MODKIT_BIN}" ]; then
            echo "ERROR: modkit binary not found after extracting ${MODKIT_URL}" >&2
            exit 1
        fi
        install -m 0755 "${MODKIT_BIN}" /usr/local/bin/modkit
    fi

    rm -f "${MODKIT_TMP}"
    rm -rf "${MODKIT_EXTRACT}"

    # ── Cleanup ────────────────────────────────────────────────────────────
    apt-get clean
    rm -rf /var/lib/apt/lists/*

%environment
    # Dorado model cache: bind-mount host weights dir here
    export DORADO_MODELS_DIRECTORY=/weights/dorado

%runscript
    if [ $# -eq 0 ]; then
        exec /bin/bash --norc
    else
        exec "$@"
    fi

%test
    dorado --version
    modkit --version
    samtools --version | head -1
    echo "Container build tests passed"

%help
    ONT Dorado basecaller + modkit methylation analysis container.
    GPU-accelerated basecalling with modified base detection.

    Expects model weights bind-mounted at /weights/dorado.
    Usage:
      apptainer run --nv --bind /mnt/BioModStack/weights/dorado:/weights/dorado dorado.sif \
        dorado basecaller --model-path /weights/dorado/dna_r10.4.1_e8.2_400bps_sup@v5.0.0 \
        --modified-bases 5mCG_5hmCG /input/pod5/
