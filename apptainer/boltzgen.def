Bootstrap: docker
From: nvcr.io/nvidia/cuda:12.8.0-cudnn-devel-ubuntu22.04

%labels
    Author ProteinDJ Extended Pipeline
    Version 1.0.0
    Description BoltzGen container for all-atom binder design

%files
    apptainer/patches/boltzgen/ligand-only-mmcif.patch /opt/bms-patches/ligand-only-mmcif.patch

%post
    export DEBIAN_FRONTEND=noninteractive
    export TZ=America/Chicago
    ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone
    
    # System packages
    apt-get update && apt-get install -y \
        git \
        wget \
        curl \
        build-essential \
        patch \
        && rm -rf /var/lib/apt/lists/*
    
    # Python 3.11 (required by BoltzGen >= 0.1.8)
    apt-get update && apt-get install -y \
        software-properties-common \
        && add-apt-repository ppa:deadsnakes/ppa -y \
        && apt-get update && apt-get install -y \
        python3.11 \
        python3.11-dev \
        python3.11-venv \
        && rm -rf /var/lib/apt/lists/*
        
    update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.11 1
    update-alternatives --install /usr/bin/python python /usr/bin/python3.11 1
    
    # UV Package Manager (YES, UV!)
    curl -LsSf https://astral.sh/uv/install.sh | sh
    export PATH="/root/.local/bin:$PATH"
    
    # Virtual Environment
    uv venv /opt/venv
    . /opt/venv/bin/activate
    
    # PyTorch release built for CUDA 12.8 (includes RTX 50-series sm_120 kernels).
    uv pip install --compile torch==2.11.0 torchvision==0.26.0 torchaudio==2.11.0 --index-url https://download.pytorch.org/whl/cu128
    
    # Install BoltzGen dependencies
    # BoltzGen is built on top of Boltz
    
    # 1. Install Boltz-2 (Core dependency)
    git clone https://github.com/jwohlwend/boltz.git /app/boltz
    cd /app/boltz
    uv pip install --compile .
    
    # 2. Install BoltzGen
    # Pinned to the commit BMS is integrated against. The patch lets a ligand-only structure
    # (no polymer rows) parse; see docs/BoltzGen_Ligand_Parser_Repair.md.
    git clone https://github.com/HannesStark/boltzgen.git /app/boltzgen
    cd /app/boltzgen
    git checkout --detach 617e549edf70787d899f47bc39e3746d8f10ffff
    patch --batch --forward src/boltzgen/data/parse/mmcif.py /opt/bms-patches/ligand-only-mmcif.patch
    uv pip install --compile .
    
    # Cleanup
    # Cleanup
    # rm -rf /root/.cache/uv
    apt-get clean
    apt-get clean

    # Generate lockfile for reproducibility
    uv pip freeze > /opt/venv/requirements.lock 2>/dev/null || true

%environment
    export PATH=/opt/venv/bin:$PATH
    export CUDA_DEVICE_ORDER=PCI_BUS_ID
    export PYTHONPATH=/app/boltzgen:$PYTHONPATH
    export BOLTZ_CACHE=/tmp/boltz_cache

%runscript
    exec python3 "$@"

%test
    . /opt/venv/bin/activate
    python3 -c "import torch; print(f'PyTorch: {torch.__version__}')"
    # Verify imports
    python3 -c "import boltz; print(f'Boltz: {boltz.__version__}')"
    python3 -c 'from boltzgen.data.parse.mmcif import mmcif_from_block; import inspect; assert "eps_loop is not None and eps_loop.length()" in inspect.getsource(mmcif_from_block)'
    # python3 -c "import boltzgen; print('BoltzGen OK')" # Module name might differ

%help
    BoltzGen Container
    
    Generative all-atom protein binder design.
    Repo: https://github.com/HannesStark/boltzgen
