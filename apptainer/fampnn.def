Bootstrap: docker
From: nvcr.io/nvidia/cuda:12.8.0-cudnn-devel-ubuntu22.04

%post
    # install build deps
    apt-get -q update
    DEBIAN_FRONTEND=noninteractive apt-get install --no-install-recommends -y \
        git \
        wget \
        curl \
        python3.10 \
        python3-venv \
        python3-pip \
        build-essential

    # Install UV package manager (10-100x faster than pip)
    curl -LsSf https://astral.sh/uv/install.sh | sh
    export PATH="/root/.local/bin:$PATH"

    # create and activate virtual environment
    python3.10 -m venv /opt/venv
    . /opt/venv/bin/activate

    # clone repository
    git clone https://github.com/PapenfussLab/fampnn.git /app/fampnn && cd /app/fampnn && git checkout 18363df

    # PyTorch release built for CUDA 12.8 (includes RTX 50-series sm_120 kernels).
    uv pip install --compile torch==2.11.0 torchvision==0.26.0 torchaudio==2.11.0 --index-url https://download.pytorch.org/whl/cu128

    # install other dependencies
    uv pip install --compile scipy certifi torch-geometric gemmi biopython tqdm natsort omegaconf rdkit einops hydra-core torchtyping dm-tree timm jaxtyping joblib pandas

    # install fampnn package
    uv pip install --compile --no-deps -e .

    # cleanup
    rm -rf /var/lib/apt/lists/*
    apt-get autoremove -y
    apt-get clean

    # link venv
    echo '. /opt/venv/bin/activate' >> $APPTAINER_ENVIRONMENT

    # Generate lockfile for reproducibility
    uv pip freeze > /opt/venv/requirements.lock 2>/dev/null || true

%environment
    export PYTHONPATH="/app/fampnn:$PYTHONPATH"

%runscript
    cd /app/fampnn
    if [ $# -eq 0 ]; then
        exec /bin/bash --norc
    else
        exec "$@"
    fi

%test
    pip show fampnn

%labels
    Author JoshuaHardy, DylanSilke
    Version 1.0
    Description "Apptainer container for Full-atom MPNN (fampnn)"

%help
    Container for running fampnn with CUDA 12.8
    Execute with GPU support using: apptainer run --nv fampnn.sif