Bootstrap: docker
From: nvidia/cuda:13.5.0-cudnn-devel-ubuntu24.04

%post
    set -eu
    # install build deps
    apt-get -q update
    DEBIAN_FRONTEND=noninteractive apt-get install --no-install-recommends -y \
        git \
        wget \
        curl \
        python3.12 \
        python3-venv \
        build-essential

    # Install pinned uv 0.13.10 with SHA256 verification
    UV_VERSION="0.13.10"
    case "$(uname -m)" in
        x86_64|amd64)
            UV_TARGET="x86_64-unknown-linux-gnu"
            UV_SHA256="bf65ac1a0af10f92c522d91ac096c7c0a39657647b155577e7836c2cbbb4526c"
            ;;
        aarch64|arm64)
            UV_TARGET="aarch64-unknown-linux-gnu"
            UV_SHA256="14590f644805a6234ffe071154340669e38137f38e60aa9629690119704107d2"
            ;;
        *)
            echo "Unsupported architecture for uv: $(uname -m)" >&2
            exit 1
            ;;
    esac
    UV_TMP="$(mktemp -d)"
    curl -fsSL --retry 3 --retry-delay 2 \
        "https://github.com/astral-sh/uv/releases/download/${UV_VERSION}/uv-${UV_TARGET}.tar.gz" \
        -o "${UV_TMP}/uv.tar.gz"
    printf '%s  %s\n' "${UV_SHA256}" "${UV_TMP}/uv.tar.gz" | sha256sum -c -
    tar -xzf "${UV_TMP}/uv.tar.gz" -C "${UV_TMP}"
    install -D -m 0755 "${UV_TMP}/uv-${UV_TARGET}/uv" /usr/local/bin/uv
    install -D -m 0755 "${UV_TMP}/uv-${UV_TARGET}/uvx" /usr/local/bin/uvx
    rm -rf "${UV_TMP}"
    uv --version

    # create and activate virtual environment
    python3.12 -m venv /opt/venv
    . /opt/venv/bin/activate

    # clone repository
    git clone https://github.com/PapenfussLab/fampnn.git /app/fampnn && cd /app/fampnn && git checkout 18363df

    # Hold the chosen CUDA wheels during later tool dependency resolution.
    export UV_CONSTRAINT=/tmp/bms-gpu-constraints.txt
    printf '%s\n' 'torch==2.15.0+cu134' 'torchvision==0.29.2+cu134' 'torchaudio==2.11.1+cu134' > "$UV_CONSTRAINT"
    # PyTorch release built for CUDA 13.4 (includes RTX 50-series sm_120 kernels).
    uv pip install --python /opt/venv/bin/python --no-cache --compile torch==2.15.0+cu134 torchvision==0.29.2+cu134 torchaudio==2.11.1+cu134 --index https://download.pytorch.org/whl/cu134 --default-index https://pypi.org/simple

    # install other dependencies
    uv pip install --python /opt/venv/bin/python --no-cache --compile scipy certifi torch-geometric gemmi biopython tqdm natsort omegaconf rdkit einops hydra-core torchtyping dm-tree timm jaxtyping joblib pandas

    # install fampnn package
    uv pip install --python /opt/venv/bin/python --no-cache --compile --no-deps -e .

    # cleanup
    rm -rf /var/lib/apt/lists/*
    apt-get autoremove -y
    apt-get clean

    # link venv
    echo '. /opt/venv/bin/activate' >> $APPTAINER_ENVIRONMENT

    # Generate lockfile for reproducibility
    /opt/venv/bin/python -c "import torch, torchvision; assert torch.__version__ == '2.15.0+cu134' and torch.version.cuda == '13.4'"
    uv pip freeze --python /opt/venv/bin/python > /opt/venv/requirements.lock 2>/dev/null || true

%environment
    export PYTHONPATH="/app/fampnn:$PYTHONPATH"

%runscript
    cd /app/fampnn
    if [ $# -eq 0 ]; then
        exec /bin/bash --norc
    else
        exec "$@"
    fi

%test
    /opt/venv/bin/python -c "from importlib.metadata import distribution; print(distribution('fampnn').version)"

%labels
    Author JoshuaHardy, DylanSilke
    Version 1.0
    Description "Apptainer container for Full-atom MPNN (fampnn)"

%help
    Container for running fampnn with CUDA 13.4
    Execute with GPU support using: apptainer run --nv fampnn.sif