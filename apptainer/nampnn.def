Bootstrap: docker
From: nvcr.io/nvidia/cuda:12.8.0-cudnn-devel-ubuntu22.04

%post
    # Install build dependencies
    apt-get -q update
    DEBIAN_FRONTEND=noninteractive apt-get install --no-install-recommends -y \
        git \
        wget \
        curl \
        python3.10 \
        python3.10-dev \
        python3-venv \
        python3-pip \
        build-essential \
        cmake \
        libopenbabel-dev \
        openbabel

    # Install UV package manager (10-100x faster than pip)
    curl -LsSf https://astral.sh/uv/install.sh | sh
    export PATH="/root/.local/bin:$PATH"

    # Create and activate virtual environment
    python3.10 -m venv /opt/venv
    . /opt/venv/bin/activate

    # Clone NA-MPNN repository
    git clone https://github.com/baker-laboratory/NA-MPNN.git /app/NA-MPNN

    # Install PyTorch nightly with CUDA 12.8 for RTX 5090 (sm_120) support
    # CUDA 12.8 nightly builds include sm_120 support for Blackwell architecture
    uv pip install --compile --no-cache-dir torch torchvision torchaudio --index-url https://download.pytorch.org/whl/nightly/cu128

    # Install NA-MPNN dependencies (from their environment.yml)
    uv pip install --compile --no-cache-dir \
        scipy \
        numpy \
        pandas \
        pyarrow \
        biopython \
        prody \
        openbabel-wheel

    # Cleanup build dependencies but KEEP python3.10-dev (needed for Triton JIT on RTX 5090)
    apt-mark manual python3.10-dev
    rm -rf /var/lib/apt/lists/*
    apt-get autoremove -y
    apt-get clean

    # Link venv activation
    echo '. /opt/venv/bin/activate' >> $APPTAINER_ENVIRONMENT

    # Generate lockfile for reproducibility
    uv pip freeze > /opt/venv/requirements.lock 2>/dev/null || true

%environment
    export PYTHONPATH="/app/NA-MPNN:$PYTHONPATH"
    # torch.compile cache directories
    export NUMBA_CACHE_DIR=/tmp
    export XDG_CONFIG_HOME=/tmp
    export TRITON_CACHE_DIR=/tmp

%runscript
    cd /app/NA-MPNN
    if [ $# -eq 0 ]; then
        exec /bin/bash --norc
    else
        exec "$@"
    fi

%test
    . /opt/venv/bin/activate
    export NUMBA_CACHE_DIR=/tmp
    export XDG_CONFIG_HOME=/tmp
    export TRITON_CACHE_DIR=/tmp
    python3 -c "import torch; print(f'PyTorch {torch.__version__}')"
    python3 -c "import prody; print('ProDy available')"
    echo "Build tests completed successfully"

%labels
    Author BioModStack
    Version 1.0
    Description "Container for NA-MPNN nucleic acid sequence design with torch.compile support"

%help
    Container for running NA-MPNN (Nucleic Acid MPNN) sequence design.
    Built with PyTorch CUDA 12.8 nightly for RTX 5090 (sm_120) support.
    
    Usage:
      apptainer run --nv nampnn.sif python inference/run.py \
        --model_type "na_mpnn" \
        --mode "design" \
        --pdb_path input.pdb \
        --out_folder output/
    
    Execute with GPU support using: apptainer run --nv nampnn.sif
