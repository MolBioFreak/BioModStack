Bootstrap: docker
From: nvidia/cuda:13.5.0-cudnn-devel-ubuntu24.04

%post
    set -eu
    # Install build dependencies
    apt-get -q update
    DEBIAN_FRONTEND=noninteractive apt-get install --no-install-recommends -y \
        git \
        wget \
        curl \
        python3.12 \
        python3.12-dev \
        python3-venv \
        build-essential \
        cmake \
        libopenbabel-dev \
        openbabel

    # Install pinned uv 0.13.10 with SHA256 verification
    UV_VERSION="0.13.10"
    case "$(uname -m)" in
        x86_64|amd64)
            UV_TARGET="x86_64-unknown-linux-gnu"
            UV_SHA256="bf65ac1a0af10f92c522d91ac096c7c0a39657647b155577e7836c2cbbb4526c"
            ;;
        aarch64|arm64)
            UV_TARGET="aarch64-unknown-linux-gnu"
            UV_SHA256="14590f644805a6234ffe071154340669e38137f38e60aa9629690119704107d2"
            ;;
        *)
            echo "Unsupported architecture for uv: $(uname -m)" >&2
            exit 1
            ;;
    esac
    UV_TMP="$(mktemp -d)"
    curl -fsSL --retry 3 --retry-delay 2 \
        "https://github.com/astral-sh/uv/releases/download/${UV_VERSION}/uv-${UV_TARGET}.tar.gz" \
        -o "${UV_TMP}/uv.tar.gz"
    printf '%s  %s\n' "${UV_SHA256}" "${UV_TMP}/uv.tar.gz" | sha256sum -c -
    tar -xzf "${UV_TMP}/uv.tar.gz" -C "${UV_TMP}"
    install -D -m 0755 "${UV_TMP}/uv-${UV_TARGET}/uv" /usr/local/bin/uv
    install -D -m 0755 "${UV_TMP}/uv-${UV_TARGET}/uvx" /usr/local/bin/uvx
    rm -rf "${UV_TMP}"
    uv --version

    # Create and activate virtual environment
    python3.12 -m venv /opt/venv
    . /opt/venv/bin/activate

    # Clone NA-MPNN repository
    git clone https://github.com/baker-laboratory/NA-MPNN.git /app/NA-MPNN
    git -C /app/NA-MPNN checkout --detach 9fabc2482092b725e067969fba21297a806b6fda

    # Hold the chosen CUDA wheels during later tool dependency resolution.
    export UV_CONSTRAINT=/tmp/bms-gpu-constraints.txt
    printf '%s\n' 'torch==2.15.0+cu134' 'torchvision==0.29.2+cu134' 'torchaudio==2.11.1+cu134' > "$UV_CONSTRAINT"
    # PyTorch release built for CUDA 13.4 (includes RTX 50-series sm_120 kernels).
    uv pip install --python /opt/venv/bin/python --compile --no-cache torch==2.15.0+cu134 torchvision==0.29.2+cu134 torchaudio==2.11.1+cu134 --index https://download.pytorch.org/whl/cu134 --default-index https://pypi.org/simple

    # Install NA-MPNN dependencies (from their environment.yml)
    uv pip install --python /opt/venv/bin/python --compile --no-cache \
        scipy \
        numpy \
        pandas \
        pyarrow \
        biopython \
        prody \
        openbabel-wheel

    # Cleanup build dependencies but KEEP python3.12-dev (needed for Triton JIT on RTX 5090)
    apt-mark manual python3.12-dev
    rm -rf /var/lib/apt/lists/*
    apt-get autoremove -y
    apt-get clean

    # Link venv activation
    echo '. /opt/venv/bin/activate' >> $APPTAINER_ENVIRONMENT

    # Generate lockfile for reproducibility
    /opt/venv/bin/python -c "import torch, torchvision; assert torch.__version__ == '2.15.0+cu134' and torch.version.cuda == '13.4'"
    uv pip freeze --python /opt/venv/bin/python > /opt/venv/requirements.lock 2>/dev/null || true

%environment
    export PYTHONPATH="/app/NA-MPNN:$PYTHONPATH"
    # torch.compile cache directories
    export NUMBA_CACHE_DIR=/tmp
    export XDG_CONFIG_HOME=/tmp
    export TRITON_CACHE_DIR=/tmp

%runscript
    cd /app/NA-MPNN
    if [ $# -eq 0 ]; then
        exec /bin/bash --norc
    else
        exec "$@"
    fi

%test
    . /opt/venv/bin/activate
    export NUMBA_CACHE_DIR=/tmp
    export XDG_CONFIG_HOME=/tmp
    export TRITON_CACHE_DIR=/tmp
    python3 -c "import torch; print(f'PyTorch {torch.__version__}')"
    python3 -c "import prody; print('ProDy available')"
    echo "Build tests completed successfully"

%labels
    Author BioModStack
    Version 1.0
    Description "Container for NA-MPNN nucleic acid sequence design with torch.compile support"

%help
    Container for running NA-MPNN (Nucleic Acid MPNN) sequence design.
    Built with the PyTorch 2.15.0 CUDA 13.4 release for RTX 5090 (sm_120) support.
    
    Usage:
      apptainer run --nv nampnn.sif python inference/run.py \
        --model_type "na_mpnn" \
        --mode "design" \
        --pdb_path input.pdb \
        --out_folder output/
    
    Execute with GPU support using: apptainer run --nv nampnn.sif
