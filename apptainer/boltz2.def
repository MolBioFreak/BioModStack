# Build stage - install dependencies and compile
Bootstrap: docker
Stage: build
From: nvcr.io/nvidia/cuda:12.1.1-cudnn8-devel-ubuntu22.04

%post
    # install build deps
    apt-get -q update
    DEBIAN_FRONTEND=noninteractive apt-get install --no-install-recommends -y \
        git \
        wget \
        python3.10 \
        python3-venv \
        python3-pip \
        build-essential

    # create and activate virtual environment
    python3.10 -m venv /opt/venv
    . /opt/venv/bin/activate

    # install PyTorch with RTX 5090 support (compute capability 12.0) first
    pip install --no-cache-dir torch==2.4.1 torchvision torchaudio --index-url https://download.pytorch.org/whl/cu121

    # install boltz
    git clone https://github.com/jwohlwend/boltz.git && cd /boltz && git checkout aaef502
    pip install --no-cache-dir .

    # cleanup build dependencies
    apt-get autoremove -y
    apt-get clean
    
    # link venv
    echo '. /opt/venv/bin/activate' >> $APPTAINER_ENVIRONMENT
    
%runscript
    cd /boltz
    if [ $# -eq 0 ]; then
        exec /bin/bash --norc
    else
        exec "$@"
    fi

%test
    . /opt/venv/bin/activate
    cd /boltz
    export NUMBA_CACHE_DIR=/tmp
    export XDG_CONFIG_HOME=/tmp
    export TRITON_CACHE_DIR=/tmp
    boltz --help
    echo "Build tests completed sucessfully"

%help
    Boltz container with CUDA 12.8 runtime
