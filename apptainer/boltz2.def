# Build stage - install dependencies and compile
Bootstrap: docker
Stage: build
From: nvcr.io/nvidia/cuda:12.8.0-cudnn-devel-ubuntu22.04

%post
    # install build deps
    apt-get -q update
    DEBIAN_FRONTEND=noninteractive apt-get install --no-install-recommends -y \
        git \
        wget \
        curl \
        python3.10 \
        python3.10-dev \
        python3-venv \
        python3-pip \
        build-essential

    # Install UV package manager (10-100x faster than pip)
    curl -LsSf https://astral.sh/uv/install.sh | sh
    export PATH="/root/.local/bin:$PATH"

    # create and activate virtual environment
    python3.10 -m venv /opt/venv
    . /opt/venv/bin/activate

    # install PyTorch nightly with CUDA 12.8 for RTX 5090 (sm_120) support
    # CUDA 12.8 nightly builds include sm_120 support for Blackwell architecture
    uv pip install --no-cache-dir torch torchvision torchaudio --index-url https://download.pytorch.org/whl/nightly/cu128

    # install boltz
    git clone https://github.com/jwohlwend/boltz.git && cd /boltz && git checkout aaef502
    uv pip install --no-cache-dir .

    # cleanup build dependencies but KEEP python3.10-dev (needed for Triton JIT on RTX 5090)
    apt-mark manual python3.10-dev
    apt-get autoremove -y
    apt-get clean
    
    # link venv
    echo '. /opt/venv/bin/activate' >> $APPTAINER_ENVIRONMENT
    
%runscript
    cd /boltz
    if [ $# -eq 0 ]; then
        exec /bin/bash --norc
    else
        exec "$@"
    fi

%test
    . /opt/venv/bin/activate
    cd /boltz
    export NUMBA_CACHE_DIR=/tmp
    export XDG_CONFIG_HOME=/tmp
    export TRITON_CACHE_DIR=/tmp
    boltz --help
    echo "Build tests completed sucessfully"

%help
    Boltz container with CUDA 12.8 runtime
