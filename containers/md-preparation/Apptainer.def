Bootstrap: docker
From: ubuntu:24.04

%files
    md-preparation-v1.tar.gz /opt/md-preparation-v1.tar.gz

%post
    mkdir -p /opt/md-preparation
    tar -xzf /opt/md-preparation-v1.tar.gz -C /opt/md-preparation
    /opt/md-preparation/bin/python /opt/md-preparation/bin/conda-unpack
    rm -f /opt/md-preparation-v1.tar.gz

%environment
    export PATH=/opt/md-preparation/bin:$PATH
    export AMBERHOME=/opt/md-preparation
    export PYTHONNOUSERSITE=1

%runscript
    exec /opt/md-preparation/bin/python "$@"

%test
    /opt/md-preparation/bin/python - <<'PY'
import openmm, parmed
assert openmm.__version__ == '8.3.1'
assert parmed.__version__ == '4.3.0'
PY
    /opt/md-preparation/bin/tleap -h >/dev/null 2>&1 || test $? -eq 1
    /opt/md-preparation/bin/gmx --version | grep -F 'GROMACS version:     2025.3'

%labels
    org.opencontainers.image.title "BioModStack MD preparation runtime"
    org.opencontainers.image.version "1"
    org.biomodstack.runtime.id "md-preparation-v1"
    org.biomodstack.runtime.lock.sha256 "9ef655773364c6ca18378e5a3e0d34c69eef403c1b79d8e6dc2fb1ffe823be65"
