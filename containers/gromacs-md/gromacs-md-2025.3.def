Bootstrap: docker
From: nvcr.io/nvidia/gromacs@sha256:8ee1822b8a34ace738e000a6c9cf8bc9a8abdbbf49e84506238a427b89ee6daf

%labels
    org.opencontainers.image.title "BioModStack GROMACS MD runtime"
    org.opencontainers.image.version "2025.3"
    org.opencontainers.image.base.name "nvcr.io/nvidia/gromacs@sha256:8ee1822b8a34ace738e000a6c9cf8bc9a8abdbbf49e84506238a427b89ee6daf"
    org.biomodstack.gromacs.variant "avx2_256"

%environment
    export PATH="/usr/local/gromacs/avx2_256/bin:${PATH}"

%test
    command -v gmx
    command -v python3
    gmx mdrun -version
