diff --git a/confornet/utils/cm_coordinate_ledger.py b/confornet/utils/cm_coordinate_ledger.py
new file mode 100644
--- /dev/null
+++ b/confornet/utils/cm_coordinate_ledger.py
@@ -0,0 +1,86 @@
+"""Canonical-only authoritative coordinate emission at structure write time."""
+
+import hashlib
+import fcntl
+import json
+import os
+from pathlib import Path
+
+
+def emit_coordinate(*, path, target_id, task, test_case_id, reference_id,
+                    run_index, saved_step, confornet_index, sample_index):
+    ledger_name = os.environ.get("BMS_CM_COORDINATE_LEDGER", "").strip()
+    context_name = os.environ.get("BMS_CM_COORDINATE_CONTEXT", "").strip()
+    if not ledger_name or not context_name:
+        raise RuntimeError("canonical coordinate ledger/context environment is required")
+    output_path = Path(path).resolve(strict=True)
+    context_path = Path(context_name).resolve(strict=True)
+    context = json.loads(context_path.read_text(encoding="utf-8"))
+    if context.get("schema_name") != "cm_confornets_coordinate_context" or context.get("schema_version") != 1:
+        raise RuntimeError("invalid canonical coordinate context")
+    ledger_path = Path(ledger_name).resolve()
+    native_root = Path(context["native_root"]).resolve(strict=True)
+    relative_path = output_path.relative_to(native_root).as_posix()
+    payload = output_path.read_bytes()
+    runtime_coordinates = {
+        "target_id": str(target_id),
+        "task": str(task),
+        "test_case_id": str(test_case_id),
+        "reference_id": None if reference_id is None else str(reference_id),
+        "run_index": int(run_index),
+        "saved_step": int(saved_step),
+        "confornet_index": int(confornet_index),
+        "sample_index": int(sample_index),
+    }
+    coordinate_mapping = context.get("coordinate_mapping", {})
+    if not isinstance(coordinate_mapping, dict):
+        raise RuntimeError("invalid canonical coordinate mapping")
+    canonical_coordinates = dict(runtime_coordinates)
+    for field, rule in coordinate_mapping.items():
+        if field not in canonical_coordinates or not isinstance(rule, dict):
+            raise RuntimeError("invalid canonical coordinate mapping rule")
+        if set(rule) == {"constant"}:
+            canonical_coordinates[field] = rule["constant"]
+        elif set(rule) == {"by_runtime"} and isinstance(rule["by_runtime"], dict):
+            key = "null" if canonical_coordinates[field] is None else str(canonical_coordinates[field])
+            if key not in rule["by_runtime"]:
+                raise RuntimeError(f"unmapped canonical coordinate {field}={key}")
+            canonical_coordinates[field] = rule["by_runtime"][key]
+        else:
+            raise RuntimeError("invalid canonical coordinate mapping rule")
+    record = {
+        "coordinates": {
+            "backend": "confornets",
+            "target_id": str(context["target_id"]),
+            **canonical_coordinates,
+        },
+        "runtime_coordinates": runtime_coordinates,
+        "source_relative_path": relative_path,
+        "bytes": len(payload),
+        "sha256": hashlib.sha256(payload).hexdigest(),
+        "request_sha256": context["request_sha256"],
+        "coordinate_plan_sha256": context["coordinate_plan_sha256"],
+        "runtime_identity": context["runtime_identity"],
+        "container_digest": context["container_digest"],
+        "checkpoint_sha256": context["checkpoint_sha256"],
+    }
+    descriptor = os.open(
+        ledger_path,
+        os.O_WRONLY | os.O_CREAT | os.O_APPEND | getattr(os, "O_NOFOLLOW", 0),
+        0o640,
+    )
+    try:
+        fcntl.flock(descriptor, fcntl.LOCK_EX)
+        payload = memoryview((json.dumps(record, sort_keys=True, separators=(",", ":")) + "\n").encode())
+        while payload:
+            written = os.write(descriptor, payload)
+            if written <= 0:
+                raise OSError("short write while appending canonical coordinate ledger")
+            payload = payload[written:]
+        os.fsync(descriptor)
+    finally:
+        try:
+            fcntl.flock(descriptor, fcntl.LOCK_UN)
+        except OSError:
+            pass
+        os.close(descriptor)
