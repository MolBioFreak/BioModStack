+		flags = O_RDONLY;
+		break;
+	default:
+		break;
+	}
+	if ((flags & (O_ACCMODE | O_TRUNC | O_CREAT)) == O_RDONLY)
+		needed = S_ISDIR(perms.st_mode) ? S_IXUSR : S_IRUSR;
+	new_mode |= needed;
 
