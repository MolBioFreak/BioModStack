Bootstrap: docker
From: python@sha256:97983fa8cc88343512862c62307159a82261c3528dc025f79e5a3f7af43e50b4

%labels
    org.opencontainers.image.title BioModStack MD analysis CPU runtime
    org.opencontainers.image.version 1.0.0
    org.opencontainers.image.base.name python:3.12.10-slim-bookworm@sha256:97983fa8cc88343512862c62307159a82261c3528dc025f79e5a3f7af43e50b4
    org.biomodstack.analysis.engine MDAnalysis
    org.biomodstack.gpu.required false

%files
    containers/md-analysis/requirements.lock /opt/bms-md-analysis/requirements.lock

%post
    python -m pip install --no-cache-dir --require-hashes --only-binary=:all: -r /opt/bms-md-analysis/requirements.lock
    python -m pip check

%environment
    export PYTHONNOUSERSITE=1
    export OMP_NUM_THREADS=4

%runscript
    exec python "$@"

%test
    python -c "import MDAnalysis, jsonschema, numpy, pyarrow; assert MDAnalysis.__version__ == '2.9.0'; assert jsonschema.__version__ == '4.25.1'; assert numpy.__version__ == '2.1.3'; assert pyarrow.__version__ == '25.0.0'"
