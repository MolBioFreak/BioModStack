#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
api_root="$repo_root/platform/api"
python_bin="${BMS_API_PYTHON:-$api_root/.venv/bin/python}"
if [[ ! -x "$python_bin" ]]; then
  python_bin="python"
fi

usage() {
  cat <<'EOF'
Usage:
  bms api-image preflight
  bms api-image plan
EOF
}

load_env_file_overrides() {
  local env_file="$1"
  [[ -f "$env_file" ]] || return 0
  while IFS= read -r line || [[ -n "$line" ]]; do
    case "$line" in
      ''|'#'*) continue ;;
    esac
    local key="${line%%=*}"
    local value="${line#*=}"
    if [[ -z "$key" || "$key" == "$line" ]]; then
      continue
    fi
    export "$key=$value"
  done < "$env_file"
}

profile_env_file="${XDG_CONFIG_HOME:-$HOME/.config}/biomodstack/core-runtime.env"
legacy_env_file="$repo_root/.env.core-runtime.local"
core_env_file="${BMS_CORE_RUNTIME_ENV_FILE:-$profile_env_file}"
if [[ -f "$core_env_file" ]]; then
  load_env_file_overrides "$core_env_file"
elif [[ -f "$legacy_env_file" ]]; then
  load_env_file_overrides "$legacy_env_file"
fi

export BMS_DOCKER_COMPOSE_PROJECT="${BMS_DOCKER_COMPOSE_PROJECT:-${COMPOSE_PROJECT_NAME:-biomodstack-core-runtime}}"

tool="${1:-}"
action="${2:-}"
if [[ "$tool" != "api-image" || "$action" != "preflight" && "$action" != "plan" || $# -ne 2 ]]; then
  usage >&2
  exit 2
fi

PYTHONPATH="$api_root" \
  "$python_bin" "$repo_root/scripts/bms_api_image_proof.py" "$action"
