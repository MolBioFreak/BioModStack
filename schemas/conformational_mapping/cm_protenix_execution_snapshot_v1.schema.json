{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://biomodstack.org/schemas/conformational_mapping/cm_protenix_execution_snapshot_v1.schema.json",
  "title": "BioModStack Protenix execution snapshot receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_name", "schema_version", "status", "checkpoint", "wrapper"],
  "properties": {
    "schema_name": {"const": "cm_protenix_execution_snapshot"},
    "schema_version": {"const": 1},
    "status": {"const": "verified_before_execution"},
    "checkpoint": {"$ref": "#/$defs/file_receipt"},
    "wrapper": {"$ref": "#/$defs/file_receipt"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "relative_path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\)(?!.*\\/$).+$"},
    "identity": {
      "type": "object", "additionalProperties": false,
      "required": ["device", "inode", "mode", "size", "mtime_ns", "sha256", "bytes"],
      "properties": {
        "device": {"type": "integer", "minimum": 0}, "inode": {"type": "integer", "minimum": 0},
        "mode": {"type": "integer", "minimum": 0}, "size": {"type": "integer", "minimum": 0},
        "mtime_ns": {"type": "integer", "minimum": 0}, "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 0}
      }
    },
    "snapshot": {
      "type": "object", "additionalProperties": false,
      "required": ["sha256", "bytes", "mode"],
      "properties": {
        "sha256": {"$ref": "#/$defs/sha256"}, "bytes": {"type": "integer", "minimum": 0},
        "mode": {"type": "integer", "minimum": 0}
      }
    },
    "file_receipt": {
      "type": "object", "additionalProperties": false,
      "required": ["source_path", "snapshot_path", "expected_sha256", "observed_source", "verified_snapshot"],
      "properties": {
        "source_path": {"$ref": "#/$defs/relative_path"}, "snapshot_path": {"$ref": "#/$defs/relative_path"},
        "expected_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "observed_source": {"$ref": "#/$defs/identity"}, "verified_snapshot": {"$ref": "#/$defs/snapshot"}
      }
    }
  }
}
