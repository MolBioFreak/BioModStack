{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://biomodstack.org/schemas/conformational_mapping/cm_structure_map_v1.schema.json",
  "title": "BioModStack conformational mapping structure map v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_name", "schema_version", "target_id", "candidate_id", "original_cif_sha256", "source_format", "source_sha256", "source_bytes", "normalized_pdb_sha256", "selected_source_model", "altloc_policy", "normalizer_version", "rows"],
  "properties": {
    "schema_name": {"const": "cm_structure_map"}, "schema_version": {"const": 1},
    "target_id": {"type": "string", "minLength": 1}, "candidate_id": {"type": "string", "minLength": 1}, "original_cif_sha256": {"$ref": "#/$defs/sha256"},
    "source_format": {"enum": ["mmcif", "pdb"]}, "source_sha256": {"$ref": "#/$defs/sha256"}, "source_bytes": {"type": "integer", "minimum": 0},
    "normalized_pdb_sha256": {"$ref": "#/$defs/sha256"}, "selected_source_model": {"type": "integer", "minimum": 1},
    "altloc_policy": {"type": "string", "minLength": 1}, "normalizer_version": {"type": "string", "minLength": 1},
    "rows": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/row"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "backbone_atoms": {
      "type": "object", "additionalProperties": false, "required": ["N", "CA", "C", "O"],
      "properties": {"N": {"type": ["string", "null"]}, "CA": {"type": ["string", "null"]}, "C": {"type": ["string", "null"]}, "O": {"type": ["string", "null"]}}
    },
    "row": {
      "type": "object", "additionalProperties": false,
      "required": ["entity_instance_id", "source_entity_id", "source_model", "label_asym_id", "auth_asym_id", "label_seq_id", "auth_seq_id", "insertion_code", "residue_name", "sequence_index", "pdb_chain_id", "pdb_residue_id", "pdb_insertion_code", "backbone_atoms", "selected_altloc", "model_decision", "status", "reason"],
      "properties": {
        "entity_instance_id": {"type": "string", "minLength": 1}, "source_model": {"type": "integer", "minimum": 1},
        "source_entity_id": {"type": "string", "minLength": 1},
        "label_asym_id": {"type": "string", "minLength": 1}, "auth_asym_id": {"type": "string", "minLength": 1},
        "label_seq_id": {"type": "integer", "minimum": 1}, "auth_seq_id": {"type": "integer"}, "insertion_code": {"type": "string", "maxLength": 1},
        "residue_name": {"type": "string", "minLength": 1}, "sequence_index": {"type": "integer", "minimum": 1},
        "pdb_chain_id": {"type": "string", "minLength": 1, "maxLength": 1}, "pdb_residue_id": {"type": "integer", "minimum": -999, "maximum": 9999}, "pdb_insertion_code": {"type": "string", "maxLength": 1},
        "backbone_atoms": {"$ref": "#/$defs/backbone_atoms"}, "selected_altloc": {"type": "string", "maxLength": 1}, "model_decision": {"type": "string", "minLength": 1},
        "status": {"enum": ["mapped", "missing_backbone", "nonstandard_residue", "mapping_failed"]}, "reason": {"type": ["string", "null"]}
      }
    }
  }
}
