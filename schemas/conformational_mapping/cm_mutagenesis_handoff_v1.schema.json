{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://biomodstack.org/schemas/conformational_mapping/cm_mutagenesis_handoff_v1.schema.json",
  "title": "BioModStack conformational mapping mutagenesis handoff v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_name", "schema_version", "source_ensemble_sha256", "source_analysis_sha256", "source_complex_sha256", "source_structure_map_sha256", "target_id", "entity_instance_id", "auth_asym_id", "auth_seq_id", "insertion_code", "sequence_index", "validated_wt", "substitution", "mutation_set_id", "mutation_set_string", "evidence_row_keys", "support", "missingness", "ranking_components", "warnings", "feature_policy", "resampling_settings", "adapter_version", "idempotency_key"],
  "properties": {
    "schema_name": {"const": "cm_mutagenesis_handoff"}, "schema_version": {"const": 1},
    "source_ensemble_sha256": {"$ref": "#/$defs/sha256"}, "source_analysis_sha256": {"$ref": "#/$defs/sha256"}, "source_complex_sha256": {"$ref": "#/$defs/sha256"}, "source_structure_map_sha256": {"$ref": "#/$defs/sha256"},
    "target_id": {"type": "string", "minLength": 1}, "entity_instance_id": {"type": "string", "minLength": 1}, "auth_asym_id": {"type": "string", "minLength": 1},
    "auth_seq_id": {"type": "integer"}, "insertion_code": {"type": "string", "maxLength": 1}, "sequence_index": {"type": "integer", "minimum": 1},
    "validated_wt": {"$ref": "#/$defs/aa"}, "substitution": {"$ref": "#/$defs/aa"}, "mutation_set_id": {"type": "string", "minLength": 1}, "mutation_set_string": {"type": "string", "minLength": 1},
    "evidence_row_keys": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "support": {"$ref": "#/$defs/support"}, "missingness": {"type": "array", "items": {"type": "string"}},
    "ranking_components": {"type": "object"},
    "warnings": {"type": "array", "items": {"type": "string"}}, "feature_policy": {"$ref": "#/$defs/feature_policy"},
    "resampling_settings": {"type": "object", "minProperties": 1, "additionalProperties": {"type": ["string", "number", "integer", "boolean", "array", "object", "null"]}},
    "adapter_version": {"type": "string", "minLength": 1}, "idempotency_key": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "aa": {"type": "string", "enum": ["A", "C", "D", "E", "F", "G", "H", "I", "K", "L", "M", "N", "P", "Q", "R", "S", "T", "V", "W", "Y"]},
    "support": {
      "type": "object", "additionalProperties": false, "required": ["outer", "coordinate"],
      "properties": {"outer": {"type": "number", "minimum": 0, "maximum": 1}, "coordinate": {"type": "number", "minimum": 0, "maximum": 1}}
    },
    "feature_policy": {
      "type": "object", "additionalProperties": false, "required": ["mode"],
      "properties": {
        "mode": {"enum": ["regenerate_mutated_protein_v1", "paired_regenerate_changed_protein_v1", "features_disabled_control_v1"]},
        "per_entity_hashes": {"type": "object", "additionalProperties": {"$ref": "#/$defs/sha256"}},
        "protein_msa_enabled": {"type": "boolean"}, "templates_enabled": {"type": "boolean"}, "rna_msa_enabled": {"type": "boolean"}
      }
    }
  }
}
