{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://biomodstack.org/schemas/conformational_mapping/cm_protenix_runtime_attestation_v1.schema.json",
  "title": "BioModStack observed Protenix runtime attestation v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_name", "schema_version", "status", "runtime_image", "execution_snapshot", "checkpoint", "backend_source", "executed_wrapper", "backend_version", "backend_commit", "runtime_identity", "container_digest", "checkpoint_sha256", "model_id", "started_at", "completed_at", "command", "global_artifacts", "attestation_sha256"],
  "properties": {
    "schema_name": {"const": "cm_protenix_runtime_attestation"}, "schema_version": {"const": 1},
    "status": {"const": "observed_and_verified"},
    "runtime_image": {"$ref": "#/$defs/runtime_image"},
    "execution_snapshot": {"$ref": "#/$defs/execution_snapshot"},
    "checkpoint": {"type": "object", "additionalProperties": false, "required": ["sha256", "bytes", "relative_path"], "properties": {"sha256": {"$ref": "#/$defs/sha256"}, "bytes": {"type": "integer", "minimum": 0}, "relative_path": {"$ref": "#/$defs/relative_path"}}},
    "backend_source": {"$ref": "#/$defs/backend_source"},
    "executed_wrapper": {"type": "object", "additionalProperties": false, "required": ["relative_path", "sha256", "bytes"], "properties": {"relative_path": {"$ref": "#/$defs/relative_path"}, "sha256": {"$ref": "#/$defs/sha256"}, "bytes": {"type": "integer", "minimum": 0}}},
    "backend_version": {"type": "string", "minLength": 1}, "backend_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "runtime_identity": {"type": "string", "minLength": 1}, "container_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "checkpoint_sha256": {"$ref": "#/$defs/sha256"}, "model_id": {"type": "string", "minLength": 1},
    "started_at": {"type": "string", "format": "date-time"}, "completed_at": {"type": "string", "format": "date-time"},
    "command": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "global_artifacts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/global_artifact"}},
    "attestation_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "relative_path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\)(?!.*\\/$).+$"},
    "observed_source": {"type": "object", "additionalProperties": true, "required": ["sha256"], "properties": {"sha256": {"$ref": "#/$defs/sha256"}}},
    "verified_snapshot": {"type": "object", "additionalProperties": true, "required": ["sha256", "bytes"], "properties": {"sha256": {"$ref": "#/$defs/sha256"}, "bytes": {"type": "integer", "minimum": 0}}},
    "runtime_image": {
      "type": "object", "additionalProperties": false, "required": ["sha256", "bytes", "measurement", "host_observed_source", "host_verified_snapshot", "receipt"],
      "properties": {
        "sha256": {"$ref": "#/$defs/sha256"}, "bytes": {"type": "integer", "minimum": 0}, "measurement": {"type": "string", "minLength": 1},
        "host_observed_source": {"$ref": "#/$defs/observed_source"}, "host_verified_snapshot": {"$ref": "#/$defs/verified_snapshot"},
        "receipt": {"type": "object", "additionalProperties": false, "required": ["schema_name", "schema_version", "status", "sha256", "bytes"], "properties": {"schema_name": {"const": "cm_runtime_image_receipt"}, "schema_version": {"const": 1}, "status": {"const": "verified_immutable_snapshot"}, "sha256": {"$ref": "#/$defs/sha256"}, "bytes": {"type": "integer", "minimum": 0}}}
      }
    },
    "execution_snapshot": {
      "type": "object", "additionalProperties": false, "required": ["receipt", "sha256", "bytes"],
      "properties": {
        "receipt": {"$ref": "#/$defs/execution_receipt"}, "sha256": {"$ref": "#/$defs/sha256"}, "bytes": {"type": "integer", "minimum": 0}
      }
    },
    "execution_file": {
      "type": "object", "additionalProperties": false, "required": ["source_path", "snapshot_path", "expected_sha256", "observed_source", "verified_snapshot"],
      "properties": {
        "source_path": {"$ref": "#/$defs/relative_path"}, "snapshot_path": {"$ref": "#/$defs/relative_path"}, "expected_sha256": {"type": ["string", "null"]},
        "observed_source": {"type": "object", "additionalProperties": true, "required": ["sha256", "bytes"], "properties": {"sha256": {"$ref": "#/$defs/sha256"}, "bytes": {"type": "integer", "minimum": 0}}},
        "verified_snapshot": {"$ref": "#/$defs/verified_snapshot"}
      }
    },
    "execution_receipt": {"type": "object", "additionalProperties": false, "required": ["schema_name", "schema_version", "status", "checkpoint", "wrapper"], "properties": {"schema_name": {"const": "cm_protenix_execution_snapshot"}, "schema_version": {"const": 1}, "status": {"const": "verified_before_execution"}, "checkpoint": {"$ref": "#/$defs/execution_file"}, "wrapper": {"$ref": "#/$defs/execution_file"}}},
    "backend_source": {
      "type": "object", "additionalProperties": false, "required": ["distribution", "distribution_version", "commit", "measurement", "manifest_sha256", "files"],
      "properties": {"distribution": {"const": "protenix"}, "distribution_version": {"type": "string", "minLength": 1}, "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "measurement": {"type": "string", "minLength": 1}, "manifest_sha256": {"$ref": "#/$defs/sha256"}, "files": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["relative_path", "sha256", "bytes"], "properties": {"relative_path": {"$ref": "#/$defs/relative_path"}, "sha256": {"$ref": "#/$defs/sha256"}, "bytes": {"type": "integer", "minimum": 0}}}}}
    },
    "global_artifact": {"type": "object", "additionalProperties": false, "required": ["semantic_role", "relative_path"], "properties": {"semantic_role": {"type": "string", "minLength": 1}, "relative_path": {"$ref": "#/$defs/relative_path"}}}
  }
}
