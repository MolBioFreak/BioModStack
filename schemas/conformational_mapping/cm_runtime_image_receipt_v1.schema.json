{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://biomodstack.org/schemas/conformational_mapping/cm_runtime_image_receipt_v1.schema.json",
  "title": "BioModStack runtime image receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_name", "schema_version", "status", "measurement_method", "expected_sha256", "observed_source", "verified_snapshot"],
  "properties": {
    "schema_name": {"const": "cm_runtime_image_receipt"},
    "schema_version": {"const": 1},
    "status": {"const": "verified_immutable_snapshot"},
    "measurement_method": {"type": "string", "minLength": 1},
    "expected_sha256": {"$ref": "#/$defs/sha256"},
    "observed_source": {"$ref": "#/$defs/observed_source"},
    "verified_snapshot": {"$ref": "#/$defs/verified_snapshot"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "observed_source": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "device", "inode", "bytes", "mtime_ns", "ctime_ns", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1}, "device": {"type": "integer", "minimum": 0},
        "inode": {"type": "integer", "minimum": 0}, "bytes": {"type": "integer", "minimum": 0},
        "mtime_ns": {"type": "integer", "minimum": 0}, "ctime_ns": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "verified_snapshot": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "bytes", "sha256"],
      "properties": {
        "name": {"type": "string", "minLength": 1}, "bytes": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
