{
  "$id": "bms.ngs-molbio.event-registry.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "baseline_source_commit": {
      "const": "d2fc413d6d0224fe9fbecb1cb1797e0456ca1517"
    },
    "content_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "entries": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "attestation": {
            "enum": [
              "required_contract_only",
              "exact_same_domain_native_authority"
            ]
          },
          "baseline_state": {
            "enum": [
              "missing",
              "partial",
              "present"
            ]
          },
          "event_stream_template": {
            "maxLength": 255,
            "minLength": 1,
            "type": "string"
          },
          "event_type": {
            "maxLength": 255,
            "minLength": 1,
            "type": "string"
          },
          "implementation_owner": {
            "anyOf": [
              {
                "maxLength": 512,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "payload_schema_id": {
            "maxLength": 255,
            "minLength": 1,
            "type": "string"
          },
          "payload_schema_sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "required_contract_state": {
            "const": "frozen"
          },
          "source_generation_derivation": {
            "maxLength": 255,
            "minLength": 1,
            "type": "string"
          },
          "state_revision_id_derivation": {
            "maxLength": 255,
            "minLength": 1,
            "type": "string"
          },
          "stream_generation_owner": {
            "const": "domain_store_transaction"
          }
        },
        "required": [
          "event_type",
          "payload_schema_id",
          "payload_schema_sha256",
          "event_stream_template",
          "source_generation_derivation",
          "stream_generation_owner",
          "attestation",
          "state_revision_id_derivation",
          "required_contract_state",
          "baseline_state",
          "implementation_owner"
        ],
        "type": "object"
      },
      "maxItems": 12,
      "minItems": 12,
      "type": "array"
    },
    "schema": {
      "const": "bms.ngs-molbio.event-registry.v1"
    }
  },
  "required": [
    "schema",
    "baseline_source_commit",
    "entries",
    "content_sha256"
  ],
  "type": "object"
}
