{
  "$id": "bms.ngs-molbio.event-registry.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "baseline_source_commit": {
      "const": "74d49997c4eaf54c28e5521b7e0ebf14eaaf3365"
    },
    "content_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "entries": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "attestation": {
            "const": "exact_same_domain_native_authority"
          },
          "event_stream_template": {
            "maxLength": 255,
            "minLength": 1,
            "type": "string"
          },
          "event_type": {
            "maxLength": 255,
            "minLength": 1,
            "type": "string"
          },
          "payload_schema_id": {
            "maxLength": 255,
            "minLength": 1,
            "type": "string"
          },
          "payload_schema_sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "source_generation_derivation": {
            "maxLength": 255,
            "minLength": 1,
            "type": "string"
          },
          "stream_generation_owner": {
            "const": "domain_store_transaction"
          }
        },
        "required": [
          "event_type",
          "payload_schema_id",
          "payload_schema_sha256",
          "event_stream_template",
          "source_generation_derivation",
          "stream_generation_owner",
          "attestation"
        ],
        "type": "object"
      },
      "maxItems": 256,
      "minItems": 9,
      "type": "array"
    },
    "schema": {
      "const": "bms.ngs-molbio.event-registry.v1"
    }
  },
  "required": [
    "schema",
    "baseline_source_commit",
    "entries",
    "content_sha256"
  ],
  "type": "object"
}
