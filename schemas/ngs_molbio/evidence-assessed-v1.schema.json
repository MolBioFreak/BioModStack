{
  "$id": "bms.molbio-ngs.evidence-assessed.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "evidence_id": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "schema": {
      "const": "bms.molbio-ngs.evidence-assessed.v1"
    },
    "scientific_assessment": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "wrapper_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "required": [
    "schema",
    "evidence_id",
    "wrapper_sha256",
    "scientific_assessment"
  ],
  "type": "object"
}
