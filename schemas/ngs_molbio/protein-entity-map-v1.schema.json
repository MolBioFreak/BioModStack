{
  "$id": "bms.protein-entity-map.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "entities": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "auth_asym_id": {
            "maxLength": 32,
            "minLength": 1,
            "type": "string"
          },
          "entity_instance_id": {
            "maxLength": 255,
            "minLength": 1,
            "type": "string"
          },
          "entity_type": {
            "enum": [
              "protein",
              "dna",
              "rna",
              "ligand",
              "ion",
              "other"
            ]
          },
          "label_asym_id": {
            "maxLength": 32,
            "minLength": 1,
            "type": "string"
          },
          "residue_mappings": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "auth_seq_id": {
                  "type": "integer"
                },
                "insertion_code": {
                  "maxLength": 1,
                  "minLength": 0,
                  "type": "string"
                },
                "label_seq_id": {
                  "minimum": 1,
                  "type": "integer"
                }
              },
              "required": [
                "auth_seq_id",
                "insertion_code",
                "label_seq_id"
              ],
              "type": "object"
            },
            "maxItems": 1000000,
            "type": "array",
            "x-bms-unique-by": [
              "auth_seq_id",
              "insertion_code"
            ],
            "x-bms-unique-field": "label_seq_id"
          },
          "sequence": {
            "anyOf": [
              {
                "maxLength": 1000000,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "source_entity_id": {
            "maxLength": 255,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "entity_type",
          "entity_instance_id",
          "source_entity_id",
          "label_asym_id",
          "auth_asym_id",
          "sequence",
          "residue_mappings"
        ],
        "type": "object"
      },
      "maxItems": 256,
      "minItems": 1,
      "type": "array",
      "x-bms-unique-by": [
        "entity_instance_id"
      ]
    }
  },
  "required": [
    "entities"
  ],
  "type": "object"
}
