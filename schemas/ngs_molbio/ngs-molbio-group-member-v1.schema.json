{
  "$id": "bms.ngs-molbio.group-member.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "member_kind": {
      "enum": [
        "receipt",
        "dataset_revision"
      ]
    },
    "ordinal": {
      "maximum": 65535,
      "minimum": 0,
      "type": "integer"
    },
    "resource_id": {
      "maxLength": 255,
      "minLength": 1,
      "type": "string"
    },
    "role": {
      "enum": [
        "input",
        "sample",
        "reference",
        "target",
        "panel",
        "control",
        "comparison"
      ]
    }
  },
  "required": [
    "member_kind",
    "resource_id",
    "role",
    "ordinal"
  ],
  "type": "object"
}
