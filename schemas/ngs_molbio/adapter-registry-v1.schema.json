{
  "$id": "bms.ngs-molbio.adapter-registry.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "baseline_source_commit": {
      "const": "d2fc413d6d0224fe9fbecb1cb1797e0456ca1517"
    },
    "binding_adapter": {
      "additionalProperties": false,
      "properties": {
        "adapter_id": {
          "const": "bms.ngs-molbio.domain-binding.adapter.v1"
        },
        "adapter_version": {
          "const": "1"
        },
        "baseline_state": {
          "const": "missing"
        },
        "binding_receipt_schema_id": {
          "const": "bms.ngs-molbio.global-binding-receipt.v1"
        },
        "implementation_owner": {
          "type": "null"
        }
      },
      "required": [
        "adapter_id",
        "adapter_version",
        "binding_receipt_schema_id",
        "baseline_state",
        "implementation_owner"
      ],
      "type": "object"
    },
    "content_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "entries": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "adapter_id": {
            "maxLength": 255,
            "minLength": 1,
            "type": "string"
          },
          "adapter_version": {
            "const": 1,
            "type": "integer"
          },
          "allowed_dataset_roles": {
            "items": {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 64,
            "type": "array",
            "uniqueItems": true
          },
          "allowed_local_roles": {
            "items": {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 64,
            "type": "array",
            "uniqueItems": true
          },
          "baseline_state": {
            "enum": [
              "missing",
              "present",
              "partial"
            ]
          },
          "contract_class": {
            "enum": [
              "local_member_adapter",
              "direct_native_adapter"
            ]
          },
          "digest_contract": {
            "additionalProperties": false,
            "properties": {
              "algorithm": {
                "const": "sha256"
              },
              "scope": {
                "maxLength": 512,
                "minLength": 1,
                "type": "string"
              },
              "serialization": {
                "enum": [
                  "exact_bytes",
                  "rfc8785_canonical_json",
                  "canonical_domain_bytes"
                ]
              },
              "source_fields": {
                "items": {
                  "maxLength": 128,
                  "minLength": 1,
                  "type": "string"
                },
                "maxItems": 16,
                "minItems": 1,
                "type": "array",
                "uniqueItems": true
              }
            },
            "required": [
              "algorithm",
              "serialization",
              "source_fields",
              "scope"
            ],
            "type": "object"
          },
          "entity_kind": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "identity_contract": {
            "additionalProperties": false,
            "properties": {
              "binding_fields": {
                "items": {
                  "maxLength": 128,
                  "minLength": 1,
                  "type": "string"
                },
                "maxItems": 8,
                "type": "array",
                "uniqueItems": true
              },
              "fixed_revision_marker": {
                "anyOf": [
                  {
                    "maxLength": 64,
                    "minLength": 1,
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "generation_fields": {
                "items": {
                  "maxLength": 128,
                  "minLength": 1,
                  "type": "string"
                },
                "maxItems": 8,
                "type": "array",
                "uniqueItems": true
              },
              "key_fields": {
                "items": {
                  "maxLength": 128,
                  "minLength": 1,
                  "type": "string"
                },
                "maxItems": 16,
                "minItems": 1,
                "type": "array",
                "uniqueItems": true
              },
              "revision_fields": {
                "items": {
                  "maxLength": 128,
                  "minLength": 1,
                  "type": "string"
                },
                "maxItems": 8,
                "type": "array",
                "uniqueItems": true
              }
            },
            "required": [
              "key_fields",
              "revision_fields",
              "generation_fields",
              "binding_fields",
              "fixed_revision_marker"
            ],
            "type": "object"
          },
          "implementation_owner": {
            "anyOf": [
              {
                "maxLength": 255,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "reopen_contract": {
            "additionalProperties": false,
            "properties": {
              "head_resolution_forbidden": {
                "type": "boolean"
              },
              "parameter_fields": {
                "items": {
                  "maxLength": 128,
                  "minLength": 1,
                  "type": "string"
                },
                "maxItems": 16,
                "minItems": 1,
                "type": "array",
                "uniqueItems": true
              },
              "path": {
                "maxLength": 255,
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "path",
              "parameter_fields",
              "head_resolution_forbidden"
            ],
            "type": "object"
          },
          "source_contracts": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "artifact_schema_version": {
                  "anyOf": [
                    {
                      "minimum": 1,
                      "type": "integer"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "normalized_schema_id": {
                  "anyOf": [
                    {
                      "maxLength": 255,
                      "minLength": 1,
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "schema_presence": {
                  "enum": [
                    "required",
                    "absent"
                  ]
                },
                "source_schema": {
                  "maxLength": 255,
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "source_schema",
                "schema_presence",
                "artifact_schema_version",
                "normalized_schema_id"
              ],
              "type": "object"
            },
            "maxItems": 16,
            "minItems": 1,
            "type": "array"
          }
        },
        "required": [
          "adapter_id",
          "adapter_version",
          "contract_class",
          "entity_kind",
          "source_contracts",
          "identity_contract",
          "digest_contract",
          "allowed_local_roles",
          "allowed_dataset_roles",
          "reopen_contract",
          "baseline_state",
          "implementation_owner"
        ],
        "type": "object"
      },
      "maxItems": 27,
      "minItems": 27,
      "type": "array"
    },
    "schema": {
      "const": "bms.ngs-molbio.adapter-registry.v1"
    }
  },
  "required": [
    "schema",
    "baseline_source_commit",
    "binding_adapter",
    "entries",
    "content_sha256"
  ],
  "type": "object"
}
