{
  "$id": "bms.ngs-molbio.adapter-registry.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "baseline_source_commit": {
      "const": "74d49997c4eaf54c28e5521b7e0ebf14eaaf3365"
    },
    "content_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "entries": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "adapter_id": {
            "maxLength": 255,
            "minLength": 1,
            "type": "string"
          },
          "adapter_version": {
            "const": 1,
            "type": "integer"
          },
          "allowed_dataset_roles": {
            "items": {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 64,
            "type": "array",
            "uniqueItems": true
          },
          "allowed_local_roles": {
            "items": {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 64,
            "type": "array",
            "uniqueItems": true
          },
          "baseline_state": {
            "enum": [
              "missing",
              "present",
              "partial"
            ]
          },
          "contract_class": {
            "enum": [
              "local_member_adapter",
              "direct_native_adapter"
            ]
          },
          "digest_authority": {
            "maxLength": 255,
            "minLength": 1,
            "type": "string"
          },
          "entity_kind": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "implementation_owner": {
            "anyOf": [
              {
                "maxLength": 255,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "native_key_fields": {
            "items": {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 16,
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          },
          "reopen_policy": {
            "enum": [
              "exact_revision_or_generation",
              "direct_native_exact_identity"
            ]
          },
          "source_contracts": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "artifact_schema_version": {
                  "anyOf": [
                    {
                      "minimum": 1,
                      "type": "integer"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "normalized_schema_id": {
                  "anyOf": [
                    {
                      "maxLength": 255,
                      "minLength": 1,
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "schema_presence": {
                  "enum": [
                    "required",
                    "absent"
                  ]
                },
                "source_schema": {
                  "maxLength": 255,
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "source_schema",
                "schema_presence",
                "artifact_schema_version",
                "normalized_schema_id"
              ],
              "type": "object"
            },
            "maxItems": 16,
            "minItems": 1,
            "type": "array"
          }
        },
        "required": [
          "adapter_id",
          "adapter_version",
          "contract_class",
          "entity_kind",
          "source_contracts",
          "native_key_fields",
          "digest_authority",
          "allowed_local_roles",
          "allowed_dataset_roles",
          "reopen_policy",
          "baseline_state",
          "implementation_owner"
        ],
        "type": "object"
      },
      "maxItems": 128,
      "minItems": 1,
      "type": "array"
    },
    "schema": {
      "const": "bms.ngs-molbio.adapter-registry.v1"
    }
  },
  "required": [
    "schema",
    "baseline_source_commit",
    "entries",
    "content_sha256"
  ],
  "type": "object"
}
