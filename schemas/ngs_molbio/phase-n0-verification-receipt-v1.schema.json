{
  "$id": "bms.ngs-molbio.phase-n0-verification-receipt.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "baseline_commit": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "baseline_tree": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "content_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "environment": {
      "additionalProperties": false,
      "properties": {
        "git": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "platform": {
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        },
        "python": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "uv": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "python",
        "uv",
        "git",
        "platform"
      ],
      "type": "object"
    },
    "executed_at": {
      "format": "date-time",
      "type": "string"
    },
    "payload_files": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "maxLength": 512,
            "minLength": 1,
            "type": "string"
          },
          "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "size_bytes": {
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "path",
          "sha256",
          "size_bytes"
        ],
        "type": "object"
      },
      "maxItems": 256,
      "minItems": 1,
      "type": "array",
      "x-bms-unique-by": [
        "path"
      ]
    },
    "payload_fingerprint_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "result": {
      "additionalProperties": false,
      "properties": {
        "adapters": {
          "const": 27
        },
        "capabilities": {
          "const": 21
        },
        "datasets": {
          "const": 16
        },
        "events": {
          "const": 12
        },
        "n0_status": {
          "const": "static_contract_freeze_complete"
        },
        "negative_cases": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 64,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "open_contract_gates": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 32,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "plannable": {
          "const": 0
        },
        "schemas": {
          "minimum": 1,
          "type": "integer"
        },
        "verification": {
          "const": "not_run_by_operator_instruction"
        }
      },
      "required": [
        "capabilities",
        "plannable",
        "schemas",
        "adapters",
        "events",
        "datasets",
        "negative_cases",
        "verification",
        "n0_status",
        "open_contract_gates"
      ],
      "type": "object"
    },
    "schema": {
      "const": "bms.ngs-molbio.phase-n0-verification-receipt.v1"
    },
    "verification_command": {
      "items": {
        "maxLength": 2048,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 32,
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "schema",
    "baseline_commit",
    "baseline_tree",
    "payload_files",
    "payload_fingerprint_sha256",
    "verification_command",
    "executed_at",
    "environment",
    "result",
    "content_sha256"
  ],
  "type": "object"
}
