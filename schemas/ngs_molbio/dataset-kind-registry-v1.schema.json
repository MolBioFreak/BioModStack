{
  "$id": "bms.ngs-molbio.dataset-kind-registry.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "baseline_source_commit": {
      "const": "d2fc413d6d0224fe9fbecb1cb1797e0456ca1517"
    },
    "content_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "entries": {
      "items": {
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "dataset_kind": {
                  "pattern": "^ngs_molbio\\."
                }
              },
              "required": [
                "dataset_kind"
              ]
            },
            "then": {
              "properties": {
                "allowed_domain_kinds": {
                  "const": [
                    "ngs_molbio"
                  ]
                },
                "owner_contract_state": {
                  "const": "closed"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "dataset_kind": {
                  "pattern": "^protein\\."
                }
              },
              "required": [
                "dataset_kind"
              ]
            },
            "then": {
              "properties": {
                "allowed_domain_kinds": {
                  "const": [
                    "protein_in_silico"
                  ]
                },
                "owner_contract_state": {
                  "enum": [
                    "closed",
                    "unavailable"
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "owner_contract_state": {
                  "const": "closed"
                }
              },
              "required": [
                "owner_contract_state"
              ]
            },
            "then": {
              "properties": {
                "allowed_members": {
                  "minItems": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "owner_contract_state": {
                  "const": "unavailable"
                }
              },
              "required": [
                "owner_contract_state"
              ]
            },
            "then": {
              "properties": {
                "allowed_members": {
                  "maxItems": 0
                },
                "compatibility_rules": {
                  "const": [
                    "no_immutable_producer_native_member_contract"
                  ]
                },
                "enabled": {
                  "const": false
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "owner_contract_state": {
                  "const": "unavailable"
                }
              },
              "required": [
                "owner_contract_state"
              ]
            },
            "then": {
              "properties": {
                "allowed_members": {
                  "maxItems": 0
                },
                "compatibility_rules": {
                  "const": [
                    "no_immutable_producer_native_member_contract"
                  ]
                },
                "enabled": {
                  "const": false
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "owner_contract_state": {
                  "const": "unavailable"
                }
              },
              "required": [
                "owner_contract_state"
              ]
            },
            "then": {
              "properties": {
                "allowed_members": {
                  "maxItems": 0
                },
                "compatibility_rules": {
                  "const": [
                    "no_immutable_producer_native_member_contract"
                  ]
                },
                "enabled": {
                  "const": false
                }
              }
            }
          }
        ],
        "properties": {
          "allowed_domain_kinds": {
            "items": {
              "enum": [
                "ngs_molbio",
                "protein_in_silico"
              ]
            },
            "maxItems": 1,
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          },
          "allowed_members": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "adapter_id": {
                  "maxLength": 255,
                  "minLength": 1,
                  "type": "string"
                },
                "allowed_roles": {
                  "items": {
                    "maxLength": 128,
                    "minLength": 1,
                    "type": "string"
                  },
                  "maxItems": 64,
                  "minItems": 1,
                  "type": "array",
                  "uniqueItems": true
                },
                "compatibility_rule": {
                  "maxLength": 255,
                  "minLength": 1,
                  "type": "string"
                },
                "receipt_kind": {
                  "maxLength": 128,
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "receipt_kind",
                "adapter_id",
                "allowed_roles",
                "compatibility_rule"
              ],
              "type": "object"
            },
            "maxItems": 64,
            "minItems": 0,
            "type": "array"
          },
          "compatibility_rules": {
            "items": {
              "maxLength": 255,
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 32,
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          },
          "dataset_kind": {
            "maxLength": 255,
            "minLength": 1,
            "type": "string"
          },
          "enabled": {
            "type": "boolean"
          },
          "label": {
            "maxLength": 255,
            "minLength": 1,
            "type": "string"
          },
          "maximum_members": {
            "const": 10000,
            "type": "integer"
          },
          "minimum_members": {
            "const": 0,
            "type": "integer"
          },
          "owner_contract_state": {
            "enum": [
              "closed",
              "unavailable"
            ]
          }
        },
        "required": [
          "dataset_kind",
          "label",
          "allowed_domain_kinds",
          "minimum_members",
          "maximum_members",
          "allowed_members",
          "compatibility_rules",
          "enabled",
          "owner_contract_state"
        ],
        "type": "object"
      },
      "maxItems": 16,
      "minItems": 16,
      "type": "array"
    },
    "schema": {
      "const": "bms.ngs-molbio.dataset-kind-registry.v1"
    }
  },
  "required": [
    "schema",
    "baseline_source_commit",
    "entries",
    "content_sha256"
  ],
  "type": "object"
}
