{
  "$id": "bms.payload-ownership-manifest.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "classes": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "active_authority": {
            "maxLength": 1000,
            "minLength": 1,
            "type": "string"
          },
          "forbidden_global_payloads": {
            "items": {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 64,
            "type": "array",
            "uniqueItems": true
          },
          "payload_class": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "permitted_global_fields": {
            "items": {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 64,
            "type": "array",
            "uniqueItems": true
          }
        },
        "required": [
          "payload_class",
          "active_authority",
          "permitted_global_fields",
          "forbidden_global_payloads"
        ],
        "type": "object"
      },
      "maxItems": 256,
      "minItems": 4,
      "type": "array",
      "x-bms-unique-by": [
        "payload_class"
      ]
    },
    "content_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "scanner_id": {
      "const": "bms.payload-ownership-scanner.v1"
    },
    "scanner_version": {
      "const": "1"
    },
    "schema": {
      "const": "bms.payload-ownership-manifest.v1"
    }
  },
  "required": [
    "schema",
    "scanner_id",
    "scanner_version",
    "classes",
    "content_sha256"
  ],
  "title": "Payload ownership manifest v1",
  "type": "object"
}
