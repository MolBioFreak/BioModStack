{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bms.domain-experiment.v4",
  "title": "Bounded Domain Experiment revision v3",
  "type": "object",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "domain_kind": {
            "const": "ngs_molbio"
          }
        },
        "required": [
          "domain_kind"
        ]
      },
      "then": {
        "properties": {
          "domain_payload": {
            "$ref": "bms.ngs-molbio-experiment.v2"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "domain_kind": {
            "const": "protein_in_silico"
          }
        },
        "required": [
          "domain_kind"
        ]
      },
      "then": {
        "properties": {
          "domain_payload": {
            "$ref": "bms.protein-in-silico-experiment.v3"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "planned",
              "active"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "domain_payload": {
            "oneOf": [
              {
                "allOf": [
                  {
                    "$ref": "bms.ngs-molbio-experiment.v2"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "planned_capability_ids": {
                        "type": "array",
                        "minItems": 1
                      },
                      "acceptance_criteria": {
                        "type": "array",
                        "minItems": 1
                      },
                      "evidence_plan": {
                        "type": "array",
                        "minItems": 1
                      }
                    },
                    "required": [
                      "planned_capability_ids",
                      "acceptance_criteria",
                      "evidence_plan"
                    ]
                  }
                ]
              },
              {
                "allOf": [
                  {
                    "$ref": "bms.protein-in-silico-experiment.v3"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "planned_capability_ids": {
                        "type": "array",
                        "minItems": 1
                      },
                      "acceptance_criteria": {
                        "type": "array",
                        "minItems": 1
                      },
                      "evidence_plan": {
                        "type": "array",
                        "minItems": 1
                      }
                    },
                    "required": [
                      "planned_capability_ids",
                      "acceptance_criteria",
                      "evidence_plan"
                    ]
                  }
                ]
              }
            ]
          }
        }
      }
    }
  ],
  "required": [
    "schema",
    "domain_kind",
    "domain_contract_version",
    "name",
    "objective",
    "status",
    "tags",
    "source_receipt_ids",
    "dataset_revision_ids",
    "created_by",
    "change_summary",
    "domain_payload",
    "domain_payload_canonical_size_bytes",
    "canonical_size_bytes",
    "semantic_validator_id",
    "semantic_validator_contract_sha256"
  ],
  "properties": {
    "schema": {
      "const": "bms.domain-experiment.v4"
    },
    "domain_kind": {
      "enum": [
        "protein_in_silico",
        "ngs_molbio"
      ]
    },
    "domain_contract_version": {
      "const": "4"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "objective": {
      "type": "string",
      "maxLength": 8192
    },
    "status": {
      "enum": [
        "draft",
        "planned",
        "active",
        "analysis",
        "review",
        "completed",
        "blocked",
        "archived"
      ]
    },
    "tags": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      }
    },
    "source_receipt_ids": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "dataset_revision_ids": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "created_by": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "change_summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "domain_payload": {
      "oneOf": [
        {
          "$ref": "bms.ngs-molbio-experiment.v2"
        },
        {
          "$ref": "bms.protein-in-silico-experiment.v3"
        }
      ]
    },
    "domain_payload_canonical_size_bytes": {
      "type": "integer",
      "minimum": 2,
      "maximum": 786432,
      "description": "Server-derived UTF-8 byte length of RFC 8785 canonical domain_payload JSON."
    },
    "canonical_size_bytes": {
      "type": "integer",
      "minimum": 2,
      "maximum": 917504,
      "description": "Server-derived UTF-8 byte length of RFC 8785 canonical complete revision JSON with only canonical_size_bytes omitted."
    },
    "semantic_validator_id": {
      "const": "bms.project-manager.semantic-validator.v2"
    },
    "semantic_validator_contract_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
