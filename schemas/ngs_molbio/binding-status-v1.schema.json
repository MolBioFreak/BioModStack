{
  "$id": "bms.ngs-molbio.binding-status.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "acknowledgement_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "acknowledgement_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "binding_revision_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "command_state": {
      "enum": [
        "pending",
        "leased",
        "applied",
        "duplicate",
        "retryable",
        "conflicted",
        "needs_reverification"
      ]
    },
    "connector_command_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "created_at": {
      "format": "date-time",
      "type": "string"
    },
    "domain_id": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "domain_revision_id": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "global_experiment_id": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "global_experiment_revision_id": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "global_receipt_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "global_receipt_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "head_generation": {
      "minimum": 0,
      "type": "integer"
    },
    "local_state_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "project_id": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "project_revision_id": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "provisioning_state": {
      "enum": [
        "provisioning",
        "ready",
        "degraded"
      ]
    },
    "schema": {
      "const": "bms.ngs-molbio.binding-status.v1"
    },
    "updated_at": {
      "format": "date-time",
      "type": "string"
    }
  },
  "required": [
    "schema",
    "project_id",
    "project_revision_id",
    "global_experiment_id",
    "global_experiment_revision_id",
    "domain_id",
    "domain_revision_id",
    "binding_revision_id",
    "global_receipt_id",
    "global_receipt_sha256",
    "connector_command_id",
    "command_state",
    "acknowledgement_id",
    "acknowledgement_sha256",
    "local_state_id",
    "provisioning_state",
    "head_generation",
    "created_at",
    "updated_at"
  ],
  "title": "Binding status v1",
  "type": "object"
}
