{
  "$id": "bms.operation-parameters.molbio.restriction_digest.v2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "molbio.restriction_digest exact public save request v2",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "bms.molbio.restriction-digest-save-request.v1"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {"const": "molecular_revision"},
        "sequence_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "revision_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "expected_content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "topology": {
          "oneOf": [
            {"enum": ["linear", "circular"]},
            {"type": "null"}
          ]
        }
      },
      "required": ["kind", "sequence_id", "revision_id", "expected_content_sha256"]
    },
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "catalog_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "expected_catalog_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "required": ["catalog_id", "expected_catalog_sha256"]
    },
    "enzyme_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 128}
    },
    "simulation_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": ".*\\S.*"
    },
    "persistence_mode": {"enum": ["operation_only", "operation_and_fragments"]},
    "fragment_name_prefix": {
      "oneOf": [
        {"type": "string", "minLength": 1, "maxLength": 128, "pattern": ".*\\S.*"},
        {"type": "null"}
      ]
    }
  },
  "required": [
    "schema",
    "source",
    "catalog",
    "enzyme_ids",
    "simulation_sha256",
    "idempotency_key",
    "persistence_mode"
  ],
  "x-bms-authority-state": "active_exact_public_save_request",
  "x-bms-coordinate-contract": "docs/contracts/restriction-enzyme-catalog-api-v2.md",
  "x-bms-predecessor": {
    "schema_id": "bms.operation-parameters.molbio.restriction_digest.v1",
    "status": "legacy_inexact_read_compatibility_only",
    "new_writes_forbidden": true
  },
  "x-bms-browser-authority-forbidden": ["site", "cut_index", "chemistry", "recognition", "cleavage"],
  "x-bms-unknown-fields": "reject_before_route_execution"
}
