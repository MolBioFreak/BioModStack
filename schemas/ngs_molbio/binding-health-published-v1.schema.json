{
  "$id": "bms.molbio-ngs.binding-health-published.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "binding_revision_id": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "binding_revision_number": {
      "minimum": 1,
      "type": "integer"
    },
    "health_state": {
      "enum": [
        "ready",
        "degraded",
        "unavailable",
        "stale"
      ]
    },
    "observed_at": {
      "format": "date-time",
      "type": "string"
    },
    "schema": {
      "const": "bms.molbio-ngs.binding-health-published.v1"
    }
  },
  "required": [
    "schema",
    "binding_revision_id",
    "binding_revision_number",
    "health_state",
    "observed_at"
  ],
  "type": "object"
}
