{
  "$defs": {
    "AssembleTask": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "bms.golden-gate-design.v1",
          "default": "bms.golden-gate-design.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "task": {
          "const": "assemble_parts",
          "default": "assemble_parts",
          "title": "Task",
          "type": "string"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/Source"
          },
          "title": "Sources",
          "type": "array"
        },
        "parts": {
          "items": {
            "$ref": "#/$defs/Part"
          },
          "title": "Parts",
          "type": "array"
        },
        "target": {
          "$ref": "#/$defs/Target"
        },
        "enzyme": {
          "$ref": "#/$defs/EnzymeBinding"
        },
        "primer_settings": {
          "$ref": "#/$defs/Thermodynamics"
        },
        "fidelity": {
          "$ref": "#/$defs/FidelitySettings"
        },
        "domestication": {
          "items": {
            "$ref": "#/$defs/EditRequest"
          },
          "title": "Domestication",
          "type": "array"
        },
        "automatic_primers": {
          "items": {
            "$ref": "#/$defs/AutomaticPrimerSelection"
          },
          "title": "Automatic Primers",
          "type": "array"
        },
        "reaction": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReactionRequest"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "sources",
        "parts",
        "target",
        "enzyme"
      ],
      "title": "AssembleTask",
      "type": "object"
    },
    "AutomaticPrimerSelection": {
      "additionalProperties": false,
      "properties": {
        "part_id": {
          "title": "Part Id",
          "type": "string"
        },
        "settings": {
          "$ref": "#/$defs/PrimerSelectionSettings"
        },
        "pair_rank": {
          "default": 1,
          "minimum": 1,
          "title": "Pair Rank",
          "type": "integer"
        }
      },
      "required": [
        "part_id"
      ],
      "title": "AutomaticPrimerSelection",
      "type": "object"
    },
    "CDSConstraint": {
      "additionalProperties": false,
      "properties": {
        "feature_id": {
          "minLength": 1,
          "title": "Feature Id",
          "type": "string"
        },
        "region": {
          "$ref": "#/$defs/EditRegion"
        },
        "strand": {
          "default": 1,
          "enum": [
            1,
            -1
          ],
          "title": "Strand",
          "type": "integer"
        },
        "frame": {
          "default": 0,
          "description": "Bases skipped at biological 5' end; v1 preserves incomplete 5'/3' boundary codons exactly and translates complete codons only.",
          "enum": [
            0,
            1,
            2
          ],
          "title": "Frame",
          "type": "integer"
        },
        "genetic_code": {
          "default": 1,
          "description": "NCBI genetic code table ID.",
          "title": "Genetic Code",
          "type": "integer"
        },
        "initiation": {
          "default": "preserve",
          "description": "ordinary: partial CDS/no initiation; preserve: exact start; allowed: selected start codons, translated as Met.",
          "enum": [
            "ordinary",
            "preserve",
            "allowed"
          ],
          "title": "Initiation",
          "type": "string"
        },
        "allowed_start_codons": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Allowed Start Codons",
          "type": "array"
        },
        "stop_policy": {
          "default": "preserve",
          "description": "Preserve exact stop codons or permit synonymous stops; stop positions always remain unchanged.",
          "enum": [
            "preserve",
            "synonymous"
          ],
          "title": "Stop Policy",
          "type": "string"
        }
      },
      "required": [
        "feature_id",
        "region"
      ],
      "title": "CDSConstraint",
      "type": "object"
    },
    "CutWindow": {
      "additionalProperties": false,
      "properties": {
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "end": {
          "minimum": 0,
          "title": "End",
          "type": "integer"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "CutWindow",
      "type": "object"
    },
    "CyclingBlock": {
      "additionalProperties": false,
      "properties": {
        "repetitions": {
          "title": "Repetitions",
          "type": "integer"
        },
        "steps": {
          "items": {
            "$ref": "#/$defs/CyclingStep"
          },
          "title": "Steps",
          "type": "array"
        }
      },
      "required": [
        "repetitions",
        "steps"
      ],
      "title": "CyclingBlock",
      "type": "object"
    },
    "CyclingProgram": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "provenance": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provenance"
        },
        "blocks": {
          "items": {
            "$ref": "#/$defs/CyclingBlock"
          },
          "title": "Blocks",
          "type": "array"
        }
      },
      "required": [
        "name",
        "blocks"
      ],
      "title": "CyclingProgram",
      "type": "object"
    },
    "CyclingStep": {
      "additionalProperties": false,
      "properties": {
        "temperature_C": {
          "title": "Temperature C",
          "type": "number"
        },
        "duration_seconds": {
          "title": "Duration Seconds",
          "type": "number"
        }
      },
      "required": [
        "temperature_C",
        "duration_seconds"
      ],
      "title": "CyclingStep",
      "type": "object"
    },
    "DNAAmount": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "title": "Value",
          "type": "number"
        },
        "unit": {
          "enum": [
            "ng",
            "pmol"
          ],
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "value",
        "unit"
      ],
      "title": "DNAAmount",
      "type": "object"
    },
    "DNAStock": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "title": "Value",
          "type": "number"
        },
        "unit": {
          "enum": [
            "ng/uL",
            "pmol/uL",
            "nM",
            "uM"
          ],
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "value",
        "unit"
      ],
      "title": "DNAStock",
      "type": "object"
    },
    "Dilution": {
      "additionalProperties": false,
      "properties": {
        "factor": {
          "default": 1,
          "description": "Final volume / stock volume; 1 means undiluted. Invalid values are worksheet diagnostics.",
          "title": "Factor",
          "type": "number"
        },
        "preparation_volume_uL": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Preparation Volume Ul"
        }
      },
      "title": "Dilution",
      "type": "object"
    },
    "DomesticationSettings": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "golden-gate-domestication/v1",
          "default": "golden-gate-domestication/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "editable_regions": {
          "default": [],
          "items": {
            "$ref": "#/$defs/EditRegion"
          },
          "title": "Editable Regions",
          "type": "array"
        },
        "protected_regions": {
          "default": [],
          "items": {
            "$ref": "#/$defs/EditRegion"
          },
          "title": "Protected Regions",
          "type": "array"
        },
        "cds": {
          "default": [],
          "items": {
            "$ref": "#/$defs/CDSConstraint"
          },
          "title": "Cds",
          "type": "array"
        },
        "unwanted_sites": {
          "default": [],
          "items": {
            "$ref": "#/$defs/UnwantedSite"
          },
          "title": "Unwanted Sites",
          "type": "array"
        },
        "algorithm": {
          "const": "minimal_substitutions",
          "default": "minimal_substitutions",
          "title": "Algorithm",
          "type": "string"
        },
        "candidate_budget": {
          "default": 100000,
          "description": "Maximum candidate evaluations; deterministic, no random seed or restart state.",
          "minimum": 1,
          "title": "Candidate Budget",
          "type": "integer"
        },
        "max_edits": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional operator-selected substitution limit; null permits every editable base.",
          "title": "Max Edits"
        }
      },
      "title": "DomesticationSettings",
      "type": "object"
    },
    "DonorPreparation": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "donor",
          "default": "donor",
          "title": "Kind",
          "type": "string"
        },
        "retained_fragment_index": {
          "minimum": 0,
          "title": "Retained Fragment Index",
          "type": "integer"
        },
        "removed_fragment_indices": {
          "items": {
            "type": "integer"
          },
          "title": "Removed Fragment Indices",
          "type": "array"
        }
      },
      "required": [
        "retained_fragment_index",
        "removed_fragment_indices"
      ],
      "title": "DonorPreparation",
      "type": "object"
    },
    "EditRegion": {
      "additionalProperties": false,
      "properties": {
        "start": {
          "description": "Forward source start boundary, bp (zero-based).",
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "end": {
          "description": "Forward source end boundary, bp (exclusive).",
          "minimum": 0,
          "title": "End",
          "type": "integer"
        },
        "wraps_origin": {
          "default": false,
          "title": "Wraps Origin",
          "type": "boolean"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "EditRegion",
      "type": "object"
    },
    "EditRequest": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "settings": {
          "$ref": "#/$defs/DomesticationSettings"
        },
        "accepted_sequence": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Accepted Sequence"
        }
      },
      "required": [
        "source_id"
      ],
      "title": "EditRequest",
      "type": "object"
    },
    "EndInventory": {
      "additionalProperties": false,
      "properties": {
        "instance_id": {
          "title": "Instance Id",
          "type": "string"
        },
        "sequence": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Sequence"
        },
        "role": {
          "title": "Role",
          "type": "string"
        },
        "intended_junction_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Intended Junction Id"
        },
        "polarity": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Polarity"
        },
        "removed": {
          "default": false,
          "title": "Removed",
          "type": "boolean"
        },
        "phosphorylation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Phosphorylation"
        }
      },
      "required": [
        "instance_id",
        "sequence",
        "role"
      ],
      "title": "EndInventory",
      "type": "object"
    },
    "EnzymeBinding": {
      "additionalProperties": false,
      "properties": {
        "enzyme_id": {
          "title": "Enzyme Id",
          "type": "string"
        },
        "catalog_id": {
          "title": "Catalog Id",
          "type": "string"
        },
        "catalog_sha256": {
          "title": "Catalog Sha256",
          "type": "string"
        }
      },
      "required": [
        "enzyme_id",
        "catalog_id",
        "catalog_sha256"
      ],
      "title": "EnzymeBinding",
      "type": "object"
    },
    "EvaluateTask": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "bms.golden-gate-design.v1",
          "default": "bms.golden-gate-design.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "task": {
          "const": "evaluate_overhangs",
          "title": "Task",
          "type": "string"
        },
        "junctions": {
          "items": {
            "type": "string"
          },
          "title": "Junctions",
          "type": "array"
        },
        "fidelity": {
          "$ref": "#/$defs/FidelitySettings"
        },
        "inventory": {
          "items": {
            "$ref": "#/$defs/EndInventory"
          },
          "title": "Inventory",
          "type": "array"
        },
        "inventory_complete": {
          "default": false,
          "title": "Inventory Complete",
          "type": "boolean"
        }
      },
      "required": [
        "task",
        "junctions"
      ],
      "title": "EvaluateTask",
      "type": "object"
    },
    "Feature": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "type": {
          "title": "Type",
          "type": "string"
        },
        "name": {
          "default": "",
          "title": "Name",
          "type": "string"
        },
        "segments": {
          "items": {
            "$ref": "#/$defs/Region"
          },
          "title": "Segments",
          "type": "array"
        },
        "strand": {
          "default": 1,
          "enum": [
            -1,
            0,
            1
          ],
          "title": "Strand",
          "type": "integer"
        },
        "qualifiers": {
          "additionalProperties": true,
          "title": "Qualifiers",
          "type": "object"
        },
        "codon_start": {
          "anyOf": [
            {
              "enum": [
                1,
                2,
                3
              ],
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Codon Start"
        },
        "status": {
          "default": "intact",
          "enum": [
            "intact",
            "truncated",
            "disrupted"
          ],
          "title": "Status",
          "type": "string"
        },
        "frame_preserved": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Frame Preserved"
        }
      },
      "required": [
        "id",
        "type",
        "segments"
      ],
      "title": "Feature",
      "type": "object"
    },
    "FidelitySettings": {
      "additionalProperties": false,
      "properties": {
        "dataset_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dataset Id"
        },
        "condition_use": {
          "default": "reference",
          "enum": [
            "reference",
            "explicit_proxy"
          ],
          "title": "Condition Use",
          "type": "string"
        },
        "include_pair_observations": {
          "default": false,
          "title": "Include Pair Observations",
          "type": "boolean"
        }
      },
      "title": "FidelitySettings",
      "type": "object"
    },
    "FragmentEnd": {
      "properties": {
        "type": {
          "enum": [
            "blunt",
            "sticky_5",
            "sticky_3"
          ],
          "title": "Type",
          "type": "string"
        },
        "overhang": {
          "default": "",
          "title": "Overhang",
          "type": "string"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "protruding_strand": {
          "anyOf": [
            {
              "enum": [
                "top",
                "bottom"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Protruding Strand"
        }
      },
      "required": [
        "type"
      ],
      "title": "FragmentEnd",
      "type": "object"
    },
    "FrameConstraint": {
      "additionalProperties": false,
      "properties": {
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "end": {
          "minimum": 0,
          "title": "End",
          "type": "integer"
        },
        "origin": {
          "minimum": 0,
          "title": "Origin",
          "type": "integer"
        },
        "phase": {
          "enum": [
            0,
            1,
            2
          ],
          "title": "Phase",
          "type": "integer"
        }
      },
      "required": [
        "start",
        "end",
        "origin",
        "phase"
      ],
      "title": "FrameConstraint",
      "type": "object"
    },
    "InlineSource": {
      "additionalProperties": false,
      "properties": {
        "sequence": {
          "title": "Sequence",
          "type": "string"
        },
        "topology": {
          "enum": [
            "linear",
            "circular"
          ],
          "title": "Topology",
          "type": "string"
        },
        "features": {
          "items": {
            "$ref": "#/$defs/Feature"
          },
          "title": "Features",
          "type": "array"
        },
        "kind": {
          "const": "inline",
          "default": "inline",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "sequence",
        "topology"
      ],
      "title": "InlineSource",
      "type": "object"
    },
    "OptimizeTask": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "bms.golden-gate-design.v1",
          "default": "bms.golden-gate-design.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "task": {
          "const": "optimize_overhangs",
          "title": "Task",
          "type": "string"
        },
        "candidate_domain": {
          "items": {
            "type": "string"
          },
          "title": "Candidate Domain",
          "type": "array"
        },
        "junction_count": {
          "minimum": 1,
          "title": "Junction Count",
          "type": "integer"
        },
        "end_length": {
          "enum": [
            3,
            4
          ],
          "title": "End Length",
          "type": "integer"
        },
        "fixed": {
          "items": {
            "type": "string"
          },
          "title": "Fixed",
          "type": "array"
        },
        "required": {
          "items": {
            "type": "string"
          },
          "title": "Required",
          "type": "array"
        },
        "excluded": {
          "items": {
            "type": "string"
          },
          "title": "Excluded",
          "type": "array"
        },
        "fidelity": {
          "$ref": "#/$defs/FidelitySettings"
        },
        "search": {
          "$ref": "#/$defs/SearchControls"
        }
      },
      "required": [
        "task",
        "candidate_domain",
        "junction_count",
        "end_length"
      ],
      "title": "OptimizeTask",
      "type": "object"
    },
    "PCRPreparation": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "pcr",
          "default": "pcr",
          "title": "Kind",
          "type": "string"
        },
        "region": {
          "$ref": "#/$defs/Region"
        },
        "left": {
          "$ref": "#/$defs/Tail"
        },
        "right": {
          "$ref": "#/$defs/Tail"
        },
        "forward_anneal_length": {
          "minimum": 8,
          "title": "Forward Anneal Length",
          "type": "integer"
        },
        "reverse_anneal_length": {
          "minimum": 8,
          "title": "Reverse Anneal Length",
          "type": "integer"
        },
        "qc_min_binding_anneal_length": {
          "default": 12,
          "minimum": 1,
          "title": "Qc Min Binding Anneal Length",
          "type": "integer"
        },
        "removed_fragment_indices": {
          "items": {
            "type": "integer"
          },
          "title": "Removed Fragment Indices",
          "type": "array"
        }
      },
      "required": [
        "region",
        "left",
        "right",
        "forward_anneal_length",
        "reverse_anneal_length"
      ],
      "title": "PCRPreparation",
      "type": "object"
    },
    "Part": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "role": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Role"
        },
        "slot": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Slot"
        },
        "orientation": {
          "default": "forward",
          "enum": [
            "forward",
            "reverse"
          ],
          "title": "Orientation",
          "type": "string"
        },
        "preparation": {
          "discriminator": {
            "mapping": {
              "donor": "#/$defs/DonorPreparation",
              "pcr": "#/$defs/PCRPreparation",
              "prepared": "#/$defs/PreparedPreparation",
              "synthesis": "#/$defs/SynthesisPreparation"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
