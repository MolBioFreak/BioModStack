{
  "$id": "https://biomodstack.local/schemas/frustrampnn/frustrampnn_structure_map_v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "altloc_policy": {
      "pattern": "^blank_or_explicit:(?:<blank>|[A-Za-z0-9])$",
      "type": "string"
    },
    "authority_artifact_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "candidate_id": {
      "minLength": 1,
      "type": "string"
    },
    "excluded_records": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "reason": {
            "minLength": 1,
            "type": "string"
          },
          "reason_code": {
            "enum": [
              "non_protein_entity",
              "not_selected",
              "missing_backbone",
              "nonstandard_residue",
              "unsupported_record"
            ]
          },
          "source_identity": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "source_identity",
          "reason_code",
          "reason"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "identity_authority": {
      "enum": [
        "pdb_self_identity_v1",
        "mmcif_atom_site_v1",
        "producer_manifest_v1",
        "cm_complex_snapshot_v1"
      ]
    },
    "identity_domain": {
      "enum": [
        "candidate_local",
        "source_authoritative"
      ]
    },
    "model_ready_sequence": {
      "minLength": 1,
      "pattern": "^[ACDEFGHIKLMNPQRSTVWY]+$",
      "type": "string"
    },
    "model_ready_sequence_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "normalized_pdb_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "normalizer_version": {
      "const": "frustrampnn_structure_normalizer_v1"
    },
    "parent_job_id": {
      "minLength": 1,
      "type": "string"
    },
    "rows": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "auth_asym_id": {
            "minLength": 1,
            "type": "string"
          },
          "auth_seq_id": {
            "maximum": 9999,
            "minimum": -999,
            "type": "integer"
          },
          "backbone_atoms": {
            "additionalProperties": false,
            "properties": {
              "C": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "CA": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "N": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "O": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "N",
              "CA",
              "C",
              "O"
            ],
            "type": "object"
          },
          "backbone_complete": {
            "type": "boolean"
          },
          "entity_instance_id": {
            "minLength": 1,
            "type": "string"
          },
          "insertion_code": {
            "maxLength": 1,
            "type": "string"
          },
          "label_asym_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "label_seq_id": {
            "minimum": 1,
            "type": [
              "integer",
              "null"
            ]
          },
          "model_position": {
            "minimum": 0,
            "type": "integer"
          },
          "pdb_chain_id": {
            "maxLength": 1,
            "minLength": 1,
            "type": "string"
          },
          "pdb_insertion_code": {
            "maxLength": 1,
            "type": "string"
          },
          "pdb_residue_id": {
            "maximum": 9999,
            "minimum": -999,
            "type": "integer"
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "residue_name": {
            "maxLength": 3,
            "minLength": 3,
            "type": "string"
          },
          "selected_altloc": {
            "maxLength": 1,
            "type": "string"
          },
          "selected_model": {
            "minimum": 1,
            "type": "integer"
          },
          "sequence_index": {
            "minimum": 1,
            "type": "integer"
          },
          "source_entity_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "enum": [
              "mapped",
              "missing_backbone",
              "nonstandard_residue",
              "excluded"
            ]
          },
          "wt": {
            "pattern": "^[ACDEFGHIKLMNPQRSTVWY]$",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "entity_instance_id",
          "source_entity_id",
          "label_asym_id",
          "auth_asym_id",
          "label_seq_id",
          "auth_seq_id",
          "insertion_code",
          "sequence_index",
          "pdb_chain_id",
          "pdb_residue_id",
          "pdb_insertion_code",
          "model_position",
          "residue_name",
          "wt",
          "selected_model",
          "selected_altloc",
          "backbone_complete",
          "backbone_atoms",
          "status",
          "reason"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "schema_name": {
      "const": "frustrampnn_structure_map"
    },
    "schema_version": {
      "const": 1
    },
    "selected_source_model": {
      "minimum": 1,
      "type": "integer"
    },
    "source_bytes": {
      "minimum": 1,
      "type": "integer"
    },
    "source_format": {
      "enum": [
        "pdb",
        "mmcif"
      ]
    },
    "source_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "target_id": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "schema_name",
    "schema_version",
    "target_id",
    "parent_job_id",
    "candidate_id",
    "source_format",
    "source_sha256",
    "source_bytes",
    "identity_authority",
    "identity_domain",
    "authority_artifact_sha256",
    "normalized_pdb_sha256",
    "selected_source_model",
    "altloc_policy",
    "normalizer_version",
    "model_ready_sequence",
    "model_ready_sequence_sha256",
    "excluded_records",
    "rows"
  ],
  "title": "frustrampnn_structure_map_v1",
  "type": "object"
}
