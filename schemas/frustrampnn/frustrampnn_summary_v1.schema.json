{
  "$id": "https://biomodstack.local/schemas/frustrampnn/frustrampnn_summary_v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "candidate_id": {
      "minLength": 1,
      "type": "string"
    },
    "complete_landscape_counts": {
      "additionalProperties": false,
      "properties": {
        "high": {
          "minimum": 0,
          "type": "integer"
        },
        "minimal": {
          "minimum": 0,
          "type": "integer"
        },
        "neutral": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "high",
        "neutral",
        "minimal"
      ],
      "type": "object"
    },
    "complete_landscape_fractions": {
      "additionalProperties": false,
      "properties": {
        "high": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "minimal": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "neutral": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        }
      },
      "required": [
        "high",
        "neutral",
        "minimal"
      ],
      "type": "object"
    },
    "landscape_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "missingness_by_reason": {
      "additionalProperties": {
        "minimum": 1,
        "type": "integer"
      },
      "type": "object"
    },
    "native_slot_counts": {
      "additionalProperties": false,
      "properties": {
        "high": {
          "minimum": 0,
          "type": "integer"
        },
        "minimal": {
          "minimum": 0,
          "type": "integer"
        },
        "neutral": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "high",
        "neutral",
        "minimal"
      ],
      "type": "object"
    },
    "native_slot_fractions": {
      "additionalProperties": false,
      "properties": {
        "high": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "minimal": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "neutral": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        }
      },
      "required": [
        "high",
        "neutral",
        "minimal"
      ],
      "type": "object"
    },
    "parent_job_id": {
      "minLength": 1,
      "type": "string"
    },
    "residue_support": {
      "additionalProperties": false,
      "properties": {
        "ambiguous": {
          "minimum": 0,
          "type": "integer"
        },
        "excluded": {
          "minimum": 0,
          "type": "integer"
        },
        "expected": {
          "minimum": 0,
          "type": "integer"
        },
        "mapped": {
          "minimum": 0,
          "type": "integer"
        },
        "scoreable": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "expected",
        "mapped",
        "scoreable",
        "excluded",
        "ambiguous"
      ],
      "type": "object"
    },
    "schema_name": {
      "const": "frustrampnn_summary"
    },
    "schema_version": {
      "const": 1
    },
    "slot_support": {
      "additionalProperties": false,
      "properties": {
        "expected": {
          "minimum": 0,
          "type": "integer"
        },
        "observed": {
          "minimum": 0,
          "type": "integer"
        },
        "scoreable": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "expected",
        "observed",
        "scoreable"
      ],
      "type": "object"
    },
    "support_by_entity_chain": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "auth_asym_id": {
            "minLength": 1,
            "type": "string"
          },
          "entity_instance_id": {
            "minLength": 1,
            "type": "string"
          },
          "expected_residues": {
            "minimum": 0,
            "type": "integer"
          },
          "expected_slots": {
            "minimum": 0,
            "type": "integer"
          },
          "mapped_residues": {
            "minimum": 0,
            "type": "integer"
          },
          "observed_slots": {
            "minimum": 0,
            "type": "integer"
          },
          "scoreable_residues": {
            "minimum": 0,
            "type": "integer"
          },
          "scoreable_slots": {
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "entity_instance_id",
          "auth_asym_id",
          "expected_residues",
          "mapped_residues",
          "scoreable_residues",
          "expected_slots",
          "observed_slots",
          "scoreable_slots"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "target_id": {
      "minLength": 1,
      "type": "string"
    },
    "threshold_policy": {
      "additionalProperties": false,
      "properties": {
        "high_max": {
          "const": -1.0
        },
        "id": {
          "const": "frustrampnn_threshold_v1"
        },
        "minimal_min": {
          "const": 0.58
        }
      },
      "required": [
        "id",
        "high_max",
        "minimal_min"
      ],
      "type": "object"
    },
    "threshold_policy_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "required": [
    "schema_name",
    "schema_version",
    "target_id",
    "parent_job_id",
    "candidate_id",
    "landscape_sha256",
    "residue_support",
    "slot_support",
    "missingness_by_reason",
    "native_slot_counts",
    "native_slot_fractions",
    "complete_landscape_counts",
    "complete_landscape_fractions",
    "support_by_entity_chain",
    "threshold_policy",
    "threshold_policy_sha256"
  ],
  "title": "frustrampnn_summary_v1",
  "type": "object"
}
