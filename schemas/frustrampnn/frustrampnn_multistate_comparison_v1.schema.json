{
  "$id": "https://biomodstack.local/schemas/frustrampnn/frustrampnn_multistate_comparison_v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "schema_name": {"const": "frustrampnn_multistate_comparison"},
    "schema_version": {"const": 1},
    "comparison_mode": {"const": "multi_state"},
    "comparison_id": {"type": ["string", "null"]},
    "comparison_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "reference_landscape_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "target_landscape_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "target_landscape_sha256s": {"items": {"pattern": "^[0-9a-f]{64}$", "type": "string"}, "minItems": 1, "type": "array"},
    "configuration_id": {"type": ["string", "null"]},
    "configuration_sha256": {"pattern": "^[0-9a-f]{64}$", "type": ["string", "null"]},
    "comparability": {"type": "object"},
    "summary": {"additionalProperties": {"type": "integer"}, "type": "object"},
    "rows": {"items": {"additionalProperties": true, "type": "object"}, "type": "array"}
  },
  "required": [
    "schema_name",
    "schema_version",
    "comparison_mode",
    "comparison_id",
    "comparison_sha256",
    "reference_landscape_sha256",
    "target_landscape_sha256",
    "target_landscape_sha256s",
    "comparability",
    "summary",
    "rows"
  ],
  "title": "frustrampnn_multistate_comparison_v1",
  "type": "object"
}
