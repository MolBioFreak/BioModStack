  "$id": "https://biomodstack.local/schemas/frustrampnn/workflow_component_request_v3.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "else": {
        "properties": {
          "identity_authority_artifact": false
        }
      },
      "if": {
        "properties": {
          "identity_authority": {
            "enum": [
              "producer_manifest",
              "cm_complex_snapshot"
            ]
          }
        },
        "required": [
          "identity_authority"
        ]
      },
      "then": {
        "required": [
          "identity_authority_artifact"
        ]
      }
    },
    {
      "else": {
        "properties": {
          "identity_authority_artifact": {
            "not": {
              "required": [
                "cm_complex_snapshot_sha256"
              ]
            }
          }
        }
      },
      "if": {
        "properties": {
          "identity_authority": {
            "const": "cm_complex_snapshot"
          }
        },
        "required": [
          "identity_authority"
        ]
      },
      "then": {
        "properties": {
          "identity_authority_artifact": {
            "required": [
              "cm_complex_snapshot_sha256"
            ]
          }
        }
      }
    }
  ],
