{
  "$id": "https://biomodstack.local/schemas/frustrampnn/frustrampnn_execution_receipt_v3.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "frustrampnn_execution_receipt_v3",
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "chains": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9]$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "positions": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "integer",
        "minimum": 0
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "planEntry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ordinal": {
          "type": "integer",
          "minimum": 0
        },
        "chains": {
          "$ref": "#/$defs/chains"
        },
        "positions": {
          "$ref": "#/$defs/positions"
        },
        "shard_relative_path": {
          "type": "string",
          "pattern": "^raw_frustrampnn_shard_[0-9]{4}\\.csv$"
        }
      },
      "required": [
        "ordinal",
        "chains",
        "positions",
        "shard_relative_path"
      ]
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ordinal": {
          "type": "integer",
          "minimum": 0
        },
        "chains": {
          "$ref": "#/$defs/chains"
        },
        "positions": {
          "$ref": "#/$defs/positions"
        },
        "shard_relative_path": {
          "type": "string",
          "pattern": "^raw_frustrampnn_shard_[0-9]{4}\\.csv$"
        },
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "argv_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "status": {
          "enum": [
            "succeeded",
            "failed",
            "not_run"
          ]
        },
        "exit_code": {
          "type": [
            "integer",
            "null"
          ]
        },
        "shard_sha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "shard_row_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "started_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "ended_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "duration_seconds": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      },
      "required": [
        "ordinal",
        "chains",
        "positions",
        "shard_relative_path",
        "argv",
        "argv_sha256",
        "status",
        "exit_code",
        "shard_sha256",
        "shard_row_count",
        "started_at",
        "ended_at",
        "duration_seconds"
      ]
    },
    "commandPlan": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "entries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/planEntry"
          }
        },
        "plan_sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "entries",
        "plan_sha256"
      ]
    }
  },
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_name": {
      "const": "frustrampnn_execution_receipt"
    },
    "schema_version": {
      "const": 3
    },
    "execution_method": {
      "enum": [
        "predict",
        "predict_batch"
      ]
    },
    "invocation_id": {
      "type": "string",
      "minLength": 1
    },
    "execution_configuration_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "requested_settings_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "effective_settings_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "runtime_identity_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "source_artifact_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "structure_map_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "normalized_pdb_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "command_plan": {
      "$ref": "#/$defs/commandPlan"
    },
    "command_count": {
      "type": "integer",
      "minimum": 1
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/command"
      }
    },
    "merged_raw_csv_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "landscape_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "summary_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "assigned_physical_gpu_id": {
      "type": "string",
      "minLength": 1
    },
    "task_visible_device_index": {
      "const": 0
    },
    "stdout_artifact": {
      "const": "frustrampnn_stdout.log"
    },
    "stderr_artifact": {
      "const": "frustrampnn_stderr.log"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "ended_at": {
      "type": "string",
      "format": "date-time"
    },
    "duration_seconds": {
      "type": "number",
      "minimum": 0
    }
  },
  "required": [
    "schema_name",
    "schema_version",
    "execution_method",
    "invocation_id",
    "execution_configuration_sha256",
    "requested_settings_sha256",
    "effective_settings_sha256",
    "runtime_identity_sha256",
    "source_artifact_sha256",
    "structure_map_sha256",
    "normalized_pdb_sha256",
    "command_plan",
    "command_count",
    "commands",
    "merged_raw_csv_sha256",
    "landscape_sha256",
    "summary_sha256",
    "assigned_physical_gpu_id",
    "task_visible_device_index",
    "stdout_artifact",
    "stderr_artifact",
    "started_at",
    "ended_at",
    "duration_seconds"
  ]
}
