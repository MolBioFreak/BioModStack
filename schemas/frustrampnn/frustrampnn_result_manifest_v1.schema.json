{
  "$id": "https://biomodstack.local/schemas/frustrampnn/frustrampnn_result_manifest_v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_count": {
      "enum": [
        10,
        11
      ]
    },
    "artifacts": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "bytes": {
            "minimum": 0,
            "type": "integer"
          },
          "cardinality": {
            "additionalProperties": false,
            "properties": {
              "count": {
                "minimum": 0,
                "type": "integer"
              },
              "kind": {
                "enum": [
                  "rows",
                  "residues",
                  "slots",
                  "records"
                ]
              }
            },
            "required": [
              "kind",
              "count"
            ],
            "type": [
              "object",
              "null"
            ]
          },
          "relative_path": {
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*//)(?!\\./).+$",
            "type": "string"
          },
          "role": {
            "const": "identity_authority"
          },
          "schema_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "schema_version": {
            "minimum": 1,
            "type": [
              "integer",
              "null"
            ]
          },
          "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "relative_path",
          "schema_name",
          "schema_version",
          "sha256",
          "bytes",
          "cardinality"
        ],
        "type": "object"
      },
      "maxItems": 11,
      "minItems": 10,
      "type": "array"
    },
    "candidate_id": {
      "minLength": 1,
      "type": "string"
    },
    "invocation_id": {
      "minLength": 1,
      "type": "string"
    },
    "parent_job_id": {
      "minLength": 1,
      "type": "string"
    },
    "request_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "schema_name": {
      "const": "frustrampnn_result_manifest"
    },
    "schema_version": {
      "const": 1
    },
    "source_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "required": [
    "schema_name",
    "schema_version",
    "invocation_id",
    "parent_job_id",
    "candidate_id",
    "request_sha256",
    "source_sha256",
    "artifact_count",
    "artifacts"
  ],
  "title": "frustrampnn_result_manifest_v1",
  "type": "object"
}
