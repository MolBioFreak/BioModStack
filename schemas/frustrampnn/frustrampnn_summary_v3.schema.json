{
  "$id": "https://biomodstack.local/schemas/frustrampnn/frustrampnn_summary_v3.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "frustrampnn_summary_v3",
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "thresholdPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "canonical",
            "custom"
          ]
        },
        "high_max": {
          "type": "number"
        },
        "minimal_min": {
          "type": "number"
        }
      },
      "required": [
        "mode",
        "high_max",
        "minimal_min"
      ]
    },
    "classCounts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "high": {
          "type": "integer",
          "minimum": 0
        },
        "neutral": {
          "type": "integer",
          "minimum": 0
        },
        "minimal": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "high",
        "neutral",
        "minimal"
      ]
    },
    "classFractions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "high": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "neutral": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "minimal": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "high",
        "neutral",
        "minimal"
      ]
    },
    "residueSupport": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "expected": {
          "type": "integer",
          "minimum": 1
        },
        "mapped": {
          "type": "integer",
          "minimum": 1
        },
        "scoreable": {
          "type": "integer",
          "minimum": 1
        },
        "excluded": {
          "type": "integer",
          "minimum": 0
        },
        "ambiguous": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "expected",
        "mapped",
        "scoreable",
        "excluded",
        "ambiguous"
      ]
    },
    "slotSupport": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "expected": {
          "type": "integer",
          "minimum": 20
        },
        "observed": {
          "type": "integer",
          "minimum": 20
        },
        "scoreable": {
          "type": "integer",
          "minimum": 20
        }
      },
      "required": [
        "expected",
        "observed",
        "scoreable"
      ]
    },
    "chainSupport": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "entity_instance_id": {
          "type": "string",
          "minLength": 1
        },
        "auth_asym_id": {
          "type": "string",
          "minLength": 1
        },
        "expected_residues": {
          "type": "integer",
          "minimum": 1
        },
        "mapped_residues": {
          "type": "integer",
          "minimum": 1
        },
        "scoreable_residues": {
          "type": "integer",
          "minimum": 1
        },
        "expected_slots": {
          "type": "integer",
          "minimum": 20
        },
        "observed_slots": {
          "type": "integer",
          "minimum": 20
        },
        "scoreable_slots": {
          "type": "integer",
          "minimum": 20
        }
      },
      "required": [
        "entity_instance_id",
        "auth_asym_id",
        "expected_residues",
        "mapped_residues",
        "scoreable_residues",
        "expected_slots",
        "observed_slots",
        "scoreable_slots"
      ]
    }
  },
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_name": {
      "const": "frustrampnn_summary"
    },
    "schema_version": {
      "const": 3
    },
    "execution_configuration_id": {
      "const": "frustrampnn_execution_configuration_v3"
    },
    "execution_configuration_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "requested_settings_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "effective_settings_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "runtime_identity_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "target_id": {
      "type": "string",
      "minLength": 1
    },
    "parent_job_id": {
      "type": "string",
      "minLength": 1
    },
    "candidate_id": {
      "type": "string",
      "minLength": 1
    },
    "source_artifact_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "structure_map_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "normalized_pdb_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "landscape_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "threshold_policy_id": {
      "const": "frustrampnn_class_v1"
    },
    "threshold_policy": {
      "$ref": "#/$defs/thresholdPolicy"
    },
    "threshold_policy_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "residue_support": {
      "$ref": "#/$defs/residueSupport"
    },
    "slot_support": {
      "$ref": "#/$defs/slotSupport"
    },
    "missingness_by_reason": {
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 0
    },
    "native_slot_counts": {
      "$ref": "#/$defs/classCounts"
    },
    "native_slot_fractions": {
      "$ref": "#/$defs/classFractions"
    },
    "complete_landscape_counts": {
      "$ref": "#/$defs/classCounts"
    },
    "complete_landscape_fractions": {
      "$ref": "#/$defs/classFractions"
    },
    "support_by_entity_chain": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/chainSupport"
      }
    }
  },
  "required": [
    "schema_name",
    "schema_version",
    "execution_configuration_id",
    "execution_configuration_sha256",
    "requested_settings_sha256",
    "effective_settings_sha256",
    "runtime_identity_sha256",
    "target_id",
    "parent_job_id",
    "candidate_id",
    "source_artifact_sha256",
    "structure_map_sha256",
    "normalized_pdb_sha256",
    "landscape_sha256",
    "threshold_policy_id",
    "threshold_policy",
    "threshold_policy_sha256",
    "residue_support",
    "slot_support",
    "missingness_by_reason",
    "native_slot_counts",
    "native_slot_fractions",
    "complete_landscape_counts",
    "complete_landscape_fractions",
    "support_by_entity_chain"
  ]
}
