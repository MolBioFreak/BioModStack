{
  "$id": "https://biomodstack.local/schemas/frustrampnn/frustrampnn_landscape_v2.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "frustrampnn_landscape_v2",
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "thresholdPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {"enum": ["canonical", "custom"]},
        "high_max": {"type": "number"},
        "minimal_min": {"type": "number"}
      },
      "required": ["mode", "high_max", "minimal_min"]
    },
    "slot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mutation_aa": {"type": "string", "pattern": "^[ACDEFGHIKLMNPQRSTVWY]$"},
        "score": {"type": "number"},
        "class": {"enum": ["high", "neutral", "minimal"]},
        "scoreable": {"const": true},
        "status": {"const": "ok"},
        "reason": {"type": "null"},
        "native": {"type": "boolean"}
      },
      "required": ["mutation_aa", "score", "class", "scoreable", "status", "reason", "native"]
    },
    "residue": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "entity_instance_id": {"type": "string", "minLength": 1},
        "source_entity_id": {"type": ["string", "null"]},
        "label_asym_id": {"type": ["string", "null"]},
        "label_seq_id": {"type": ["integer", "null"], "minimum": 1},
        "auth_asym_id": {"type": "string", "minLength": 1},
        "auth_seq_id": {"type": "integer"},
        "insertion_code": {"type": "string", "maxLength": 1},
        "sequence_index": {"type": "integer", "minimum": 1},
        "wt": {"type": "string", "pattern": "^[ACDEFGHIKLMNPQRSTVWY]$"},
        "pdb_chain_id": {"type": "string", "pattern": "^[A-Za-z0-9]$"},
        "pdb_residue_id": {"type": "integer", "minimum": -999, "maximum": 9999},
        "pdb_insertion_code": {"type": "string", "maxLength": 1},
        "model_position": {"type": "integer", "minimum": 0},
        "residue_name": {"type": "string", "minLength": 3, "maxLength": 3},
        "slots": {"type": "array", "minItems": 20, "maxItems": 20, "items": {"$ref": "#/$defs/slot"}}
      },
      "required": ["entity_instance_id", "source_entity_id", "label_asym_id", "label_seq_id", "auth_asym_id", "auth_seq_id", "insertion_code", "sequence_index", "wt", "pdb_chain_id", "pdb_residue_id", "pdb_insertion_code", "model_position", "residue_name", "slots"]
    }
  },
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_name": {"const": "frustrampnn_landscape"},
    "schema_version": {"const": 2},
    "execution_configuration_id": {"const": "frustrampnn_execution_configuration_v2"},
    "execution_configuration_sha256": {"$ref": "#/$defs/sha256"},
    "requested_settings_sha256": {"$ref": "#/$defs/sha256"},
    "effective_settings_sha256": {"$ref": "#/$defs/sha256"},
    "runtime_identity_sha256": {"$ref": "#/$defs/sha256"},
    "target_id": {"type": "string", "minLength": 1},
    "parent_job_id": {"type": "string", "minLength": 1},
    "candidate_id": {"type": "string", "minLength": 1},
    "source_artifact_sha256": {"$ref": "#/$defs/sha256"},
    "structure_map_sha256": {"$ref": "#/$defs/sha256"},
    "normalized_pdb_sha256": {"$ref": "#/$defs/sha256"},
    "raw_csv_sha256": {"$ref": "#/$defs/sha256"},
    "threshold_policy_id": {"const": "frustrampnn_class_v1"},
    "threshold_policy": {"$ref": "#/$defs/thresholdPolicy"},
    "threshold_policy_sha256": {"$ref": "#/$defs/sha256"},
    "residues": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/residue"}}
  },
  "required": ["schema_name", "schema_version", "execution_configuration_id", "execution_configuration_sha256", "requested_settings_sha256", "effective_settings_sha256", "runtime_identity_sha256", "target_id", "parent_job_id", "candidate_id", "source_artifact_sha256", "structure_map_sha256", "normalized_pdb_sha256", "raw_csv_sha256", "threshold_policy_id", "threshold_policy", "threshold_policy_sha256", "residues"]
}
