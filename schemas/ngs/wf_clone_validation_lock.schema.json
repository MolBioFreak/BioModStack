{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://biomodstack.local/schemas/ngs/wf_clone_validation_lock.schema.json",
  "title": "BioModStack immutable wf-clone-validation runtime lock",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "lock_version", "upstream", "patched_source", "compatibility_patch", "nextflow", "containers", "models", "runtime_policy"],
  "properties": {
    "schema": {"const": "biomodstack.wf_clone_validation_lock.v1"},
    "lock_version": {"const": 1},
    "upstream": {"$ref": "#/$defs/upstream"},
    "patched_source": {"$ref": "#/$defs/patchedSource"},
    "compatibility_patch": {"$ref": "#/$defs/patch"},
    "nextflow": {"$ref": "#/$defs/nextflow"},
    "containers": {"$ref": "#/$defs/containers"},
    "models": {"$ref": "#/$defs/models"},
    "runtime_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["network", "nxf_offline"],
      "properties": {"network": {"const": "forbidden"}, "nxf_offline": {"const": true}}
    }
  },
  "$defs": {
    "gitObject": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "upstream": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "tag", "commit", "tree"],
      "properties": {
        "repository": {"type": "string", "format": "uri"}, "tag": {"type": "string"},
        "commit": {"$ref": "#/$defs/gitObject"}, "tree": {"$ref": "#/$defs/gitObject"}
      }
    },
    "patchedSource": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "commit", "tree"],
      "properties": {"path": {"type": "string"}, "commit": {"$ref": "#/$defs/gitObject"}, "tree": {"$ref": "#/$defs/gitObject"}}
    },
    "patch": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "base_commit", "result_commit", "result_tree"],
      "properties": {
        "path": {"type": "string"}, "sha256": {"$ref": "#/$defs/sha256"},
        "base_commit": {"$ref": "#/$defs/gitObject"}, "result_commit": {"$ref": "#/$defs/gitObject"}, "result_tree": {"$ref": "#/$defs/gitObject"}
      }
    },
    "nextflow": {
      "type": "object", "additionalProperties": false,
      "required": ["executable", "version", "build"],
      "properties": {"executable": {"type": "string"}, "version": {"type": "string"}, "build": {"type": "string", "pattern": "^[0-9]+$"}}
    },
    "containers": {
      "type": "object", "additionalProperties": false, "required": ["cache_dir", "images"],
      "properties": {
        "cache_dir": {"type": "string"},
        "images": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"$ref": "#/$defs/image"}}
      }
    },
    "image": {
      "type": "object", "additionalProperties": false, "required": ["uri", "cache_file", "sha256"],
      "properties": {"uri": {"type": "string"}, "cache_file": {"type": "string", "pattern": "^[^/]+$"}, "sha256": {"$ref": "#/$defs/sha256"}}
    },
    "models": {
      "type": "object", "additionalProperties": false, "required": ["store", "accepted_upstream_ids", "default"],
      "properties": {
        "store": {"type": "string"}, "accepted_upstream_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}, "default": {"type": "string"}
      }
    }
  }
}
