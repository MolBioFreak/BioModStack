{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://biomodstack.local/schemas/ngs/wf_clone_validation_adapter.schema.json",
  "title": "BioModStack wf-clone-validation normalized adapter manifest",
  "type": "object",
  "required": ["schema", "adapter_version", "execution", "upstream_sample_status", "scientific_verdict", "scientific_reason_codes", "sample", "runtime_provenance", "authoritative_inputs", "artifacts", "missing_evidence_reasons", "contradictory_evidence_reasons"],
  "properties": {
    "schema": {"const": "biomodstack.wf_clone_validation_adapter.v1"},
    "adapter_version": {"const": "1.0.0"},
    "execution": {
      "type": "object", "required": ["status", "exit_code", "reason_codes"],
      "properties": {"status": {"enum": ["SUCCEEDED", "FAILED"]}, "exit_code": {"type": "integer"}, "reason_codes": {"type": "array", "items": {"type": "string"}}}
    },
    "upstream_sample_status": {"type": "object"},
    "scientific_verdict": {"const": "REVIEW"},
    "scientific_reason_codes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "sample": {"type": "object"},
    "runtime_provenance": {"type": "object"},
    "authoritative_inputs": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "items": {
        "type": "object", "required": ["kind", "path", "size_bytes", "sha256"],
        "properties": {"kind": {"enum": ["authoritative_analysis_bam", "authoritative_analysis_bai"]}, "path": {"type": "string"}, "size_bytes": {"type": "integer", "minimum": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
      }
    },
    "artifacts": {
      "type": "array", "minItems": 7,
      "items": {
        "type": "object", "required": ["kind", "path", "required", "size_bytes", "sha256"],
        "properties": {"kind": {"type": "string"}, "path": {"type": "string"}, "required": {"type": "boolean"}, "size_bytes": {"type": "integer", "minimum": 0}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
      }
    },
    "missing_evidence_reasons": {"type": "array", "items": {"type": "string"}},
    "contradictory_evidence_reasons": {"type": "array", "items": {"type": "string"}}
  }
}
