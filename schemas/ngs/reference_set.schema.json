{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://biomodstack.local/schemas/ngs/reference_set.schema.json",
  "title": "BioModStack pooled ONT reference-set manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "mode", "manifest_id", "manifest_sha256", "entries"],
  "properties": {
    "schema": {"const": "bms.ngs.reference-set.v1"},
    "mode": {"const": "pooled"},
    "manifest_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "description": "Immutable server-issued reference-set identity."
    },
    "manifest_sha256": {
      "$ref": "#/$defs/sha256",
      "description": "SHA-256 of canonical JSON for this manifest with manifest_sha256 omitted."
    },
    "entries": {
      "type": "array",
      "minItems": 2,
      "maxItems": 96,
      "items": {"$ref": "#/$defs/entry"}
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "identity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\s\\x00-\\x1f\\x7f]+$"
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_id",
        "label",
        "molbio_sequence_id",
        "molbio_revision_id",
        "revision_sha256",
        "fasta_path",
        "fasta_sha256"
      ],
      "properties": {
        "target_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[^\\r\\n\\x00-\\x1f\\x7f]+$"
        },
        "molbio_sequence_id": {"$ref": "#/$defs/identity"},
        "molbio_revision_id": {"$ref": "#/$defs/identity"},
        "revision_sha256": {"$ref": "#/$defs/sha256"},
        "fasta_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\x00-\\x1f\\x7f]+$",
          "description": "POSIX path relative to the immutable snapshot directory containing this manifest."
        },
        "fasta_sha256": {"$ref": "#/$defs/sha256"},
        "indistinguishable_group": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        }
      }
    }
  }
}
