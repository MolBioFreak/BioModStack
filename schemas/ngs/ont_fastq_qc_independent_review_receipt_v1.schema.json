{
  "$id": "https://biomodstack.local/schemas/ngs/ont_fastq_qc_independent_review_receipt_v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "candidate_commit": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "candidate_tree": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "contracts": {
      "additionalProperties": false,
      "properties": {
        "alignment_session_schema_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "browser_evidence_schema_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "capability_revocation_schema_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "deployment_receipt_schema_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "error_schema_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "evidence_bundle_schema_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "final_acceptance_schema_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "gate_evidence_body_schema_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "reconciliation_schema_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "result_schema_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "retry3_fixture_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "review_ledger_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "review_receipt_schema_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "rotation_schema_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "sow_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "sow_sha256",
        "review_ledger_sha256",
        "result_schema_sha256",
        "reconciliation_schema_sha256",
        "alignment_session_schema_sha256",
        "error_schema_sha256",
        "rotation_schema_sha256",
        "evidence_bundle_schema_sha256",
        "browser_evidence_schema_sha256",
        "review_receipt_schema_sha256",
        "deployment_receipt_schema_sha256",
        "final_acceptance_schema_sha256",
        "retry3_fixture_sha256",
        "capability_revocation_schema_sha256",
        "gate_evidence_body_schema_sha256"
      ],
      "type": "object"
    },
    "findings": {
      "maxItems": 0,
      "type": "array"
    },
    "receipt_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "review_id": {
      "pattern": "^[A-Za-z0-9_.:-]{1,255}$",
      "type": "string"
    },
    "reviewed_at": {
      "format": "date-time",
      "pattern": "Z$",
      "type": "string"
    },
    "reviewer": {
      "pattern": "^[A-Za-z0-9_.:@-]{1,255}$",
      "type": "string"
    },
    "schema": {
      "const": "bms.ont-fastq-qc-independent-review.v1"
    },
    "scope": {
      "enum": [
        "backend_security_scientific",
        "frontend_browser_viewer",
        "integration_minimality"
      ]
    },
    "verdict": {
      "const": "pass"
    }
  },
  "required": [
    "schema",
    "review_id",
    "scope",
    "reviewer",
    "reviewed_at",
    "candidate_commit",
    "candidate_tree",
    "contracts",
    "verdict",
    "findings",
    "receipt_sha256"
  ],
  "type": "object"
}
