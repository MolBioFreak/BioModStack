{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://biomodstack.local/schemas/ngs/construct_verification_manifest.schema.json",
  "title": "BioModStack construct verification manifest",
  "type": "object",
  "required": [
    "artifact_schema_version",
    "schema",
    "execution",
    "verdict",
    "reason_codes",
    "threshold_profile",
    "inputs",
    "checks",
    "variants",
    "summary",
    "provenance",
    "artifacts"
  ],
  "properties": {
    "artifact_schema_version": {"const": 2},
    "schema": {"const": "biomodstack.construct_verification.v2"},
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "exit_code", "reason_codes"],
      "properties": {
        "status": {"enum": ["SUCCEEDED", "FAILED"]},
        "exit_code": {"type": "integer", "minimum": 0},
        "reason_codes": {
          "type": "array",
          "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+$"},
          "uniqueItems": true
        }
      }
    },
    "verdict": {"enum": ["PASS", "FAIL", "REVIEW"]},
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+$"}
    },
    "threshold_profile": {
      "type": "object",
      "required": ["id", "version", "sha256", "calibration_status", "public_accuracy_validated", "values"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "calibration_status": {"enum": ["experimental", "calibrated"]},
        "public_accuracy_validated": {"type": "boolean"},
        "values": {"type": "object"}
      },
      "additionalProperties": false
    },
    "inputs": {
      "type": "object",
      "required": ["reference", "observed", "source_reads", "support", "alignment", "alignment_index", "alignment_stats", "topology"],
      "properties": {
        "reference": {"$ref": "#/$defs/inputEvidence"},
        "observed": {"$ref": "#/$defs/inputEvidence"},
        "source_reads": {"$ref": "#/$defs/inputEvidence"},
        "support": {"$ref": "#/$defs/inputEvidence"},
        "alignment": {"$ref": "#/$defs/inputEvidence"},
        "alignment_index": {"$ref": "#/$defs/inputEvidence"},
        "alignment_stats": {"$ref": "#/$defs/inputEvidence"},
        "topology": {"$ref": "#/$defs/inputEvidence"}
      },
      "additionalProperties": false
    },
    "checks": {
      "type": "object",
      "required": ["sequence_identity", "read_support", "coverage", "contamination", "topology"],
      "properties": {
        "sequence_identity": {"$ref": "#/$defs/check"},
        "read_support": {"$ref": "#/$defs/check"},
        "coverage": {"$ref": "#/$defs/check"},
        "contamination": {"$ref": "#/$defs/check"},
        "topology": {"$ref": "#/$defs/check"}
      },
      "additionalProperties": false
    },
    "variants": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "position_1based", "ref", "alt", "support_status"],
        "properties": {
          "id": {"type": "string"},
          "kind": {"enum": ["SNV", "INS", "DEL", "MNV", "COMPLEX"]},
          "position_1based": {"type": "integer", "minimum": 1},
          "end_1based": {"type": "integer", "minimum": 1},
          "ref": {"type": "string", "minLength": 1},
          "alt": {"type": "string", "minLength": 1},
          "support_status": {"enum": ["supported", "ambiguous", "unsupported", "not_evaluated"]},
          "depth": {"type": ["integer", "null"], "minimum": 0},
          "support_fraction": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
          "circular_event_id": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    },
    "summary": {"type": "object"},
    "provenance": {
      "type": "object",
      "required": ["verifier", "workflow", "tool_versions", "commands", "generated_at"],
      "properties": {
        "verifier": {"type": "object"},
        "workflow": {
          "type": "object",
          "required": ["name", "module", "version"],
          "properties": {
            "name": {"type": "string", "minLength": 1},
            "module": {"type": "string", "minLength": 1},
            "version": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        },
        "tool_versions": {
          "type": "object",
          "additionalProperties": {"type": ["string", "null"]}
        },
        "commands": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "argv"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "argv": {"type": "array", "minItems": 1, "items": {"type": "string"}}
            },
            "additionalProperties": false
          }
        },
        "generated_at": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "required", "state", "semantic_validation"],
        "properties": {
          "kind": {"type": "string", "minLength": 1},
          "path": {"type": ["string", "null"]},
          "required": {"type": "boolean"},
          "state": {"enum": ["present", "missing_required", "missing_optional", "not_applicable", "not_produced"]},
          "sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
          "size_bytes": {"type": ["integer", "null"], "minimum": 0},
          "reason": {"type": ["string", "null"]},
          "semantic_validation": {"$ref": "#/$defs/semanticValidation"}
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "semanticValidation": {
      "type": "object",
      "required": ["status", "validator", "reason"],
      "properties": {
        "status": {"enum": ["valid", "invalid", "unavailable", "not_applicable"]},
        "validator": {"type": "string", "minLength": 1},
        "reason": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "inputEvidence": {
      "type": "object",
      "required": ["state", "role", "declared_path", "sha256", "size_bytes", "semantic_validation"],
      "properties": {
        "state": {"enum": ["present", "missing", "malformed", "digest_mismatch", "not_applicable"]},
        "role": {"type": "string", "minLength": 1},
        "declared_path": {"type": ["string", "null"]},
        "sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "size_bytes": {"type": ["integer", "null"], "minimum": 0},
        "source_kind": {"type": ["string", "null"]},
        "independent_from_expected": {"type": ["boolean", "null"]},
        "reason": {"type": ["string", "null"]},
        "semantic_validation": {"$ref": "#/$defs/semanticValidation"},
        "normalized_sequence_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "declared_sequence_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"}
      },
      "additionalProperties": false
    },
    "check": {
      "type": "object",
      "required": ["status", "reason_codes", "metrics"],
      "properties": {
        "status": {"enum": ["pass", "fail", "review", "not_evaluated"]},
        "reason_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+$"}
        },
        "metrics": {"type": "object"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
