{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://biomodstack.local/schemas/md_job_v2.schema.json",
  "title": "BioModStack MD Job v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "job_id",
    "engine",
    "replicas",
    "random_seed",
    "input",
    "chemistry",
    "preparation",
    "stages",
    "execution"
  ],
  "properties": {
    "schema": {
      "const": "bms.md.job.v2"
    },
    "job_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "engine": {
      "enum": [
        "gromacs",
        "openmm"
      ]
    },
    "engine_runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sif_sha256",
        "image_name"
      ],
      "properties": {
        "sif_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "image_name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "replicas": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8
    },
    "random_seed": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "structure": {
          "type": "string",
          "minLength": 1
        },
        "coordinates": {
          "type": "string",
          "minLength": 1
        },
        "topology": {
          "type": "string",
          "minLength": 1
        },
        "structure_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "coordinates_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "topology_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "structure_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 104857600
        },
        "coordinates_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 104857600
        },
        "topology_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 104857600
        },
        "topology_closure": {
          "$ref": "#/$defs/topologyClosure"
        }
      },
      "oneOf": [
        {
          "required": [
            "structure"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "coordinates"
                ]
              },
              {
                "required": [
                  "topology"
                ]
              }
            ]
          }
        }
      ]
    },
    "preparation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "box_type",
        "padding_nm",
        "salt_molar",
        "neutralize"
      ],
      "properties": {
        "box_type": {
          "enum": [
            "cubic",
            "triclinic",
            "dodecahedron",
            "octahedron"
          ]
        },
        "padding_nm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "salt_molar": {
          "type": "number",
          "minimum": 0
        },
        "neutralize": {
          "type": "boolean"
        }
      }
    },
    "stages": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimization",
        "nvt",
        "npt",
        "production"
      ],
      "properties": {
        "minimization": {
          "$ref": "#/$defs/minimizationStage"
        },
        "nvt": {
          "$ref": "#/$defs/temperatureStage"
        },
        "npt": {
          "$ref": "#/$defs/pressureStage"
        },
        "production": {
          "$ref": "#/$defs/productionStage"
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gpu_id",
        "ntmpi",
        "ntomp",
        "gpu_offload",
        "pin"
      ],
      "properties": {
        "gpu_id": {
          "type": "string",
          "minLength": 1
        },
        "scheduler_gpu_id": {
          "type": "string",
          "minLength": 1
        },
        "ntmpi": {
          "const": 1
        },
        "ntomp": {
          "type": "integer",
          "minimum": 1,
          "maximum": 128
        },
        "gpu_offload": {
          "enum": [
            "full",
            "full_forces",
            "auto",
            "none"
          ]
        },
        "pin": {
          "enum": [
            "on",
            "off",
            "auto"
          ]
        }
      }
    },
    "chemistry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "profile_sha256",
        "catalog_digest",
        "requested_scope"
      ],
      "properties": {
        "profile_id": {
          "type": "string",
          "minLength": 1
        },
        "profile_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "catalog_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "requested_scope": {
          "type": "string",
          "minLength": 1
        },
        "approved_pack_ids": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          }
        },
        "resolved_approved_packs": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "version", "pack_sha256", "snapshot"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "version": {"type": "string", "minLength": 1},
              "pack_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "snapshot": {"type": "object"}
            }
          }
        },
        "assurance": {
          "type": "string",
          "minLength": 1
        },
        "family": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "resolved_preparation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "force_field",
            "water_model"
          ],
          "properties": {
            "force_field": {
              "type": "string",
              "minLength": 1
            },
            "water_model": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "runtime_identity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "runtime_id",
            "runtime_version",
            "sif_sha256"
          ],
          "properties": {
            "runtime_id": {
              "type": "string",
              "minLength": 1
            },
            "runtime_version": {
              "type": [
                "string",
                "null"
              ]
            },
            "sif_sha256": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "topologyClosure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root",
        "files",
        "runtime_includes"
      ],
      "properties": {
        "root": {
          "type": "string",
          "minLength": 1
        },
        "files": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256",
              "bytes",
              "parent",
              "include"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_.+/-]+$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "bytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 104857600
              },
              "parent": {
                "type": "string",
                "minLength": 1
              },
              "include": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "runtime_includes": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "parent",
              "include"
            ],
            "properties": {
              "parent": {
                "type": "string",
                "minLength": 1
              },
              "include": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "runtime_identity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "runtime_id",
            "runtime_version",
            "sif_sha256",
            "asset_ids"
          ],
          "properties": {
            "runtime_id": {
              "const": "openmm-md-8.5.2"
            },
            "runtime_version": {
              "const": "8.5.2+gromacs-2025.3"
            },
            "sif_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "asset_ids": {
              "type": "array",
              "minItems": 1,
              "maxItems": 128,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.+-]{1,96}\\.ff$"
              }
            }
          }
        }
      }
    },
    "baseStage": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "steps": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "enabled",
        "steps"
      ]
    },
    "minimizationStage": {
      "allOf": [
        {
          "$ref": "#/$defs/baseStage"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "steps",
            "force_tolerance_kj_mol_nm"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "steps": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5000000
            },
            "force_tolerance_kj_mol_nm": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        }
      ]
    },
    "temperatureStage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "steps",
        "temperature_k"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "steps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5000000
        },
        "temperature_k": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "pressureStage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "steps",
        "temperature_k",
        "pressure_bar"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "steps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5000000
        },
        "temperature_k": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "pressure_bar": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "productionStage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "steps",
        "timestep_fs",
        "temperature_k",
        "pressure_bar",
        "checkpoint_interval_minutes",
        "trajectory_interval_steps",
        "energy_interval_steps"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "steps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50000000
        },
        "timestep_fs": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 4.0
        },
        "temperature_k": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "pressure_bar": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "checkpoint_interval_minutes": {
          "type": "number",
          "minimum": 1.0,
          "maximum": 1440
        },
        "trajectory_interval_steps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50000000
        },
        "energy_interval_steps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50000000
        }
      }
    }
  }
}
