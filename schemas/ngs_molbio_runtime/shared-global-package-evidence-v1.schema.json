{
  "$id": "bms.shared-global-package-evidence.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    { "$ref": "#/$defs/migration" },
    { "$ref": "#/$defs/connector" },
    { "$ref": "#/$defs/workflow" },
    { "$ref": "#/$defs/developmentDeployment" },
    { "$ref": "#/$defs/exactTreeReview" },
    { "$ref": "#/$defs/health" },
    { "$ref": "#/$defs/browser" },
    { "$ref": "#/$defs/focusedCheck" }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "rfc3339": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
    },
    "gitObject": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "nonempty": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "artifact_id": { "$ref": "#/$defs/sha256" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "size_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1099511627776
        }
      },
      "required": ["artifact_id", "sha256", "size_bytes"]
    },
    "common": {
      "type": "object",
      "properties": {
        "schema": { "type": "string" },
        "evidence_kind": { "type": "string" },
        "native_identity": { "$ref": "#/$defs/nonempty" },
        "source_commit": { "$ref": "#/$defs/gitObject" },
        "source_tree": { "$ref": "#/$defs/gitObject" },
        "runtime_implementation_sha256": { "$ref": "#/$defs/sha256" },
        "outcome": { "const": "pass" },
        "verifier_id": { "$ref": "#/$defs/nonempty" },
        "verification_authority": { "const": "authenticated_operator" },
        "verified_at": { "$ref": "#/$defs/rfc3339" },
        "evidence_artifacts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "$ref": "#/$defs/artifact" }
        }
      },
      "required": [
        "schema",
        "evidence_kind",
        "native_identity",
        "source_commit",
        "source_tree",
        "runtime_implementation_sha256",
        "outcome",
        "verifier_id",
        "verification_authority",
        "verified_at",
        "evidence_artifacts"
      ]
    },
    "migration": {
      "allOf": [
        { "$ref": "#/$defs/common" },
        {
          "type": "object",
          "properties": {
            "schema": { "const": "bms.shared-package.migration-acceptance.v1" },
            "evidence_kind": { "const": "migration" },
            "store_id": {
              "enum": ["global-experiments", "molbio-domain", "molbio-ngs-domain"]
            },
            "migration_version": {
              "oneOf": [
                { "type": "integer", "minimum": 1 },
                { "type": "string", "pattern": "^[0-9]{4}_[a-z0-9_]+$" }
              ]
            },
            "migration_checksum": { "$ref": "#/$defs/sha256" },
            "schema_attestation": {
              "type": "object",
              "minProperties": 1
            }
          },
          "required": ["store_id", "migration_version", "migration_checksum", "schema_attestation"]
        }
      ],
      "unevaluatedProperties": false
    },
    "connector": {
      "allOf": [
        { "$ref": "#/$defs/common" },
        {
          "type": "object",
          "properties": {
            "schema": { "const": "bms.shared-package.connector-acceptance.v1" },
            "evidence_kind": { "const": "connector" },
            "connector_status": { "const": "healthy" },
            "source_store_id": { "$ref": "#/$defs/nonempty" },
            "target_store_id": { "$ref": "#/$defs/nonempty" },
            "event_count": { "type": "integer", "minimum": 0 },
            "command_count": { "type": "integer", "minimum": 0 },
            "convergence_sha256": { "$ref": "#/$defs/sha256" }
          },
          "required": [
            "connector_status",
            "source_store_id",
            "target_store_id",
            "event_count",
            "command_count",
            "convergence_sha256"
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "workflow": {
      "allOf": [
        { "$ref": "#/$defs/common" },
        {
          "type": "object",
          "properties": {
            "schema": { "const": "bms.shared-package.workflow-acceptance.v1" },
            "evidence_kind": { "const": "workflow" },
            "workflow_id": { "$ref": "#/$defs/nonempty" },
            "workflow_status": { "const": "pass" },
            "preparation_id": { "$ref": "#/$defs/nonempty" },
            "run_group_id": { "$ref": "#/$defs/nonempty" },
            "terminal_receipt_sha256": { "$ref": "#/$defs/sha256" }
          },
          "required": [
            "workflow_id",
            "workflow_status",
            "preparation_id",
            "run_group_id",
            "terminal_receipt_sha256"
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "developmentDeployment": {
      "allOf": [
        { "$ref": "#/$defs/common" },
        {
          "type": "object",
          "properties": {
            "schema": { "const": "bms.shared-package.development-deployment.v1" },
            "evidence_kind": { "const": "development_deployment" },
            "environment": { "const": "Development" },
            "deployment_status": { "const": "deployed" },
            "service_name": { "$ref": "#/$defs/nonempty" },
            "process_id": { "type": "integer", "minimum": 1 },
            "listener_identity": { "$ref": "#/$defs/nonempty" }
          },
          "required": [
            "environment",
            "deployment_status",
            "service_name",
            "process_id",
            "listener_identity"
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "exactTreeReview": {
      "allOf": [
        { "$ref": "#/$defs/common" },
        {
          "type": "object",
          "properties": {
            "schema": { "const": "bms.shared-package.exact-tree-review.v1" },
            "evidence_kind": { "const": "exact_tree_review" },
            "review_status": { "const": "pass" },
            "diff_sha256": { "$ref": "#/$defs/sha256" },
            "reviewed_path_count": { "type": "integer", "minimum": 1, "maximum": 100000 }
          },
          "required": ["review_status", "diff_sha256", "reviewed_path_count"]
        }
      ],
      "unevaluatedProperties": false
    },
    "healthCheck": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "check_id": { "$ref": "#/$defs/nonempty" },
        "status": { "const": "pass" },
        "evidence_sha256": { "$ref": "#/$defs/sha256" }
      },
      "required": ["check_id", "status", "evidence_sha256"]
    },
    "health": {
      "allOf": [
        { "$ref": "#/$defs/common" },
        {
          "type": "object",
          "properties": {
            "schema": { "const": "bms.shared-package.health-acceptance.v1" },
            "evidence_kind": { "const": "health" },
            "health_status": { "const": "healthy" },
            "health_checks": {
              "type": "array",
              "minItems": 1,
              "maxItems": 128,
              "items": { "$ref": "#/$defs/healthCheck" }
            }
          },
          "required": ["health_status", "health_checks"]
        }
      ],
      "unevaluatedProperties": false
    },
    "browserScenario": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scenario_id": { "$ref": "#/$defs/nonempty" },
        "status": { "const": "pass" },
        "capture_sha256": { "$ref": "#/$defs/sha256" }
      },
      "required": ["scenario_id", "status", "capture_sha256"]
    },
    "browser": {
      "allOf": [
        { "$ref": "#/$defs/common" },
        {
          "type": "object",
          "properties": {
            "schema": { "const": "bms.shared-package.browser-acceptance.v1" },
            "evidence_kind": { "const": "browser" },
            "scenario_status": { "const": "pass" },
            "scenarios": {
              "type": "array",
              "minItems": 1,
              "maxItems": 128,
              "items": { "$ref": "#/$defs/browserScenario" }
            }
          },
          "required": ["scenario_status", "scenarios"]
        }
      ],
      "unevaluatedProperties": false
    },
    "focusedCheck": {
      "allOf": [
        { "$ref": "#/$defs/common" },
        {
          "type": "object",
          "properties": {
            "schema": { "const": "bms.shared-package.focused-check.v1" },
            "evidence_kind": { "const": "focused_check" },
            "check_id": { "$ref": "#/$defs/nonempty" },
            "check_status": { "const": "pass" },
            "command_sha256": { "$ref": "#/$defs/sha256" },
            "output_sha256": { "$ref": "#/$defs/sha256" }
          },
          "required": ["check_id", "check_status", "command_sha256", "output_sha256"]
        }
      ],
      "unevaluatedProperties": false
    }
  }
}
