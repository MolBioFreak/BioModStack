{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://biomodstack.local/schemas/md_run_v1.schema.json",
  "title": "BioModStack MD Run Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "job_schema", "status", "created_at", "job_id", "replica_index", "replica_seed", "engine", "config", "stages", "artifacts"],
  "properties": {
    "schema": {"const": "bms.md.run.v1"},
    "job_schema": {"const": "bms.md.job.v1"},
    "status": {"enum": ["completed", "failed", "cancelled"]},
    "created_at": {"type": "string", "format": "date-time"},
    "job_id": {"type": "string", "minLength": 1},
    "replica_index": {"type": "integer", "minimum": 0},
    "replica_seed": {"type": "integer", "minimum": 1, "maximum": 2147483647},
    "engine": {
      "type": "object",
      "additionalProperties": true,
      "required": ["name", "version", "platform", "runtime"],
      "properties": {
        "name": {"enum": ["gromacs", "openmm"]},
        "version": {"type": "string", "minLength": 1},
        "platform": {"type": "string", "minLength": 1},
        "cuda_enabled": {"type": "boolean"},
        "binary": {"type": "string", "minLength": 1},
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sif_sha256", "image_name"],
          "properties": {
            "sif_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "image_name": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "config": {"type": "object"},
    "stages": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": {"enum": ["pending", "running", "completed", "failed", "skipped"]}
        },
        "additionalProperties": true
      }
    },
    "artifacts": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/artifact"}
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "pattern": "^(?!/)"},
        "bytes": {"type": "integer", "minimum": 0},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "semantic_role": {"enum": ["analysis_topology", "analysis_trajectory", "atom_order_manifest", "representative_structure", "trajectory_frame_map"]},
        "atom_order_identity": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "selection_method": {"const": "completed_production_final_coordinates"},
        "source_frame": {"oneOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]},
        "time_ps": {"type": "number", "minimum": 0},
        "source_trajectory_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
