{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bms:interactive-checkpoint:1",
  "title": "Shared local/worker interactive checkpoint v1",
  "$defs": {
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "job_id",
        "attempt_id",
        "worker_id",
        "source_digest",
        "plan_digest"
      ],
      "properties": {
        "job_id": {
          "type": "string",
          "minLength": 1
        },
        "attempt_id": {
          "type": "string",
          "minLength": 1
        },
        "worker_id": {
          "type": "string",
          "minLength": 1
        },
        "source_digest": {
          "type": "string",
          "minLength": 1
        },
        "plan_digest": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "sha256"
      ],
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "role",
        "path",
        "sha256",
        "size_bytes",
        "format"
      ],
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "candidate",
            "review"
          ]
        },
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "format": {
          "type": "string"
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "job_id",
        "attempt_id",
        "worker_id",
        "source_digest",
        "plan_digest",
        "checkpoint_id",
        "decision_id",
        "action",
        "selected_artifacts"
      ],
      "properties": {
        "schema_version": {
          "const": "bms.interactive-checkpoint/1"
        },
        "job_id": {
          "type": "string",
          "minLength": 1
        },
        "attempt_id": {
          "type": "string",
          "minLength": 1
        },
        "worker_id": {
          "type": "string",
          "minLength": 1
        },
        "source_digest": {
          "type": "string",
          "minLength": 1
        },
        "plan_digest": {
          "type": "string",
          "minLength": 1
        },
        "checkpoint_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "decision_id": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "enum": [
            "continue",
            "reject"
          ]
        },
        "selected_artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/selection"
          },
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "action": {
                "const": "continue"
              }
            }
          },
          "then": {
            "properties": {
              "selected_artifacts": {
                "minItems": 1
              }
            }
          },
          "else": {
            "properties": {
              "selected_artifacts": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "job_id",
        "attempt_id",
        "worker_id",
        "source_digest",
        "plan_digest",
        "checkpoint_id",
        "stage",
        "artifacts",
        "metadata",
        "science_complete",
        "retrieval_policy"
      ],
      "properties": {
        "schema_version": {
          "const": "bms.interactive-checkpoint/1"
        },
        "job_id": {
          "type": "string",
          "minLength": 1
        },
        "attempt_id": {
          "type": "string",
          "minLength": 1
        },
        "worker_id": {
          "type": "string",
          "minLength": 1
        },
        "source_digest": {
          "type": "string",
          "minLength": 1
        },
        "plan_digest": {
          "type": "string",
          "minLength": 1
        },
        "checkpoint_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "stage": {
          "enum": [
            "post_rfantibody",
            "post_fampnn",
            "post_structure_validation",
            "post_ppiflow_generator"
          ]
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifact"
          },
          "minItems": 1
        },
        "metadata": {
          "type": "object"
        },
        "science_complete": {
          "const": false
        },
        "retrieval_policy": {
          "const": "explicit_review_only"
        }
      }
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/receipt"
    },
    {
      "$ref": "#/$defs/decision"
    }
  ]
}
