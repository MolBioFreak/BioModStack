{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bms.project-manager.read-model.v2",
  "title": "BioModStack Project Manager composite read model v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "subject_id",
    "subject_generation",
    "assembled_at",
    "source_receipt_ids",
    "source_authorities",
    "source_digest_set_sha256",
    "adapter_versions",
    "reconciliation",
    "counts",
    "status_summary",
    "pagination",
    "project",
    "tree",
    "map",
    "selection",
    "runs",
    "warnings",
    "allowed_actions"
  ],
  "properties": {
    "schema": {"const": "bms.project-manager.read-model.v2"},
    "subject_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "subject_generation": {"type": "integer", "minimum": 0},
    "assembled_at": {"type": "string", "format": "date-time"},
    "source_receipt_ids": {
      "type": "array",
      "maxItems": 1000,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 128}
    },
    "source_authorities": {
      "type": "array",
      "maxItems": 2000,
      "items": {"$ref": "#/$defs/sourceAuthority"},
      "uniqueItems": true
    },
    "source_digest_set_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "adapter_versions": {
      "type": "array",
      "maxItems": 256,
      "items": {"$ref": "#/$defs/adapterVersion"},
      "uniqueItems": true
    },
    "reconciliation": {"$ref": "#/$defs/reconciliation"},
    "counts": {"$ref": "#/$defs/counts"},
    "status_summary": {"$ref": "#/$defs/statusSummary"},
    "pagination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["results", "lineage", "notes", "decisions", "datasets", "activity"],
      "properties": {
        "results": {"$ref": "#/$defs/page"},
        "lineage": {"$ref": "#/$defs/page"},
        "notes": {"$ref": "#/$defs/page"},
        "decisions": {"$ref": "#/$defs/page"},
        "datasets": {"$ref": "#/$defs/page"},
        "activity": {"$ref": "#/$defs/page"}
      }
    },
    "project": {"$ref": "#/$defs/project"},
    "tree": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parent_node_key", "nodes", "next_cursor", "has_more", "total"],
      "properties": {
        "parent_node_key": {"type": "string", "minLength": 1, "maxLength": 512},
        "nodes": {
          "type": "array",
          "maxItems": 100,
          "items": {"$ref": "#/$defs/treeNode"}
        },
        "next_cursor": {"$ref": "#/$defs/cursor"},
        "has_more": {"type": "boolean"},
        "total": {"$ref": "#/$defs/optionalTotal"}
      },
      "allOf": [
        {"if": {"properties": {"has_more": {"const": true}}, "required": ["has_more"]}, "then": {"properties": {"next_cursor": {"type": "string", "minLength": 1, "maxLength": 512}, "nodes": {"minItems": 1}}}},
        {"if": {"properties": {"has_more": {"const": false}}, "required": ["has_more"]}, "then": {"properties": {"next_cursor": {"type": "null"}}}}
      ]
    },
    "map": {
      "type": "object",
      "additionalProperties": false,
      "required": ["focus_node_key", "nodes", "edges", "stream_record_count", "next_cursor", "has_more", "total"],
      "properties": {
        "focus_node_key": {"type": "string", "minLength": 1, "maxLength": 512},
        "nodes": {"type": "array", "maxItems": 201, "items": {"$ref": "#/$defs/mapNode"}},
        "edges": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/mapEdge"}},
        "stream_record_count": {"type": "integer", "minimum": 0, "maximum": 100},
        "next_cursor": {"$ref": "#/$defs/cursor"},
        "has_more": {"type": "boolean"},
        "total": {"$ref": "#/$defs/optionalTotal"}
      },
      "allOf": [
        {"if": {"properties": {"has_more": {"const": true}}, "required": ["has_more"]}, "then": {"properties": {"next_cursor": {"type": "string", "minLength": 1, "maxLength": 512}, "stream_record_count": {"minimum": 1}}}},
        {"if": {"properties": {"has_more": {"const": false}}, "required": ["has_more"]}, "then": {"properties": {"next_cursor": {"type": "null"}}}}
      ]
    },
    "selection": {"$ref": "#/$defs/selection"},
    "runs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items", "next_cursor", "has_more", "total"],
      "properties": {
        "items": {"type": "array", "maxItems": 100, "items": {"$ref": "bms.project-manager.run.v2"}},
        "next_cursor": {"$ref": "#/$defs/cursor"},
        "has_more": {"type": "boolean"},
        "total": {"$ref": "#/$defs/optionalTotal"}
      },
      "allOf": [
        {"if": {"properties": {"has_more": {"const": true}}, "required": ["has_more"]}, "then": {"properties": {"next_cursor": {"type": "string", "minLength": 1, "maxLength": 512}, "items": {"minItems": 1}}}},
        {"if": {"properties": {"has_more": {"const": false}}, "required": ["has_more"]}, "then": {"properties": {"next_cursor": {"type": "null"}}}}
      ]
    },
    "warnings": {
      "type": "array",
      "maxItems": 256,
      "items": {"$ref": "#/$defs/warning"}
    },
    "allowed_actions": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 128}
    }
  },
  "$defs": {
    "cursor": {
      "anyOf": [
        {"type": "string", "minLength": 1, "maxLength": 512},
        {"type": "null"}
      ]
    },
    "optionalTotal": {
      "anyOf": [
        {"type": "integer", "minimum": 0},
        {"type": "null"}
      ]
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items", "next_cursor", "has_more", "total"],
      "properties": {
        "items": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "allOf": [
              {"$ref": "#/$defs/typedEnvelope"},
              {"required": ["stable_id"]}
            ]
          }
        },
        "next_cursor": {"$ref": "#/$defs/cursor"},
        "has_more": {"type": "boolean"},
        "total": {"$ref": "#/$defs/optionalTotal"}
      },
      "allOf": [
        {"if": {"properties": {"has_more": {"const": true}}, "required": ["has_more"]}, "then": {"properties": {"next_cursor": {"type": "string", "minLength": 1, "maxLength": 512}, "items": {"minItems": 1}}}},
        {"if": {"properties": {"has_more": {"const": false}}, "required": ["has_more"]}, "then": {"properties": {"next_cursor": {"type": "null"}}}}
      ]
    },
    "sourceAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority_kind", "stable_id", "revision_or_generation", "content_sha256", "adapter_id", "adapter_version"],
      "properties": {
        "authority_kind": {"type": "string", "minLength": 1, "maxLength": 128},
        "stable_id": {"type": "string", "minLength": 1, "maxLength": 255},
        "revision_or_generation": {"type": "string", "minLength": 1, "maxLength": 255},
        "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "adapter_id": {"anyOf": [{"type": "string", "minLength": 1, "maxLength": 255}, {"type": "null"}]},
        "adapter_version": {"anyOf": [{"type": "string", "minLength": 1, "maxLength": 128}, {"type": "null"}]}
      }
    },
    "typedEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "source_authority_keys", "payload"],
      "properties": {
        "schema": {"type": "string", "pattern": "^bms\\.[A-Za-z0-9_.-]+$", "maxLength": 255},
        "stable_id": {"type": "string", "minLength": 1, "maxLength": 255},
        "source_authority_keys": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "payload": {"type": "object"}
      }
    },
    "adapterVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter_id", "version"],
      "properties": {
        "adapter_id": {"type": "string", "minLength": 1, "maxLength": 255},
        "version": {"type": "string", "minLength": 1, "maxLength": 128}
      }
    },
    "reconciliation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "last_verified_at", "reason"],
      "properties": {
        "state": {"enum": ["current", "pending", "stale", "source_unavailable", "digest_mismatch"]},
        "last_verified_at": {"anyOf": [{"type": "string", "format": "date-time"}, {"type": "null"}]},
        "reason": {"anyOf": [{"type": "string", "maxLength": 2048}, {"type": "null"}]}
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["global_experiments", "domain_experiments", "linked_local_projects", "workflow_plans", "runs", "results", "dataset_revisions", "notes", "decisions", "attached_entities", "unresolved_reconciliation"],
      "properties": {
        "global_experiments": {"type": "integer", "minimum": 0},
        "domain_experiments": {"type": "integer", "minimum": 0},
        "linked_local_projects": {"type": "integer", "minimum": 0},
        "workflow_plans": {"type": "integer", "minimum": 0},
        "runs": {"type": "integer", "minimum": 0},
        "results": {"type": "integer", "minimum": 0},
        "dataset_revisions": {"type": "integer", "minimum": 0},
        "notes": {"type": "integer", "minimum": 0},
        "decisions": {"type": "integer", "minimum": 0},
        "attached_entities": {"type": "integer", "minimum": 0},
        "unresolved_reconciliation": {"type": "integer", "minimum": 0}
      }
    },
    "statusSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projects", "global_experiments", "domain_experiments", "project_links", "datasets", "workflow_plans", "runs", "reconciliation"],
      "properties": {
        "projects": {"$ref": "#/$defs/projectStateCounts"},
        "global_experiments": {"$ref": "#/$defs/globalStateCounts"},
        "domain_experiments": {"$ref": "#/$defs/domainStateCounts"},
        "project_links": {"$ref": "#/$defs/linkStateCounts"},
        "datasets": {"$ref": "#/$defs/activeArchiveCounts"},
        "workflow_plans": {"$ref": "#/$defs/planStateCounts"},
        "runs": {"$ref": "#/$defs/runStateCounts"},
        "reconciliation": {"$ref": "#/$defs/reconciliationStateCounts"}
      }
    },
    "projectStateCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["draft", "active", "on_hold", "completed", "archived"],
      "properties": {
        "draft": {"type": "integer", "minimum": 0},
        "active": {"type": "integer", "minimum": 0},
        "on_hold": {"type": "integer", "minimum": 0},
        "completed": {"type": "integer", "minimum": 0},
        "archived": {"type": "integer", "minimum": 0}
      }
    },
    "globalStateCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["draft", "planned", "active", "analysis", "review", "completed", "blocked", "archived"],
      "properties": {
        "draft": {"type": "integer", "minimum": 0},
        "planned": {"type": "integer", "minimum": 0},
        "active": {"type": "integer", "minimum": 0},
        "analysis": {"type": "integer", "minimum": 0},
        "review": {"type": "integer", "minimum": 0},
        "completed": {"type": "integer", "minimum": 0},
        "blocked": {"type": "integer", "minimum": 0},
        "archived": {"type": "integer", "minimum": 0}
      }
    },
    "domainStateCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["draft", "planned", "active", "analysis", "review", "completed", "blocked", "archived"],
      "properties": {
        "draft": {"type": "integer", "minimum": 0},
        "planned": {"type": "integer", "minimum": 0},
        "active": {"type": "integer", "minimum": 0},
        "analysis": {"type": "integer", "minimum": 0},
        "review": {"type": "integer", "minimum": 0},
        "completed": {"type": "integer", "minimum": 0},
        "blocked": {"type": "integer", "minimum": 0},
        "archived": {"type": "integer", "minimum": 0}
      }
    },
    "linkStateCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["active", "revoked"],
      "properties": {
        "active": {"type": "integer", "minimum": 0},
        "revoked": {"type": "integer", "minimum": 0}
      }
    },
    "activeArchiveCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["active", "archived"],
      "properties": {
        "active": {"type": "integer", "minimum": 0},
        "archived": {"type": "integer", "minimum": 0}
      }
    },
    "planStateCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["active_unpublished", "active_published", "archived"],
      "properties": {
        "active_unpublished": {"type": "integer", "minimum": 0},
        "active_published": {"type": "integer", "minimum": 0},
        "archived": {"type": "integer", "minimum": 0}
      }
    },
    "runStateCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["planned", "prepared", "queued", "running", "paused", "cancelling", "completed", "failed", "cancelled", "blocked", "unknown"],
      "properties": {
        "planned": {"type": "integer", "minimum": 0},
        "prepared": {"type": "integer", "minimum": 0},
        "queued": {"type": "integer", "minimum": 0},
        "running": {"type": "integer", "minimum": 0},
        "paused": {"type": "integer", "minimum": 0},
        "cancelling": {"type": "integer", "minimum": 0},
        "completed": {"type": "integer", "minimum": 0},
        "failed": {"type": "integer", "minimum": 0},
        "cancelled": {"type": "integer", "minimum": 0},
        "blocked": {"type": "integer", "minimum": 0},
        "unknown": {"type": "integer", "minimum": 0}
      }
    },
    "reconciliationStateCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["current", "pending", "stale", "source_unavailable", "digest_mismatch"],
      "properties": {
        "current": {"type": "integer", "minimum": 0},
        "pending": {"type": "integer", "minimum": 0},
        "stale": {"type": "integer", "minimum": 0},
        "source_unavailable": {"type": "integer", "minimum": 0},
        "digest_mismatch": {"type": "integer", "minimum": 0}
      }
    },
    "nodeCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["children", "plans", "runs", "results", "datasets", "records", "unresolved"],
      "properties": {
        "children": {"type": "integer", "minimum": 0},
        "plans": {"type": "integer", "minimum": 0},
        "runs": {"type": "integer", "minimum": 0},
        "results": {"type": "integer", "minimum": 0},
        "datasets": {"type": "integer", "minimum": 0},
        "records": {"type": "integer", "minimum": 0},
        "unresolved": {"type": "integer", "minimum": 0}
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "project_scope", "name", "objective", "lifecycle_state", "head_generation", "current_revision_id", "updated_at"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 128},
        "project_scope": {"enum": ["global", "ngs_molbio_local"]},
        "name": {"type": "string", "minLength": 1, "maxLength": 255},
        "objective": {"type": "string", "maxLength": 8192},
        "lifecycle_state": {"enum": ["draft", "active", "on_hold", "completed", "archived"]},
        "head_generation": {"type": "integer", "minimum": 0},
        "current_revision_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "updated_at": {"type": "string", "format": "date-time"}
      }
    },
    "treeNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_key", "node_type", "subject_id", "parent_node_key", "label", "lifecycle_state", "counts", "has_children", "allowed_actions"],
      "properties": {
        "node_key": {"type": "string", "minLength": 1, "maxLength": 512},
        "node_type": {"enum": ["project", "global_experiment", "domain_experiment", "linked_local_project", "virtual_folder"]},
        "subject_id": {"anyOf": [{"type": "string", "minLength": 1, "maxLength": 128}, {"type": "null"}]},
        "parent_node_key": {"anyOf": [{"type": "string", "minLength": 1, "maxLength": 512}, {"type": "null"}]},
        "label": {"type": "string", "minLength": 1, "maxLength": 512},
        "lifecycle_state": {"anyOf": [{"type": "string", "maxLength": 128}, {"type": "null"}]},
        "counts": {"$ref": "#/$defs/nodeCounts"},
        "has_children": {"type": "boolean"},
        "allowed_actions": {"type": "array", "maxItems": 128, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}}
      }
    },
    "mapNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_key", "node_type", "label", "normalized_state", "canonical_source_identity", "counts", "reconciliation", "allowed_actions"],
      "properties": {
        "node_key": {"type": "string", "minLength": 1, "maxLength": 512},
        "node_type": {"enum": ["project", "global_experiment", "domain_experiment", "linked_local_project", "virtual_folder", "workflow_plan", "run", "result", "dataset_revision", "research_record", "external_receipt"]},
        "label": {"type": "string", "minLength": 1, "maxLength": 512},
        "normalized_state": {"anyOf": [{"type": "string", "maxLength": 128}, {"type": "null"}]},
        "canonical_source_identity": {"anyOf": [{"$ref": "#/$defs/typedEnvelope"}, {"type": "null"}]},
        "counts": {"$ref": "#/$defs/nodeCounts"},
        "reconciliation": {"$ref": "#/$defs/reconciliation"},
        "allowed_actions": {"type": "array", "maxItems": 128, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}}
      }
    },
    "mapEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["edge_key", "source_node_key", "target_node_key", "lineage_mode", "accessible_label", "metadata"],
      "properties": {
        "edge_key": {"type": "string", "minLength": 1, "maxLength": 512},
        "source_node_key": {"type": "string", "minLength": 1, "maxLength": 512},
        "target_node_key": {"type": "string", "minLength": 1, "maxLength": 512},
        "lineage_mode": {"enum": ["owns", "contains", "derived_from", "uses_input", "produced", "validated_by", "compared_with", "retried_from", "resubmitted_from", "supersedes", "references", "supports_conclusion"]},
        "accessible_label": {"type": "string", "minLength": 1, "maxLength": 512},
        "metadata": {"$ref": "#/$defs/typedEnvelope"}
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_key", "node_type", "title", "subtitle", "canonical_identity", "summary", "relationship", "scientific_context", "reconciliation", "available_actions", "canonical_surface"],
      "properties": {
        "node_key": {"type": "string", "minLength": 1, "maxLength": 512},
        "node_type": {"type": "string", "minLength": 1, "maxLength": 128},
        "title": {"type": "string", "minLength": 1, "maxLength": 512},
        "subtitle": {"anyOf": [{"type": "string", "maxLength": 2048}, {"type": "null"}]},
        "canonical_identity": {"$ref": "#/$defs/typedEnvelope"},
        "summary": {"$ref": "#/$defs/typedEnvelope"},
        "relationship": {"$ref": "#/$defs/typedEnvelope"},
        "scientific_context": {"$ref": "#/$defs/typedEnvelope"},
        "reconciliation": {"$ref": "#/$defs/reconciliation"},
        "available_actions": {"type": "array", "maxItems": 128, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
        "canonical_surface": {"anyOf": [{"$ref": "#/$defs/typedEnvelope"}, {"type": "null"}]}
      }
    },

    "warning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["severity", "code", "message"],
      "properties": {
        "severity": {"enum": ["info", "warning", "failure"]},
        "code": {"type": "string", "minLength": 1, "maxLength": 128},
        "message": {"type": "string", "minLength": 1, "maxLength": 2048}
      }
    }
  }
}
