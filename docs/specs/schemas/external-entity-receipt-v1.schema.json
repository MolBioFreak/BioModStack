{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bms.global.external-entity-receipt.v1",
  "title": "BioModStack External Entity Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "store_id", "entity_kind", "entity_id", "entity_revision_id", "content_digest", "contract_digest", "source_build_revision", "verified_at", "verifier_id", "reopen_uri", "metadata"],
  "properties": {
    "schema": {"const": "bms.global.external-entity-receipt.v1"},
    "store_id": {"enum": ["core", "molbio", "ont", "bioxp", "other-approved-store"]},
    "entity_kind": {"type": "string", "minLength": 1},
    "entity_id": {"type": "string", "minLength": 1},
    "entity_revision_id": {"type": ["string", "null"]},
    "content_digest": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "contract_digest": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "source_build_revision": {"type": ["string", "null"]},
    "verified_at": {"type": "string", "format": "date-time"},
    "verifier_id": {"type": "string", "minLength": 1},
    "reopen_uri": {"type": "string", "pattern": "^/"},
    "metadata": {"type": "object"}
  },
  "anyOf": [
    {"properties": {"content_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    {"properties": {"contract_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}
  ]
}
