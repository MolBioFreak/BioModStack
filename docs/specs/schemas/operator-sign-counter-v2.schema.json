{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bms.operator-sign-counter.v2",
  "title": "Atomic WebAuthn sign-counter advancement v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "sign_counter_receipt_id",
    "credential_id_base64url",
    "credential_id_sha256",
    "challenge_id",
    "expected_generation",
    "new_generation",
    "prior_sign_count",
    "asserted_sign_count",
    "accepted_sign_count",
    "counter_mode",
    "transition_algorithm",
    "transition_validation_artifact",
    "atomic_compare_and_advance",
    "counter_service_assertion",
    "advanced_at",
    "self_digest_algorithm",
    "receipt_sha256"
  ],
  "properties": {
    "schema": {
      "const": "bms.operator-sign-counter.v2"
    },
    "sign_counter_receipt_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "credential_id_base64url": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{16,4096}$"
    },
    "credential_id_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "challenge_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "expected_generation": {
      "type": "integer",
      "minimum": 0
    },
    "new_generation": {
      "type": "integer",
      "minimum": 1
    },
    "prior_sign_count": {
      "type": "integer",
      "minimum": 0
    },
    "asserted_sign_count": {
      "type": "integer",
      "minimum": 0
    },
    "accepted_sign_count": {
      "type": "integer",
      "minimum": 0
    },
    "atomic_compare_and_advance": {
      "const": true
    },
    "counter_service_assertion": {
      "allOf": [
        {
          "$ref": "bms.project-manager.operational-evidence.v2#/$defs/writerAssertion"
        },
        {
          "type": "object",
          "properties": {
            "principal_id": {
              "const": "bms-development-authn-service"
            }
          },
          "required": [
            "principal_id"
          ]
        }
      ]
    },
    "advanced_at": {
      "type": "string",
      "format": "date-time"
    },
    "receipt_sha256": {
      "allOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      ],
      "description": "SHA-256 of RFC 8785 UTF-8 for the complete signed document after all assertions are inserted, with only receipt_sha256 omitted."
    },
    "self_digest_algorithm": {
      "const": "sha256-rfc8785-complete-signed-document-omit-self-digest-v2"
    },
    "counter_mode": {
      "enum": [
        "supported",
        "unsupported_zero"
      ]
    },
    "transition_algorithm": {
      "const": "webauthn-sign-counter-atomic-transition-v2",
      "description": "Require atomic stored generation and prior count equality, new_generation=expected_generation+1, strict supported-counter increase, exact unsupported zero semantics, and exact credential/challenge binding."
    },
    "transition_validation_artifact": {
      "$ref": "bms.project-manager.operational-evidence.v2#/$defs/canonicalJsonArtifact"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "counter_mode": {
            "const": "unsupported_zero"
          }
        }
      },
      "then": {
        "properties": {
          "prior_sign_count": {
            "const": 0
          },
          "asserted_sign_count": {
            "const": 0
          },
          "accepted_sign_count": {
            "const": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "counter_mode": {
            "const": "supported"
          }
        }
      },
      "then": {
        "properties": {
          "asserted_sign_count": {
            "minimum": 1
          },
          "accepted_sign_count": {
            "minimum": 1
          }
        }
      }
    }
  ]
}
