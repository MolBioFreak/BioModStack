{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bms.project-manager.semantic-validator.v1",
  "title": "Package-bound scientific semantic uniqueness validator v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "validator_id",
    "implementation_artifact",
    "rules",
    "gates",
    "duplicate_fixture_manifest",
    "content_algorithm",
    "content_sha256"
  ],
  "properties": {
    "schema": {
      "const": "bms.project-manager.semantic-validator.v1"
    },
    "validator_id": {
      "const": "bms.project-manager.semantic-validator.v1"
    },
    "implementation_artifact": {
      "allOf": [
        {
          "$ref": "bms.project-manager.operational-evidence.v1#/$defs/rawArtifact"
        },
        {
          "type": "object",
          "properties": {
            "storage_identity": {
              "const": "platform/api/app/services/project_manager_semantic_validator_v1.py"
            }
          },
          "required": [
            "storage_identity"
          ]
        }
      ]
    },
    "rules": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": false,
      "prefixItems": [
        {
          "allOf": [
            {
              "$ref": "#/$defs/rule"
            },
            {
              "type": "object",
              "properties": {
                "rule_id": {
                  "const": "ngs-group-id-unique"
                },
                "array_pointer": {
                  "const": "/domain_payload/grouping_intent"
                },
                "unique_tuple": {
                  "const": "group_id"
                },
                "scope": {
                  "const": "payload"
                }
              },
              "required": [
                "rule_id",
                "array_pointer",
                "unique_tuple",
                "scope"
              ]
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/rule"
            },
            {
              "type": "object",
              "properties": {
                "rule_id": {
                  "const": "ngs-group-member-semantic-unique"
                },
                "array_pointer": {
                  "const": "/domain_payload/grouping_intent/*/members"
                },
                "unique_tuple": {
                  "const": "member_kind,resource_id,role"
                },
                "scope": {
                  "const": "parent-group"
                }
              },
              "required": [
                "rule_id",
                "array_pointer",
                "unique_tuple",
                "scope"
              ]
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/rule"
            },
            {
              "type": "object",
              "properties": {
                "rule_id": {
                  "const": "ngs-group-member-ordinal-unique"
                },
                "array_pointer": {
                  "const": "/domain_payload/grouping_intent/*/members"
                },
                "unique_tuple": {
                  "const": "ordinal"
                },
                "scope": {
                  "const": "parent-group"
                }
              },
              "required": [
                "rule_id",
                "array_pointer",
                "unique_tuple",
                "scope"
              ]
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/rule"
            },
            {
              "type": "object",
              "properties": {
                "rule_id": {
                  "const": "ngs-criterion-id-unique"
                },
                "array_pointer": {
                  "const": "/domain_payload/acceptance_criteria"
                },
                "unique_tuple": {
                  "const": "criterion_id"
                },
                "scope": {
                  "const": "payload"
                }
              },
              "required": [
                "rule_id",
                "array_pointer",
                "unique_tuple",
                "scope"
              ]
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/rule"
            },
            {
              "type": "object",
              "properties": {
                "rule_id": {
                  "const": "ngs-evidence-requirement-id-unique"
                },
                "array_pointer": {
                  "const": "/domain_payload/evidence_plan"
                },
                "unique_tuple": {
                  "const": "requirement_id"
                },
                "scope": {
                  "const": "payload"
                }
              },
              "required": [
                "rule_id",
                "array_pointer",
                "unique_tuple",
                "scope"
              ]
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/rule"
            },
            {
              "type": "object",
              "properties": {
                "rule_id": {
                  "const": "protein-comparison-member-semantic-unique"
                },
                "array_pointer": {
                  "const": "/domain_payload/comparison_groups/*/members"
                },
                "unique_tuple": {
                  "const": "target_id,role"
                },
                "scope": {
                  "const": "parent-comparison-group"
                }
              },
              "required": [
                "rule_id",
                "array_pointer",
                "unique_tuple",
                "scope"
              ]
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/rule"
            },
            {
              "type": "object",
              "properties": {
                "rule_id": {
                  "const": "protein-comparison-member-ordinal-unique"
                },
                "array_pointer": {
                  "const": "/domain_payload/comparison_groups/*/members"
                },
                "unique_tuple": {
                  "const": "ordinal"
                },
                "scope": {
                  "const": "parent-comparison-group"
                }
              },
              "required": [
                "rule_id",
                "array_pointer",
                "unique_tuple",
                "scope"
              ]
            }
          ]
        }
      ]
    },
    "gates": {
      "const": [
        "create",
        "domain-upgrade",
        "patch",
        "exact-read",
        "migration",
        "backup",
        "restoration",
        "export",
        "preparation",
        "replay"
      ]
    },
    "duplicate_fixture_manifest": {
      "$ref": "bms.project-manager.operational-evidence.v1#/$defs/canonicalJsonArtifact"
    },
    "content_algorithm": {
      "const": "sha256-rfc8785-semantic-validator-contract-v1"
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "$defs": {
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "array_pointer",
        "unique_tuple",
        "scope",
        "duplicate_error"
      ],
      "properties": {
        "rule_id": {
          "type": "string",
          "enum": [
            "ngs-group-id-unique",
            "ngs-group-member-semantic-unique",
            "ngs-group-member-ordinal-unique",
            "ngs-criterion-id-unique",
            "ngs-evidence-requirement-id-unique",
            "protein-comparison-member-semantic-unique",
            "protein-comparison-member-ordinal-unique"
          ]
        },
        "array_pointer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "unique_tuple": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "scope": {
          "enum": [
            "payload",
            "parent-group",
            "parent-comparison-group"
          ]
        },
        "duplicate_error": {
          "const": "semantic_uniqueness_violation"
        }
      }
    }
  }
}
