        "comparison_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "export_verifier_assertion": {
      "allOf": [
        {
          "$ref": "bms.project-manager.operational-evidence.v2#/$defs/writerAssertion"
        },
        {
          "type": "object",
          "properties": {
            "principal_id": {
              "const": "bms-export-isolation-verifier-v1"
            }
          },
          "required": [
            "principal_id"
          ]
        }
      ]
    },
    "self_digest_algorithm": {
      "const": "sha256-rfc8785-complete-signed-document-omit-self-digest-v2"
    }
  },
  "$defs": {
    "exportStore": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "store_id",
        "store_binding_sha256",
        "canonical_rows_artifact_id",
        "canonical_rows_algorithm",
        "object_count",
        "canonical_rows_sha256"
      ],
      "properties": {
        "store_id": {
          "enum": [
            "global-experiments",
            "molbio-domain",
            "molbio-ngs-domain",
            "core-ngs",
            "biomodstack-native"
          ]
        },
        "store_binding_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "canonical_rows_artifact_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "canonical_rows_algorithm": {
          "const": "sha256-length-prefixed-sqlite-typed-rows-v1"
        },
        "object_count": {
          "type": "integer",
          "minimum": 0
        },
        "canonical_rows_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "exportRoot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root_id",
        "selected_files_manifest"
      ],
      "properties": {
        "root_id": {
          "enum": [
            "global-project-artifacts",
            "molbio-governed-artifacts",
            "ngs-governed-results",
            "bms-native-results"
          ]
        },
        "selected_files_manifest": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "manifest_schema_id",
            "manifest_id",
            "manifest_artifact_id",
            "manifest_content_sha256",
            "ordered_files_sha256",
            "file_count",
            "total_size_bytes"
          ],
          "properties": {
            "manifest_schema_id": {
              "const": "bms.project-manager.file-manifest.v2"
            },
            "manifest_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            },
            "manifest_artifact_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            },
            "manifest_content_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "ordered_files_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "file_count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            },
            "total_size_bytes": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "exportCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority_family",
        "object_count",
        "receipt_count",
        "artifact_count"
      ],
      "properties": {
        "authority_family": {
          "enum": [
            "project-manager",
            "ngs-molbio",
            "protein",
            "conformational-mapping",
            "molecular-dynamics",
            "frustrampnn",
            "structure-prediction",
            "trajectory"
          ]
        },
        "object_count": {
          "type": "integer",
          "minimum": 0
        },
        "receipt_count": {
          "type": "integer",
          "minimum": 0
        },
        "artifact_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
