  "additionalProperties": false,
  "required": [
    "schema",
    "export_receipt_id",
    "source_commit",
    "source_tree",
    "runtime_implementation_path",
    "runtime_implementation_algorithm",
    "runtime_implementation_sha256",
    "project_id",
    "project_revision_id",
    "project_generation",
    "project_sha256",
    "destination_classification",
