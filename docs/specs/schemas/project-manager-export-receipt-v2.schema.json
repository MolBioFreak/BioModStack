{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bms.project-manager.export-receipt.v2",
  "title": "Verified whole-Project export receipt v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "export_receipt_id",
    "source_commit",
    "source_tree",
    "runtime_implementation_path",
    "runtime_implementation_algorithm",
    "runtime_implementation_sha256",
    "project_id",
    "project_revision_id",
    "project_generation",
    "project_sha256",
    "destination_classification",
    "archive_artifact_id",
    "archive_algorithm",
    "archive_sha256",
    "archive_size_bytes",
    "export_manifest",
    "stores",
    "artifact_roots",
    "authority_family_coverage",
    "created_at",
    "created_by",
    "receipt_sha256"
  ],
  "properties": {
    "schema": {
      "const": "bms.project-manager.export-receipt.v2"
    },
    "export_receipt_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "source_tree": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "runtime_implementation_path": {
      "const": "platform/api/config/ngs_molbio_runtime/runtime_implementation_v1.json"
    },
    "runtime_implementation_algorithm": {
      "const": "sha256-raw-file-v1"
    },
    "runtime_implementation_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "project_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "project_revision_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "project_generation": {
      "type": "integer",
      "minimum": 0
    },
    "project_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "destination_classification": {
      "enum": [
        "governed-offline-archive",
        "governed-transfer-package"
      ]
    },
    "archive_artifact_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "archive_algorithm": {
      "const": "sha256-raw-file-v1"
    },
    "archive_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "archive_size_bytes": {
      "type": "integer",
      "minimum": 1
    },
    "export_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest_schema_id",
        "manifest_id",
        "manifest_artifact_id",
        "manifest_content_sha256",
        "ordered_files_sha256",
        "file_count",
        "total_size_bytes"
      ],
      "properties": {
        "manifest_schema_id": {
          "const": "bms.project-manager.file-manifest.v2"
        },
        "manifest_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "manifest_artifact_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "manifest_content_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "ordered_files_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "file_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "total_size_bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "stores": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": false,
      "prefixItems": [
        {
          "allOf": [
            {
              "$ref": "#/$defs/exportStore"
            },
            {
              "type": "object",
              "properties": {
                "store_id": {
                  "const": "global-experiments"
                }
              },
              "required": [
                "store_id"
              ]
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/exportStore"
            },
            {
              "type": "object",
              "properties": {
                "store_id": {
                  "const": "molbio-domain"
                }
              },
              "required": [
                "store_id"
              ]
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/exportStore"
            },
            {
              "type": "object",
              "properties": {
                "store_id": {
                  "const": "molbio-ngs-domain"
                }
              },
              "required": [
                "store_id"
              ]
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/exportStore"
            },
            {
              "type": "object",
              "properties": {
                "store_id": {
                  "const": "core-ngs"
                }
              },
              "required": [
                "store_id"
              ]
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/exportStore"
            },
            {
              "type": "object",
              "properties": {
                "store_id": {
                  "const": "biomodstack-native"
                }
              },
              "required": [
                "store_id"
              ]
            }
          ]
        }
      ]
    },
    "artifact_roots": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": false,
      "prefixItems": [
        {
          "allOf": [
            {
              "$ref": "#/$defs/exportRoot"
            },
            {
              "type": "object",
              "properties": {
                "root_id": {
                  "const": "global-project-artifacts"
                }
              },
              "required": [
                "root_id"
              ]
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/exportRoot"
            },
            {
              "type": "object",
              "properties": {
                "root_id": {
                  "const": "molbio-governed-artifacts"
                }
              },
              "required": [
                "root_id"
              ]
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/exportRoot"
            },
            {
              "type": "object",
              "properties": {
                "root_id": {
                  "const": "ngs-governed-results"
                }
              },
              "required": [
                "root_id"
              ]
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/exportRoot"
            },
            {
              "type": "object",
              "properties": {
                "root_id": {
                  "const": "bms-native-results"
                }
              },
              "required": [
                "root_id"
              ]
            }
          ]
        }
      ]
    },
    "authority_family_coverage": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": false,
      "prefixItems": [
        {
          "allOf": [
            {
              "$ref": "#/$defs/exportCoverage"
            },
            {
              "type": "object",
              "properties": {
                "authority_family": {
                  "const": "project-manager"
                }
              },
              "required": [
                "authority_family"
              ]
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/exportCoverage"
            },
            {
              "type": "object",
              "properties": {
                "authority_family": {
                  "const": "ngs-molbio"
                }
              },
              "required": [
                "authority_family"
              ]
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/exportCoverage"
            },
            {
              "type": "object",
              "properties": {
                "authority_family": {
                  "const": "protein"
                }
              },
              "required": [
                "authority_family"
              ]
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/exportCoverage"
            },
            {
              "type": "object",
              "properties": {
                "authority_family": {
                  "const": "conformational-mapping"
                }
              },
              "required": [
                "authority_family"
              ]
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/exportCoverage"
            },
            {
              "type": "object",
              "properties": {
                "authority_family": {
                  "const": "molecular-dynamics"
                }
              },
              "required": [
                "authority_family"
              ]
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/exportCoverage"
            },
            {
              "type": "object",
              "properties": {
                "authority_family": {
                  "const": "frustrampnn"
                }
              },
              "required": [
                "authority_family"
              ]
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/exportCoverage"
            },
            {
              "type": "object",
              "properties": {
                "authority_family": {
                  "const": "structure-prediction"
                }
              },
              "required": [
                "authority_family"
              ]
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/exportCoverage"
            },
            {
              "type": "object",
              "properties": {
                "authority_family": {
                  "const": "trajectory"
                }
              },
              "required": [
                "authority_family"
              ]
            }
          ]
        }
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_by": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "receipt_sha256": {
      "allOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      ],
      "description": "SHA-256 of UTF-8 RFC 8785 canonical JSON for the complete receipt with only receipt_sha256 omitted."
    }
  },
  "$defs": {
    "exportStore": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "store_id",
        "store_binding_sha256",
        "canonical_rows_artifact_id",
        "canonical_rows_algorithm",
        "object_count",
        "canonical_rows_sha256"
      ],
      "properties": {
        "store_id": {
          "enum": [
            "global-experiments",
            "molbio-domain",
            "molbio-ngs-domain",
            "core-ngs",
            "biomodstack-native"
          ]
        },
        "store_binding_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "canonical_rows_artifact_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "canonical_rows_algorithm": {
          "const": "sha256-length-prefixed-sqlite-typed-rows-v1"
        },
        "object_count": {
          "type": "integer",
          "minimum": 0
        },
        "canonical_rows_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "exportRoot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root_id",
        "selected_files_manifest"
      ],
      "properties": {
        "root_id": {
          "enum": [
            "global-project-artifacts",
            "molbio-governed-artifacts",
            "ngs-governed-results",
            "bms-native-results"
          ]
        },
        "selected_files_manifest": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "manifest_schema_id",
            "manifest_id",
            "manifest_artifact_id",
            "manifest_content_sha256",
            "ordered_files_sha256",
            "file_count",
            "total_size_bytes"
          ],
          "properties": {
            "manifest_schema_id": {
              "const": "bms.project-manager.file-manifest.v2"
            },
            "manifest_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            },
            "manifest_artifact_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            },
            "manifest_content_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "ordered_files_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "file_count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            },
            "total_size_bytes": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "exportCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority_family",
        "object_count",
        "receipt_count",
        "artifact_count"
      ],
      "properties": {
        "authority_family": {
          "enum": [
            "project-manager",
            "ngs-molbio",
            "protein",
            "conformational-mapping",
            "molecular-dynamics",
            "frustrampnn",
            "structure-prediction",
            "trajectory"
          ]
        },
        "object_count": {
          "type": "integer",
          "minimum": 0
        },
        "receipt_count": {
          "type": "integer",
          "minimum": 0
        },
        "artifact_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
