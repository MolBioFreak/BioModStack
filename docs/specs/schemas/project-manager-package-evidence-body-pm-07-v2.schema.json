{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bms.project-manager.package-evidence-body.pm07.v2",
  "title": "PM-07 authenticated coverage evidence body v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "evidence_body_id",
    "package_id",
    "coverage_item",
    "coverage_contract_id",
    "source_commit",
    "source_tree",
    "coverage_denominator",
    "producer_receipts",
    "positive_observations",
    "negative_observations",
    "resolver_trace",
    "evidence_kinds",
    "native_owner_attestations",
    "self_digest_algorithm",
    "content_sha256"
  ],
  "properties": {
    "schema": {
      "const": "bms.project-manager.package-evidence-body.pm07.v2"
    },
    "evidence_body_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "package_id": {
      "const": "PM-07"
    },
    "coverage_item": {
      "enum": [
        "receipt-freshness",
        "successor-receipts",
        "domain-lineage",
        "restart-reverification"
      ]
    },
    "coverage_contract_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "source_tree": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "coverage_denominator": {
      "$ref": "bms.project-manager.operational-evidence.v2#/$defs/canonicalJsonArtifact"
    },
    "producer_receipts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "bms.project-manager.operational-evidence.v2#/$defs/receiptPointer"
      }
    },
    "positive_observations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "bms.project-manager.operational-evidence.v2#/$defs/canonicalJsonArtifact"
      }
    },
    "negative_observations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "bms.project-manager.operational-evidence.v2#/$defs/canonicalJsonArtifact"
      }
    },
    "resolver_trace": {
      "$ref": "bms.project-manager.operational-evidence.v2#/$defs/canonicalJsonArtifact"
    },
    "evidence_kinds": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 255
      }
    },
    "native_owner_attestations": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": false,
      "prefixItems": [
        {
          "allOf": [
            {
              "$ref": "bms.project-manager.operational-evidence.v2#/$defs/writerAssertion"
            },
            {
              "type": "object",
              "properties": {
                "principal_id": {
                  "const": "ngs-molbio-shared-package-owner"
                }
              },
              "required": [
                "principal_id"
              ]
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "bms.project-manager.operational-evidence.v2#/$defs/writerAssertion"
            },
            {
              "type": "object",
              "properties": {
                "principal_id": {
                  "const": "ngs-molbio-domain-owner"
                }
              },
              "required": [
                "principal_id"
              ]
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "bms.project-manager.operational-evidence.v2#/$defs/writerAssertion"
            },
            {
              "type": "object",
              "properties": {
                "principal_id": {
                  "const": "global-protein-owner"
                }
              },
              "required": [
                "principal_id"
              ]
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "bms.project-manager.operational-evidence.v2#/$defs/writerAssertion"
            },
            {
              "type": "object",
              "properties": {
                "principal_id": {
                  "const": "conformational-mapping-owner"
                }
              },
              "required": [
                "principal_id"
              ]
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "bms.project-manager.operational-evidence.v2#/$defs/writerAssertion"
            },
            {
              "type": "object",
              "properties": {
                "principal_id": {
                  "const": "molecular-dynamics-owner"
                }
              },
              "required": [
                "principal_id"
              ]
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "bms.project-manager.operational-evidence.v2#/$defs/writerAssertion"
            },
            {
              "type": "object",
              "properties": {
                "principal_id": {
                  "const": "frustrampnn-owner"
                }
              },
              "required": [
                "principal_id"
              ]
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "bms.project-manager.operational-evidence.v2#/$defs/writerAssertion"
            },
            {
              "type": "object",
              "properties": {
                "principal_id": {
                  "const": "structure-prediction-owner"
                }
              },
              "required": [
                "principal_id"
              ]
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "bms.project-manager.operational-evidence.v2#/$defs/writerAssertion"
            },
            {
              "type": "object",
              "properties": {
                "principal_id": {
                  "const": "trajectory-owner"
                }
              },
              "required": [
                "principal_id"
              ]
            }
          ]
        }
      ]
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "SHA-256 of RFC 8785 UTF-8 for the complete signed document after all assertions are inserted, with only content_sha256 omitted."
    },
    "self_digest_algorithm": {
      "const": "sha256-rfc8785-complete-signed-document-omit-self-digest-v2"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "coverage_item": {
            "const": "receipt-freshness"
          }
        },
        "required": [
          "coverage_item"
        ]
      },
      "then": {
        "properties": {
          "coverage_contract_id": {
            "const": "bms.project-manager.coverage.receipt-freshness.v1"
          },
          "evidence_kinds": {
            "const": [
              "receipt-freshness-denominator",
              "receipt-freshness-positive-observation",
              "receipt-freshness-negative-observation",
              "receipt-freshness-resolver-trace"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "coverage_item": {
            "const": "successor-receipts"
          }
        },
        "required": [
          "coverage_item"
        ]
      },
      "then": {
        "properties": {
          "coverage_contract_id": {
            "const": "bms.project-manager.coverage.successor-receipts.v1"
          },
          "evidence_kinds": {
            "const": [
              "successor-receipts-denominator",
              "successor-receipts-positive-observation",
              "successor-receipts-negative-observation",
              "successor-receipts-resolver-trace"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "coverage_item": {
            "const": "domain-lineage"
          }
        },
        "required": [
          "coverage_item"
        ]
      },
      "then": {
        "properties": {
          "coverage_contract_id": {
            "const": "bms.project-manager.coverage.domain-lineage.v1"
          },
          "evidence_kinds": {
            "const": [
              "domain-lineage-denominator",
              "domain-lineage-positive-observation",
              "domain-lineage-negative-observation",
              "domain-lineage-resolver-trace"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "coverage_item": {
            "const": "restart-reverification"
          }
        },
        "required": [
          "coverage_item"
        ]
      },
      "then": {
        "properties": {
          "coverage_contract_id": {
            "const": "bms.project-manager.coverage.restart-reverification.v1"
          },
          "evidence_kinds": {
            "const": [
              "restart-reverification-denominator",
              "restart-reverification-positive-observation",
              "restart-reverification-negative-observation",
              "restart-reverification-resolver-trace"
            ]
          }
        }
      }
    }
  ]
}
