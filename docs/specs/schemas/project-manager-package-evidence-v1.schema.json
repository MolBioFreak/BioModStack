{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bms.project-manager.package-evidence.v1",
  "title": "Owner-authenticated PM coverage evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "package_evidence_receipt_id",
    "package_id",
    "coverage_item",
    "evidence_contract_id",
    "source_commit",
    "source_tree",
    "evidence_body",
    "owner_assertion",
    "receipt_sha256",
    "evidence_body_schema_id",
    "evidence_body_schema_sha256"
  ],
  "properties": {
    "schema": {
      "const": "bms.project-manager.package-evidence.v1"
    },
    "package_evidence_receipt_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "package_id": {
      "enum": [
        "PM-01",
        "PM-02",
        "PM-03A",
        "PM-03B",
        "PM-04",
        "PM-05",
        "PM-06",
        "PM-07",
        "PM-08A",
        "PM-08B",
        "PM-09",
        "PM-10A",
        "PM-10B"
      ]
    },
    "coverage_item": {
      "enum": [
        "responsive-geometry",
        "semantic-control-denominator",
        "keyboard-accessibility",
        "deep-link-reload",
        "source-denominator",
        "runtime-registry",
        "capability-dataset-exposure",
        "operator-trust-registry",
        "negative-drift",
        "project-v2",
        "global-experiment-v2",
        "protein-domain-v3",
        "hierarchy-revisions",
        "ngs-domain-v3",
        "local-projects",
        "domain-provisioning",
        "project-links",
        "attachment-receipts",
        "literal-deep-links",
        "cross-project-denials",
        "zero-payload-copy",
        "samples",
        "managed-references",
        "evidence",
        "datasets",
        "plans-preparations",
        "composite-read-model",
        "pagination",
        "eln-records",
        "adapter-versions",
        "maintained-projections",
        "receipt-freshness",
        "successor-receipts",
        "domain-lineage",
        "restart-reverification",
        "plan-execution",
        "launch-context-v2",
        "launch-fencing",
        "retry-resubmit-clone-cancel",
        "protein-adapters",
        "molecular-dynamics-adapters",
        "compatible-comparison",
        "native-result-chain",
        "validation-artifacts",
        "bounded-attempt-logs",
        "result-surfaces",
        "native-viewers",
        "connector-commands",
        "inbox-outbox",
        "acknowledgements",
        "lease-retry-reconciliation",
        "worker-convergence",
        "backup-v3",
        "restoration-v3",
        "export-v3",
        "payload-ownership-audit"
      ]
    },
    "evidence_contract_id": {
      "type": "string",
      "pattern": "^bms\\.project-manager\\.coverage\\.[a-z0-9-]+\\.v1$",
      "maxLength": 255
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "source_tree": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "evidence_body": {
      "$ref": "bms.project-manager.operational-evidence.v1#/$defs/canonicalJsonArtifact"
    },
    "owner_assertion": {
      "$ref": "bms.project-manager.operational-evidence.v1#/$defs/writerAssertion"
    },
    "receipt_sha256": {
      "allOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      ],
      "description": "SHA-256 of UTF-8 RFC 8785 canonical JSON for the complete body with only receipt_sha256 omitted."
    },
    "evidence_body_schema_id": {
      "enum": [
        "bms.project-manager.package-evidence-body.pm01.v1",
        "bms.project-manager.package-evidence-body.pm02.v1",
        "bms.project-manager.package-evidence-body.pm03a.v1",
        "bms.project-manager.package-evidence-body.pm03b.v1",
        "bms.project-manager.package-evidence-body.pm04.v1",
        "bms.project-manager.package-evidence-body.pm05.v1",
        "bms.project-manager.package-evidence-body.pm06.v1",
        "bms.project-manager.package-evidence-body.pm07.v1",
        "bms.project-manager.package-evidence-body.pm08a.v1",
        "bms.project-manager.package-evidence-body.pm08b.v1",
        "bms.project-manager.package-evidence-body.pm09.v1",
        "bms.project-manager.package-evidence-body.pm10a.v1",
        "bms.project-manager.package-evidence-body.pm10b.v1"
      ]
    },
    "evidence_body_schema_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
