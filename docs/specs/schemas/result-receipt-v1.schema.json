{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bms.result-receipt.v1",
  "title": "BioModStack Result Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "receipt_id",
    "store_id",
    "entity_kind",
    "entity_id",
    "entity_revision_id",
    "content_digest",
    "contract_digest",
    "source_build_revision",
    "verified_at",
    "verifier_id",
    "reopen_uri",
    "availability",
    "metadata"
  ],
  "properties": {
    "schema": {"const": "bms.result-receipt.v1"},
    "receipt_id": {"type": "string", "minLength": 1},
    "store_id": {"type": "string", "minLength": 1},
    "entity_kind": {"type": "string", "minLength": 1},
    "entity_id": {"type": "string", "minLength": 1},
    "entity_revision_id": {"type": ["string", "null"]},
    "content_digest": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "contract_digest": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "source_build_revision": {"type": ["string", "null"]},
    "verified_at": {"type": "string", "format": "date-time"},
    "verifier_id": {"type": "string", "minLength": 1},
    "reopen_uri": {"type": ["string", "null"]},
    "availability": {"enum": ["unknown", "available", "unavailable"]},
    "metadata": {"type": "object"},
    "generation_or_revision": {"type": ["string", "null"]},
    "contract_id": {"type": ["string", "null"]}
  },
  "allOf": [
    {
      "anyOf": [
        {
          "required": ["content_digest"],
          "properties": {"content_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
        },
        {
          "required": ["contract_digest"],
          "properties": {"contract_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
        }
      ]
    }
  ]
}
