{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bms.project-manager.read-model.v1",
  "title": "BioModStack Project Manager Composite Read Model",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "subject_id", "subject_generation", "assembled_at", "source_receipt_ids", "source_digest_set_sha256", "adapter_versions", "reconciliation", "counts", "status_summary", "recent_activity", "result_previews", "pagination", "project", "tree", "map", "selection", "runs", "warnings", "allowed_actions"],
  "properties": {
    "schema": {"const": "bms.project-manager.read-model.v1"},
    "subject_id": {"type": "string"},
    "subject_generation": {"type": "integer", "minimum": 0},
    "assembled_at": {"type": "string", "format": "date-time"},
    "source_receipt_ids": {"type": "array", "items": {"type": "string"}},
    "source_digest_set_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "adapter_versions": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["adapter_id", "version"], "properties": {"adapter_id": {"type": "string"}, "version": {"type": "string"}}}},
    "reconciliation": {"$ref": "#/$defs/reconciliation"},
    "counts": {"type": "object"},
    "status_summary": {"type": "object"},
    "recent_activity": {"type": "array"},
    "result_previews": {"type": "array"},
    "pagination": {"type": "object"},
    "project": {"type": "object", "additionalProperties": false, "required": ["id", "name", "objective", "lifecycle_state", "head_generation", "current_revision_id", "updated_at"], "properties": {"id": {"type": "string"}, "name": {"type": "string"}, "objective": {"type": "string"}, "lifecycle_state": {"type": "string"}, "head_generation": {"type": "integer", "minimum": 0}, "current_revision_id": {"type": "string"}, "updated_at": {"type": "string"}}},
    "tree": {"type": "object", "additionalProperties": false, "required": ["nodes"], "properties": {"nodes": {"type": "array", "items": {"$ref": "#/$defs/treeNode"}}}},
    "map": {"type": "object", "additionalProperties": false, "required": ["focus_node_key", "nodes", "edges", "truncated", "next_cursor"], "properties": {"focus_node_key": {"type": "string"}, "nodes": {"type": "array"}, "edges": {"type": "array"}, "truncated": {"type": "boolean"}, "next_cursor": {"type": ["string", "null"]}}},
    "selection": {"type": "object", "additionalProperties": false, "required": ["node_key", "node_type", "title", "subtitle", "canonical_identity", "summary", "relationship", "scientific_context", "reconciliation", "available_actions", "canonical_surface"], "properties": {"node_key": {"type": "string"}, "node_type": {"type": "string"}, "title": {"type": "string"}, "subtitle": {"type": ["string", "null"]}, "canonical_identity": {"type": "object"}, "summary": {"type": "object"}, "relationship": {"type": "object"}, "scientific_context": {"type": "object"}, "reconciliation": {"type": "object"}, "available_actions": {"type": "array", "items": {"type": "string"}}, "canonical_surface": {"type": ["object", "null"]}}},
    "runs": {"type": "object", "additionalProperties": false, "required": ["items", "next_cursor"], "properties": {"items": {"type": "array"}, "next_cursor": {"type": ["string", "null"]}}},
    "warnings": {"type": "array"},
    "allowed_actions": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "reconciliation": {"type": "object", "additionalProperties": false, "required": ["state", "last_verified_at", "reason"], "properties": {"state": {"enum": ["current", "pending", "stale", "source_unavailable", "digest_mismatch"]}, "last_verified_at": {"type": ["string", "null"]}, "reason": {"type": ["string", "null"]}}},
    "treeNode": {"type": "object", "additionalProperties": false, "required": ["node_key", "node_type", "subject_id", "parent_node_key", "label", "lifecycle_state", "counts", "has_children", "allowed_actions"], "properties": {"node_key": {"type": "string"}, "node_type": {"enum": ["project", "global_experiment", "domain_experiment", "virtual_folder"]}, "subject_id": {"type": ["string", "null"]}, "parent_node_key": {"type": ["string", "null"]}, "label": {"type": "string"}, "lifecycle_state": {"type": ["string", "null"]}, "counts": {"type": "object"}, "has_children": {"type": "boolean"}, "allowed_actions": {"type": "array", "items": {"type": "string"}}}}
  }
}
