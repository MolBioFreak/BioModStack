{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bms.project-manager.package-evidence-body.pm10b.v1",
  "title": "PM-10B authenticated coverage evidence body v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "evidence_body_id",
    "package_id",
    "coverage_item",
    "coverage_contract_id",
    "source_commit",
    "source_tree",
    "coverage_denominator",
    "producer_receipts",
    "positive_observations",
    "negative_observations",
    "resolver_trace",
    "evidence_kinds",
    "native_owner_attestations",
    "content_sha256"
  ],
  "properties": {
    "schema": {
      "const": "bms.project-manager.package-evidence-body.pm10b.v1"
    },
    "evidence_body_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "package_id": {
      "const": "PM-10B"
    },
    "coverage_item": {
      "enum": [
        "worker-convergence",
        "backup-v3",
        "restoration-v3",
        "export-v3",
        "payload-ownership-audit"
      ]
    },
    "coverage_contract_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "source_tree": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "coverage_denominator": {
      "$ref": "bms.project-manager.operational-evidence.v1#/$defs/canonicalJsonArtifact"
    },
    "producer_receipts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "bms.project-manager.operational-evidence.v1#/$defs/receiptPointer"
      }
    },
    "positive_observations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "bms.project-manager.operational-evidence.v1#/$defs/canonicalJsonArtifact"
      }
    },
    "negative_observations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "bms.project-manager.operational-evidence.v1#/$defs/canonicalJsonArtifact"
      }
    },
    "resolver_trace": {
      "$ref": "bms.project-manager.operational-evidence.v1#/$defs/canonicalJsonArtifact"
    },
    "evidence_kinds": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 255
      }
    },
    "native_owner_attestations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": false,
      "prefixItems": [
        {
          "allOf": [
            {
              "$ref": "bms.project-manager.operational-evidence.v1#/$defs/writerAssertion"
            },
            {
              "type": "object",
              "properties": {
                "principal_id": {
                  "const": "ngs-molbio-shared-package-owner"
                }
              },
              "required": [
                "principal_id"
              ]
            }
          ]
        }
      ]
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "coverage_item": {
            "const": "worker-convergence"
          }
        },
        "required": [
          "coverage_item"
        ]
      },
      "then": {
        "properties": {
          "coverage_contract_id": {
            "const": "bms.project-manager.coverage.worker-convergence.v1"
          },
          "evidence_kinds": {
            "const": [
              "worker-convergence-denominator",
              "worker-convergence-positive-observation",
              "worker-convergence-negative-observation",
              "worker-convergence-resolver-trace"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "coverage_item": {
            "const": "backup-v3"
          }
        },
        "required": [
          "coverage_item"
        ]
      },
      "then": {
        "properties": {
          "coverage_contract_id": {
            "const": "bms.project-manager.coverage.backup-v3.v1"
          },
          "evidence_kinds": {
            "const": [
              "backup-v3-denominator",
              "backup-v3-positive-observation",
              "backup-v3-negative-observation",
              "backup-v3-resolver-trace"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "coverage_item": {
            "const": "restoration-v3"
          }
        },
        "required": [
          "coverage_item"
        ]
      },
      "then": {
        "properties": {
          "coverage_contract_id": {
            "const": "bms.project-manager.coverage.restoration-v3.v1"
          },
          "evidence_kinds": {
            "const": [
              "restoration-v3-denominator",
              "restoration-v3-positive-observation",
              "restoration-v3-negative-observation",
              "restoration-v3-resolver-trace"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "coverage_item": {
            "const": "export-v3"
          }
        },
        "required": [
          "coverage_item"
        ]
      },
      "then": {
        "properties": {
          "coverage_contract_id": {
            "const": "bms.project-manager.coverage.export-v3.v1"
          },
          "evidence_kinds": {
            "const": [
              "export-v3-denominator",
              "export-v3-positive-observation",
              "export-v3-negative-observation",
              "export-v3-resolver-trace"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "coverage_item": {
            "const": "payload-ownership-audit"
          }
        },
        "required": [
          "coverage_item"
        ]
      },
      "then": {
        "properties": {
          "coverage_contract_id": {
            "const": "bms.project-manager.coverage.payload-ownership-audit.v1"
          },
          "evidence_kinds": {
            "const": [
              "payload-ownership-audit-denominator",
              "payload-ownership-audit-positive-observation",
              "payload-ownership-audit-negative-observation",
              "payload-ownership-audit-resolver-trace"
            ]
          }
        }
      }
    }
  ]
}
