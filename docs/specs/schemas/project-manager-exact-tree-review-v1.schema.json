{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bms.project-manager.exact-tree-review.v1",
  "title": "Independent exact-tree review acceptance v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "exact_tree_review_receipt_id",
    "source_commit",
    "source_tree",
    "outer_package_sha256",
    "reviewers",
    "outcome",
    "accepted_at",
    "receipt_sha256"
  ],
  "properties": {
    "schema": {
      "const": "bms.project-manager.exact-tree-review.v1"
    },
    "exact_tree_review_receipt_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "source_tree": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "outer_package_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "reviewers": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reviewer_id",
          "start_package_sha256",
          "end_package_sha256",
          "verdict",
          "blocker_count",
          "major_count",
          "review_receipt_sha256"
        ],
        "properties": {
          "reviewer_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "start_package_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "end_package_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "verdict": {
            "const": "pass"
          },
          "blocker_count": {
            "const": 0
          },
          "major_count": {
            "const": 0
          },
          "review_receipt_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "outcome": {
      "const": "pass"
    },
    "accepted_at": {
      "type": "string",
      "format": "date-time"
    },
    "receipt_sha256": {
      "allOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      ],
      "description": "SHA-256 of UTF-8 RFC 8785 canonical JSON with only receipt_sha256 omitted."
    }
  }
}
