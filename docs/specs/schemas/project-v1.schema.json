{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bms.project.v1",
  "title": "BioModStack Project",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "name", "description", "research_objective", "owner", "contributors", "tags", "status", "start_date", "target_end_date", "external_references", "created_by", "change_summary", "needs_metadata_review"],
  "properties": {
    "schema": {"const": "bms.project.v1"},
    "name": {"type": "string", "minLength": 1, "maxLength": 255},
    "description": {"type": "string"},
    "research_objective": {"type": "string"},
    "owner": {"type": ["string", "null"]},
    "contributors": {"type": "array", "items": {"type": "string"}},
    "tags": {"type": "array", "items": {"type": "string"}},
    "status": {"enum": ["draft", "active", "on_hold", "completed", "archived"]},
    "start_date": {"type": ["string", "null"], "format": "date"},
    "target_end_date": {"type": ["string", "null"], "format": "date"},
    "external_references": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "value", "label"],
        "properties": {
          "kind": {"enum": ["doi", "url", "accession", "ticket", "other"]},
          "value": {"type": "string", "minLength": 1},
          "label": {"type": "string"}
        }
      }
    },
    "created_by": {"type": ["string", "null"]},
    "change_summary": {"type": "string"},
    "needs_metadata_review": {"type": "boolean"}
  }
}
