{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bms.domain-experiment.v1",
  "title": "BioModStack Domain Experiment",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "domain_kind", "domain_contract_version", "name", "objective", "status", "tags", "source_receipt_ids", "dataset_ids", "created_by", "change_summary", "domain_payload"],
  "properties": {
    "schema": {"const": "bms.domain-experiment.v1"},
    "domain_kind": {"enum": ["protein_in_silico", "ngs_molbio"]},
    "domain_contract_version": {"const": "1"},
    "name": {"type": "string", "minLength": 1, "maxLength": 255},
    "objective": {"type": "string"},
    "status": {"enum": ["draft", "planned", "active", "analysis", "review", "completed", "blocked", "archived"]},
    "tags": {"type": "array", "items": {"type": "string"}},
    "source_receipt_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "dataset_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "created_by": {"type": ["string", "null"]},
    "change_summary": {"type": "string"},
    "domain_payload": {"type": "object"}
  },
  "oneOf": [
    {
      "properties": {
        "domain_kind": {"const": "protein_in_silico"},
        "domain_payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema", "experiment_mode", "targets", "scientific_objective", "design_constraints", "planned_capabilities", "comparison_groups", "validation_strategy"],
          "properties": {
            "schema": {"const": "bms.protein-in-silico-experiment.v1"},
            "experiment_mode": {"enum": ["exploration", "design", "redesign", "prediction", "validation", "comparison", "simulation", "analysis"]},
            "targets": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["target_id", "label", "entity_receipt_ids", "role"],
                "properties": {
                  "target_id": {"type": "string", "minLength": 1},
                  "label": {"type": "string"},
                  "entity_receipt_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
                  "role": {"enum": ["target", "binder", "partner", "template", "reference", "control", "other"]}
                }
              }
            },
            "scientific_objective": {"type": "string"},
            "design_constraints": {"type": "array", "items": {"type": "object"}},
            "planned_capabilities": {"type": "array", "items": {"type": "string", "minLength": 1}},
            "comparison_groups": {"type": "array", "items": {"type": "object"}},
            "validation_strategy": {"type": "array", "items": {"type": "string", "minLength": 1}}
          }
        }
      }
    },
    {
      "properties": {
        "domain_kind": {"const": "ngs_molbio"},
        "domain_payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema"],
          "properties": {"schema": {"const": "bms.ngs-molbio-experiment.v1"}}
        }
      }
    }
  ]
}
