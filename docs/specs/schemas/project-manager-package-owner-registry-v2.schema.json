        },
        "owner_key_object": {
          "$ref": "bms.project-manager.operational-evidence.v2#/$defs/rawArtifact"
        },
        "coverage": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          }
        },
        "evidence_schema_id": {
          "const": "bms.project-manager.package-evidence.v2"
        },
        "evidence_multiplicity_per_coverage": {
          "const": 1
        },
        "release_integrator_can_issue": {
          "const": false
        },
        "evidence_body_schema_id": {
          "enum": [
            "bms.project-manager.package-evidence-body.pm01.v2",
            "bms.project-manager.package-evidence-body.pm02.v2",
            "bms.project-manager.package-evidence-body.pm03a.v2",
            "bms.project-manager.package-evidence-body.pm03b.v2",
            "bms.project-manager.package-evidence-body.pm04.v2",
            "bms.project-manager.package-evidence-body.pm05.v2",
            "bms.project-manager.package-evidence-body.pm06.v2",
            "bms.project-manager.package-evidence-body.pm07.v2",
            "bms.project-manager.package-evidence-body.pm08a.v2",
            "bms.project-manager.package-evidence-body.pm08b.v2",
            "bms.project-manager.package-evidence-body.pm09.v2",
            "bms.project-manager.package-evidence-body.pm10a.v2",
            "bms.project-manager.package-evidence-body.pm10b.v2"
          ]
        },
        "native_owner_principal_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "evidence_body_multiplicity_per_coverage": {
          "const": 1
        },
        "resolver_checks": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "items": false,
          "prefixItems": [
            {
              "const": "candidate-source-match"
            },
            {
              "const": "coverage-contract-match"
            },
            {
              "const": "evidence-body-schema-digest"
            },
            {
              "const": "native-owner-signatures"
            },
            {
              "const": "positive-and-negative-observations"
            },
            {
              "const": "resolver-trace"
            },
            {
              "const": "self-digest"
            }
          ]
        }
      }
    }
  }
}
