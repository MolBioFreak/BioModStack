{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bms.project-manager.package-evidence-body.pm04.v1",
  "title": "PM-04 authenticated coverage evidence body v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "evidence_body_id",
    "package_id",
    "coverage_item",
    "coverage_contract_id",
    "source_commit",
    "source_tree",
    "coverage_denominator",
    "producer_receipts",
    "positive_observations",
    "negative_observations",
    "resolver_trace",
    "evidence_kinds",
    "native_owner_attestations",
    "content_sha256"
  ],
  "properties": {
    "schema": {
      "const": "bms.project-manager.package-evidence-body.pm04.v1"
    },
    "evidence_body_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "package_id": {
      "const": "PM-04"
    },
    "coverage_item": {
      "enum": [
        "attachment-receipts",
        "literal-deep-links",
        "cross-project-denials",
        "zero-payload-copy"
      ]
    },
    "coverage_contract_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "source_tree": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "coverage_denominator": {
      "$ref": "bms.project-manager.operational-evidence.v1#/$defs/canonicalJsonArtifact"
    },
    "producer_receipts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "bms.project-manager.operational-evidence.v1#/$defs/receiptPointer"
      }
    },
    "positive_observations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "bms.project-manager.operational-evidence.v1#/$defs/canonicalJsonArtifact"
      }
    },
    "negative_observations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "bms.project-manager.operational-evidence.v1#/$defs/canonicalJsonArtifact"
      }
    },
    "resolver_trace": {
      "$ref": "bms.project-manager.operational-evidence.v1#/$defs/canonicalJsonArtifact"
    },
    "evidence_kinds": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 255
      }
    },
    "native_owner_attestations": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": false,
      "prefixItems": [
        {
          "allOf": [
            {
              "$ref": "bms.project-manager.operational-evidence.v1#/$defs/writerAssertion"
            },
            {
              "type": "object",
              "properties": {
                "principal_id": {
                  "const": "ngs-molbio-domain-owner"
                }
              },
              "required": [
                "principal_id"
              ]
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "bms.project-manager.operational-evidence.v1#/$defs/writerAssertion"
            },
            {
              "type": "object",
              "properties": {
                "principal_id": {
                  "const": "global-protein-owner"
                }
              },
              "required": [
                "principal_id"
              ]
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "bms.project-manager.operational-evidence.v1#/$defs/writerAssertion"
            },
            {
              "type": "object",
              "properties": {
                "principal_id": {
                  "const": "conformational-mapping-owner"
                }
              },
              "required": [
                "principal_id"
              ]
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "bms.project-manager.operational-evidence.v1#/$defs/writerAssertion"
            },
            {
              "type": "object",
              "properties": {
                "principal_id": {
                  "const": "molecular-dynamics-owner"
                }
              },
              "required": [
                "principal_id"
              ]
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "bms.project-manager.operational-evidence.v1#/$defs/writerAssertion"
            },
            {
              "type": "object",
              "properties": {
                "principal_id": {
                  "const": "frustrampnn-owner"
                }
              },
              "required": [
                "principal_id"
              ]
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "bms.project-manager.operational-evidence.v1#/$defs/writerAssertion"
            },
            {
              "type": "object",
              "properties": {
                "principal_id": {
                  "const": "structure-prediction-owner"
                }
              },
              "required": [
                "principal_id"
              ]
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "bms.project-manager.operational-evidence.v1#/$defs/writerAssertion"
            },
            {
              "type": "object",
              "properties": {
                "principal_id": {
                  "const": "trajectory-owner"
                }
              },
              "required": [
                "principal_id"
              ]
            }
          ]
        }
      ]
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "coverage_item": {
            "const": "attachment-receipts"
          }
        },
        "required": [
          "coverage_item"
        ]
      },
      "then": {
        "properties": {
          "coverage_contract_id": {
            "const": "bms.project-manager.coverage.attachment-receipts.v1"
          },
          "evidence_kinds": {
            "const": [
              "attachment-receipts-denominator",
              "attachment-receipts-positive-observation",
              "attachment-receipts-negative-observation",
              "attachment-receipts-resolver-trace"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "coverage_item": {
            "const": "literal-deep-links"
          }
        },
        "required": [
          "coverage_item"
        ]
      },
      "then": {
        "properties": {
          "coverage_contract_id": {
            "const": "bms.project-manager.coverage.literal-deep-links.v1"
          },
          "evidence_kinds": {
            "const": [
              "literal-deep-links-denominator",
              "literal-deep-links-positive-observation",
              "literal-deep-links-negative-observation",
              "literal-deep-links-resolver-trace"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "coverage_item": {
            "const": "cross-project-denials"
          }
        },
        "required": [
          "coverage_item"
        ]
      },
      "then": {
        "properties": {
          "coverage_contract_id": {
            "const": "bms.project-manager.coverage.cross-project-denials.v1"
          },
          "evidence_kinds": {
            "const": [
              "cross-project-denials-denominator",
              "cross-project-denials-positive-observation",
              "cross-project-denials-negative-observation",
              "cross-project-denials-resolver-trace"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "coverage_item": {
            "const": "zero-payload-copy"
          }
        },
        "required": [
          "coverage_item"
        ]
      },
      "then": {
        "properties": {
          "coverage_contract_id": {
            "const": "bms.project-manager.coverage.zero-payload-copy.v1"
          },
          "evidence_kinds": {
            "const": [
              "zero-payload-copy-denominator",
              "zero-payload-copy-positive-observation",
              "zero-payload-copy-negative-observation",
              "zero-payload-copy-resolver-trace"
            ]
          }
        }
      }
    }
  ]
}
