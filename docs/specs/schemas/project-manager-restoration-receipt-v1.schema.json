{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bms.project-manager.restoration-receipt.v1",
  "title": "Whole-program isolated restoration receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "restoration_receipt_id",
    "backup_receipt",
    "source_commit",
    "source_tree",
    "destination_isolated",
    "destination_identity",
    "restore_started_at",
    "restore_completed_at",
    "stores",
    "artifact_roots",
    "connector_reconciliation",
    "restart_receipt",
    "historical_reopen_cases",
    "created_by",
    "receipt_sha256"
  ],
  "properties": {
    "schema": {
      "const": "bms.project-manager.restoration-receipt.v1"
    },
    "restoration_receipt_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "backup_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt_schema_id",
        "receipt_id",
        "receipt_sha256",
        "native_identity"
      ],
      "properties": {
        "receipt_schema_id": {
          "const": "bms.project-manager.backup-receipt.v1"
        },
        "receipt_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "receipt_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "native_identity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      }
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "source_tree": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "destination_isolated": {
      "const": true
    },
    "destination_identity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "restore_started_at": {
      "type": "string",
      "format": "date-time"
    },
    "restore_completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "stores": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": false,
      "prefixItems": [
        {
          "allOf": [
            {
              "$ref": "#/$defs/restoredStore"
            },
            {
              "type": "object",
              "properties": {
                "store_id": {
                  "const": "global-experiments"
                }
              },
              "required": [
                "store_id"
              ]
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/restoredStore"
            },
            {
              "type": "object",
              "properties": {
                "store_id": {
                  "const": "molbio-domain"
                }
              },
              "required": [
                "store_id"
              ]
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/restoredStore"
            },
            {
              "type": "object",
              "properties": {
                "store_id": {
                  "const": "molbio-ngs-domain"
                }
              },
              "required": [
                "store_id"
              ]
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/restoredStore"
            },
            {
              "type": "object",
              "properties": {
                "store_id": {
                  "const": "core-ngs"
                }
              },
              "required": [
                "store_id"
              ]
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/restoredStore"
            },
            {
              "type": "object",
              "properties": {
                "store_id": {
                  "const": "biomodstack-native"
                }
              },
              "required": [
                "store_id"
              ]
            }
          ]
        }
      ]
    },
    "artifact_roots": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": false,
      "prefixItems": [
        {
          "allOf": [
            {
              "$ref": "#/$defs/restoredArtifactRoot"
            },
            {
              "type": "object",
              "properties": {
                "root_id": {
                  "const": "global-project-artifacts"
                }
              },
              "required": [
                "root_id"
              ]
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/restoredArtifactRoot"
            },
            {
              "type": "object",
              "properties": {
                "root_id": {
                  "const": "molbio-governed-artifacts"
                }
              },
              "required": [
                "root_id"
              ]
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/restoredArtifactRoot"
            },
            {
              "type": "object",
              "properties": {
                "root_id": {
                  "const": "ngs-governed-results"
                }
              },
              "required": [
                "root_id"
              ]
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/restoredArtifactRoot"
            },
            {
              "type": "object",
              "properties": {
                "root_id": {
                  "const": "bms-native-results"
                }
              },
              "required": [
                "root_id"
              ]
            }
          ]
        }
      ]
    },
    "connector_reconciliation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "unresolved_conflicts",
        "deferred_gaps",
        "high_watermarks_sha256"
      ],
      "properties": {
        "state": {
          "const": "current"
        },
        "unresolved_conflicts": {
          "const": 0
        },
        "deferred_gaps": {
          "const": 0
        },
        "high_watermarks_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "restart_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt_schema_id",
        "receipt_id",
        "receipt_sha256",
        "native_identity"
      ],
      "properties": {
        "receipt_schema_id": {
          "const": "bms.project-manager.isolated-restart.v1"
        },
        "receipt_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "receipt_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "native_identity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      }
    },
    "historical_reopen_cases": {
      "type": "array",
      "minItems": 8,
      "maxItems": 512,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/reopenCase"
      },
      "allOf": [
        {
          "contains": {
            "type": "object",
            "properties": {
              "authority_family": {
                "const": "project-manager"
              }
            },
            "required": [
              "authority_family"
            ]
          },
          "minContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "authority_family": {
                "const": "ngs-molbio"
              }
            },
            "required": [
              "authority_family"
            ]
          },
          "minContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "authority_family": {
                "const": "protein"
              }
            },
            "required": [
              "authority_family"
            ]
          },
          "minContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "authority_family": {
                "const": "conformational-mapping"
              }
            },
            "required": [
              "authority_family"
            ]
          },
          "minContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "authority_family": {
                "const": "molecular-dynamics"
              }
            },
            "required": [
              "authority_family"
            ]
          },
          "minContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "authority_family": {
                "const": "frustrampnn"
              }
            },
            "required": [
              "authority_family"
            ]
          },
          "minContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "authority_family": {
                "const": "structure-prediction"
              }
            },
            "required": [
              "authority_family"
            ]
          },
          "minContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "authority_family": {
                "const": "trajectory"
              }
            },
            "required": [
              "authority_family"
            ]
          },
          "minContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "resource_kind": {
                "const": "project_revision"
              }
            },
            "required": [
              "resource_kind"
            ]
          },
          "minContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "resource_kind": {
                "const": "global_experiment_revision"
              }
            },
            "required": [
              "resource_kind"
            ]
          },
          "minContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "resource_kind": {
                "const": "domain_experiment_revision"
              }
            },
            "required": [
              "resource_kind"
            ]
          },
          "minContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "resource_kind": {
                "const": "local_state_revision"
              }
            },
            "required": [
              "resource_kind"
            ]
          },
          "minContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "resource_kind": {
                "const": "dataset_revision"
              }
            },
            "required": [
              "resource_kind"
            ]
          },
          "minContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "resource_kind": {
                "const": "run"
              }
            },
            "required": [
              "resource_kind"
            ]
          },
          "minContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "resource_kind": {
                "const": "result"
              }
            },
            "required": [
              "resource_kind"
            ]
          },
          "minContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "resource_kind": {
                "const": "research_record"
              }
            },
            "required": [
              "resource_kind"
            ]
          },
          "minContains": 1
        }
      ]
    },
    "created_by": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "receipt_sha256": {
      "allOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      ],
      "description": "SHA-256 of UTF-8 RFC 8785 canonical JSON for the complete receipt with only receipt_sha256 omitted."
    }
  },
  "$defs": {
    "restoredStore": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "store_id",
        "snapshot_artifact_id",
        "snapshot_sha256",
        "restored_database_identity",
        "size_bytes",
        "schema_sha256",
        "trigger_set_sha256",
        "migration_ledger_sha256",
        "integrity_check",
        "foreign_key_violation_count",
        "object_counts"
      ],
      "properties": {
        "store_id": {
          "enum": [
            "global-experiments",
            "molbio-domain",
            "molbio-ngs-domain",
            "core-ngs",
            "biomodstack-native"
          ]
        },
        "snapshot_artifact_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "snapshot_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "restored_database_identity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "schema_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "trigger_set_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "migration_ledger_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "integrity_check": {
          "const": "ok"
        },
        "foreign_key_violation_count": {
          "const": 0
        },
        "object_counts": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 1024,
          "propertyNames": {
            "pattern": "^[A-Za-z0-9_.-]+$",
            "maxLength": 128
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "restoredArtifactRoot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root_id",
        "backup_manifest",
        "restored_root_identity"
      ],
      "properties": {
        "root_id": {
          "enum": [
            "global-project-artifacts",
            "molbio-governed-artifacts",
            "ngs-governed-results",
            "bms-native-results"
          ]
        },
        "backup_manifest": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "manifest_schema_id",
            "manifest_id",
            "manifest_artifact_id",
            "manifest_content_sha256",
            "ordered_files_sha256",
            "file_count",
            "total_size_bytes"
          ],
          "properties": {
            "manifest_schema_id": {
              "const": "bms.project-manager.file-manifest.v1"
            },
            "manifest_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            },
            "manifest_artifact_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            },
            "manifest_content_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "ordered_files_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "file_count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            },
            "total_size_bytes": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "restored_root_identity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      }
    },
    "reopenCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "authority_family",
        "resource_kind",
        "stable_id",
        "exact_revision_id",
        "content_sha256",
        "response_size_bytes",
        "reopen_route_template_id",
        "verified"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "authority_family": {
          "enum": [
            "project-manager",
            "ngs-molbio",
            "protein",
            "conformational-mapping",
            "molecular-dynamics",
            "frustrampnn",
            "structure-prediction",
            "trajectory"
          ]
        },
        "resource_kind": {
          "enum": [
            "project_revision",
            "global_experiment_revision",
            "domain_experiment_revision",
            "local_state_revision",
            "dataset_revision",
            "run",
            "result",
            "research_record"
          ]
        },
        "stable_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "exact_revision_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "response_size_bytes": {
          "type": "integer",
          "minimum": 2,
          "maximum": 1048576
        },
        "reopen_route_template_id": {
          "type": "string",
          "pattern": "^bms\\.route\\.[A-Za-z0-9_.-]+$",
          "maxLength": 255
        },
        "verified": {
          "const": true
        }
      }
    }
  }
}
