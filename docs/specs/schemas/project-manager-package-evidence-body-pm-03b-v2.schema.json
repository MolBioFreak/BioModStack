{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bms.project-manager.package-evidence-body.pm03b.v2",
  "title": "PM-03B authenticated coverage evidence body v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "evidence_body_id",
    "package_id",
    "coverage_item",
    "coverage_contract_id",
    "source_commit",
    "source_tree",
    "coverage_denominator",
    "producer_receipts",
    "positive_observations",
    "negative_observations",
    "resolver_trace",
    "evidence_kinds",
    "native_owner_attestations",
    "self_digest_algorithm",
    "content_sha256"
  ],
  "properties": {
    "schema": {
      "const": "bms.project-manager.package-evidence-body.pm03b.v2"
    },
    "evidence_body_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "package_id": {
      "const": "PM-03B"
    },
    "coverage_item": {
      "enum": [
        "ngs-domain-v3",
        "local-projects",
        "domain-provisioning",
        "project-links"
      ]
    },
    "coverage_contract_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "source_tree": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "coverage_denominator": {
      "$ref": "bms.project-manager.operational-evidence.v2#/$defs/canonicalJsonArtifact"
    },
    "producer_receipts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "bms.project-manager.operational-evidence.v2#/$defs/receiptPointer"
      }
    },
    "positive_observations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "bms.project-manager.operational-evidence.v2#/$defs/canonicalJsonArtifact"
      }
    },
    "negative_observations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "bms.project-manager.operational-evidence.v2#/$defs/canonicalJsonArtifact"
      }
    },
    "resolver_trace": {
      "$ref": "bms.project-manager.operational-evidence.v2#/$defs/canonicalJsonArtifact"
    },
    "evidence_kinds": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 255
      }
    },
    "native_owner_attestations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": false,
      "prefixItems": [
        {
          "allOf": [
            {
              "$ref": "bms.project-manager.operational-evidence.v2#/$defs/writerAssertion"
            },
            {
              "type": "object",
              "properties": {
                "principal_id": {
                  "const": "ngs-molbio-domain-owner"
                }
              },
              "required": [
                "principal_id"
              ]
            }
          ]
        }
      ]
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "SHA-256 of RFC 8785 UTF-8 for the complete signed document after all assertions are inserted, with only content_sha256 omitted."
    },
    "self_digest_algorithm": {
      "const": "sha256-rfc8785-complete-signed-document-omit-self-digest-v2"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "coverage_item": {
            "const": "ngs-domain-v3"
          }
        },
        "required": [
          "coverage_item"
        ]
      },
      "then": {
        "properties": {
          "coverage_contract_id": {
            "const": "bms.project-manager.coverage.ngs-domain-v3.v1"
          },
          "evidence_kinds": {
            "const": [
              "ngs-domain-v3-denominator",
              "ngs-domain-v3-positive-observation",
              "ngs-domain-v3-negative-observation",
              "ngs-domain-v3-resolver-trace"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "coverage_item": {
            "const": "local-projects"
          }
        },
        "required": [
          "coverage_item"
        ]
      },
      "then": {
        "properties": {
          "coverage_contract_id": {
            "const": "bms.project-manager.coverage.local-projects.v1"
          },
          "evidence_kinds": {
            "const": [
              "local-projects-denominator",
              "local-projects-positive-observation",
              "local-projects-negative-observation",
              "local-projects-resolver-trace"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "coverage_item": {
            "const": "domain-provisioning"
          }
        },
        "required": [
          "coverage_item"
        ]
      },
      "then": {
        "properties": {
          "coverage_contract_id": {
            "const": "bms.project-manager.coverage.domain-provisioning.v1"
          },
          "evidence_kinds": {
            "const": [
              "domain-provisioning-denominator",
              "domain-provisioning-positive-observation",
              "domain-provisioning-negative-observation",
              "domain-provisioning-resolver-trace"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "coverage_item": {
            "const": "project-links"
          }
        },
        "required": [
          "coverage_item"
        ]
      },
      "then": {
        "properties": {
          "coverage_contract_id": {
            "const": "bms.project-manager.coverage.project-links.v1"
          },
          "evidence_kinds": {
            "const": [
              "project-links-denominator",
              "project-links-positive-observation",
              "project-links-negative-observation",
              "project-links-resolver-trace"
            ]
          }
        }
      }
    }
  ]
}
