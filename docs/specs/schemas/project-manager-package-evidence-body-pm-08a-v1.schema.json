{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bms.project-manager.package-evidence-body.pm08a.v1",
  "title": "PM-08A authenticated coverage evidence body v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "evidence_body_id",
    "package_id",
    "coverage_item",
    "coverage_contract_id",
    "source_commit",
    "source_tree",
    "coverage_denominator",
    "producer_receipts",
    "positive_observations",
    "negative_observations",
    "resolver_trace",
    "evidence_kinds",
    "native_owner_attestations",
    "content_sha256"
  ],
  "properties": {
    "schema": {
      "const": "bms.project-manager.package-evidence-body.pm08a.v1"
    },
    "evidence_body_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "package_id": {
      "const": "PM-08A"
    },
    "coverage_item": {
      "enum": [
        "plan-execution",
        "launch-context-v2",
        "launch-fencing",
        "retry-resubmit-clone-cancel"
      ]
    },
    "coverage_contract_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "source_tree": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "coverage_denominator": {
      "$ref": "bms.project-manager.operational-evidence.v1#/$defs/canonicalJsonArtifact"
    },
    "producer_receipts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "bms.project-manager.operational-evidence.v1#/$defs/receiptPointer"
      }
    },
    "positive_observations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "bms.project-manager.operational-evidence.v1#/$defs/canonicalJsonArtifact"
      }
    },
    "negative_observations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "bms.project-manager.operational-evidence.v1#/$defs/canonicalJsonArtifact"
      }
    },
    "resolver_trace": {
      "$ref": "bms.project-manager.operational-evidence.v1#/$defs/canonicalJsonArtifact"
    },
    "evidence_kinds": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 255
      }
    },
    "native_owner_attestations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": false,
      "prefixItems": [
        {
          "allOf": [
            {
              "$ref": "bms.project-manager.operational-evidence.v1#/$defs/writerAssertion"
            },
            {
              "type": "object",
              "properties": {
                "principal_id": {
                  "const": "ngs-molbio-shared-package-owner"
                }
              },
              "required": [
                "principal_id"
              ]
            }
          ]
        }
      ]
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "coverage_item": {
            "const": "plan-execution"
          }
        },
        "required": [
          "coverage_item"
        ]
      },
      "then": {
        "properties": {
          "coverage_contract_id": {
            "const": "bms.project-manager.coverage.plan-execution.v1"
          },
          "evidence_kinds": {
            "const": [
              "plan-execution-denominator",
              "plan-execution-positive-observation",
              "plan-execution-negative-observation",
              "plan-execution-resolver-trace"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "coverage_item": {
            "const": "launch-context-v2"
          }
        },
        "required": [
          "coverage_item"
        ]
      },
      "then": {
        "properties": {
          "coverage_contract_id": {
            "const": "bms.project-manager.coverage.launch-context-v2.v1"
          },
          "evidence_kinds": {
            "const": [
              "launch-context-v2-denominator",
              "launch-context-v2-positive-observation",
              "launch-context-v2-negative-observation",
              "launch-context-v2-resolver-trace"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "coverage_item": {
            "const": "launch-fencing"
          }
        },
        "required": [
          "coverage_item"
        ]
      },
      "then": {
        "properties": {
          "coverage_contract_id": {
            "const": "bms.project-manager.coverage.launch-fencing.v1"
          },
          "evidence_kinds": {
            "const": [
              "launch-fencing-denominator",
              "launch-fencing-positive-observation",
              "launch-fencing-negative-observation",
              "launch-fencing-resolver-trace"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "coverage_item": {
            "const": "retry-resubmit-clone-cancel"
          }
        },
        "required": [
          "coverage_item"
        ]
      },
      "then": {
        "properties": {
          "coverage_contract_id": {
            "const": "bms.project-manager.coverage.retry-resubmit-clone-cancel.v1"
          },
          "evidence_kinds": {
            "const": [
              "retry-resubmit-clone-cancel-denominator",
              "retry-resubmit-clone-cancel-positive-observation",
              "retry-resubmit-clone-cancel-negative-observation",
              "retry-resubmit-clone-cancel-resolver-trace"
            ]
          }
        }
      }
    }
  ]
}
