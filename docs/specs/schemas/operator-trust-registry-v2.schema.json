{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bms.operator-trust-registry.v2",
  "title": "Protected Christian release-owner COSE trust registry v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "registry_id",
    "generation",
    "owner_principal_id",
    "issuer_id",
    "audience",
    "storage_policy",
    "access_policy",
    "rp_id",
    "allowed_origins",
    "credentials",
    "registry_writer_assertion",
    "content_algorithm",
    "content_sha256"
  ],
  "properties": {
    "schema": {
      "const": "bms.operator-trust-registry.v2"
    },
    "registry_id": {
      "const": "bms.operator-trust-registry.v2"
    },
    "generation": {
      "type": "integer",
      "minimum": 1
    },
    "owner_principal_id": {
      "const": "christian-release-owner-v1"
    },
    "issuer_id": {
      "const": "bms-development-authn-service"
    },
    "audience": {
      "const": "bms-project-manager-pm12"
    },
    "storage_policy": {
      "const": "owner-enrollment-service-protected-file-v2"
    },
    "access_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_integrator_write_access",
        "release_integrator_registration_access",
        "authorization_service_read_access",
        "owner_enrollment_service_write_access"
      ],
      "properties": {
        "release_integrator_write_access": {
          "const": false
        },
        "release_integrator_registration_access": {
          "const": false
        },
        "authorization_service_read_access": {
          "const": true
        },
        "owner_enrollment_service_write_access": {
          "const": true
        }
      }
    },
    "rp_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253
    },
    "allowed_origins": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "uri",
        "maxLength": 1024
      }
    },
    "credentials": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 8,
      "propertyNames": {
        "pattern": "^[A-Za-z0-9_-]{16,4096}$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "credential_id_sha256",
          "cose_public_key_base64url",
          "cose_public_key_sha256",
          "signature_algorithm",
          "status",
          "owner_enrollment_receipt",
          "sign_counter_authority_id"
        ],
        "properties": {
          "credential_id_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "cose_public_key_base64url": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{16,4096}$"
          },
          "cose_public_key_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "signature_algorithm": {
            "enum": [
              "ES256",
              "EdDSA"
            ]
          },
          "status": {
            "enum": [
              "active",
              "retired"
            ]
          },
          "owner_enrollment_receipt": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "receipt_schema_id",
              "receipt_id",
              "receipt_sha256",
              "native_identity"
            ],
            "properties": {
              "receipt_schema_id": {
                "const": "bms.operator-owner-enrollment.v1"
              },
              "receipt_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 255
              },
              "receipt_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "native_identity": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              }
            }
          },
          "sign_counter_authority_id": {
            "const": "bms.operator-sign-counter.v1"
          }
        }
      }
    },
    "registry_writer_assertion": {
      "allOf": [
        {
          "$ref": "bms.project-manager.operational-evidence.v1#/$defs/writerAssertion"
        },
        {
          "type": "object",
          "properties": {
            "principal_id": {
              "const": "bms-owner-enrollment-service-v1"
            }
          },
          "required": [
            "principal_id"
          ]
        }
      ]
    },
    "content_algorithm": {
      "const": "sha256-rfc8785-operator-trust-registry-v2"
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
