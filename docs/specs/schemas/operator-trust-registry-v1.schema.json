{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bms.operator-trust-registry.v1",
  "title": "Protected Christian release-owner trust registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "registry_id",
    "generation",
    "owner_principal_id",
    "issuer_id",
    "audience",
    "storage_policy",
    "access_policy",
    "owner_enrollment_method",
    "owner_enrollment_receipt_sha256",
    "rp_id",
    "allowed_origins",
    "credentials",
    "content_algorithm",
    "content_sha256"
  ],
  "properties": {
    "schema": {
      "const": "bms.operator-trust-registry.v1"
    },
    "registry_id": {
      "const": "bms.operator-trust-registry.v1"
    },
    "generation": {
      "type": "integer",
      "minimum": 1
    },
    "owner_principal_id": {
      "const": "christian-release-owner-v1"
    },
    "issuer_id": {
      "const": "bms-development-authn-service"
    },
    "audience": {
      "const": "bms-project-manager-pm12"
    },
    "storage_policy": {
      "const": "owner-enrollment-service-protected-file-v1"
    },
    "access_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_integrator_write_access",
        "release_integrator_registration_access",
        "authorization_service_read_access",
        "owner_enrollment_service_write_access"
      ],
      "properties": {
        "release_integrator_write_access": {
          "const": false
        },
        "release_integrator_registration_access": {
          "const": false
        },
        "authorization_service_read_access": {
          "const": true
        },
        "owner_enrollment_service_write_access": {
          "const": true
        }
      }
    },
    "owner_enrollment_method": {
      "const": "local-console-webauthn-owner-enrollment-v1"
    },
    "owner_enrollment_receipt_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "rp_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253
    },
    "allowed_origins": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "uri",
        "maxLength": 1024
      }
    },
    "credentials": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/credential"
      },
      "contains": {
        "type": "object",
        "properties": {
          "status": {
            "const": "active"
          }
        },
        "required": [
          "status"
        ]
      },
      "minContains": 1
    },
    "content_algorithm": {
      "const": "sha256-rfc8785-operator-trust-registry-v1"
    },
    "content_sha256": {
      "allOf": [
        {
          "$ref": "#/$defs/sha256"
        }
      ],
      "description": "SHA-256 of UTF-8 RFC 8785 canonical JSON for the complete registry with only content_sha256 omitted."
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "credential": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "credential_id_sha256",
        "credential_public_key_sha256",
        "signature_algorithm",
        "status",
        "sign_count_floor",
        "enrolled_at"
      ],
      "properties": {
        "credential_id_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "credential_public_key_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "signature_algorithm": {
          "enum": [
            "ES256",
            "EdDSA"
          ]
        },
        "status": {
          "enum": [
            "active",
            "retired"
          ]
        },
        "sign_count_floor": {
          "type": "integer",
          "minimum": 0
        },
        "enrolled_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
