{
  "$defs": {
    "FamsaSettings": {
      "additionalProperties": false,
      "properties": {
        "engine": {
          "const": "famsa",
          "default": "famsa",
          "title": "Engine",
          "type": "string"
        },
        "threads": {
          "default": 1,
          "minimum": 1,
          "title": "Threads",
          "type": "integer"
        },
        "guide_tree": {
          "default": "sl",
          "enum": [
            "sl",
            "upgma",
            "nj",
            "import"
          ],
          "title": "Guide Tree",
          "type": "string"
        },
        "guide_tree_newick": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Newick guide tree, used when Guide tree is set to import. Use Leaf mapping to match leaves to rows.",
          "format": "newick",
          "title": "Guide Tree Newick"
        },
        "leaf_mapping": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Matches tree leaf names to row IDs. Unmatched leaves are reported, not guessed.",
          "title": "Leaf Mapping",
          "type": "object"
        },
        "refine_mode": {
          "default": "auto",
          "enum": [
            "auto",
            "on",
            "off"
          ],
          "title": "Refine Mode",
          "type": "string"
        },
        "keep_duplicates": {
          "default": false,
          "title": "Keep Duplicates",
          "type": "boolean"
        },
        "medoidtree": {
          "default": false,
          "title": "Medoidtree",
          "type": "boolean"
        },
        "medoid_seeds": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Medoid Seeds"
        },
        "medoid_threshold": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Medoid Threshold"
        },
        "trim_columns": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trim Columns"
        },
        "r": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "R"
        },
        "sm": {
          "anyOf": [
            {
              "enum": [
                "MIQS",
                "PFASUM31",
                "PFASUM43",
                "PFASUM60"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sm"
        },
        "go": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Go"
        },
        "ge": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ge"
        },
        "tgo": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tgo"
        },
        "tge": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tge"
        },
        "dist": {
          "anyOf": [
            {
              "enum": [
                "indel_div_lcs",
                "indel075_div_lcs"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dist"
        },
        "gsd": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Gsd"
        },
        "gsl": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Gsl"
        },
        "dgr": {
          "default": false,
          "title": "Dgr",
          "type": "boolean"
        },
        "dgo": {
          "default": false,
          "title": "Dgo",
          "type": "boolean"
        },
        "dsp": {
          "default": false,
          "title": "Dsp",
          "type": "boolean"
        },
        "verbose": {
          "default": false,
          "title": "Verbose",
          "type": "boolean"
        }
      },
      "title": "FamsaSettings",
      "type": "object"
    },
    "MafftSettings": {
      "additionalProperties": false,
      "properties": {
        "engine": {
          "const": "mafft",
          "default": "mafft",
          "title": "Engine",
          "type": "string"
        },
        "strategy": {
          "default": "fft_ns_2",
          "enum": [
            "fft_ns_2",
            "linsi",
            "ginsi",
            "einsi",
            "auto"
          ],
          "title": "Strategy",
          "type": "string"
        },
        "threads": {
          "default": 1,
          "minimum": 1,
          "title": "Threads",
          "type": "integer"
        },
        "treeout": {
          "default": false,
          "title": "Treeout",
          "type": "boolean"
        },
        "pair_method": {
          "anyOf": [
            {
              "enum": [
                "6merpair",
                "10merpair",
                "hybridpair",
                "localgenafpair",
                "oldgenafpair",
                "shortlongpair",
                "longshortpair"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Pair method. Overrides the strategy pair method; blank keeps the strategy setting. 10merpair needs DNA/RNA. hybridpair can fail on protein input.",
          "title": "Pair Method"
        },
        "tree_method": {
          "anyOf": [
            {
              "enum": [
                "large",
                "memsavetree",
                "memsavetreex",
                "stepadd",
                "youngestlinkage",
                "pileup",
                "randomchain"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Guide-tree method. Blank uses the strategy setting.",
          "title": "Tree Method"
        },
        "refinement_policy": {
          "anyOf": [
            {
              "enum": [
                "bestfirst",
                "adhoc0",
                "adhoc1",
                "adhoc2",
                "simplehillclimbing"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Parallel refinement method.",
          "title": "Refinement Policy"
        },
        "alga": {
          "default": false,
          "title": "Alga",
          "type": "boolean"
        },
        "allowshift": {
          "default": false,
          "description": "Shift-aware scoring. Needs the G-INS-i (globalpair) strategy.",
          "title": "Allowshift",
          "type": "boolean"
        },
        "anchors": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Anchor table: 7 numbers per line (i j start_i end_i start_j end_j score), 1-based. i and j are sequence numbers in input order; i comes before j.",
          "format": "mafft-anchors",
          "title": "Anchors"
        },
        "bunkatsunashi": {
          "default": false,
          "title": "Bunkatsunashi",
          "type": "boolean"
        },
        "focus": {
          "default": false,
          "description": "Focus the alignment on marked sequences. Use Focus rows to mark them.",
          "title": "Focus",
          "type": "boolean"
        },
        "focus_rows": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Row IDs to focus on, one per line. Unknown IDs are ignored.",
          "title": "Focus Rows"
        },
        "gep": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Global pairwise offset (--gep).",
          "title": "Gep"
        },
        "gexp": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Global pairwise gap extension (--gexp).",
          "title": "Gexp"
        },
        "gop": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Global pairwise gap opening (--gop).",
          "title": "Gop"
        },
        "kappa": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Kappa"
        },
        "leavegappyregion": {
          "default": false,
          "description": "Same as legacygappenalty.",
          "title": "Leavegappyregion",
          "type": "boolean"
        },
        "lhlimit": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Local-homology limit for memory-saving tree methods.",
          "title": "Lhlimit"
        },
        "minimumweight": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimumweight"
        },
        "noscore": {
          "default": false,
          "title": "Noscore",
          "type": "boolean"
        },
        "oneiteration": {
          "default": false,
          "title": "Oneiteration",
          "type": "boolean"
        },
        "shiftpenalty": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Shiftpenalty"
        },
        "similaritylevel": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Similaritylevel"
        },
        "skipiterate": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Skipiterate"
        },
        "sp": {
          "default": false,
          "description": "Rigorous sum-of-pairs scoring. Refinement needs Iteration threads = 0.",
          "title": "Sp",
          "type": "boolean"
        },
        "sparsepickup": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Sparse pickup. Some rows may be left out; those are listed in a separate file.",
          "title": "Sparsepickup"
        },
        "terminalmargin": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Terminalmargin"
        },
        "unalignlevel": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unalignlevel"
        },
        "nodeout": {
          "default": false,
          "title": "Nodeout",
          "type": "boolean"
        },
        "distance_output": {
          "anyOf": [
            {
              "enum": [
                "distout",
                "distoutclustalo"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Distance Output"
        },
        "scoreout": {
          "default": false,
          "description": "Write alignment scores to the engine log. Can fail with L-INS-i.",
          "title": "Scoreout",
          "type": "boolean"
        },
        "op": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Op"
        },
        "ep": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ep"
        },
        "weighti": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Pairwise consistency weight; applies to iterative pairwise strategies.",
          "title": "Weighti"
        },
        "lop": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Local pairwise gap opening penalty.",
          "title": "Lop"
        },
        "lep": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Local pairwise offset.",
          "title": "Lep"
        },
        "lexp": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Local pairwise gap extension penalty.",
          "title": "Lexp"
        },
        "long_gap_open": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "E-INS-i skip penalty (--LOP).",
          "title": "Long Gap Open"
        },
        "long_gap_extend": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "E-INS-i skip extension penalty (--LEXP).",
          "title": "Long Gap Extend"
        },
        "bl": {
          "anyOf": [
            {
              "enum": [
                30,
                45,
                62,
                80
              ],
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Protein BLOSUM matrix number.",
          "title": "Bl"
        },
        "jtt": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Protein JTT PAM distance.",
          "title": "Jtt"
        },
        "tm": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Protein transmembrane PAM distance.",
          "title": "Tm"
        },
        "kimura": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Nucleotide transition/transversion parameter.",
          "title": "Kimura"
        },
        "randomseed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Random seed, where MAFFT uses one.",
          "title": "Randomseed"
        },
        "nofft": {
          "default": false,
          "title": "Nofft",
          "type": "boolean"
        },
        "fft": {
          "default": false,
          "description": "Force FFT; compiled before nofft if both are selected.",
          "title": "Fft",
          "type": "boolean"
        },
        "threadit": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Threads for refinement. 0 turns off threaded refinement; -1 is automatic.",
          "title": "Threadit"
        },
        "threadtb": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Threads for the progressive step. -1 is automatic.",
          "title": "Threadtb"
        },
        "parttree": {
          "anyOf": [
            {
              "enum": [
                "parttree",
                "dpparttree"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "PartTree distance mode.",
          "title": "Parttree"
        },
        "partsize": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Partsize"
        },
        "groupsize": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Groupsize"
        },
        "linkage": {
          "anyOf": [
            {
              "enum": [
                "minimumlinkage",
                "averagelinkage"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Linkage"
        },
        "mixedlinkage": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Mixed linkage coefficient; compiled after linkage when both are supplied.",
          "title": "Mixedlinkage"
        },
        "unweight": {
          "default": false,
          "title": "Unweight",
          "type": "boolean"
        },
        "termgappenalty": {
          "default": false,
          "title": "Termgappenalty",
          "type": "boolean"
        },
        "legacygappenalty": {
          "default": false,
          "title": "Legacygappenalty",
          "type": "boolean"
        },
        "anysymbol": {
          "default": false,
          "title": "Anysymbol",
          "type": "boolean"
        },
        "preservecase": {
          "default": false,
          "title": "Preservecase",
          "type": "boolean"
        },
        "direction": {
          "anyOf": [
            {
              "enum": [
                "adjustdirection",
                "adjustdirectionaccurately"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Reverse-complement sequences when needed (DNA/RNA).",
          "title": "Direction"
        },
        "memsave": {
          "anyOf": [
            {
              "enum": [
                "memsave",
                "nomemsave"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Memsave"
        },
        "fmodel": {
          "default": false,
          "title": "Fmodel",
          "type": "boolean"
        },
        "nucleotide_scoring": {
          "anyOf": [
            {
              "enum": [
                "nwildcard",
                "nzero"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Nucleotide Scoring"
        },
        "opdist": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Opdist"
        },
        "exp": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exp"
        },
        "treein": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "MAFFT merge table (not Newick): one merge per line, 1-based sequence numbers and branch lengths.",
          "format": "mafft-merge-table",
          "title": "Treein"
        },
        "aamatrix": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Custom amino-acid scoring matrix. Overrides BLOSUM, JTT and transmembrane settings.",
          "format": "mafft-amino-matrix",
          "title": "Aamatrix"
        },
        "retree": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Override the strategy guide-tree rebuild count.",
          "title": "Retree"
        },
        "maxiterate": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Override the strategy refinement iteration count.",
          "title": "Maxiterate"
        },
        "reorder": {
          "default": false,
          "title": "Reorder",
          "type": "boolean"
        },
        "quiet": {
          "default": false,
          "title": "Quiet",
          "type": "boolean"
        }
      },
      "title": "MafftSettings",
      "type": "object"
    },
    "MuscleSettings": {
      "additionalProperties": false,
      "properties": {
        "engine": {
          "const": "muscle",
          "default": "muscle",
          "title": "Engine",
          "type": "string"
        },
        "mode": {
          "default": "align",
          "enum": [
            "align",
            "super5"
          ],
          "title": "Mode",
          "type": "string"
        },
        "guidetreeout": {
          "default": false,
          "description": "Write the guide tree only. MUSCLE stops before aligning, so no alignment is produced. Ignored with Random-chain tree.",
          "title": "Guidetreeout",
          "type": "boolean"
        },
        "hmmin": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "MUSCLE HMM parameter file.",
          "format": "muscle-hmm",
          "title": "Hmmin"
        },
        "hmmout": {
          "default": false,
          "description": "Write the HMM parameters to a file (Super5 only).",
          "title": "Hmmout",
          "type": "boolean"
        },
        "anchor_letter": {
          "anyOf": [
            {
              "maxLength": 1,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "One-character HMM anchor (case-sensitive).",
          "title": "Anchor Letter"
        },
        "randseed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Random seed. 0 picks a seed from the clock.",
