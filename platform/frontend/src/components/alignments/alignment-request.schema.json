{
  "$defs": {
    "FamsaSettings": {
      "additionalProperties": false,
      "properties": {
        "engine": {
          "const": "famsa",
          "default": "famsa",
          "title": "Engine",
          "type": "string"
        },
        "threads": {
          "default": 1,
          "minimum": 1,
          "title": "Threads",
          "type": "integer"
        },
        "guide_tree": {
          "default": "sl",
          "enum": [
            "sl",
            "upgma",
            "nj"
          ],
          "title": "Guide Tree",
          "type": "string"
        },
        "refine_mode": {
          "default": "auto",
          "enum": [
            "auto",
            "on",
            "off"
          ],
          "title": "Refine Mode",
          "type": "string"
        },
        "keep_duplicates": {
          "default": false,
          "title": "Keep Duplicates",
          "type": "boolean"
        },
        "medoidtree": {
          "default": false,
          "title": "Medoidtree",
          "type": "boolean"
        },
        "medoid_seeds": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Medoid Seeds"
        },
        "medoid_threshold": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Medoid Threshold"
        },
        "trim_columns": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trim Columns"
        },
        "r": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "R"
        },
        "sm": {
          "anyOf": [
            {
              "enum": [
                "MIQS",
                "PFASUM31",
                "PFASUM43",
                "PFASUM60"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sm"
        },
        "go": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Go"
        },
        "ge": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ge"
        },
        "tgo": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tgo"
        },
        "tge": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tge"
        },
        "dist": {
          "anyOf": [
            {
              "enum": [
                "indel_div_lcs",
                "indel075_div_lcs"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dist"
        },
        "gsd": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Gsd"
        },
        "gsl": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Gsl"
        },
        "dgr": {
          "default": false,
          "title": "Dgr",
          "type": "boolean"
        },
        "dgo": {
          "default": false,
          "title": "Dgo",
          "type": "boolean"
        },
        "dsp": {
          "default": false,
          "title": "Dsp",
          "type": "boolean"
        },
        "verbose": {
          "default": false,
          "title": "Verbose",
          "type": "boolean"
        }
      },
      "title": "FamsaSettings",
      "type": "object"
    },
    "MafftSettings": {
      "additionalProperties": false,
      "properties": {
        "engine": {
          "const": "mafft",
          "default": "mafft",
          "title": "Engine",
          "type": "string"
        },
        "strategy": {
          "default": "fft_ns_2",
          "enum": [
            "fft_ns_2",
            "linsi",
            "ginsi",
            "einsi",
            "auto"
          ],
          "title": "Strategy",
          "type": "string"
        },
        "threads": {
          "default": 1,
          "minimum": 1,
          "title": "Threads",
          "type": "integer"
        },
        "treeout": {
          "default": false,
          "title": "Treeout",
          "type": "boolean"
        },
        "op": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Op"
        },
        "ep": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ep"
        },
        "weighti": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Pairwise consistency weight; applies to iterative pairwise strategies.",
          "title": "Weighti"
        },
        "lop": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Local pairwise gap opening penalty.",
          "title": "Lop"
        },
        "lep": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Local pairwise offset.",
          "title": "Lep"
        },
        "lexp": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Local pairwise gap extension penalty.",
          "title": "Lexp"
        },
        "long_gap_open": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "E-INS-i skip penalty (native --LOP).",
          "title": "Long Gap Open"
        },
        "long_gap_extend": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "E-INS-i skip extension penalty (native --LEXP).",
          "title": "Long Gap Extend"
        },
        "bl": {
          "anyOf": [
            {
              "enum": [
                30,
                45,
                62,
                80
              ],
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Protein BLOSUM matrix number.",
          "title": "Bl"
        },
        "jtt": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Protein JTT PAM distance.",
          "title": "Jtt"
        },
        "tm": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Protein transmembrane PAM distance.",
          "title": "Tm"
        },
        "kimura": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Nucleotide transition/transversion parameter.",
          "title": "Kimura"
        },
        "randomseed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Native random seed where used by MAFFT.",
          "title": "Randomseed"
        },
        "nofft": {
          "default": false,
          "title": "Nofft",
          "type": "boolean"
        },
        "retree": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Override the strategy guide-tree rebuild count.",
          "title": "Retree"
        },
        "maxiterate": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Override the strategy refinement iteration count.",
          "title": "Maxiterate"
        },
        "reorder": {
          "default": false,
          "title": "Reorder",
          "type": "boolean"
        },
        "quiet": {
          "default": false,
          "title": "Quiet",
          "type": "boolean"
        }
      },
      "title": "MafftSettings",
      "type": "object"
    },
    "MuscleSettings": {
      "additionalProperties": false,
      "properties": {
        "engine": {
          "const": "muscle",
          "default": "muscle",
          "title": "Engine",
          "type": "string"
        },
        "mode": {
          "default": "align",
          "enum": [
            "align",
            "super5"
          ],
          "title": "Mode",
          "type": "string"
        },
        "threads": {
          "default": 1,
          "minimum": 1,
          "title": "Threads",
          "type": "integer"
        },
        "permutation": {
          "default": "none",
          "enum": [
            "none",
            "abc",
            "acb",
            "bca",
            "all"
          ],
          "title": "Permutation",
          "type": "string"
        },
        "perturb": {
          "default": 0,
          "minimum": 0,
          "title": "Perturb",
          "type": "integer"
        },
        "ensemble": {
          "default": "none",
          "enum": [
            "none",
            "stratified",
            "diversified"
          ],
          "title": "Ensemble",
          "type": "string"
        },
        "replicates": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Replicates"
        }
      },
      "title": "MuscleSettings",
      "type": "object"
    },
    "Row": {
      "additionalProperties": false,
      "properties": {
        "row_id": {
          "title": "Row Id",
          "type": "string"
        },
        "header": {
          "title": "Header",
          "type": "string"
        },
        "sequence": {
          "title": "Sequence",
          "type": "string"
        },
        "source_member_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Member Id"
        },
        "occurrence_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Occurrence Id"
        },
        "source_offset": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Offset"
        },
        "source_positions": {
          "anyOf": [
            {
              "items": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Positions"
        },
        "transformation_provenance": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Transformation Provenance"
        }
      },
      "required": [
        "row_id",
        "header",
        "sequence"
      ],
      "title": "Row",
      "type": "object"
    },
    "SequenceSet": {
      "additionalProperties": false,
      "properties": {
        "molecule": {
          "enum": [
            "protein",
            "dna",
            "rna"
          ],
          "title": "Molecule",
          "type": "string"
        },
        "rows": {
          "items": {
            "$ref": "#/$defs/Row"
          },
          "title": "Rows",
          "type": "array"
        },
        "source_format": {
          "default": "fasta",
          "enum": [
            "fasta",
            "stockholm",
            "clustal",
            "a3m"
          ],
          "title": "Source Format",
          "type": "string"
        },
        "source_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Text"
        },
        "stockholm_annotations": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Stockholm Annotations",
          "type": "array"
        },
        "format_observations": {
          "items": {
            "type": "string"
          },
          "title": "Format Observations",
          "type": "array"
        },
        "source_evidence": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Source Evidence",
          "type": "array"
        }
      },
      "required": [
        "molecule",
        "rows"
      ],
      "title": "SequenceSet",
      "type": "object"
    },
    "TwilightSettings": {
      "additionalProperties": false,
      "properties": {
        "engine": {
          "const": "twilight",
          "default": "twilight",
          "title": "Engine",
          "type": "string"
        },
        "threads": {
          "default": 1,
          "minimum": 1,
          "title": "Threads",
          "type": "integer"
        },
        "method": {
          "default": "pairwise",
          "enum": [
            "pairwise",
            "tcs"
          ],
          "title": "Method",
          "type": "string"
        },
        "acc_mode": {
          "default": 0,
          "enum": [
            0,
            1,
            2,
            3
          ],
          "title": "Acc Mode",
          "type": "integer"
        },
        "acc_max_group": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Acc Max Group"
        },
        "acc_sample_rate": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Acc Sample Rate"
        },
        "acc_sample_top": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Acc Sample Top"
        },
        "consistency_weight": {
          "default": 5.0,
          "title": "Consistency Weight",
          "type": "number"
        },
        "max_subtree": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Subtree"
        },
        "remove_gappy": {
          "default": 0.95,
          "title": "Remove Gappy",
          "type": "number"
        },
        "wildcard": {
          "default": false,
          "title": "Wildcard",
          "type": "boolean"
        },
        "rooted": {
          "default": false,
          "title": "Rooted",
          "type": "boolean"
        },
        "prune": {
          "default": false,
          "title": "Prune",
          "type": "boolean"
        },
        "filter": {
          "default": false,
          "title": "Filter",
          "type": "boolean"
        },
        "length_deviation": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Length Deviation"
        },
        "max_ambig": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Ambig"
        },
        "max_len": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Len"
        },
        "min_len": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min Len"
        },
        "write_filtered": {
          "default": false,
          "title": "Write Filtered",
          "type": "boolean"
        },
        "write_prune": {
          "default": false,
          "title": "Write Prune",
          "type": "boolean"
        },
        "check": {
          "default": false,
          "title": "Check",
          "type": "boolean"
        },
        "verbose": {
          "default": false,
          "title": "Verbose",
          "type": "boolean"
        },
        "match": {
          "default": 18,
          "title": "Match",
          "type": "number"
        },
        "mismatch": {
          "default": -8,
          "title": "Mismatch",
          "type": "number"
        },
        "transition": {
          "default": -4,
          "title": "Transition",
          "type": "number"
        },
        "gap_open": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Gap Open"
        },
        "gap_extend": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Gap Extend"
        },
        "gap_ends": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Gap Ends"
        },
        "scale": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scale"
        },
        "xdrop": {
          "default": 600,
          "title": "Xdrop",
          "type": "number"
        },
        "guide_source": {
          "default": "supplied",
          "enum": [
            "supplied",
            "mafft"
          ],
          "title": "Guide Source",
          "type": "string"
        },
        "guide_tree": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Guide Tree"
        },
        "leaf_mapping": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Leaf Mapping",
          "type": "object"
        }
      },
      "title": "TwilightSettings",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "roster": {
      "$ref": "#/$defs/SequenceSet"
    },
    "settings": {
      "discriminator": {
        "mapping": {
          "famsa": "#/$defs/FamsaSettings",
          "mafft": "#/$defs/MafftSettings",
          "muscle": "#/$defs/MuscleSettings",
          "twilight": "#/$defs/TwilightSettings"
        },
        "propertyName": "engine"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/MafftSettings"
        },
        {
          "$ref": "#/$defs/FamsaSettings"
        },
        {
          "$ref": "#/$defs/MuscleSettings"
        },
        {
          "$ref": "#/$defs/TwilightSettings"
        }
      ],
      "title": "Settings"
    }
  },
  "required": [
    "roster",
    "settings"
  ],
  "title": "AlignmentRequest",
  "type": "object"
}
