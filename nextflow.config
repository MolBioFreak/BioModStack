// ==========================================
// UNIVERSAL VRAM-AWARE GPU SELECTION
// ==========================================
// Model VRAM profiles: [baseVram: MB, scaleFactor: MB per (100 residues)²]
// All GPUs available for overflow when heavy GPUs are full
def GPU_VRAM_PROFILES = [
    // Heavy structure predictors (quadratic scaling with seq length)
    'boltz':      [base: 7000, scale: 40, seqAware: true],   // 7GB + 40*(len/100)² (Increased from 5GB/30)
    'rf3':        [base: 8000, scale: 50, seqAware: true],   // 8GB + 50*(len/100)² (Increased from 6GB/40)
    'af2':        [base: 9000, scale: 60, seqAware: true],   // 9GB + 60*(len/100)² (Increased from 8GB/50)
    
    // Design/generation models (roughly linear or fixed)
    'rfdiffusion': [base: 10000, scale: 20, seqAware: true], // RFDiffusion heavier
    'boltzgen':    [base: 8000, scale: 25, seqAware: true],  // BoltzGen for generation
    'diffdock':    [base: 6000, scale: 10, seqAware: true],  // DiffDock lighter
    
    // Lightweight models (linear/fixed, can pack many)
    'mpnn':        [base: 2500, scale: 5, seqAware: true],   // ProteinMPNN very light
    'fampnn':      [base: 3000, scale: 8, seqAware: true],   // FAMPNN slightly heavier
    
    // Default for unknown models
    'default':     [base: 6000, scale: 20, seqAware: false]
]

// GPU inventory with capacities
def GPU_INVENTORY = [
    '0': [name: 'RTX 5090', capacity: 32607, tier: 'heavy'],
    '1': [name: 'RTX 5060 Ti', capacity: 16311, tier: 'light'],
    '2': [name: 'RTX 3090', capacity: 24576, tier: 'heavy'],
    '3': [name: 'RTX 3090', capacity: 24576, tier: 'heavy']
]

// ROUND-ROBIN GPU SELECTOR (Test Version)
// Simple rotation across heavy GPUs - no delays, no queries
// This maximizes parallelism but doesn't check VRAM availability

def gpuRoundRobinCounter = new java.util.concurrent.atomic.AtomicInteger(0)
def heavyGpuPool = ['0', '2', '3']  // Exclude 5060Ti (GPU 1)

// ==========================================
// GPU COOLDOWN + CAPACITY LOCK SYSTEM
// ==========================================
// Prevents OOM race conditions by:
// 1. Cooldown: GPU unavailable for N seconds after job assignment (CUDA init time)
// 2. Capacity Lock: GPU unavailable if >threshold% VRAM used (prevent overpacking)
// Settings are configurable via API at /api/gpu/scheduler-config

def cooldownFile = new File("${projectDir}/.gpu_cooldowns.json")
def configFile = new File("${projectDir}/.gpu_config.json")

// Read scheduler config from file (written by API)
def getSchedulerConfig = {
    def defaultConfig = [
        global: [busy_threshold: 0.5, cooldown_ms: 10000, enabled: true],
        overrides: [:]
    ]
    if (!configFile.exists()) return defaultConfig
    try {
        def content = configFile.text
        if (content.trim().isEmpty()) return defaultConfig
        def config = new groovy.json.JsonSlurper().parseText(content)
        // Merge with defaults
        return [
            global: [
                busy_threshold: config.global?.busy_threshold ?: 0.5,
                cooldown_ms: config.global?.cooldown_ms ?: 10000,
                enabled: config.global?.enabled != false
            ],
            overrides: config.overrides ?: [:]
        ]
    } catch (Exception e) {
        return defaultConfig
    }
}

// Read cooldown timestamps from file
def getCooldowns = {
    if (!cooldownFile.exists()) return [:]
    try {
        def content = cooldownFile.text
        if (content.trim().isEmpty()) return [:]
        return new groovy.json.JsonSlurper().parseText(content)
    } catch (Exception e) {
        return [:]
    }
}



// Read/Write GPU Reservations (Virtual Ledger)
def reservationFile = new File("${projectDir}/.gpu_reservations.json")

def getReservations = {
    if (!reservationFile.exists()) return [:]
    try {
        def content = reservationFile.text
        if (content.trim().isEmpty()) return [:]
        return new groovy.json.JsonSlurper().parseText(content)
    } catch (Exception e) {
        return [:]
    }
}

def cleanReservations = {
    try {
        def reservations = getReservations()
        def now = System.currentTimeMillis()
        def changed = false
        def newReservations = [:]
        
        reservations.each { gpuId, usageList ->
            // Keep reservations valid for 60s (Safety Window for startup)
            def active = usageList.findAll { (now - it.timestamp) < 60000 }
            if (active.size() != usageList.size()) changed = true
            if (!active.isEmpty()) newReservations[gpuId] = active
        }
        
        if (changed) {
            reservationFile.text = groovy.json.JsonOutput.toJson(newReservations)
        }
        return newReservations
    } catch (Exception e) {
        return [:]
    }
}

def addReservation = { String gpuId, int vramMB ->
    try {
        def reservations = getReservations()
        if (!reservations[gpuId]) reservations[gpuId] = []
        reservations[gpuId] << [timestamp: System.currentTimeMillis(), vram: vramMB]
        reservationFile.text = groovy.json.JsonOutput.toJson(reservations)
    } catch (Exception e) {
        def debugFile = new File("${projectDir}/gpu_debug.log")
        debugFile.append("[${new Date()}] [ERROR] Failed to add reservation: ${e.message}\n")
    }
}

// THREAD-LEVEL LOCK: Use synchronized block on static object
def GPU_LOCK = new Object()

// Write cooldown timestamp for a GPU (called within synchronized block)
def setCooldown = { String gpuId ->
    try {
        def cooldowns = getCooldowns()
        cooldowns[gpuId] = System.currentTimeMillis()
        cooldownFile.text = groovy.json.JsonOutput.toJson(cooldowns)
    } catch (Exception e) {
        def debugFile = new File("${projectDir}/gpu_debug.log")
        debugFile.append("[${new Date()}] [ERROR] Failed to set cooldown for GPU ${gpuId}: ${e.message}\n")
    }
}

def selectGpuByVram = { String modelType, Integer seqLen = 300, Boolean allowLightGpu = true ->
    def debugFile = new File("${projectDir}/gpu_debug.log")
    def now = System.currentTimeMillis()
    
    // THREAD-LEVEL SYNCHRONIZATION: Only one thread can select GPU at a time
    synchronized(GPU_LOCK) {
        // Load scheduler config (from API)
        def schedulerConfig = getSchedulerConfig()
        def globalConfig = schedulerConfig.global
        def overrides = schedulerConfig.overrides
        def GPU_COOLDOWN_MS = globalConfig.cooldown_ms as int
        def GPU_BUSY_THRESHOLD = globalConfig.busy_threshold as float
        def capacityLockEnabled = globalConfig.enabled != false
        
        // Calculate estimated VRAM requirement based on model and sequence length
        def profile = GPU_VRAM_PROFILES[modelType] ?: GPU_VRAM_PROFILES['default']
        def estimatedVram = profile.base + (profile.scale * Math.pow(seqLen / 100.0, 2)).intValue()
        // Add 10% safety margin
        def requiredVram = (estimatedVram * 1.1).intValue()
        
        // Load cooldown state (inside lock to ensure fresh read)
        def cooldowns = getCooldowns()
    
        // Create/Clean reservations ledger (Prune expired references)
        cleanReservations()
        def allReservations = getReservations()
    
        try {
            def cmd = "nvidia-smi --query-gpu=index,memory.free --format=csv,noheader,nounits"
            def process = cmd.execute()
            process.waitFor()
        
        if (process.exitValue() == 0) {
            def output = process.text.trim()
            def gpuStats = output.split('\n').collect { line ->
                def parts = line.split(',')
                [index: parts[0].trim(), free: parts[1].trim().toInteger()]
            }
            
            // Filter for heavy GPUs only (0, 2, 3)
            def candidates = gpuStats.findAll { it.index in heavyGpuPool }
            
            // Apply cooldown and Capacity Lock (Predictive)
            def available = candidates.findAll { gpu ->
                def gpuId = gpu.index
                def gpuOverride = overrides[gpuId] ?: [:]
                def capacity = GPU_INVENTORY[gpuId].capacity
                def lastAssign = cooldowns[gpuId] ?: 0
                def cooldownRemaining = GPU_COOLDOWN_MS - (now - lastAssign)
                
                // Active Reservations (The "Ghost" Load)
                def activeRes = allReservations[gpuId] ?: []
                def reservedMB = activeRes.sum { it.vram } ?: 0
                
                // Virtual Stats (Real + Reserved)
                def usedMB = capacity - gpu.free
                def virtualUsedMB = usedMB + reservedMB
                
                // Check 0a: Quick Enable
                if (gpuOverride.quick_enable == true) {
                    def msg = "[QUICK_ENABLE] GPU ${gpuId}: One-shot enable active"
                    debugFile.append("[${new Date()}] ${msg}\n")
                    return true
                }
                
                // Check 0b: Force available
                if (gpuOverride.force_available == true) {
                    def msg = "[FORCE_AVAILABLE] GPU ${gpuId}: Debug override active"
                    debugFile.append("[${new Date()}] ${msg}\n")
                    return true
                }
                
                // Check 1: Cooldown (Timer based)
                if (cooldownRemaining > 0) {
                    def msg = "[COOLDOWN] GPU ${gpuId}: ${(cooldownRemaining / 1000).intValue()}s remaining"
                    debugFile.append("[${new Date()}] ${msg}\n")
                    return false
                }
                
                // Check 2: Capacity lock (Predictive)
                if (capacityLockEnabled) {
                    def threshold = (gpuOverride.threshold != null) ? gpuOverride.threshold : GPU_BUSY_THRESHOLD
                    def thresholdMB = (capacity * threshold).intValue()
                    
                    // PREDICTIVE CHECK: Will adding this job exceed the limit?
                    if ((virtualUsedMB + requiredVram) > thresholdMB) {
                        def usePct = ((virtualUsedMB + requiredVram) / capacity * 100).intValue()
                        def msg = "[LOCKED] GPU ${gpuId}: Predictive Load ${usePct}% > Threshold ${(threshold * 100).intValue()}% (Used:${usedMB} + Rsv:${reservedMB} + New:${requiredVram})"
                        debugFile.append("[${new Date()}] ${msg}\n")
                        return false
                    }
                }
                
                // Check 3: Hardware fit (Virtual Free)
                if ((gpu.free - reservedMB) < requiredVram) {
                    def msg = "[INSUFFICIENT] GPU ${gpuId}: Virtual Free ${(gpu.free - reservedMB)}MB < ${requiredVram}MB required"
                    debugFile.append("[${new Date()}] ${msg}\n")
                    return false
                }
                
                return true
            }
            
            // If no GPU available, WAIT for cooldown to expire and RETRY (throw to trigger Nextflow retry)
            // This ensures fresh VRAM check after wait
            if (available.isEmpty()) {
                def statusSummary = candidates.collect { gpu ->
                    def capacity = GPU_INVENTORY[gpu.index].capacity
                    def usedPct = ((capacity - gpu.free) / capacity * 100).intValue()
                    def lastAssign = cooldowns[gpu.index] ?: 0
                    def cdRemaining = Math.max(0, GPU_COOLDOWN_MS - (now - lastAssign))
                    "GPU${gpu.index}:${usedPct}%,cd=${(cdRemaining/1000).intValue()}s"
                }.join(', ')
                
                // Find the GPU that will exit cooldown soonest
                def soonest = candidates.collect { gpu ->
                    def lastAssign = cooldowns[gpu.index] ?: 0
                    def exitTime = lastAssign + GPU_COOLDOWN_MS
                    [gpu: gpu, exitTime: exitTime]
                }.min { it.exitTime }
                
                def waitMs = Math.max(0, soonest.exitTime - now) + 500  // Add 500ms buffer
                def msg = "[WAITING] All GPUs busy/cooldown. Waiting ${(waitMs/1000).intValue()}s for GPU ${soonest.gpu.index}. Status: ${statusSummary}"
                debugFile.append("[${new Date()}] ${msg}\n")
                
                // Sleep
                if (waitMs > 0 && waitMs < 60000) {
                    Thread.sleep(waitMs as long)
                }
                
                // CRITICAL FIX: Instead of returning stale data, throw exception to force Nextflow retry
                // This will re-run selectGpuByVram with fresh nvidia-smi data
                throw new RuntimeException("GPU_RETRY: All GPUs busy, waited ${(waitMs/1000).intValue()}s. Nextflow will retry.")
            }
            
            // Round-Robin among available GPUs
            available = available.sort { it.index }
            def idx = gpuRoundRobinCounter.getAndIncrement() % available.size()
            def bestGpu = available[idx]
            
            // SET COOLDOWN for selected GPU
            setCooldown(bestGpu.index)
            
            // 2. Add VRAM Reservation (The Ledger)
            addReservation(bestGpu.index, requiredVram)
            
            // AUTO-CLEAR quick_enable for this GPU (one-shot behavior)
            def selectedOverride = overrides[bestGpu.index] ?: [:]
            if (selectedOverride.quick_enable == true) {
                try {
                    def currentConfig = new groovy.json.JsonSlurper().parse(configFile)
                    if (currentConfig.overrides && currentConfig.overrides[bestGpu.index]) {
                        currentConfig.overrides[bestGpu.index].quick_enable = false
                        configFile.text = groovy.json.JsonOutput.prettyPrint(groovy.json.JsonOutput.toJson(currentConfig))
                        debugFile.append("[${new Date()}] [QUICK_ENABLE_CLEARED] GPU ${bestGpu.index}: One-shot used, cleared\n")
                    }
                } catch (Exception e) {
                    debugFile.append("[${new Date()}] [WARN] Failed to clear quick_enable for GPU ${bestGpu.index}: ${e.message}\n")
                }
            }
            
            def msg = "[ASSIGNED] GPU ${bestGpu.index} (${bestGpu.free}MB free) | need: ${requiredVram}MB (${modelType}, ${seqLen}aa) | available: ${available.collect{it.index}}"
            debugFile.append("[${new Date()}] ${msg}\n")
            
            return bestGpu.index
        }

    } catch (RuntimeException re) {
        // Re-throw RuntimeExceptions (like NO_GPU_AVAILABLE) to trigger retry
        throw re
    } catch (Exception e) {
        def errFile = new File("${projectDir}/gpu_debug.log")
        errFile.append("[${new Date()}] [ERROR] nvidia-smi failed: ${e.message}. Throwing to trigger retry.\n")
        throw new RuntimeException("GPU selection failed: ${e.message}")
    }
    }  // End synchronized block
}
params {    
    //////////////////////////
    // ESSENTIAL PARAMETERS //
    //////////////////////////

    // Pipeline mode. Choose from 'monomer_denovo', 'monomer_foldcond', 'monomer_motifscaff', 'monomer_partialdiff',
    // 'binder_denovo', 'binder_foldcond', 'binder_motifscaff', or 'binder_partialdiff'
    rfd_mode          = null
    
    // Number of designs to generate using RFdiffusion
    rfd_num_designs   = 8
    
    // Number of sequences to generate per RFdiffusion design
    seqs_per_design   = 8
    
    // Number of parallel jobs for sequence-based prediction
    num_parallel_jobs = 1

    // Output directory for results. Existing results in this directory will be overwritten. 
    // To generate a unique directory name with date/time use a Groovy function e.g "pdj_results/${new Date().format('yyyyMMdd_HHmmss')}"
    out_dir           = "pdj_results"

    // Complex/Ligand definition JSON path (for complex prediction)
    complex_json_path = null

    //////////////////////////////
    // MODE SPECIFIC PARAMETERS //
    //////////////////////////////
    
    // Contigs specification. See examples in documentation. e.g. '[A17-145/0 50-100]'
    // Required for 'binder_denovo', 'binder_motifscaff', 'binder_partialdiff', 'monomer_denovo', 'monomer_motifscaff', 'monomer_partialdiff' modes
    rfd_contigs            = null

    // Path to input pdb e.g. target protein for binder design 'target.pdb'
    // Required for 'binder_denovo', 'binder_foldcond', 'binder_motifscaff', 'binder_partialdiff', 'monomer_motifscaff', 'monomer_partialdiff' modes
    rfd_input_pdb          = null
    
    // Hotspot residues on target chain(s) for binder design. e.g. '[A56,A115,A123]'
    // Optional for 'binder_denovo' and 'binder_foldcond' modes
    rfd_hotspots           = null

    // Path to directory containing fold conditioning secondary structure (*_ss.pt) and block adjacency files (*_adj.pt) files e.g. 'binderscaffolds/scaffolds_assorted'
    // Required for 'binder_foldcond' and 'monomer_foldcond' modes.
    rfd_scaffold_dir = null
    
    // Paths to fold conditioning secondary structure and block adjacency files for the target protein. e.g. 'target_ss.pt', 'target_adj.pt'
    // Required for 'binder_foldcond' mode.
    rfd_target_ss    = null
    rfd_target_adj   = null

    // Whether to ignore loop regions when applying secondary structure constraints from scaffolds (default=true)
    // Optional for 'binder_foldcond' and 'monomer_foldcond' modes.
    // Recommended to set to false for binder design as the scaffold sets have enough diversity
    rfd_mask_loops = true

    // Residues that will have their sequence masked when diffusing (default=null). e.g. '[A17-19/A143-145]'
    // Optional for 'monomer_motifscaff' and 'monomer_foldcond' modes
    rfd_inpaint_seq = null
    
    // Total length of diffused chain when performing motif scaffolding (default = null). e.g. '100-100', '100-120'
    // Optional for 'binder_motifscaff' and 'monomer_motifscaff' modes
    rfd_length = null
    
    // Number of timesteps for partial diffusion. e.g. 20
    // Required by 'binder_partialdiff' and 'monomer_partialdiff' modes
    rfd_partial_diffusion_timesteps = null    
    
    //////////////////////////////////
    // WORKFLOW ADVANCED PARAMETERS //
    //////////////////////////////////
    // Diffusion method: 'rfd3' (RFdiffusion3/Foundry, recommended) or 'rfd' (legacy, deprecated)
    diffusion_method = 'rfd3'

    // Sequence design method: 'fampnn' (Full-Atom MPNN, recommended) or 'mpnn' (ProteinMPNN, legacy)
    seq_method = 'fampnn'

    // Structure prediction method. Choose from 'af2' (AlphaFold2), 'boltz' (Boltz-2), or 'rf3' (RosettaFold3/Foundry).
    pred_method = 'af2'

    // Whether to compress output final designs in a tar.gz archive. If false, results will be output as uncompressed PDB files.
    zip_pdbs = true

    // Whether to run RFdiffusion only and skip downstream stages (i.e. sequence design, prediction, and analysis)
    run_rfd_only = false

    // Whether to skip stages (RFdiffusion, sequence design, and/or prediction).
    // Skip RFdiffusion and run Sequence Design, Structure Prediction, and Analysis only. Must provide 'skip_input_dir' directory below containing PDB and JSON files with metadata. Binder design PDBs must have binder as chain A and target as chain B.
    skip_rfd = false

    // Skip RFdiffusion and Sequence Design, and run Structure Prediction and Analysis only. Must provide 'skip_input_dir' directory below containing PDB files. Binder design PDBs must have binder as chain A and target as chain B.
    skip_rfd_seq = false

    // Skip RFdiffusion, Sequence Design, and Structure Prediction, and run Analysis only. Must provide 'skip_input_dir' directory below containing PDB files. Binder design PDBs must have binder as chain A and target as chain B.
    skip_rfd_seq_pred = false
    
    // Skip only Structure Prediction stage (useful for standalone docking)
    skip_pred = false

    // Path to input files when skipping stages e.g. './lib/rfd_previous_results'
    skip_input_dir = null

    /////////////////////////////
    // RFD ADVANCED PARAMETERS //
    /////////////////////////////

    // Override the diffusion model checkpoint used by RFdiffusion.
    // Choose from: 'active_site', 'base', 'base_epoch8', 'complex_base', 'complex_beta', 'complex_fold_base', 'inpaint_seq', 'inpaint_seq_fold'
    // RFdiffusion will automatically select a checkpoint. Not recommended to override except for 'binder_denovo' mode i.e. 'complex_beta'
    rfd_ckpt_override   = null

    // Scale of noise for RFD translations (ca) and rotations (frame)
    // 1 (default) is recommended for monomer modes to increase diversity
    // 0 is recommended for binder modes to increase success rates
    rfd_noise_scale       = null

    // Additional configuration parameters to pass to RFdiffusion that are not externalised in Nextflow. e.g. 'contigmap.inpaint_str=[B165-178]'
    rfd_extra_config       = null
    
    //////////////////////////////
    // MPNN ADVANCED PARAMETERS //
    //////////////////////////////
    // Parameters for ProteinMPNN-FastRelax. Binder design modes only.

    // Residue types to avoid during sequence design (one letter case-insensitive) (default: 'CX').
    mpnn_omitAAs                      = 'CX'
    
    // Temperature for sequence sampling. Higher values increase sequence diversity. Default=0.1
    // For binder design, it is recommended to decrease this significantly e.g. 0.0001 
    mpnn_temperature                  = 0.1

    // Checkpoint type to use for ProteinMPNN. Choose from 'vanilla' or 'soluble' (default = soluble).
    mpnn_checkpoint_type = 'soluble'

    // Checkpoint model to use for ProteinMPNN. Indicates noise level used during training for backbone atoms.
    // Choose from 'v_48_002','v_48_010,'v_48_020','v_48_030'. (default = 'v_48_020', noised with 0.20Å Gaussian noise)
    mpnn_checkpoint_model = 'v_48_020'
    
    // Standard deviation of Gaussian noise to add to backbone atoms.
    // 0 = no change to backbone, 0.1-0.3 = allows mild pertubation of backbone
    mpnn_backbone_noise               = 0
    
    // Maximum number of fast relax cycles to run on each sequence. Set to zero to disable.
    mpnn_relax_max_cycles             = 0
    
    // Number of sequences to generate between relaxation steps. The sequence with the best score will be kept.
    mpnn_relax_seqs_per_cycle         = 1
    
    // Whether to run a relaxation cycle before saving output.
    mpnn_relax_output                 = false
    
    // Convergence criteria 1 of 2. 
    // Design is considered converged if the C-alpha RMSD (Å) between cycles is <= this threshold (default: 0.2)
    mpnn_relax_convergence_rmsd       = 0.2
    
    // Convergence criteria 2 of 2. 
    // Design is considered converged if the improvement in score between cycles is <= this threshold (default: 0.1)
    mpnn_relax_convergence_score      = 0.1
    
    // Design is considered converged if it meets both convergence criteria for n consecutive cycles (default: 1)
    mpnn_relax_convergence_max_cycles = 1

    // Additional configuration parameters to pass to ProteinMPNN-FastRelax that are not externalised in Nextflow. e.g. '-protein_features='full''
    mpnn_extra_config       = null

    ////////////////////////////////
    // FAMPNN ADVANCED PARAMETERS //
    ////////////////////////////////
    // Parameters for Full-Atom MPNN

    // Fix target side-chain positions when performing binder sequence design (default: false)
    fampnn_fix_target_sidechains = false

    // Only keep sidechains below this PSCE threshold during design; null to keep all (default: 0.3)
    fampnn_psce_threshold = 0.3
    
    // Temperature for sequence sampling. Higher values increase sequence diversity (default: 0.1)
    // For binder design, it is recommended to decrease this significantly e.g. 0.0001 
    fampnn_temperature    = 0.1
    
    // Exclude cysteine residues from sequence design (default: true)
    fampnn_exclude_cys    = true

    // Sequence-only mode: skip sidechain diffusion for faster inference (default: false)
    fampnn_seq_only       = false

    // Number of denoising timesteps: higher = better quality but slower (default: 100)
    fampnn_num_steps      = 100

    // Batch size for inference: reduce if encountering OOM errors (default: 16)
    fampnn_batch_size     = 16

    // Repack sidechains after final denoising step (default: true)
    fampnn_repack_last    = true

    // Additional configuration parameters to pass to Full-Atom MPNN for debugging
    // e.g. 'seed=42 scn_diffusion.num_steps=50 scn_diffusion.step_scale=1.0'
    fampnn_extra_config   = null

    //////////////////////////////
    // PRED ADVANCED PARAMETERS //
    //////////////////////////////
    // Parameters for structure prediction using AlphaFold2 Initial-Guess and Boltz-2.

    // Path to uncropped target PDB file to use in structure prediction e.g. './benchmarkdata/5o45_pd-l1_uncropped.pdb'.
    uncropped_target_pdb = null

    // Use an initial-guess of the target chain(s) when performing binder structure prediction. When false, AF2 will not use an initial guess. Default = true
    af2_initial_guess = true

    // Additional configuration parameters to pass to AlphaFold2 Initial-Guess that are not externalised in Nextflow. e.g. '-recycle 3'
    af2_extra_config   = '-debug'
    
    // Boltz settings
    boltz_sampling_steps = 50
    boltz_recycling_steps = 3
    boltz_num_samples = 1
    boltz_use_msa = false            // Default to false (fast, single sequence)
    rf3_use_msa = true               // Default to true (RF3 needs MSA for quality)
    boltz_method = ''                // Default to none (no conditioning)
    boltz_extra_config = ''
    
    // The number of diffusion samples to use for prediction with Boltz-2. (default: 1)
    boltz_diffusion_samples = 1
    
    // The number of sampling steps to use for prediction with Boltz-2. (default: 200)
    boltz_sampling_steps = 200

    // Use physics-based potentials during inference to improve physical plausibility of predictions (also known as Boltz-2x). Increases prediction time.
    boltz_use_potentials = false

    // Additional configuration parameters to pass to Boltz-2 that are not externalised in Nextflow. e.g. '--msa_pairing_strategy complete'
    boltz_extra_config   = null

    //////////////////////////////
    // RFD3 ADVANCED PARAMETERS //
    //////////////////////////////
    // Parameters for RFdiffusion3 (Foundry)
    
    // Number of structure batches per design (default: 1, produces 8 models per batch)
    rfd3_batches_per_design = 1
    
    // Additional RFD3 config overrides (Hydra format)
    rfd3_extra_config = null

    /////////////////////////////
    // RF3 ADVANCED PARAMETERS //
    /////////////////////////////
    // Parameters for RosettaFold3 (Foundry)
    
    // Additional RF3 config overrides
    rf3_extra_config = null

    // RF3 Filtering Parameters
    // Minimum pLDDT score for RF3 predictions
    rf3_min_plddt = null
    
    // Minimum pTM score for RF3 predictions  
    rf3_min_ptm = null
    
    // Maximum PAE for RF3 predictions
    rf3_max_pae = null
    
    // Maximum overall RMSD for RF3 predictions
    rf3_max_rmsd_overall = null
    
    // Maximum binder RMSD for RF3 predictions (binder modes)
    rf3_max_rmsd_binder = null

    /////////////////////////
    // BOLTZGEN PARAMETERS //
    /////////////////////////
    // Parameters for BoltzGen (All-atom binder generation)
    
    // Whether to run BoltzGen as a standalone tool and exit (skips downstream platform steps)
    run_boltzgen_only = false
    
    // Number of designs to generate
    boltzgen_num_designs = 10
    
    // Scaffold length range (e.g. '80-120' or '100')
    boltzgen_scaffold_length = '80-120'
    
    // Ligand SMILES string (if not using NTP template)
    boltzgen_ligand_smiles = null
    
    // NTP template type (e.g. 'dATP', 'GTP') - overrides ligand_smiles if provided
    boltzgen_ntp_type = null
    
    // Binding pocket specification (e.g., 'A:45-52,A:78-85' for residue ranges)
    boltzgen_binding_site_residues = null
    
    // Include catalytic site features (Mg2+ coordination) for enzyme design
    boltzgen_catalytic_site = false
    
    // Existing protein backbone for NTP docking mode
    boltzgen_input_pdb = null
    
    // Ligand structure with 3D coordinates for scaffold_around_ligand mode
    boltzgen_ligand_pdb = null
    
    // Additional configuration overrides
    boltzgen_extra_config = null

    /////////////////////////
    // DIFFDOCK PARAMETERS //
    /////////////////////////
    // Parameters for DiffDock (Protein-Ligand Docking)

    // Whether to run the docking stage (Stage 4)
    run_docking = false
    
    // Number of docking poses to generate per complex
    diffdock_num_poses = 10
    
    // Minimum confidence threshold for filtering poses (0.0 - 1.0)
    diffdock_confidence_threshold = 0.0
    
    // Ligand SMILES for docking (if not provided, will look for 'ligand_description' column in inputs or use NTP type)
    diffdock_ligand_smiles = null
    
    // NTP template type to use as ligand
    diffdock_ntp_type = null
    
    // Additional configuration overrides
    diffdock_extra_config = null
    
    // Number of inference steps (higher = more accurate but slower)
    diffdock_inference_steps = 20

    //////////////////////////
    // FILTERING PARAMETERS //
    //////////////////////////

    // RFdiffusion Filtering Parameters. Applies to binder chain only in binder design modes, otherwise all chains.
    // Max/min number of alpha-helices in design
    rfd_min_helices = null
    rfd_max_helices = null
    
    // Max/min number of beta-strands in design
    rfd_min_strands = null
    rfd_max_strands = null
    
    // Max/min number of secondary structure elements (α-helices + β-strands)
    rfd_min_ss = null
    rfd_max_ss = null
    
    // Max/min radius of gyration (Å) of design
    rfd_min_rog = null
    rfd_max_rog = null

    // ProteinMPNN Filtering Parameters
    // Maximum ProteinMPNN score (negative log likelihood).
    // A lower score means ProteinMPNN is more confident in the sequence.
    mpnn_max_score = null

    // Full-Atom MPNN Filtering Parameters
    // Max average predicted side-chain error (PSCE) for designed side-chains.
    // Applies to binder chain only in binder design modes, otherwise averages all chains.
    // A lower score means FAMPNN is more confident in the sequence.
    fampnn_max_psce = null

    // AlphaFold2 Initial-Guess Filtering Parameters.
    // Max predicted aligned error for interactions between binder and target
    af2_max_pae_interaction = null

    // Max predicted aligned error for all chains
    af2_max_pae_overall = null

    // Max predicted aligned error for binder
    af2_max_pae_binder      = null

    // Max predicted aligned error for target
    af2_max_pae_target      = null

    // Min average pLDDT score for target and binder chains
    af2_min_plddt_overall     = null

    // Min pLDDT score required for binder
    af2_min_plddt_binder    = null

    // Min pLDDT score required for target
    af2_min_plddt_target    = null
    
    // Max C-alpha RMSD between AF2 prediction and input design when all chains are aligned
    af2_max_rmsd_overall     = null

    // Max binder C-alpha RMSD between AF2 prediction and input design when binder chains are aligned
    af2_max_rmsd_binder_bndaln     = null

    // Max binder C-alpha RMSD between AF2 prediction and input design when target chains are aligned
    af2_max_rmsd_binder_tgtaln     = null

    // Max target C-alpha RMSD between AF2 prediction and input design when target chains are aligned
    af2_max_rmsd_target     = null

    // Boltz-2 Filtering Parameters.

    // Max C-alpha RMSD between all chains of Boltz-2 prediction and input design.
    boltz_max_overall_rmsd = null

    // Max C-alpha RMSD between binder chains of Boltz-2 prediction and input design. Binder modes only. 
    boltz_max_binder_rmsd = null

    // Max C-alpha RMSD between target chains of Boltz-2 prediction and input design. Binder modes only. 
    boltz_max_target_rmsd = null

    // Minimum confidence score
    boltz_min_conf_score = null

    // Minimum predicted TM-score
    boltz_min_ptm              = null

    // Minimum predicted TM-score of interface
    boltz_min_ptm_interface             = null

    // Minimum pLDDT score of the complex
    boltz_min_plddt    = null

    // Minimum pLDDT score of the complex interface
    boltz_min_plddt_interface   = null

    // Maximum predicted distance error for the complex
    boltz_max_pde      = null

    // Maximum predicted distance error for the complex interface
    boltz_max_pde_interface     = null

    ///////////////////////////
    // CLUSTER CONFIGURATION //
    ///////////////////////////
    
    // Path to the pipeline containers directory or cloud URL to fetch from
    container_dir    = 'https://object-store.rc.nectar.org.au/v1/AUTH_b6f9bdf15faf4320a7587fd42f62e530/ContainerHub'
    
    // Path to the RFdiffusion model checkpoints
    rfd_models       = "${projectDir}/models/rfd"
    
    // Path to the AlphaFold2 models
    af2_models    = "${projectDir}/models/af2"

    // Path to the Boltz-2 models
    boltz_models   = "${projectDir}/models/boltz"
    
    // GPU model requested (e.g. 'A30')
    gpu_model        = 'A30'

    // GPU queue name or partition (if applicable, e.g. 'gpuq')
    gpu_queue = null
    
    // Number of GPUs to request
    gpus         = 4
    
    // Number of CPUs to request per GPU
    cpus_per_gpu = 8

    // Number of CPUs to request for CPU-only jobs
    cpus           = 24
    
    // Memory requested for GPU jobs
    memory_gpu     = '24GB'
    
    // Memory requested for CPU-only jobs
    memory_cpu     = '24GB'

    ////////////////////////////////
    // INTERNAL SYSTEM PARAMETERS //
    ////////////////////////////////
    // WARNING: These parameters are used internally by the pipeline system.
    // Users should NOT modify these parameters as they will interfere with functionality
    bindsweeper_param_combo = null

}
profiles {
    test { // base configuration for testing
        params {
            rfd_num_designs = 4
            seqs_per_design = 2
        }
    }
    af2_predict {
        params {
            pred_method = 'af2'
            skip_rfd_seq = true
        }
    }
    rf3 {
        params {
            pred_method = 'rf3'
            skip_rfd_seq = true
        }
    }
    boltz {
        params {
            pred_method = 'boltz'
            skip_rfd_seq = true
        }
    }
    both {
        // Run both Boltz-2 and RF3 predictors for sequence-based structure prediction
        params {
            pred_method = 'both'
        }
    }
    boltzgen {
        // BoltzGen ligand-aware binder design
        params {
            diffusion_method = 'boltzgen'
            run_boltzgen_only = false
            run_docking = true
            seq_method = 'fampnn'
            pred_method = 'boltz'
        }
    }
    fampnn_predict {
        // Skip diffusion, just do sequence design + prediction (for existing backbones)
        params {
            skip_rfd = true
            seq_method = 'fampnn'
            pred_method = 'boltz'
        }
    }
    docking {
        // Standalone DiffDock docking (no design pipeline)
        params {
            skip_rfd = true
            skip_rfd_seq = true
            skip_pred = true
            run_docking = true
        }
    }
    monomer_denovo {
        params {
            rfd_mode = 'monomer_denovo'
            rfd_contigs = '[80-80]'
            seq_method = 'fampnn'
            pred_method = 'boltz'
        }
    }
    monomer_foldcond {
        params {
            rfd_mode = 'monomer_foldcond'
            rfd_scaffold_dir = './binderscaffolds/scaffolds_assorted'
            seq_method = 'fampnn'
        }
    }
    monomer_motifscaff {
        params {
            rfd_mode = 'monomer_motifscaff'
            rfd_input_pdb = './benchmarkdata/5o45_pd-l1.pdb'
            rfd_contigs = '[A17-43/9-15/A53-117/3-6/A121-131]'
            rfd_inpaint_seq = '[A17-19/A129-131]'
        }
    }
    monomer_partialdiff {
        params {
            rfd_mode = 'monomer_partialdiff'
            rfd_input_pdb = './benchmarkdata/5o45_pd-l1.pdb'
            rfd_contigs = '[A17-111/20]'
            rfd_partial_diffusion_timesteps = 20
            mpnn_relax_max_cycles = 1
            pred_method = 'boltz'
        }
    }
    binder_denovo {
        params {
            rfd_mode = 'binder_denovo'
            rfd_input_pdb = './benchmarkdata/5o45_pd-l1.pdb'
            rfd_contigs = '[A17-131/0 60-100]'
        }
    }
    binder_foldcond {
        params {
            rfd_mode = 'binder_foldcond'
            rfd_input_pdb = './benchmarkdata/5o45_pd-l1.pdb'
            rfd_scaffold_dir = './binderscaffolds/scaffolds_assorted'
            rfd_target_ss = './benchmarkdata/5o45_pd-l1_ss.pt'
            rfd_target_adj = './benchmarkdata/5o45_pd-l1_adj.pt'
            rfd_mask_loops = false
        }
    }
    binder_motifscaff {
        params {
            rfd_mode = 'binder_motifscaff'
            rfd_input_pdb = "./lib/examplebinder.pdb"
            rfd_contigs = "[5-10/A1-88/10-20/0 B89-203]"
            rfd_ckpt_override = 'complex_base'
            rfd_length = '110-110'
        }
    }
    binder_partialdiff {
        params {
            rfd_mode = 'binder_partialdiff'
            rfd_input_pdb = "./lib/examplebinder.pdb"
            rfd_contigs = "[88-88/0 B89-203]"
            rfd_partial_diffusion_timesteps = 20
        }
    }
    apptainer {
        conda.enabled          = false
        apptainer.enabled      = true
        apptainer.autoMount    = true
        singularity.enabled    = false
        docker.enabled         = false
        params.container_dir   = "https://object-store.rc.nectar.org.au/v1/AUTH_b6f9bdf15faf4320a7587fd42f62e530/ContainerHub"
    }
    singularity {
        conda.enabled          = false
        apptainer.enabled      = false
        apptainer.autoMount    = false
        singularity.enabled    = true
        singularity.autoMount  = true
        docker.enabled         = false
        params.container_dir   = "https://object-store.rc.nectar.org.au/v1/AUTH_b6f9bdf15faf4320a7587fd42f62e530/ContainerHub"
    }
    // Profile for WEHI HPC environment
    milton {
        conda.enabled          = false
        apptainer.enabled      = true
        apptainer.autoMount    = true
        singularity.enabled    = false
        docker.enabled         = false
        params.rfd_models       = '/vast/projects/alphafold/databases/predictedDb/RFDiffusion/models'
        params.af2_models    = '/vast/projects/alphafold/databases/params_2022-12-06'
        params.boltz_models   = '/vast/projects/alphafold/databases/predictedDb/containers/proteinDJ/boltzmodels'
        params.container_dir    = '/vast/projects/alphafold/databases/predictedDb/containers/proteinDJ/18_08'
        params.gpu_queue = 'gpuq'
    }

    // Profile for Ryzen 7960x workstation with 3x GPUs (2x RTX 3090, 1x RTX 5090)
    workstation_ryzen7960x {
        conda.enabled          = false
        apptainer.enabled      = true
        apptainer.autoMount    = true
        apptainer.pullTimeout  = '60 min'
        apptainer.cacheDir     = "${HOME}/.apptainer/cache"
        singularity.enabled    = false
        docker.enabled         = false

        // Local executor (not SLURM)
        executor.name = 'local'
        executor.queueSize = 100

        params {
            // Local model paths (download once, use forever)
            rfd_models      = "${projectDir}/models/rfd"
            af2_models      = "${projectDir}/models/af2"
            boltz_models    = "${projectDir}/models/boltz"

            // Local container directory (build containers locally, no slow downloads)
            container_dir   = "${projectDir}/containers"

            // GPU configuration - 4 GPUs (0=5090, 1=5060Ti, 2=3090, 3=3090)
            gpus            = 4

            // CPU allocation per GPU task (48 threads / 4 = 12 max, memory will limit to 10)
            cpus_per_gpu    = 4

            // Memory per GPU task (125GB / 12GB = ~10 concurrent tasks)
            memory_gpu      = '12GB'

            // CPU-only tasks (filtering, analysis)
            cpus            = 4
            memory_cpu      = '8GB'

            // No SLURM-specific settings
            gpu_model       = null
            gpu_queue       = null
        }

        process {
            // Default resources for CPU tasks
            cpus   = params.cpus
            memory = params.memory_cpu

            // GPU tasks: allow up to 25 parallel - VRAM-aware allocation handles packing
            withLabel: 'gpu' {
                maxForks = 25
                cpus     = params.cpus_per_gpu
                memory   = params.memory_gpu
                
                // Retry on OOM - will re-run selectGpuByVram with fresh VRAM check
                errorStrategy = { task.exitStatus in [1, 137, 139] ? 'retry' : 'finish' }
                maxRetries = 10

                // Priority-based GPU selection:
                // 1. RTX 5090 (GPU 0) - PRIMARY
                // 2. RTX 3090s (GPUs 2,3) - OVERFLOW, pick one with more free VRAM
                // 3. RTX 5060 Ti (GPU 1) - EXCLUDED for heavy tasks
                containerOptions = {
                    def baseOpts = task.ext.containerOptions ?: ""
                    
                    // Query GPU memory status
                    def nvidiaSmi = "nvidia-smi --query-gpu=index,memory.free --format=csv,noheader,nounits".execute()
                    nvidiaSmi.waitFor()
                    def gpuInfo = nvidiaSmi.text.trim().split('\n').collect { line ->
                        def parts = line.split(',').collect { it.trim() }
                        [index: parts[0], free: parts[1] as int]
                    }
                    
                    // Priority selection: 5090 first if available (>8GB free)
                    def gpu0 = gpuInfo.find { it.index == '0' }
                    if (gpu0 && gpu0.free > 8000) {
                        return "--nv --env CUDA_DEVICE_ORDER=PCI_BUS_ID --env CUDA_VISIBLE_DEVICES=0 ${baseOpts}"
                    }
                    
                    // Overflow: pick 3090 with more free memory
                    def gpu2 = gpuInfo.find { it.index == '2' }
                    def gpu3 = gpuInfo.find { it.index == '3' }
                    def overflow3090s = [gpu2, gpu3].findAll { it != null && it.free > 8000 }
                    if (overflow3090s) {
                        def bestGpu = overflow3090s.max { it.free }
                        return "--nv --env CUDA_DEVICE_ORDER=PCI_BUS_ID --env CUDA_VISIBLE_DEVICES=${bestGpu.index} ${baseOpts}"
                    }
                    
                    // Fallback: use GPU with most free memory from primary pool
                    def primaryPool = gpuInfo.findAll { ['0', '2', '3'].contains(it.index) }
                    def fallback = primaryPool.max { it.free }?.index ?: '0'
                    return "--nv --env CUDA_DEVICE_ORDER=PCI_BUS_ID --env CUDA_VISIBLE_DEVICES=${fallback} ${baseOpts}"
                }
            }
            
            // Light GPU tasks: prefer 5060 Ti, fallback to any available
            withLabel: 'gpu_light' {
                maxForks = 4
                cpus     = params.cpus_per_gpu
                memory   = '16GB'
                
                containerOptions = {
                    def baseOpts = task.ext.containerOptions ?: ""
                    
                    def nvidiaSmi = "nvidia-smi --query-gpu=index,memory.free --format=csv,noheader,nounits".execute()
                    nvidiaSmi.waitFor()
                    def gpuInfo = nvidiaSmi.text.trim().split('\n').collect { line ->
                        def parts = line.split(',').collect { it.trim() }
                        [index: parts[0], free: parts[1] as int]
                    }
                    
                    // Prefer 5060 Ti (GPU 1) for light tasks if available
                    def gpu1 = gpuInfo.find { it.index == '1' }
                    if (gpu1 && gpu1.free > 4000) {
                        return "--nv --env CUDA_DEVICE_ORDER=PCI_BUS_ID --env CUDA_VISIBLE_DEVICES=1 ${baseOpts}"
                    }
                    
                    // Fallback to any GPU with most free memory
                    def best = gpuInfo.max { it.free }?.index ?: '0'
                    return "--nv --env CUDA_DEVICE_ORDER=PCI_BUS_ID --env CUDA_VISIBLE_DEVICES=${best} ${baseOpts}"
                }
            }
        }
    }

    debug {
            cleanup = false
    }
}




process {
        // default is to use resource request for cpu-only jobs
        cpus             = "${params.cpus}"
        memory           = "${params.memory_cpu}" 
        withLabel: 'gpu'{
            clusterOptions    = '--gres=gpu:' + "${params.gpu_model}" + ':1'
            cpus              = "${params.cpus_per_gpu}"
            memory            = "${params.memory_gpu}"
            queue             = params.gpu_queue ? "${params.gpu_queue}" : null
        }
        withLabel: 'AF2' {
            container         = "${params.container_dir}/af2.sif"
            containerOptions  = {
                def seqLen = task.ext?.seqLength ?: params.sequence_input?.length() ?: 1000
                def gpu = selectGpuByVram('af2', seqLen, false)  // AF2 heavy - no 5060Ti
                """ --nv --env CUDA_DEVICE_ORDER=PCI_BUS_ID --env CUDA_VISIBLE_DEVICES=${gpu} \\
                --env "XLA_PYTHON_CLIENT_PREALLOCATE=false" \\
                --bind "${params.af2_models}:/dl_binder_design/af2_initial_guess/model_weights/params" \\
                --bind "${projectDir}/scripts:/scripts" \\
                --bind "${projectDir}" """
            }
        }
        withLabel: 'Boltz' {
            container         = "${params.container_dir}/boltzgen.sif"  // BoltzGen includes Boltz-2 with proper deps       
            containerOptions  = {
                def seqLen = task.ext?.seqLength ?: params.sequence_input?.length() ?: 1000
                def gpu = selectGpuByVram('boltz', seqLen, true)
                """--nv --env CUDA_DEVICE_ORDER=PCI_BUS_ID --env CUDA_VISIBLE_DEVICES=${gpu} \\
                --bind ${params.boltz_models}:/boltzcache \\
                --bind ${projectDir}/scripts:/scripts \\
                --bind ${projectDir} \\
                """
            }
        }
        withLabel: 'FAMPNN' {
            container         = "${params.container_dir}/fampnn.sif"
            containerOptions  = {
                def seqLen = task.ext?.seqLength ?: params.sequence_input?.length() ?: 1000
                def gpu = selectGpuByVram('fampnn', seqLen, true)  // Allow 5060Ti
                """--nv --env CUDA_DEVICE_ORDER=PCI_BUS_ID --env CUDA_VISIBLE_DEVICES=${gpu} \\
                --bind ${projectDir}/scripts:/scripts \\
                --bind ${projectDir} \\
                """
            }
        }
        withLabel: 'MPNN' {
            container        = "${params.container_dir}/dl_binder_design.sif"
            containerOptions = {
                def seqLen = task.ext?.seqLength ?: params.sequence_input?.length() ?: 1000
                def gpu = selectGpuByVram('mpnn', seqLen, true)  // Allow 5060Ti - very light
                """--nv --env CUDA_DEVICE_ORDER=PCI_BUS_ID --env CUDA_VISIBLE_DEVICES=${gpu} \\
                --bind ${projectDir}/scripts:/scripts \\
                --bind ${projectDir} """
            }
        }
        withLabel: 'RFDiffusion' {
            container         = "${params.container_dir}/rfdiffusion.sif"
            containerOptions = {
                def seqLen = task.ext?.seqLength ?: params.contig_length?.replaceAll('[^0-9]', '')?.toInteger() ?: 1000
                def gpu = selectGpuByVram('rfdiffusion', seqLen, false)  // Heavy model - no 5060Ti
                """--nv --env CUDA_DEVICE_ORDER=PCI_BUS_ID --env CUDA_VISIBLE_DEVICES=${gpu} \\
                --writable-tmpfs \\
                --bind ${params.rfd_models}:/app/RFdiffusion/models \\
                --bind ./schedules:/app/RFdiffusion/schedules \\
                --bind ./.dgl:\$HOME/.dgl \\
                --bind ${projectDir}/scripts:/scripts \\
                --bind ${projectDir} \\
                """
            }
        }
        withLabel: 'pyrosetta_tools' { 
            container = "${params.container_dir}/pyrosetta_tools.sif"
            containerOptions = "--env PATH=/opt/conda/envs/pyrosetta/bin:\$PATH --bind ${projectDir} --bind ${projectDir}/scripts:/scripts"
        }
        withLabel: 'Foundry' {
            container = "${params.container_dir}/foundry.sif"
            containerOptions = {
                def seqLen = task.ext?.seqLength ?: params.sequence_input?.length() ?: 1000
                def gpu = selectGpuByVram('rf3', seqLen, true)  // Allow 5060Ti for overflow
                """--nv --env CUDA_DEVICE_ORDER=PCI_BUS_ID --env CUDA_VISIBLE_DEVICES=${gpu} \\
                --writable-tmpfs \\
                --env XDG_CACHE_HOME=/tmp --env TRITON_CACHE_DIR=/tmp/triton \\
                --env HF_HOME=/cache/huggingface \\
                --bind /home/dalab/.cache/huggingface:/cache/huggingface \\
                --bind ${projectDir}/scripts:/scripts \\
                --bind ${projectDir}"""
            }
        }
        withLabel: 'BoltzGen' {
            container = "${params.container_dir}/boltzgen.sif"
            containerOptions = {
                def seqLen = task.ext?.seqLength ?: params.sequence_input?.length() ?: 1000
                def gpu = selectGpuByVram('boltzgen', seqLen, true)  // Allow 5060Ti for overflow
                """--nv --env CUDA_DEVICE_ORDER=PCI_BUS_ID --env CUDA_VISIBLE_DEVICES=${gpu} \\
                --env HF_HOME=/cache/huggingface --env XDG_CACHE_HOME=/cache/general --env MPLCONFIGDIR=/cache/matplotlib \\
                --env TRITON_CACHE_DIR=/cache/triton \\
                --bind /home/dalab/.cache/huggingface:/cache/huggingface \\
                --bind /home/dalab/.cache/triton:/cache/triton \\
                --bind /home/dalab/.cache:/cache/general \\
                --bind /home/dalab/.cache/matplotlib:/cache/matplotlib \\
                --bind ${projectDir}/scripts:/scripts \\
                --bind ${projectDir}"""
            }
        }
        withLabel: 'DiffDock' {
            container = "${params.container_dir}/diffdock.sif"
            containerOptions = {
                def seqLen = task.ext?.seqLength ?: params.sequence_input?.length() ?: 1000
                def gpu = selectGpuByVram('diffdock', seqLen, true)  // Allow 5060Ti - lighter model
                """--nv --env CUDA_DEVICE_ORDER=PCI_BUS_ID --env CUDA_VISIBLE_DEVICES=${gpu} \\
                --env HF_HOME=/cache/huggingface --env TORCH_HOME=/cache/torch --env XDG_CACHE_HOME=/cache/general \\
                --bind /home/dalab/.cache/huggingface:/cache/huggingface \\
                --bind /home/dalab/.cache:/cache/general \\
                --bind /home/dalab/.cache/torch:/cache/torch \\
                --bind /home/dalab/.cache/diffdock:/cache/diffdock \\
                --pwd /cache/diffdock \\
                --bind ${projectDir}/scripts:/scripts \\
                --bind ${projectDir}"""
            }
        }
}
