+                names = self.array.res_name.astype(np.result_type(self.array.res_name.dtype, np.array([label]).dtype))
+                names[moving] = label
+                self.array.set_annotation("res_name", names)
+            if anchor is not None:
+                moving_set = set(moving)
+                rest = [index for index in range(len(self.array)) if index not in moving_set]
+                boundary = anchor["atom_indices"][0 if before else -1]
+                offset = rest.index(boundary) + (0 if before else 1)
+                # A moved segment belongs to its explicit target chain, never an inferred duplex.
+                for key in ("chain_id", "chain_iid", "chain_type"):
+                    if key in self.array.get_annotation_categories():
+                        self.array.get_annotation(key)[moving] = self.array.get_annotation(key)[boundary]
+                self.array = self.array[np.array(rest[:offset] + moving + rest[offset:], dtype=int)]
+                # Structural label residue numbering must follow the explicit new order.
