index 0000000..c5b0b4b
--- /dev/null
+++ b/tests/test_bms_s03.py
@@ -0,0 +1,214 @@
+"""Reviewed S03 regressions against real upstream document/store implementations."""
+from concurrent.futures import ThreadPoolExecutor
+from pathlib import Path
+from threading import Event
+import os
+import time
+import numpy as np
+import pytest
+from annotation_studio import main
+from annotation_studio.main import DocumentStore
+from atomworks_studio_editing.document import StudioDocument
+from atomworks_studio_rfd4 import CONDITION_PROVIDER
+from atomworks_studio_rfd4.model import C_CRD
+from fastapi.testclient import TestClient
+
+FIXTURE = Path(__file__).parent / 'fixtures' / 'inverse_folding_2kl8.cif'
+
+def document():
+    return StudioDocument.from_cif(FIXTURE.read_text(), condition_provider=CONDITION_PROVIDER)
+
+
+def test_backbone_exact_atoms_one_undo():
+    doc = document()
+    indices = list(range(len(doc.array)))
+    before = doc.array.copy()
+    doc.set_chain_role(indices, 'backbone', expected_revision=0, allow_target_discard=True)
+    expected = np.isin(doc.array.atom_name, ['N', 'CA', 'C', 'O'])
+    np.testing.assert_array_equal(C_CRD.mask(doc.array), expected)
+    assert doc.revision == 1
+    assert doc.undo()
+    np.testing.assert_array_equal(C_CRD.mask(doc.array), C_CRD.mask(before))
+
+
+@pytest.mark.parametrize('persistent', [False, True])
+def test_pruning_does_not_evict_active_mutation(tmp_path, monkeypatch, persistent):
+    documents = DocumentStore(tmp_path if persistent else None)
+    sid = documents.add(document())
+    started, finish = Event(), Event()
+    def change(doc):
+        started.set()
+        assert finish.wait(10)
+        doc.set_charge([0], value=3)
+    with ThreadPoolExecutor() as pool:
+        pending = pool.submit(documents.call, sid, change, persist=True)
+        assert started.wait(10)
+        with documents._lock:
+            _, owner, doc = documents._documents[sid]
+            documents._documents[sid] = (time.monotonic() - main.SESSION_TTL_SECONDS - 5, owner, doc)
+            if persistent:
+                old = time.time() - main.SESSION_TTL_SECONDS - 5
+                os.utime(documents._session_file(sid), (old, old))
+            documents._prune(reserve_slot=True)
+            survived = sid in documents._documents
+        finish.set()
+        pending.result(timeout=10)
+    assert survived
+    assert documents.call(sid, lambda doc: int(doc.array.charge[0])) == 3
+
+
+def test_persistence_failure_is_visible_recoverable_and_not_evicted(tmp_path, monkeypatch):
+    documents = DocumentStore(tmp_path)
+    monkeypatch.setattr(main, 'store', documents)
+    sid = documents.add(document())
+    original = documents._persist
+    def fail(*args):
+        raise OSError('disk unavailable')
+    monkeypatch.setattr(documents, '_persist', fail)
+    client = TestClient(main.app)
+    response = client.post(f'/api/sessions/{sid}/charges', json={'atom_indices':[0], 'value':3})
+    assert response.status_code == 200, response.text
+    state = response.json()['persistence']
+    assert state['state'] == 'memory_only'
+    assert state['revision'] == 1
+    assert documents.call(sid, lambda doc: int(doc.array.charge[0])) == 3
+    undone = client.post(f'/api/sessions/{sid}/undo')
+    assert undone.status_code == 200, undone.text
+    assert undone.json()['persistence']['state'] == 'memory_only'
+    assert undone.json()['persistence']['revision'] == 2
+    assert client.post(f'/api/sessions/{sid}/charges', json={'atom_indices':[0], 'value':3}).status_code == 200
+    with documents._lock:
+        _, owner, doc = documents._documents[sid]
+        documents._documents[sid] = (0, owner, doc)
+        documents._prune(reserve_slot=True)
+        assert sid in documents._documents
+    monkeypatch.setattr(documents, '_persist', original)
+    retry = client.post(f'/api/sessions/{sid}/persistence/retry')
+    assert retry.status_code == 200, retry.text
+    assert retry.json()['persistence']['state'] == 'saved'
+    cold = DocumentStore(tmp_path)
+    assert cold.call(sid, lambda doc: int(doc.array.charge[0])) == 3
+    assert cold.call(sid, lambda doc: doc.revision) == 0  # restart does not promise history
+
+
+@pytest.mark.usefixtures('stable_cif_metadata')
+def test_segment_length_anchor_order_export_and_undo():
+    doc = document()
+    doc.insert_segment(3, 5, 0, before=True)
+    segment = next(i for c in doc.sequence_view() for i in c['items'] if i['kind'] == 'segment')
+    start = segment['atom_indices'][0]
+    anchor = next(i['atom_indices'][0] for c in doc.sequence_view() for i in c['items'] if i['kind'] == 'residue')
+    before = doc.to_cif()
+    doc.edit_segment(start, 7, 11, anchor_index=anchor, before=False, expected_revision=1)
+    items = doc.sequence_view()[0]['items']
+    assert items[0]['kind'] == 'residue'
+    assert items[1]['kind'] == 'segment'
+    assert (items[1]['minimum'], items[1]['maximum']) == (7, 11)
+    cold = StudioDocument.from_cif(doc.to_cif(), condition_provider=CONDITION_PROVIDER)
+    assert [(i['kind'], i.get('minimum'), i.get('maximum')) for i in cold.sequence_view()[0]['items']] == [(i['kind'], i.get('minimum'), i.get('maximum')) for i in items]
+    assert doc.undo()
+    assert doc.to_cif() == before
+    doc.edit_segment(start, 12345, 23456, expected_revision=doc.revision)
+    assert doc.array.res_name[start] == "12345-23456"
+    cold = StudioDocument.from_cif(doc.to_cif(), condition_provider=CONDITION_PROVIDER)
+    assert cold.sequence_view()[0]['items'][0]['minimum'] == 12345
+
+
+def test_segment_conflict_and_bad_anchor_are_atomic():
+    doc = document()
+    doc.insert_segment(3, 5, 0)
+    start = doc.sequence_view()[0]['items'][0]['atom_indices'][0]
+    before = doc.export_state()
+    with pytest.raises(ValueError):
+        doc.edit_segment(start, 9, 2, expected_revision=doc.revision)
+    assert doc.export_state() == before
+    from atomworks_studio_editing.contracts import DocumentRevisionConflictError
+    with pytest.raises(DocumentRevisionConflictError):
+        doc.edit_segment(start, 2, 9, expected_revision=0)
+    assert doc.export_state() == before
+
+
+
+def test_reviewed_backbone_shortcut_reproduction_on_native_document():
+    """The released UI's exact residue-wide recipe retains sidechains, not just BB."""
+    doc = document()
+    indices = list(range(len(doc.array)))
+    doc.set_conditions([
+        {'condition':'coordinate', 'atom_indices':indices, 'scope':'residue', 'enabled':True},
+        {'condition':'sequence', 'atom_indices':indices, 'scope':'residue', 'enabled':False},
+    ], allow_target_discard=True)
+    sidechain = ~np.isin(doc.array.atom_name, ['N','CA','C','O'])
+    assert sidechain.any()
+    assert C_CRD.mask(doc.array)[sidechain].any()  # defect reproduction, not acceptance
+
+
+def test_chain_role_http_preserves_unrelated_internal_targets_and_confirmation(monkeypatch):
+    from atomworks_studio_rfd4.model import C_INTCRD
+    doc = document()
+    # Valid internal group outside the selected first residue.
+    doc.set_condition("coordinate_group", [len(doc.array)-2,len(doc.array)-1], value=7)
+    targets = C_INTCRD.default_annotation(doc.array)
+    targets[-2:] = [[1.,2.,3.],[2.,3.,4.]]
+    C_INTCRD.set_annotation(doc.array, targets)
+    documents = DocumentStore()
+    monkeypatch.setattr(main, 'store', documents)
+    sid = documents.add(doc)
+    client = TestClient(main.app)
+    selected = doc.sequence_view()[0]['items'][0]['atom_indices']
+    response = client.post(f'/api/sessions/{sid}/chain-role', json={
+        'atom_indices':selected, 'role':'backbone', 'expected_revision':doc.revision,
+    })
+    assert response.status_code == 200, response.text
+    np.testing.assert_equal(C_INTCRD.annotation(doc.array)[-2:], [[1.,2.,3.],[2.,3.,4.]])
+    original = doc.export_state()
+    response = client.post(f'/api/sessions/{sid}/chain-role', json={
+        'atom_indices':[len(doc.array)-1], 'role':'fixed', 'expected_revision':doc.revision,
+    })
+    assert response.status_code == 409, response.text
+    assert response.json()['detail']['code'] == 'target_discard_confirmation_required'
+    assert doc.export_state() == original
+
+
+def test_segment_reorder_remaps_pair_annotations_and_preserves_targets():
+    from atomworks_studio_rfd4.model import C_INTCRD
+    doc = document()
+    doc.insert_segment(3,5,0)
+    from atomworks_studio_editing.conditions import CONDITION_PROVIDER as PUBLIC_PROVIDER
+    doc.condition_provider = PUBLIC_PROVIDER
+    doc.edit_distance_restraint(1,2,'set',4.25)
+    targets = C_INTCRD.default_annotation(doc.array)
+    targets[1] = [1.,2.,3.]
+    C_INTCRD.set_annotation(doc.array, targets)
+    # Stable author/atom identities allow observing the same target after permutation.
+    atom_name = str(doc.array.atom_name[1])
+    author_id = str(doc.array.auth_seq_id[1])
+    doc.edit_segment(0,4,8,anchor_index=2,before=False,expected_revision=doc.revision)
+    np.testing.assert_equal(C_INTCRD.annotation(doc.array)[0], [1.,2.,3.])
+    assert str(doc.array.atom_name[0]) == atom_name
+    assert str(doc.array.auth_seq_id[0]) == author_id
+    assert doc.distance_restraints()[0]['atom1'] == 0
+    assert doc.distance_restraints()[0]['atom2'] == 1
+    assert doc.distance_restraints()[0]['distance'] == 4.25
+
+
+def test_all_pinned_capacity_defers_eviction_without_new_refusal(tmp_path, monkeypatch):
+    monkeypatch.setattr(main, "MAX_SESSIONS", 1)
+    documents = DocumentStore(tmp_path)
+    sid = documents.add(document())
+    started, finish = Event(), Event()
+    def hold(doc):
+        started.set()
+        assert finish.wait(10)
+    with ThreadPoolExecutor() as pool:
+        pending = pool.submit(documents.call, sid, hold)
+        assert started.wait(10)
+        try:
+            second = documents.add(document())
+            assert sid in documents._documents
+            assert second in documents._documents
+        finally:
+            finish.set()
+        pending.result(timeout=10)
+    with documents._lock:
+        documents._prune()
+    assert len(documents._documents) == 1
