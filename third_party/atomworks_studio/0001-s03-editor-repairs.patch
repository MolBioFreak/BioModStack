+        Indices belong to the expected document revision. Slicing AtomArrayPlus
+        remaps bonds and 2-D pair annotations; no delete/reinsert loses annotations.
+        A realized run retains its existing realization until explicitly collapsed.
+        """
+        if expected_revision is not None and expected_revision != self.revision:
+            raise DocumentRevisionConflictError(expected_revision, self.revision)
+        if minimum < 1 or maximum < minimum:
+            raise ValueError("segment bounds require 1 <= minimum <= maximum")
+        self.resolve_indices([atom_index])
+        segment = next((item for chain in self.sequence_view() for item in chain["items"]
+                        if item["kind"] == "segment" and atom_index in item["atom_indices"]), None)
+        if segment is None:
+            raise ValueError("selected atom is not an expandable segment")
+        moving = segment["atom_indices"]
+        anchor = None
+        if anchor_index is not None:
+            self.resolve_indices([anchor_index])
+            anchor = next(item for chain in self.sequence_view() for item in chain["items"]
+                          if anchor_index in item["atom_indices"])
+            if anchor_index in moving:
+                raise ValueError("segment cannot be anchored to itself")
+        with self.edit():
+            S_SEGMIN.annotation(self.array)[moving] = minimum
+            S_SEGMAX.annotation(self.array)[moving] = maximum
+            if not segment["realized"]:
