+                bounds = struc.get_residue_starts(self.array, add_exclusive_stop=True)
+                counters: dict[str, int] = {}
+                for start, stop in zip(bounds[:-1], bounds[1:]):
+                    chain = str(self.array.chain_id[start])
+                    counters[chain] = counters.get(chain, 0) + 1
+                    self.array.res_id[start:stop] = counters[chain]
+                refresh_chain_derived_annotations(self.array)
