+    def edit_segment(
+        self, atom_index: int, minimum: int, maximum: int, *,
+        anchor_index: int | None = None, before: bool = True,
+        expected_revision: int | None = None,
+    ) -> None:
+        """Edit bounds and optionally move a complete segment beside a document item.
