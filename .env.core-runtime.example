# Copy to .env.core-runtime.local or export these before running the core runtime.
# Host path for persistent BioModStack state. Defaults to /mnt/BioModStack when present,
# otherwise ~/.biomodstack via scripts/run_biomodstack_core_runtime.sh.
BMS_STATE_DIR=/mnt/BioModStack

# Default container-side mount path for persisted state.
# If Nextflow path coupling still expects /mnt/BioModStack, set this to /mnt/BioModStack.
BMS_CONTAINER_STATE_PATH=/var/lib/biomodstack

# Optional explicit overrides inside the API container.
BMS_INPUTS_CONTAINER_PATH=/var/lib/biomodstack/inputs
BMS_DB_CONTAINER_PATH=/var/lib/biomodstack/biomodstack.db

# Container-side workflow work root. Host-native workflow launches use the
# generated install profile path, e.g. /mnt/BioModStack/work on this machine.
BMS_WORK=/var/lib/biomodstack/work

# Stable hosted web UI port. Vite dev owns 5173; production /bms/ stays here.
BMS_WEB_HOST_PORT=18080

# Frontend/API cross-origin defaults for localhost and Cordova shells.
# Add any remote wrapper origin explicitly via CORS_ORIGINS when needed.
CORS_ORIGINS=http://127.0.0.1,http://127.0.0.1:5173,http://127.0.0.1:18080,http://localhost,https://localhost,http://localhost:5173,http://localhost:18080,https://localhost:5173,https://127.0.0.1

# Enable the honest first-wave guard: containerized core runtime should not own workflow launches yet.
BMS_CORE_RUNTIME_MODE=1

# Host-networked core-runtime containers reach the host-native workflow adapter on localhost:8001.
BMS_WORKFLOW_ADAPTER_URL=http://127.0.0.1:8001

# Separate assay/chromatography/qPCR/DOE analytical store. This is intentionally
# distinct from the protein/workflow SQLite database configured by BMS_DB_PATH.
# The core-runtime compose file starts a local PostgreSQL service on 127.0.0.1:55432.
BMS_ANALYTICAL_DB_PORT=55432
BMS_ANALYTICAL_DB_PASSWORD=bms_assay_dev
BMS_ANALYTICAL_DATABASE_URL=postgresql+asyncpg://bms_assay:${BMS_ANALYTICAL_DB_PASSWORD}@127.0.0.1:${BMS_ANALYTICAL_DB_PORT}/bms_analytical_data
BMS_ANALYTICAL_INIT_ON_STARTUP=1

# Optional robot-local BioXP linkage. This also drives the recommended cockpit URL when no
# explicit linkage has been configured yet, so use the operator-reachable robot-local runtime URL.
BIOXP_SERVER_URL=
# BIOXP_LINKAGE_STATE_PATH=/var/lib/biomodstack/bioxp_linkage_url

# Optional compose project override.
COMPOSE_PROJECT_NAME=biomodstack-core-runtime
