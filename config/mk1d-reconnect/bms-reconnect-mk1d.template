#!/usr/bin/env bash
# Installed root-owned helper. It accepts no arguments and ignores socket input.
# Its one BMS lifecycle effect is recreating literal bms-host-agent from the
# root-owned, installation-time rendered recovery compose artifact.
set -euo pipefail
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

readonly MINKNOW_SERVICE='__MINKNOW_SYSTEMD_SERVICE__'
readonly RECOVERY_COMPOSE_FILE='__BMS_RECOVERY_COMPOSE_FILE__'
readonly COMPOSE_PROJECT='__BMS_COMPOSE_PROJECT__'
readonly LOCK_FILE='/run/biomodstack/mk1d-reconnect.lock'
readonly MINKNOW_WAIT_SECONDS=45
readonly HOST_AGENT_WAIT_SECONDS=45
readonly HOST_AGENT_NAME='biomodstack-host-agent'
readonly HOST_AGENT_URL='http://127.0.0.1:8798'

receipt_id="mk1d-reconnect-$(date -u +%Y%m%dT%H%M%SZ)-$$"
minknow_stage='not_attempted'
host_agent_recreate='not_attempted'
host_agent_health='not_checked'

# The socket request carries no command data. Never parse it.
exec </dev/null

emit_receipt() {
    local status="$1"
    printf '{"schema":"bms.mk1d-reconnect-receipt.v1","receipt_id":"%s","status":"%s","minknow":"%s","host_agent_recreate":"%s","host_agent_health":"%s"}\n' \
        "$receipt_id" "$status" "$minknow_stage" "$host_agent_recreate" "$host_agent_health"
}

emit_busy_receipt() {
    # Stable and intentionally data-free: callers can distinguish lock admission
    # from a request that reached the MinKNOW or Docker stages.
    printf '%s\n' '{"schema":"bms.mk1d-reconnect-receipt.v1","receipt_id":"mk1d-reconnect-busy","status":"busy","minknow":"not_attempted","host_agent_recreate":"not_attempted","host_agent_health":"not_checked"}'
}

wait_for_minknow_active() {
    local deadline=$((SECONDS + MINKNOW_WAIT_SECONDS))
    while (( SECONDS < deadline )); do
        if systemctl is-active --quiet "$MINKNOW_SERVICE"; then
            return 0
        fi
        sleep 1
    done
    return 1
}

host_agent_is_verified() {
    local health
    health="$(docker inspect --format '{{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}}' "$HOST_AGENT_NAME" 2>/dev/null || true)"
    [[ "$health" == 'healthy' ]] || return 1
    curl --fail --silent --show-error --max-time 2 "$HOST_AGENT_URL/health" >/dev/null 2>&1 || return 1
    # This is a GET-only host-agent MinKNOW status path; it does not start a
    # protocol, hardware check, or physical action.
    curl --fail --silent --show-error --max-time 2 "$HOST_AGENT_URL/ont/status" >/dev/null 2>&1
}

wait_for_host_agent_verification() {
    local deadline=$((SECONDS + HOST_AGENT_WAIT_SECONDS))
    while (( SECONDS < deadline )); do
        if host_agent_is_verified; then
            return 0
        fi
        sleep 1
    done
    return 1
}

# The parent is root-owned/non-writable; tmpfiles creates this root-owned lock
# before socket activation. Nonblocking flock serializes competing socket units.
exec 9>"$LOCK_FILE"
if ! flock -n 9; then
    emit_busy_receipt
    exit 0
fi

minknow_state="$(systemctl show --property=ActiveState --value "$MINKNOW_SERVICE" 2>/dev/null || true)"
case "$minknow_state" in
    active)
        # Never touch active MinKNOW: it may own a protocol/acquisition.
        minknow_stage='already_active'
        ;;
    inactive|failed)
        if ! systemctl start "$MINKNOW_SERVICE" >/dev/null 2>&1; then
            minknow_stage='failed'
            emit_receipt failed
            exit 1
        fi
        if ! wait_for_minknow_active; then
            minknow_stage='failed'
            emit_receipt failed
            exit 1
        fi
        minknow_stage='started'
        ;;
    activating|reloading)
        # It is already being managed elsewhere; wait but do not issue start.
        if ! wait_for_minknow_active; then
            minknow_stage='failed'
            emit_receipt failed
            exit 1
        fi
        minknow_stage='already_active'
        ;;
    *)
        # Deactivating/unknown states are intentionally not modified.
        minknow_stage='blocked'
        emit_receipt blocked
        exit 1
        ;;
esac

# No checkout file, project .env, build, dependency, or service selection is
# consulted here. The immutable recovery artifact has one literal service.
if ! docker compose --env-file /dev/null -p "$COMPOSE_PROJECT" -f "$RECOVERY_COMPOSE_FILE" up -d --no-build --no-deps --force-recreate bms-host-agent >/dev/null 2>&1; then
    host_agent_recreate='failed'
    emit_receipt failed
    exit 1
fi
host_agent_recreate='requested'

if ! wait_for_host_agent_verification; then
    host_agent_health='failed'
    emit_receipt failed
    exit 1
fi
host_agent_health='verified'
emit_receipt completed
