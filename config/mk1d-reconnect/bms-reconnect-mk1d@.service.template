[Unit]
Description=BioModStack bounded Mk1D reconnect transaction (%i)
Documentation=file:__BMS_REPO_ROOT__/config/mk1d-reconnect/README.md

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/sbin/bms-reconnect-mk1d
StandardInput=socket
StandardOutput=socket
StandardError=journal
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=read-only
ProtectSystem=full
